{
    "m1.obj.01": (speaker: "", text: "Move up the coast road to Port Calder"),
    "m1.obj.02": (speaker: "", text: "Free the prisoners at the miners' camp"),
    "m1.obj.03": (speaker: "", text: "Reach the town square"),
    "m1.obj.04": (speaker: "", text: "Break out of the square"),
    "m1.obj.09": (speaker: "", text: "Push through Port Calder to the spaceport"),
    "m1.obj.05": (speaker: "", text: "Destroy the rebel base at the Calder spaceport"),
    "m1.obj.06": (speaker: "", text: "Always: Merrick must survive"),
    "m1.obj.07": (speaker: "", text: "Bonus: Rescue the PDF holdouts at the warehouses"),
    "m1.obj.08": (speaker: "", text: "Bonus: Tear down propaganda (anyone's)"),
    "m1.open.01": (speaker: "COMPANY BOMBERS", text: "Bombers to Company. LZ's the beach. Starting our run."),
    "m1.open.02": (speaker: "COMPANY BOMBERS", text: "Beach is clear. It's yours."),
    "m1.open.03": (speaker: "THEO", text: "Bastion's through. Wheels down in thirty."),
    "m1.open.04": (speaker: "HARROW", text: "Merrick's Company, welcome to Vela. Commander Lio Harrow, PDF. You don't know what it means to see you here."),
    "m1.open.05": (speaker: "MERRICK", text: "The payment helped. We'll do right by you."),
    "m1.open.06": (speaker: "HARROW", text: "Ha. Fair. They say your jobs end quick, and my colony needs quick. The insurgents hold Port Calder, up the coast road. My people will meet you on the way."),
    "m1.open.07": (speaker: "THEO", text: "Ramps down. Company's yours, Merrick."),
    "m1.road.01": (speaker: "THEO", text: "Let's get off this beach. Take us up to the road."),
    "m1.road.01h": (speaker: "HINT", text: "[W][A][S][D] pans · wheel zooms · [Q]/[E] turns"),
    "m1.road.02": (speaker: "HINT", text: "Drag a box to select units · right-click the ground to move"),
    "m1.road.03": (speaker: "THEO", text: "Roadblock on the bend. Two light tanks behind sandbags."),
    "m1.road.03h": (speaker: "HINT", text: "Right-click an enemy to attack it"),
    "m1.road.04": (speaker: "MERRICK", text: "Keep moving."),
    "m1.road.04a": (speaker: "FREE VELA (broadcast)", text: "Free Vela to every cell on the coast. Off-world guns came down on the north beach, bought by the colony to kill colonists. They're on the coast road now."),
    "m1.road.04b": (speaker: "THEO", text: "Word travels."),
    "m1.road.04c": (speaker: "MERRICK", text: "We weren't exactly quiet."),
    "m1.road.05": (speaker: "HARROW", text: "That's my second platoon on your left. They know these roads. Follow them in."),
    "m1.road.06": (speaker: "THEO", text: "\"Vela: safe, prosperous, together.\" Somebody's been at it with a paint can."),
    "m1.road.07": (speaker: "MERRICK", text: "Somebody always is."),
    "m1.road.08": (speaker: "FREE VELA (broadcast)", text: "Free Vela says: the Reach takes our ore and sends back holoboards! Down with the ARC!"),
    "m1.road.09": (speaker: "HARBOUR COMMITTEE (broadcast)", text: "Harbour Committee to all fishing crews: stay in port. Free Vela does not speak for the harbour."),
    "m1.road.10": (speaker: "THEO", text: "Two rebel stations on the air, and they can't agree on anything."),
    "m1.road.11": (speaker: "MERRICK", text: "They never did."),
    "m1.road.12": (speaker: "THEO", text: "Checkpoints all the way up. Don't stop for each one. Send them forward fighting."),
    "m1.road.12h": (speaker: "HINT", text: "[F], then click the ground: attack-move. Units fight whatever they meet on the way"),
    "m1.road.13": (speaker: "HARROW", text: "There's a bridge further up. My people are holding it for you. Come straight up the road."),
    "m1.road.15": (speaker: "THEO", text: "Can't see past that ridge. Send a scout up first. They see twice as far as the tanks."),
    "m1.road.15h": (speaker: "HINT", text: "Scouts see furthest. Look before you go"),
    "m1.road.16": (speaker: "THEO", text: "Dug-in guns on the rise. Don't charge them. Let the artillery work from out of their reach."),
    "m1.road.16h": (speaker: "HINT", text: "Artillery outranges them. Park it back and order it to attack"),
    "m1.road.17": (speaker: "FREE VELA (broadcast)", text: "Free Vela to all cells: the PDF is not your friend. Hit them where they sleep."),
    "m1.road.18": (speaker: "HARROW", text: "You see what we're up against. My colony deserves better than this."),
    "m1.road.19": (speaker: "MERRICK", text: "Most do."),
    "m1.road.20": (speaker: "CALDER COUNCIL (broadcast, filtered)", text: "People of Port Calder, stay indoors today. This ends today."),
    "m1.mine.01": (speaker: "THEO", text: "Fenced yard off the road. Rebel guards, and people inside. Civilians."),
    "m1.mine.02": (speaker: "HARROW", text: "Mine crews. The insurgents have been working them. Get them out and my people will see to them."),
    "m1.mine.03": (speaker: "THEO", text: "Gate's open. They're coming out."),
    "m1.mine.04": (speaker: "MINER", text: "We dug into something down there that isn't ours. Everyone who saw it got a bullet, and I saw it. You're here now. They'll come for you too."),
    "m1.mine.05": (speaker: "HARROW", text: "He's been through a lot. My people will take good care of him."),
    "m1.mine.06": (speaker: "MERRICK", text: "Will they."),
    "m1.mine.07": (speaker: "THEO", text: "Merrick?"),
    "m1.mine.08": (speaker: "MERRICK", text: "Walk them back to the beach. Ours, not his. And eyes open."),
    "m1.town.01": (speaker: "THEO", text: "Port Calder. The spaceport's on the hill behind it, right on top of the dig site."),
    "m1.town.02": (speaker: "HARROW", text: "My platoons are around the square. Bring your company in and we'll finish this together."),
    "m1.turn.01": (speaker: "HARROW (open channel)", text: "All PDF units. Weapons free on the contractors."),
    "m1.turn.02": (speaker: "THEO", text: "They're shooting at us! The PDF's turned!"),
    "m1.turn.03": (speaker: "MARA", text: "Hello, Cole."),
    "m1.turn.04": (speaker: "MERRICK", text: "Mara."),
    "m1.turn.05": (speaker: "THEO", text: "Quell? She made it out?"),
    "m1.turn.06": (speaker: "MARA", text: "You shouldn't have come back to the colonies. You know what's in the ground better than anyone."),
    "m1.turn.07": (speaker: "MARA", text: "I'm sorry. Vela gets to be free. That has a cost, and it's you."),
    "m1.turn.08": (speaker: "MERRICK", text: "It's always somebody else."),
    "m1.turn.09": (speaker: "THEO", text: "We're boxed in. Get us out of the square, anywhere but here!"),
    "m1.turn.10": (speaker: "MERRICK", text: "That's unhelpful. Everyone on me. North street."),
    "m1.turn.10h": (speaker: "HINT", text: "Select everything and right-click away from the guns. Keep Merrick in the middle · [Home] jumps to Merrick"),
    "m1.turn.11": (speaker: "MARA", text: "Every street out of that square is covered, Cole. I built it that way."),
    "m1.turn.12": (speaker: "THEO", text: "We're losing tanks. Keep moving or we lose them all."),
    "m1.hold.01": (speaker: "PDF SERGEANT", text: "Harrow, these people just fought beside us. We're not doing this."),
    "m1.hold.02": (speaker: "HARROW", text: "Then you're with them. Second platoon, deal with it."),
    "m1.hold.03": (speaker: "THEO", text: "One PDF crew just refused. Their own side's pinning them down by the warehouses."),
    "m1.hold.04": (speaker: "PDF SERGEANT", text: "We're with you. Whatever this is, it's not what we signed up for."),
    "m1.hold.05": (speaker: "MERRICK", text: "Welcome to the Company. The pay's terrible."),
    "m1.hold.06": (speaker: "THEO", text: "The warehouse crew's gone."),
    "m1.hold.07": (speaker: "MERRICK", text: "They chose. That counts for something."),
    "m1.arc.01": (speaker: "VASK", text: "This is Captain Imre Vask, Asterian Reach Command. All PDF and insurgent forces in Port Calder: stand down."),
    "m1.arc.02": (speaker: "VASK", text: "That was not a request."),
    "m1.arc.03": (speaker: "THEO", text: "ARC? Out here? Who called them?"),
    "m1.arc.04": (speaker: "MERRICK", text: "Nobody we know."),
    "m1.arc.05": (speaker: "MARA", text: "So you did bring the ARC. I almost didn't believe it of you."),
    "m1.arc.06": (speaker: "MERRICK", text: "I didn't bring anyone."),
    "m1.arc.07": (speaker: "VASK", text: "Merrick's Company. You're in my operation now. Keep to the east streets. My drops land on the west."),
    "m1.arc.08": (speaker: "MERRICK", text: "Your operation."),
    "m1.arc.09": (speaker: "VASK", text: "My orders. Move."),
    "m1.arc.10": (speaker: "VASK", text: "Drop two landing at the warehouses. Push with them or stay out of their way."),
    "m1.push.01": (speaker: "VASK", text: "All units, push for the spaceport. Clear the streets as you go."),
    "m1.push.02": (speaker: "THEO", text: "PDF armour dug in on the harbour road. Rebels in the buildings either side."),
    "m1.push.03": (speaker: "THEO", text: "PDF and rebels in the same trench. Nobody's even pretending now."),
    "m1.push.04": (speaker: "MERRICK", text: "Saves us asking."),
    "m1.push.05": (speaker: "VASK", text: "Gunships on the harbour road. Move up behind them."),
    "m1.push.06": (speaker: "HARROW", text: "Merrick! You don't know what's under that hill. None of you do."),
    "m1.push.07": (speaker: "MERRICK", text: "Should've put it in the contract."),
    "m1.push.08": (speaker: "THEO", text: "Column on the north road. PDF colours. They're coming for our flank."),
    "m1.push.09": (speaker: "VASK", text: "Hold them. My bombers are turning round."),
    "m1.arc.11": (speaker: "VASK", text: "Strike inbound on the spaceport road. Keep your people clear."),
    "m1.arc.12": (speaker: "MERRICK", text: "Not the town, Vask."),
    "m1.arc.13": (speaker: "VASK", text: "Not the town."),
    "m1.push.10": (speaker: "THEO", text: "I think I like them better on our side."),
    "m1.push.11": (speaker: "MERRICK", text: "Don't get used to it."),
    "m1.push.12": (speaker: "MARA", text: "All cells, fall back to the spaceport. Hold the pads. Whatever it costs, hold the pads."),
    "m1.push.13": (speaker: "MERRICK", text: "She's buying time."),
    "m1.push.14": (speaker: "THEO", text: "For what?"),
    "m1.push.15": (speaker: "MERRICK", text: "We'll find out."),
    "m1.push.16": (speaker: "HARROW", text: "All PDF, fall back to the pads. Fall back!"),
    "m1.push.17": (speaker: "THEO", text: "They're running for the spaceport. All of them."),
    "m1.fin.01": (speaker: "THEO", text: "Spaceport's dug in. Gun pits round the pads, and a Bastion sitting on one of them."),
    "m1.fin.02": (speaker: "MARA", text: "You won't get through the spaceport, Cole. And if you do, it won't matter."),
    "m1.fin.03": (speaker: "THEO", text: "That Bastion's spooling up!"),
    "m1.fin.04": (speaker: "VASK", text: "Let it go. My orders are the dig site, not the woman."),
    "m1.fin.05": (speaker: "MARA", text: "Ask your new friends why they came, Cole."),
    "m1.fin.06": (speaker: "THEO", text: "Last of the guns are down. Port Calder's quiet."),
    "m1.fin.07": (speaker: "VASK", text: "ARC units, cordon the dig site. Nobody goes in. That includes the Company."),
    "m1.fin.08": (speaker: "MERRICK", text: "Wasn't planning to."),
    "m1.fin.09": (speaker: "VASK", text: "Good. Then we'll get along."),
    "m1.fin.10": (speaker: "VASK", text: "I'd imagine your contract with the PDF is void. The Reach pays better, and it doesn't shoot its contractors."),
    "m1.fin.11": (speaker: "MERRICK", text: "Usually."),
    "m1.fin.12": (speaker: "VASK", text: "You fight like one of ours, Merrick."),
    "m1.fin.13": (speaker: "MERRICK", text: "I get that a lot."),
    "m1.fin.14": (speaker: "VASK", text: "My people will be in touch."),
    "m1.fin.15": (speaker: "THEO", text: "We're taking it?"),
    "m1.fin.16": (speaker: "MERRICK", text: "We're listening."),
    "m1.fail.01": (speaker: "THEO", text: "You're out front again, Merrick. Get behind the tanks."),
    "m1.fail.02": (speaker: "MERRICK", text: "They're behind me. That's the idea."),
    "m1.fail.02h": (speaker: "HINT", text: "[Home] jumps to Merrick. If Merrick falls, the mission is lost"),
    "m1.fail.03": (speaker: "THEO", text: "Get out of there!"),
    "m1.fail.04": (speaker: "THEO", text: "Merrick! Merrick, respond!"),
    "m1.prop.01": (speaker: "THEO", text: "That was a Reach holoboard. Harrow won't love that."),
    "m1.prop.02": (speaker: "MERRICK", text: "It was lying."),
    "m1.prop.03": (speaker: "THEO", text: "One less smiling face on the road."),
    "m1.prop.04": (speaker: "THEO", text: "Something against happy slogans?"),
    "m1.prop.05": (speaker: "MERRICK", text: "They're bad for my eyes."),
    "m1.prop.06": (speaker: "VASK", text: "Merrick. Those boards are Reach property."),
    "m1.prop.07": (speaker: "MERRICK", text: "Bill me."),
    "m1.prop.08": (speaker: "VASK", text: "My orders don't cover redecorating."),
    "m1.prop.09": (speaker: "THEO", text: "\"Free Vela,\" two metres tall. Not anymore."),
    "m1.prop.10": (speaker: "THEO", text: "One less loudspeaker. Quieter already."),
    "m1.prop.11": (speaker: "THEO", text: "Running a cleanup crew now?"),
    "m1.prop.12": (speaker: "MERRICK", text: "Somebody has to."),
    "m1.prop.13": (speaker: "MARA", text: "Tearing down our walls, Cole? You used to paint them."),
    "m1.prop.14": (speaker: "THEO", text: "So, one of theirs and one of ours. Whoever \"ours\" is today."),
    "m1.prop.15": (speaker: "MERRICK", text: "We're the Company. We don't do slogans."),
    "m1.prop.16": (speaker: "VASK", text: "Is your company always this even-handed?"),
    "m1.prop.17": (speaker: "MERRICK", text: "We bill by the hour."),
    "m1.prop.18": (speaker: "MARA", text: "Still don't believe in anything, do you, Cole?"),
    "m1.prop.19": (speaker: "MERRICK", text: "I believe in going home."),
    "m1.prop.20": (speaker: "THEO", text: "That's every sign in Port Calder. Both sides."),
    "m1.prop.21": (speaker: "MERRICK", text: "Clean slate."),
    "prop.reach_welcome": (speaker: "LOCAL SIGN", text: "VELA: SAFE. PROSPEROUS. TOGETHER."),
    "prop.reach_harrow": (speaker: "LOCAL SIGN", text: "THE REACH CARES. Report suspicious activity to your PDF post."),
    "prop.reach_safe": (speaker: "LOCAL SIGN", text: "SAFE? PROSPEROUS? TOGETHER?"),
    "prop.reach_property": (speaker: "LOCAL SIGN", text: "CALDER ORE: POWERING THE REACH"),
    "prop.reach_future": (speaker: "LOCAL SIGN", text: "ONE REACH. ONE FUTURE."),
    "prop.rebel_free": (speaker: "LOCAL SIGN", text: "FREE VELA"),
    "prop.rebel_speaker": (speaker: "LOCAL SIGN", text: "DOWN WITH THE ARC"),
    "prop.rebel_cleanup": (speaker: "LOCAL SIGN", text: "ARC GO HOME"),
    "prop.rebel_mural": (speaker: "LOCAL SIGN", text: "THE REACH CARES (ABOUT ORE)"),
    "prop.rebel_ore": (speaker: "LOCAL SIGN", text: "OUR ORE. OUR SEA."),
    "prop.reach_pdf": (speaker: "LOCAL SIGN", text: "YOUR PDF: VELAN BORN, VELAN PROUD"),
    "prop.rebel_home": (speaker: "LOCAL SIGN", text: "ONE REACH, ONE BOOT"),
    "prop.rebel_harbour": (speaker: "LOCAL SIGN", text: "NO ONE SPEAKS FOR THE HARBOUR"),
}
