(
    key: "Naga",
    // What ARC soldiers call them. Their own name for themselves is still open.
    name: "The Naga",
    abbreviation: "Naga",
    description: "An old empire of rival houses, united by a Precursor machine they learned to understand. Ultra-mechanical war machines of dark plate over bronze workings, lit red; plasma bound by gravity, star cores, nanites that build, and shields.",
    // Their own structures and engineer, but no fighting units yet: their factories turn out
    // the stand-in's until they have some. Structures are always their own (mc-data checks).
    stand_in: Some("Aster"),
    commander: "naga_commander",
    plating_color: (0.03, 0.026, 0.026),
    accent_color: (0.012, 0.01, 0.01),
    highlight_color: (1.0, 0.05, 0.07),
    shield_color: (0.95, 0.24, 0.12),
    // Nanites build for them: a builder pours a stream of them onto its work, and a black
    // swarm holding the building's shape condenses into plate, violet light running through
    // it, instead of it being printed under a beam.
    construction: Nanite,
    // Their own voices (data/factions/naga/sounds.ron): hisses, clicks, breaths and
    // heartbeats, not servos and chimes.
    sounds: (
        select: {
            Commander: "naga_select_commander",
            Engineer: "naga_select_engineer",
            Factory: "naga_select_factory",
            Extractor: "naga_select_extractor",
            Power: "naga_select_power",
            Storage: "naga_select_storage",
            Defense: "naga_select_defense",
            AntiAir: "naga_select_anti_air",
            Intel: "naga_select_intel",
            Wall: "naga_select_wall",
        },
        build: (beam: "naga_nanite", start: "naga_nanite_start", end: "naga_nanite_end"),
    ),
)
