        // An Eye: the lid sliding open, wet, and the pupil focusing with a soft click, then
        // a smaller one as it settles.
        "naga_select_intel": (
            length: 0.9, peak: 0.19, room: 0.55,
            layers: [
                // The slide: a moist glide rising, small bubbles of wet in it.
                Chirp(from: 220, to: 330, glide: 0.2, attack: 0.04, decay: 0.08, gain: 0.45, vibrato: 11, bend: 0.03, ratio: 0.5, index: 0.7),
                Tone(at: 0.04, from: 700, to: 1100, glide: 0.008, attack: 0.001, decay: 0.006, gain: 0.12, pan: -0.2),
                Tone(at: 0.09, from: 760, to: 1200, glide: 0.008, attack: 0.001, decay: 0.006, gain: 0.1, pan: 0.15),
                Tone(at: 0.135, from: 820, to: 1250, glide: 0.008, attack: 0.001, decay: 0.006, gain: 0.1, pan: -0.1),
                // The focusing clicks: soft, the second smaller.
                Fm(at: 0.24, from: 660, to: 587.3, glide: 0.01, ratio: 2, index: 0.8, fade: 0.01, attack: 0.001, decay: 0.022, gain: 0.45, pan: 0.1),
                Burst(at: 0.24, low: 500, high: 1800, attack: 0.0003, decay: 0.0025, gain: 0.9, pan: 0.1),
                Fm(at: 0.3, from: 494, to: 440, glide: 0.01, ratio: 2, index: 0.6, fade: 0.01, attack: 0.001, decay: 0.02, gain: 0.25, pan: -0.1),
                Burst(at: 0.3, low: 450, high: 1500, attack: 0.0003, decay: 0.002, gain: 0.5, pan: -0.1),
                Drive(1.1),
                Sweep(at: 0.01, from: 500, to: 1500, glide: 0.2, q: 3.0, attack: 0.05, decay: 0.1, gain: 0.3, pan: -0.1),
            ],
        ),
        // A Thornwall: thorns creaking under their own weight, low, heavy and short.
        "naga_select_wall": (
            length: 0.6, peak: 0.26, room: 0.35,
            layers: [
                Chirp(from: 146.8, to: 110, glide: 0.12, attack: 0.008, decay: 0.07, gain: 0.8, pulse: 62, ratio: 0.5, index: 2.4),
                Chirp(at: 0.1, from: 130.8, to: 98, glide: 0.1, attack: 0.008, decay: 0.06, gain: 0.6, pan: 0.2, pulse: 54, ratio: 0.5, index: 2.2),
