// The Naga's own sounds: the Sovereign's stinger, legs and feet; every Naga answer to a
// selection; their builders' nanites; the Barb's and Thornspitter's guns; the Tender's walk;
// the battle scorpion's beam and bombs.
(
    sounds: {
        // The stinger's gun prong. The weapon draws each 0.3 s shot as three bolts
        // (`rounds` in command.ron), so this is three spits 40 ms apart: a sizzle that
        // snaps down in pitch, a dry crack under it, the air hissing shut behind.
        // Keep it light; a commander fires it all game.
        "naga_stinger": (
            length: 0.36, peak: 0.42, room: 0.12,
            layers: [
                Fm(from: 1300, to: 380, glide: 0.035, ratio: 3.5, index: 1.8, fade: 0.02, attack: 0.0006, decay: 0.03, gain: 0.3),
                Burst(low: 600, high: 2600, attack: 0.0003, decay: 0.006, gain: 2.2),
                Tone(from: 240, to: 90, glide: 0.02, attack: 0.001, decay: 0.02, gain: 0.3),
                Fm(at: 0.04, from: 1250, to: 360, glide: 0.035, ratio: 3.5, index: 1.7, fade: 0.02, attack: 0.0006, decay: 0.03, gain: 0.28, pan: 0.1),
                Burst(at: 0.04, low: 600, high: 2400, attack: 0.0003, decay: 0.006, gain: 2.0),
                Tone(at: 0.04, from: 230, to: 88, glide: 0.02, attack: 0.001, decay: 0.02, gain: 0.28),
                Fm(at: 0.08, from: 1350, to: 400, glide: 0.035, ratio: 3.5, index: 1.9, fade: 0.02, attack: 0.0006, decay: 0.03, gain: 0.3, pan: -0.1),
                Burst(at: 0.08, low: 600, high: 2600, attack: 0.0003, decay: 0.006, gain: 2.1),
                Tone(at: 0.08, from: 250, to: 92, glide: 0.02, attack: 0.001, decay: 0.02, gain: 0.3),
                Drive(1.2),
                Sweep(at: 0.01, from: 4200, to: 1400, glide: 0.2, q: 1.4, attack: 0.01, decay: 0.09, gain: 0.35),
            ],
        ),
        // Eight heavy legs working under a tonne-heavy armoured body: the drive's growl,
        // a pump chugging with the stride, the rams straining as each group of legs lifts
        // (one side, then the other), the plates grinding low over each other and the
        // weight rolling in the ground. Nothing above the low mids: no chitter, no clatter.
        // No footfalls in it: those are `naga_footfall`. Every steady frequency and wobble
        // is a whole number of cycles in the 2.4 s loop.
        "naga_crawl": (
            length: 2.4, peak: 0.26, room: 0.0, looped: true,
            layers: [
                // The drive: a growl on 45.8 Hz and its harmonics, breathing with the stride.
                Fm(from: 45.8333, to: 45.8333, glide: 1, ratio: 0.5, index: 1.4, fade: 1000, attack: 0.01, decay: 100000, gain: 0.28),
                Drone(freq: 91.6667, gain: 0.12, wobble: 2.0833, depth: 0.55),
                Drone(freq: 137.5, gain: 0.06, wobble: 4.1667, depth: 0.6, pan: -0.1),
                // The rams: each group of legs straining up to the lift and easing off.
                Fm(at: 0.05, from: 64, to: 86, glide: 0.45, ratio: 1.41, index: 0.7, fade: 0.4, attack: 0.25, decay: 0.2, gain: 0.16, pan: -0.3),
                Fm(at: 0.65, from: 60, to: 80, glide: 0.45, ratio: 1.41, index: 0.7, fade: 0.4, attack: 0.25, decay: 0.2, gain: 0.15, pan: 0.3),
                Fm(at: 1.25, from: 66, to: 88, glide: 0.45, ratio: 1.41, index: 0.7, fade: 0.4, attack: 0.25, decay: 0.2, gain: 0.16, pan: -0.25),
                Fm(at: 1.85, from: 62, to: 82, glide: 0.4, ratio: 1.41, index: 0.7, fade: 0.35, attack: 0.22, decay: 0.18, gain: 0.15, pan: 0.25),
                // A valve letting go at the top of each lift: a dull thump, not a click.
                Burst(at: 0.55, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.1, pan: -0.3),
                Burst(at: 1.15, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.0, pan: 0.3),
                Burst(at: 1.75, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.1, pan: -0.25),
                Burst(at: 2.3, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.0, pan: 0.25),
                Drive(1.3),
                // Plates grinding over each other as it moves, low.
                Rumble(freq: 260, q: 0.9, gain: 3.2, wobble: 4.1667, depth: 0.7),
                Drone(freq: 183.3333, gain: 0.04, wobble: 4.1667, depth: 0.7, pan: 0.1),
                // The weight in the ground.
                Rumble(freq: 110, q: 0.7, gain: 3.0, wobble: 2.0833, depth: 0.5),
            ],
        ),
        // A heavy armoured foot coming down, one of eight: the leg's ram shoving it down
        // (a short hiss of oil under pressure), then the impact, a deep thud into the
        // ground with a dull clank of the leg's armour taking the load, grit crunching and
        // the weight settling. No bright tick or ring: it is heavy, not tinny.
        "naga_footfall": (
            length: 0.6, peak: 0.34, room: 0.3,
            layers: [
                // The ram driving the leg down.
                Sweep(from: 1400, to: 500, glide: 0.05, q: 0.9, attack: 0.01, decay: 0.03, gain: 0.12),
                // The impact: the thud and the ground's answer.
                Burst(at: 0.045, low: 35, high: 240, attack: 0.002, decay: 0.09, gain: 9),
                Tone(at: 0.045, from: 118, to: 44, glide: 0.08, attack: 0.002, decay: 0.12, gain: 1.4),
                Tone(at: 0.05, from: 60, to: 34, glide: 0.2, attack: 0.006, decay: 0.2, gain: 0.9),
                // The leg's armour taking the load: one low, dull clank.
                Fm(at: 0.047, from: 176, to: 150, glide: 0.08, ratio: 1.41, index: 0.9, fade: 0.04, attack: 0.002, decay: 0.07, gain: 0.26, pan: 0.1),
                // Grit crunching under the claw.
                Burst(at: 0.046, low: 140, high: 900, attack: 0.001, decay: 0.022, gain: 2.2),
                Drive(1.4),
                Roll(at: 0.06, from: 520, to: 140, glide: 0.3, attack: 0.02, decay: 0.16, gain: 0.18, swell: 9, depth: 0.6, seed: 7101),
            ],
        ),


        // ---- selection answers ---------------------------------------------------------
        // What a Naga answers the player with, by the kind of thing it is (faction.ron's
        // `sounds.select`). Heard as data/sounds/responses.ron's are: at interface volume,
        // from no place, far more often than any gun, so short and quiet. Not ARC's servos
        // and chimes: a Naga breathes, hisses, clicks wetly, rattles its chitin, growls and
        // beats. Every answer is a gesture that moves, and the kind is told by the gesture;
        // what pitch there is still lands on the interface's D and A.

        // The Sovereign: the biggest answer. A breath drawn in, a low growl rising out of
        // it from A onto D with the throat's rasp in it, the back plates lifting and
        // settling in a dull rattle, and the breath let out.
        "naga_select_commander": (
            length: 1.1, peak: 0.32, room: 0.6,
            layers: [
                // The growl: a rasping fry rising A to D (the half-ratio shake puts the rasp
                // an octave under it), a lighter voice above, a sub under.
                Chirp(at: 0.1, from: 110, to: 146.8, glide: 0.28, attack: 0.08, decay: 0.17, gain: 0.8, pulse: 27, ratio: 0.5, index: 2.4, vibrato: 4.5, bend: 0.015),
                Chirp(at: 0.11, from: 220, to: 293.7, glide: 0.27, attack: 0.08, decay: 0.13, gain: 0.3, pan: 0.15, pulse: 27, ratio: 0.5, index: 1.4, vibrato: 4.5, bend: 0.015),
                Tone(at: 0.08, from: 41.2, to: 55, glide: 0.28, attack: 0.08, decay: 0.16, gain: 0.5),
                // The plates lifting: dull, low, one after another down the back.
                Fm(at: 0.33, from: 262, to: 220, glide: 0.03, ratio: 1.41, index: 1.5, fade: 0.02, attack: 0.001, decay: 0.03, gain: 0.45, pan: -0.3),
                Fm(at: 0.365, from: 247, to: 208, glide: 0.03, ratio: 1.41, index: 1.5, fade: 0.02, attack: 0.001, decay: 0.03, gain: 0.4, pan: -0.1),
                Fm(at: 0.395, from: 233, to: 196, glide: 0.03, ratio: 1.41, index: 1.4, fade: 0.02, attack: 0.001, decay: 0.035, gain: 0.4, pan: 0.12),
                Fm(at: 0.43, from: 220, to: 185, glide: 0.03, ratio: 1.41, index: 1.3, fade: 0.02, attack: 0.001, decay: 0.045, gain: 0.45, pan: 0.3),
                Burst(at: 0.33, low: 200, high: 1300, attack: 0.0005, decay: 0.006, gain: 2.0, pan: -0.3),
                Burst(at: 0.365, low: 200, high: 1200, attack: 0.0005, decay: 0.005, gain: 1.6, pan: -0.1),
                Burst(at: 0.395, low: 200, high: 1200, attack: 0.0005, decay: 0.005, gain: 1.5, pan: 0.12),
                Burst(at: 0.43, low: 180, high: 1100, attack: 0.0005, decay: 0.008, gain: 1.9, pan: 0.3),
                Drive(1.3),
                // The breath: drawn in, rising, then let out long and falling.
                Sweep(from: 320, to: 1100, glide: 0.3, q: 1.1, attack: 0.15, decay: 0.07, gain: 0.55),
                Sweep(at: 0.44, from: 1500, to: 420, glide: 0.4, q: 0.8, attack: 0.04, decay: 0.18, gain: 0.45),
            ],
        ),
        // A Tender: a quick run of small wet clicks climbing, a chitter, and a short hiss.
        "naga_select_engineer": (
            length: 0.6, peak: 0.24, room: 0.4,
            layers: [
                Chirp(from: 587.3, to: 880, glide: 0.1, attack: 0.004, decay: 0.07, gain: 0.5, pulse: 42, ratio: 2, index: 1.1),
                Burst(at: 0.004, low: 700, high: 2400, attack: 0.0003, decay: 0.002, gain: 1.0, pan: -0.2),
                Burst(at: 0.027, low: 750, high: 2500, attack: 0.0003, decay: 0.002, gain: 0.9, pan: 0.1),
                Burst(at: 0.048, low: 800, high: 2600, attack: 0.0003, decay: 0.002, gain: 1.0, pan: -0.1),
                Burst(at: 0.067, low: 850, high: 2700, attack: 0.0003, decay: 0.002, gain: 0.9, pan: 0.2),
                Burst(at: 0.084, low: 900, high: 2800, attack: 0.0003, decay: 0.002, gain: 1.1),
                Tone(at: 0.004, from: 440, to: 660, glide: 0.006, attack: 0.0005, decay: 0.006, gain: 0.25, pan: -0.2),
                Tone(at: 0.048, from: 494, to: 740, glide: 0.006, attack: 0.0005, decay: 0.006, gain: 0.25, pan: -0.1),
                Tone(at: 0.084, from: 587.3, to: 880, glide: 0.006, attack: 0.0005, decay: 0.008, gain: 0.3),
                // The hiss: a short breath out through the spinneret.
                Sweep(at: 0.1, from: 2200, to: 4200, glide: 0.08, q: 1.6, attack: 0.008, decay: 0.05, gain: 0.2, pan: 0.15),
            ],
        ),

        // ---- structures: grown things, so they swell, beat, draw and creak ----
        // A brood pit: something deep churning in it, thick bubbles coming up faster as it
        // swells, and a warm low note rising A to D under it.
        "naga_select_factory": (
            length: 0.9, peak: 0.25, room: 0.55,
            layers: [
                Fm(from: 110, to: 146.8, glide: 0.3, ratio: 0.5, index: 1.8, fade: 0.2, attack: 0.12, decay: 0.12, gain: 0.7),
                Stack(at: 0.05, from: 220, to: 293.7, glide: 0.3, attack: 0.12, decay: 0.1, gain: 0.3, detune: 1.006, width: 0.3, partials: [(1, 0.8), (2, 0.4), (3, 0.2)]),
                // Bubbles breaking: big and slow first, then smaller and quicker.
                Tone(at: 0.05, from: 165, to: 330, glide: 0.045, attack: 0.004, decay: 0.03, gain: 0.55, pan: -0.25),
                Tone(at: 0.15, from: 185, to: 370, glide: 0.04, attack: 0.004, decay: 0.026, gain: 0.5, pan: 0.2),
                Tone(at: 0.225, from: 208, to: 415, glide: 0.035, attack: 0.004, decay: 0.022, gain: 0.45, pan: -0.1),
                Tone(at: 0.28, from: 233, to: 466, glide: 0.03, attack: 0.004, decay: 0.02, gain: 0.4, pan: 0.3),
                Tone(at: 0.32, from: 262, to: 523, glide: 0.026, attack: 0.004, decay: 0.018, gain: 0.35, pan: -0.3),
                Burst(at: 0.09, low: 200, high: 1100, attack: 0.001, decay: 0.005, gain: 1.3, pan: -0.25),
                Burst(at: 0.187, low: 220, high: 1150, attack: 0.001, decay: 0.005, gain: 1.1, pan: 0.2),
                Burst(at: 0.257, low: 240, high: 1200, attack: 0.001, decay: 0.004, gain: 1.0, pan: -0.1),
                Burst(at: 0.307, low: 260, high: 1300, attack: 0.001, decay: 0.004, gain: 0.9, pan: 0.3),
                Drive(1.25),
                // The churn: thick and rolling, swelling with the note.
                Roll(from: 450, to: 750, glide: 0.3, attack: 0.14, decay: 0.12, gain: 0.45, swell: 10, depth: 0.7),
            ],
        ),
        // A Taproot: roots straining in the ground, creaking as they take the pull, and a
        // slow draw coming up through them with a gulp at the top.
        "naga_select_extractor": (
            length: 0.9, peak: 0.18, room: 0.5,
            layers: [
                // The strain: a slow creak whose pitch sinks as the roots take the weight.
                Chirp(from: 164.8, to: 130.8, glide: 0.35, attack: 0.05, decay: 0.11, gain: 0.7, pulse: 36, ratio: 0.5, index: 2.4),
                Chirp(at: 0.02, from: 329.6, to: 277.2, glide: 0.35, attack: 0.06, decay: 0.1, gain: 0.22, pan: 0.2, pulse: 29, ratio: 0.5, index: 1.3),
                // The draw: tension rising A to D as the sap comes up.
                Fm(at: 0.04, from: 110, to: 146.8, glide: 0.36, ratio: 0.5, index: 1.2, fade: 0.25, attack: 0.2, decay: 0.07, gain: 0.45),
                // The gulp at the top.
                Tone(at: 0.38, from: 146.8, to: 293.7, glide: 0.045, attack: 0.004, decay: 0.04, gain: 0.6),
                Burst(at: 0.41, low: 150, high: 900, attack: 0.001, decay: 0.007, gain: 1.4),
                Drive(1.2),
                Sweep(at: 0.02, from: 300, to: 900, glide: 0.36, q: 2.4, attack: 0.24, decay: 0.07, gain: 0.4, pan: -0.15),
            ],
        ),
        // A Heart: two beats, lub-dub, muffled in flesh, and a warm swell coming up after
        // them and settling back.
        "naga_select_power": (
            length: 0.9, peak: 0.19, room: 0.45,
            layers: [
                Tone(from: 150, to: 55, glide: 0.04, attack: 0.003, decay: 0.05, gain: 1.0),
                Burst(low: 50, high: 450, attack: 0.002, decay: 0.016, gain: 3.5),
                Tone(at: 0.15, from: 130, to: 49, glide: 0.045, attack: 0.003, decay: 0.065, gain: 0.85),
                Burst(at: 0.15, low: 50, high: 420, attack: 0.002, decay: 0.02, gain: 3.0),
                // The swell the beats push through it: warm, low partials only, A up to D.
                Stack(at: 0.19, from: 220, to: 293.7, glide: 0.24, attack: 0.08, decay: 0.1, gain: 0.16, detune: 1.005, width: 0.35, partials: [(1, 0.8), (2, 0.4), (3, 0.15)]),
                Fm(at: 0.19, from: 110, to: 146.8, glide: 0.24, ratio: 0.5, index: 0.9, fade: 0.2, attack: 0.08, decay: 0.1, gain: 0.22),
                Drive(1.2),
            ],
        ),
        // A Cyst: a sac swelling full, stretching, and settling back heavy with a slosh.
        "naga_select_storage": (
            length: 0.9, peak: 0.19, room: 0.5,
            layers: [
                // Swelling: a soft note rising, the skin stretching.
                Fm(from: 146.8, to: 220, glide: 0.22, ratio: 0.5, index: 0.9, fade: 0.2, attack: 0.16, decay: 0.06, gain: 0.7),
                Fm(from: 293.7, to: 440, glide: 0.22, ratio: 1, index: 0.5, fade: 0.2, attack: 0.16, decay: 0.05, gain: 0.2, pan: 0.2),
                // Settling: the note sinks back a step as the weight comes down.
                Fm(at: 0.24, from: 220, to: 196, glide: 0.16, ratio: 0.5, index: 0.7, fade: 0.12, attack: 0.015, decay: 0.12, gain: 0.6),
                Tone(at: 0.24, from: 130, to: 73.4, glide: 0.05, attack: 0.005, decay: 0.05, gain: 0.5),
                Drive(1.1),
                Sweep(from: 250, to: 800, glide: 0.22, q: 1.6, attack: 0.16, decay: 0.05, gain: 0.3),
                Roll(at: 0.24, from: 900, to: 260, glide: 0.25, attack: 0.015, decay: 0.12, gain: 0.35, swell: 12, depth: 0.6, pan: -0.15),
            ],
        ),
        // A Barb: the barb drawn back in a dry rattle, locking with a dull knock, and the
        // venom hissing up into it.
        "naga_select_defense": (
            length: 0.8, peak: 0.30, room: 0.45,
            layers: [
                Chirp(from: 146.8, to: 220, glide: 0.12, attack: 0.006, decay: 0.07, gain: 0.55, pulse: 56, ratio: 0.5, index: 2.0),
                Burst(at: 0.005, low: 500, high: 2000, attack: 0.0003, decay: 0.0025, gain: 1.0, pan: -0.2),
                Burst(at: 0.024, low: 520, high: 2100, attack: 0.0003, decay: 0.0025, gain: 0.9, pan: -0.1),
                Burst(at: 0.041, low: 540, high: 2200, attack: 0.0003, decay: 0.0025, gain: 1.0),
                Burst(at: 0.057, low: 560, high: 2300, attack: 0.0003, decay: 0.0025, gain: 0.9, pan: 0.1),
                Burst(at: 0.072, low: 580, high: 2300, attack: 0.0003, decay: 0.0025, gain: 1.0, pan: 0.2),
                Burst(at: 0.086, low: 600, high: 2400, attack: 0.0003, decay: 0.0025, gain: 0.9, pan: 0.2),
                // Locked.
                Fm(at: 0.12, from: 220, to: 146.8, glide: 0.025, ratio: 1.41, index: 1.8, fade: 0.015, attack: 0.001, decay: 0.03, gain: 0.8, pan: 0.1),
                Tone(at: 0.12, from: 130, to: 60, glide: 0.03, attack: 0.002, decay: 0.035, gain: 0.7),
                Burst(at: 0.12, low: 200, high: 1100, attack: 0.0005, decay: 0.006, gain: 1.4, pan: 0.1),
                Drive(1.25),
                // The venom coming up: a hiss that swells and cuts off.
                Sweep(at: 0.15, from: 1600, to: 3200, glide: 0.14, q: 1.4, attack: 0.03, decay: 0.07, gain: 0.5, pan: 0.15),
            ],
        ),
        // A Thornspitter: quills rattling up, light and climbing, then a sharp breath of
        // air up past them.
        "naga_select_anti_air": (
            length: 0.8, peak: 0.24, room: 0.45,
            layers: [
                Chirp(from: 293.7, to: 587.3, glide: 0.13, attack: 0.006, decay: 0.07, gain: 0.45, pulse: 48, ratio: 2, index: 0.9),
                Burst(at: 0.004, low: 600, high: 2200, attack: 0.0003, decay: 0.002, gain: 0.8, pan: -0.3),
                Burst(at: 0.021, low: 700, high: 2500, attack: 0.0003, decay: 0.002, gain: 0.8, pan: 0.2),
                Burst(at: 0.037, low: 800, high: 2800, attack: 0.0003, decay: 0.002, gain: 0.85, pan: -0.15),
                Burst(at: 0.052, low: 900, high: 3100, attack: 0.0003, decay: 0.002, gain: 0.85, pan: 0.3),
                Burst(at: 0.066, low: 1000, high: 3400, attack: 0.0003, decay: 0.002, gain: 0.9, pan: -0.25),
                Burst(at: 0.079, low: 1100, high: 3700, attack: 0.0003, decay: 0.002, gain: 0.9, pan: 0.1),
                Burst(at: 0.091, low: 1200, high: 4000, attack: 0.0003, decay: 0.002, gain: 1.0, pan: 0.25),
                Tone(at: 0.1, from: 180, to: 110, glide: 0.03, attack: 0.002, decay: 0.03, gain: 0.35),
                Drive(1.15),
                // The breath up: sharp, airy, climbing.
                Sweep(at: 0.1, from: 2600, to: 6000, glide: 0.1, q: 2.0, attack: 0.006, decay: 0.07, gain: 0.55),
            ],
