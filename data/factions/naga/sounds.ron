        // ---- building ------------------------------------------------------------------
        // What a Naga builder makes instead of ARC's weld (faction.ron's `sounds.build`):
        // the nanite stream coming on, pouring while it works, and settling when it stops.
        // A machine at work, not a living thing: steady tones, contactors, ratchets.

        // The loop while a builder works: a low machine hum and its octave under the swarm,
        // a close stack of tones beaten fast into a fine chatter of millions of small
        // things moving, and the stream itself, narrow and low. Every frequency and wobble
        // is a whole number of cycles in the 2.0 s loop.
        "naga_nanite": (
            length: 2.0, peak: 0.35, room: 0.15, looped: true,
            layers: [
                Drone(freq: 65, gain: 0.06, wobble: 2, depth: 0.3),
                Drone(freq: 130, gain: 0.04, wobble: 1, depth: 0.2),
                // The swarm: its chatter.
                Drone(freq: 390, gain: 0.03, wobble: 24, depth: 0.9),
                Drone(freq: 585, gain: 0.018, wobble: 30, depth: 0.9, pan: 0.15),
                Drone(freq: 292.5, gain: 0.02, wobble: 18, depth: 0.85, pan: -0.15),
                Drive(1.2),
                // The stream: narrow and low, or it is static.
                Rumble(freq: 700, q: 3.0, gain: 0.8, wobble: 12, depth: 0.8),
            ],
        ),
        // The stream coming on: a contactor, the hum catching from under the loop's note,
        // the swarm spinning up onto its chord, and a ratchet as the emitter locks on.
        "naga_nanite_start": (
            length: 0.6, peak: 0.45, room: 0.2,
            layers: [
                Burst(low: 180, high: 1100, attack: 0.0005, decay: 0.012, gain: 9),
                Tone(from: 40, to: 65, glide: 0.12, attack: 0.004, decay: 0.18, gain: 0.5),
                Stack(from: 300, to: 390, glide: 0.15, attack: 0.02, decay: 0.16, gain: 0.5, detune: 1.008, width: 0.4, partials: [(1, 1), (1.5, 0.5), (2, 0.35)]),
                Tone(at: 0.06, from: 1200, to: 800, glide: 0.004, attack: 0.0003, decay: 0.004, gain: 0.15),
                Tone(at: 0.1, from: 1200, to: 800, glide: 0.004, attack: 0.0003, decay: 0.004, gain: 0.14, pan: 0.1),
                Tone(at: 0.13, from: 1200, to: 800, glide: 0.004, attack: 0.0003, decay: 0.004, gain: 0.13, pan: -0.1),
                Tone(at: 0.155, from: 1200, to: 800, glide: 0.004, attack: 0.0003, decay: 0.004, gain: 0.12),
                Drive(1.25),
            ],
        ),
        // The stream stopping: the contactor opening, the swarm running down out of the
        // loop's chord, and a latch as it settles.
        "naga_nanite_end": (
            length: 0.7, peak: 0.42, room: 0.25,
            layers: [
                Burst(low: 180, high: 900, attack: 0.0005, decay: 0.01, gain: 7),
                Stack(from: 390, to: 260, glide: 0.3, attack: 0.004, decay: 0.17, gain: 0.8, detune: 1.008, width: 0.4, partials: [(1, 1), (1.5, 0.5), (2, 0.35)]),
                Tone(from: 65, to: 35, glide: 0.3, attack: 0.004, decay: 0.2, gain: 0.25),
                Tone(at: 0.26, from: 160, to: 70, glide: 0.04, attack: 0.003, decay: 0.06, gain: 0.45),
                Drive(1.2),
            ],
        ),

        // ---- weapons -------------------------------------------------------------------
        // The Barb. Each 0.9 s shot is drawn as three bolts (`rounds: 3` in structures.ron),
