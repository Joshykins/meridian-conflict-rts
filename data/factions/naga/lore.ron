// In-world lore for the Naga's own units and the weapons they carry. One short sentence
// each; weapon names must match the unit file's `name:` exactly.
{
    "naga_commander": (
        lore: "A war-machine that walks ashore alone and raises a stronghold from its tail; ARC crews call it the Sovereign.",
        weapons: {
            "Plasmeric Repeater": "The tail's right prong fires slugs of plasma held tight by gravity; they hit like shells and glaze the ground they miss.",
        },
    ),
    "naga_t1_engineer": (
        lore: "A small crawler that tends the Naga's growths, walking the seabed as easily as the shore.",
        weapons: {},
    ),
    "naga_t1_land_factory": (
        lore: "A press works under swept armour: fabricators hung round a turning ring pour nanites onto the bay floor, and the machine walks out finished.",
        weapons: {},
    ),
    "naga_t1_air_factory": (
        lore: "Four armoured towers hold a lift ring over the pad; the craft is poured whole under it and rises through.",
        weapons: {},
    ),
    "naga_t1_naval_factory": (
        lore: "A floating dock of two armoured arms and a gantry; the hull is poured in the slip between them and sails straight out.",
        weapons: {},
    ),
    "naga_t1_extractor": (
        lore: "A sealed bore braced on four legs; its own gravity pinch lifts the ore, so it draws nothing from the grid. ARC engineers still argue about how.",
        weapons: {},
    ),
    "naga_t1_power": (
        lore: "A small star pinched out of plasma and held in a turning gravity cage. Breach the cage and the star falls in on itself and goes out, taking nothing with it.",
        weapons: {},
    ),
    "naga_storage": (
        lore: "An armoured mass vault between two long energy cells: one building holds both.",
        weapons: {},
    ),
    "naga_t1_point_defense": (
        lore: "A squat armoured drum under a low turret: a three-barrelled repeater that tracks anything close and punches through it.",
        weapons: {
            "Plasmeric Repeater": "Three plasma slugs a burst, short-ranged, each one bursting white-hot against armour.",
        },
    ),
    "naga_t1_aa": (
        lore: "Twin raised barrels on a braced column, fed from a drum magazine, filling the sky with bursting plasma.",
        weapons: {
            "Plasmeric Flak Cannon": "Each shell bursts among aircraft into a spray of hot fragments that burns every one it reaches.",
        },
    ),
    "naga_t1_radar": (
        lore: "A braced mast whose sensor head swings one way, dwells, and looks back. ARC crews say it sees them first.",
        weapons: {},
    ),
    "naga_wall": (
        lore: "Armoured octagons set shoulder to shoulder, their plates lapped up into spikes. Slow to build, very hard to cut.",
        weapons: {},
    ),
}
