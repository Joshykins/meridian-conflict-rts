// In-world lore for the Naga's own units and the weapons they carry. One short sentence
// each; weapon names must match the unit file's `name:` exactly.
{
    "naga_commander": (
        lore: "A walking command machine that comes ashore alone and puts up a stronghold with the nanite emitter in its claw; ARC crews call it the Sovereign.",
        weapons: {
            "Plasmeric Repeater": "The cannon that is its right forearm fires slugs of plasma held tight by gravity; they hit like shells and glaze the ground they miss.",
        },
    ),
    "naga_t1_engineer": (
        lore: "A six-legged construction machine that builds with a nanite emitter on its boom, walking the seabed as easily as the shore.",
        weapons: {},
    ),
    "naga_t1_land_factory": (
        lore: "A walled pit of molten hide where war-beasts are grown, not built.",
        weapons: {},
    ),
    "naga_t1_air_factory": (
        lore: "Hollow spires where the Naga's fliers are hatched and let go.",
        weapons: {},
    ),
    "naga_t1_naval_factory": (
        lore: "A brood pit grown out into the water, its young slipping straight into the sea.",
        weapons: {},
    ),
    "naga_t1_extractor": (
        lore: "Roots driven into the ore that draw it up with no power at all; ARC engineers still argue about how.",
        weapons: {},
    ),
    "naga_t1_power": (
        lore: "A grown heart that beats power into the ground around it. It has nothing in it to breach.",
        weapons: {},
    ),
    "naga_storage": (
        lore: "A swollen sac that holds whatever the Naga feed it, mass and energy alike.",
        weapons: {},
    ),
    "naga_t1_point_defense": (
        lore: "A squat turret that tracks anything close and burns through it.",
        weapons: {
            "Plasmeric Repeater": "Three plasma slugs a burst, short-ranged, each one bursting white-hot against armour.",
        },
    ),
    "naga_t1_aa": (
        lore: "A flak turret that fills the sky with bursting plasma.",
        weapons: {
            "Plasmeric Flak Cannon": "Each shell bursts among aircraft into a spray of hot fragments that burns every one it reaches.",
        },
    ),
    "naga_t1_radar": (
        lore: "One great eye on a stalk. ARC crews say it looks back.",
        weapons: {},
    ),
    "naga_wall": (
        lore: "A hedge of hide and thorn that grows slowly and cuts badly.",
        weapons: {},
    ),
}
