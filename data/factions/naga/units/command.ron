[
    // The Naga commander: a top-heavy walker on reverse-kneed legs, broad armoured shoulders,
    // a narrow horned head with one red optic, a plasmeric cannon for its right forearm and
    // a clawed left hand that builds. Its torso turns to face what it shoots or builds (and
    // holds its fire while it builds); each forearm pitches about its elbow. Model:
    // `naga_commander` (`models::naga::commander`). It builds only Naga structures (mc-data
    // refuses anything else).
    //
    // Refits: only the engineering suites so far; the rest of its slots are still open.
    (
        key: "naga_commander",
        name: "Naga Sovereign",
        role: "Armored Command Unit",
        tech: 1,
        categories: ["Land", "Commander", "Engineer", "DirectFire"],
        health: 11000, regen: 10,
        cost: (mass: 18000, energy: 5000000, time: 6000000),
        radius: 10.4, height: 23,
        vision: 420, radar: 0,
        motion: (layer: Amphibious, size: 0, speed: 17, accel: 17, turn: 150),
        economy: (mass_income: 1, energy_income: 20, mass_storage: 1000, energy_storage: 5000),
        // `arm`: the claw. The torso turns to face the work, then the forearm pitches at it
        // about the elbow (`pivot`); the beam leaves the violet emitter in its palm.
        builder: (power: 10, range: 70, arm: (turn: 140, emitter: (4.7, 4.8, 13.9), pivot: (-0.5, 4.8, 13.9)), builds: [
            "naga_t1_land_factory", "naga_t1_air_factory", "naga_t1_naval_factory", "naga_t1_extractor", "naga_t1_power", "naga_storage", "naga_t1_point_defense", "naga_t1_aa", "naga_t1_radar", "naga_wall",
        ]),
        weapons: [(
            name: "Plasmeric Repeater",
            // The cannon forearm: short bursts of plasmeric slugs, a commander's steady fire.
            damage: 60, splash: 2, range: 250, reload: 0.3, speed: 760, trajectory: Direct, red: 1.0,
            turret_turn: 36, muzzle: (8.9, -4.8, 13.9), pivot: (-0.5, -4.8, 13.9), spread: 0.4, sweep: 30,
            targets: ["Land", "Naval"], color: Orange, flash: 1.4, impact: 1.3, tracer: 0.8,
            rounds: 3, plasma_grade: Some(Plasmeric),
            sounds: (fire: "naga_stinger", impact: "shell_light"),
        )],
        refits: [
            (
                key: "engineering", name: "Fabrication",
                modules: [
                    (
                        key: "eng_2", icon: Engineer, name: "Engineering Suite II", tech: 2,
                        summary: "More build power and reach: twin nanite emitters and feed canisters on the claw arm, heavier plating. The Naga have no tech 2 structures yet.",
                        cost: (mass: 720, energy: 7200, time: 900),
                        health: 3000, regen: 5, build_power: 20, build_range: 5,
                        // The emitters come to work (rock on the forearm) over this long.
                        unfold: 0.6,
                    ),
                    (
                        key: "eng_3", icon: Engineer, name: "Engineering Suite III", tech: 3, after: "eng_2",
                        summary: "Far more build power and reach: a fabrication lance out of the claw, a ring of emitters round the wrist, a feed drum over the elbow, heavy plating. The Naga have no tech 3 structures yet.",
                        cost: (mass: 2400, energy: 24000, time: 3000),
                        health: 7000, regen: 15, build_power: 60, build_range: 10,
                        // The lance runs out of the palm while it builds: the beam leaves its tip.
                        arm_emitter: (7.68, 4.8, 13.9),
                    ),
                ],
            ),
        ],
        wreck_fraction: 0.2,
        mesh: "naga_commander", icon: Commander,
        sounds: (death: "commander_death", moving: "walker_heavy", step: "naga_footfall"),
    ),
    // The Naga engineer: a low six-legged walking machine whose short articulated boom curls up
    // over its back and carries the fabricator barrel forward over the head, a violet nanite
    // emitter at its tip. Its boom reaches only across the nose (`aim_arc`) and bends round
    // at its top four joints (`turret_at` is that chain's single best-fit pivot, the model's
    // `AIM_PIVOT`); past that it turns its body to the work. It walks the seabed, so every
    // Naga factory makes it. Model: `naga_tender` (`models::naga::tender`).
    (
        key: "naga_t1_engineer",
        name: "Tender",
        role: "Engineer",
        tech: 1,
        categories: ["Land", "Engineer"],
        health: 170,
        cost: (mass: 55, energy: 280, time: 280),
        radius: 3.8, height: 3.8,
        vision: 180,
        motion: (layer: Amphibious, size: 0, speed: 26, accel: 30, turn: 170, aim_arc: 120),
        turret_at: (-1.9, 0.0),
        // `arm`: the fabricator barrel on the boom's head. The boom bends round to the work,
        // then the barrel pitches at it about its joint (`pivot`); the beam leaves its tip.
        builder: (power: 5, range: 55, arm: (turn: 200, emitter: (1.0, 0, 3.3), pivot: (-0.55, 0, 3.75)), builds: [
            "naga_t1_land_factory", "naga_t1_air_factory", "naga_t1_naval_factory", "naga_t1_extractor", "naga_t1_power", "naga_storage", "naga_t1_point_defense", "naga_t1_aa", "naga_t1_radar", "naga_wall",
        ]),
        mesh: "naga_tender", icon: Engineer,
        sounds: (moving: "naga_skitter"),
    ),
]
