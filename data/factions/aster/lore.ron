// In-world lore for every Aster unit and structure, plus every weapon they
// carry. One short sentence each. Weapon names must match the `name:` field
// in data/factions/aster/units/*.ron exactly; units with no weapons omit
// the `weapons` map.
{
    "aster_commander": (
        lore: "Reach Command's chassis, landed alone to raise a foothold from nothing.",
        weapons: {
            "Vulcan Machine Gun": "A rotary gun on the right forearm, kept through every refit.",
            "Breach Cannon": "A heavy shell gun bolted over the Vulcan when the fight comes close.",
            "Meridian Rail Cannon": "The breach cannon's mount rebuilt around a pair of rails.",
            "AA Flak Cannon": "A twin flak gun on the shoulder. Both barrels fire at once and the shells drift apart, timed to burst among aircraft.",
            "Shoulder Howitzer": "A short tube on the shoulder that lobs shells past the front.",
        },
    ),
    "aster_t1_engineer": (
        lore: "Corvus Foundries' basic construction crawler, nicknamed the shovel.",
    ),
    "aster_t2_engineer": (
        lore: "A longer boom and second reactor tap, built to follow the front line.",
    ),
    "aster_t3_engineer": (
        lore: "Tech-three tankage and a stabilized boom that keeps building under fire.",
    ),
    "aster_t1_scout": (
        lore: "Corvus Foundries' light scout, nicknamed the jackrabbit for its speed.",
        weapons: {
            "Light Carbine": "A light carbine meant to discourage pursuit, not win a fight.",
        },
    ),
    "aster_t1_bot": (
        lore: "Reach's basic infantry walker, built cheap and issued by the platoon.",
        weapons: {
            "Twin Autocannon": "A pair of light guns slung under the Lancer's spindly frame.",
        },
    ),
    "aster_t1_tank": (
        lore: "The Reach's workhorse light tank, nicknamed the brick by every crew.",
        weapons: {
            "Light Cannon": "A single reliable gun, the same mount the Sentinel turret carries.",
        },
    ),
    "aster_t1_artillery": (
        lore: "A Light Howitzer on the Warden's own hull, for mobile fire support.",
        weapons: {
            "Light Howitzer": "Built to displace and fire again before counter-battery answers.",
        },
    ),
    "aster_t1_land_reclaimer": (
        lore: "A salvage hovercraft with one reclaim head. It picks a battlefield clean as it skims across it, shore and shallows included.",
    ),
    "aster_t2_land_reclaimer": (
        lore: "A wheeled salvage carrier with three heads and point-defence lasers, built to work the front before the wrecks stop smoking.",
    ),
    "aster_t2_tank": (
        lore: "Reach's heavy tank, first proven breaking the Blackridge Line.",
        weapons: {
            "Twin Rail Cannon": "Paired rail guns firing from behind the tank's faceted tech-two plate.",
        },
    ),
    "aster_t2_hover": (
        lore: "A hover tank built to cross marsh country tracked armor bogs down in.",
        weapons: {
            "Heavy Machine Gun": "Twin barrels favoring speed of fire over the weight of any single hit.",
        },
    ),
    "aster_t2_missile": (
        lore: "A six-rack missile launcher built to break up armor at long range.",
        weapons: {
            "Tactical Missile Rack": "Fires a full ripple in under two seconds, then reloads slowly.",
        },
    ),
    "aster_t3_assault_bot": (
        lore: "Corvus Foundries' breakthrough walker, built on the Commander's own rig.",
        weapons: {
            "Bolt Rifle": "Twin shoulder-mounted bolt rifles, the Raptor's gun scaled up for a walker: each bolt bursts in lightning over the ground it hits.",
            "Shin Torpedo Tubes": "Sealed tubes on each shin, for the ships it meets walking the seabed.",
        },
    ),
    "aster_t3_artillery": (
        lore: "A siege mortar on treads, built to level a position before the assault. It stakes itself to the ground before it fires.",
        weapons: {
            "Arc Howitzer": "The Paladin's gun made a siege piece: a long charge, then one great round of plasma lobbed high that bursts in lightning where it lands. Outranges every other mobile gun in the Reach inventory.",
        },
    ),
    "aster_t3_sniper": (
        lore: "Corvus Foundries' answer to the Paladin: one long gun on a low hull that digs in to fire.",
        weapons: {
            "Argon Electric Bore": "An argon tracer round, then the whole charge struck down its ionised trail as lightning.",
        },
    ),
    "aster_t4_assault_tank": (
        lore: "Too big for any foundry floor, the Fulgur is raised in the field by the engineers who will follow it.",
        weapons: {
            "AEB-2 Electric Bore": "The bore scaled past good aim: it sears everything along the channel and leaves the ground molten.",
            "Bolt Rifle": "A bolt rifle on each flank sponson, aimed on its own, bursts lightning round whatever gets close.",
            "Rotary AA Gun": "A rotary gun on the engine deck, turned aft and raised to the sky to guard the tank's back.",
        },
    ),
    "aster_t5_titan": (
        lore: "Nothing on Meridia stops a Behemoth. It walks over what it cannot be bothered to walk round, and the ground remembers every step.",
        weapons: {
            "Tempest Rotary Cannon": "Six battleship barrels in a turning cluster, fired like a machine gun as each comes to the top; every spent casing is kicked clear and comes down like a girder.",
            "AEB-3 Cataclysm Bore": "An electrical warhead on an arm: the strike raises a lightning storm that spreads for seconds and leaves nothing standing in it.",
            "Hailstorm Rocket Pods": "Its third weapon: shoulder pods that ripple heavy unguided rockets up and over onto the mark, scattering wide and bursting big.",
            "Heavy Twin Flak": "A twin flak turret beside each pod. Enough for a few gunships; against a real air wing the Behemoth wants escorts.",
        },
    ),
    "aster_t2_sensor_ship": (
        lore: "A light hull built round one great search radar, so the Reach's picture of the field travels with its army. It carries no guns; its crews say the dome is the weapon.",
    ),
    "aster_t3_corvette": (
        lore: "A light warship for the upper air, little more than a hull, a drive and one long rail gun. The yards turn them out faster than frigates, and send them out in threes.",
        weapons: {
            "Long Rail Cannon": "The Resolute's turret gun drawn out to twice its length: it charges, then fires a slug no other tech 3 gun can match for reach.",
            "AA Rotary Cannon": "A six-barrel rotary gun astern, for the fighters that come for the ship. It needs a moment to spin up.",
        },
    ),
    "aster_t4_frigate": (
        lore: "The Reach's first heavy warship of the upper air: an armoured hull laid round a single gun, with its own search radar.",
        weapons: {
            "Spinal Rail Cannon": "Rails the length of the keel; the whole ship turns and dips its nose to lay it.",
            "Rail Cannon Turret": "A heavy rail in its own house, free to find its own marks.",
            "AA Rocket Cells": "Guided rockets rippled straight up and over onto aircraft.",
        },
    ),
    "aster_t4_dreadnought": (
        lore: "The Reach's capital ship, built to lie broadside over a front and pour fire down through the clouds. Where it hangs over a front, the front moves.",
        weapons: {
            "Arc Cannon Casemate": "The battleship's Arc Cannon, paired in an armoured sleeve in the flank, three to a side, firing charged shells down out of the clouds.",
            "Twin Bolt Rifle": "A pair of plasma bolt rifles in a low house, one forward and one aft on the spine, for what the casemates cannot bear on.",
            "Long Range SAM": "Hatched cells amidships, a salvo spread over every aircraft in reach.",
        },
    ),
    "aster_t4_anti_ship": (
        lore: "A rail cannon too heavy to move, built to bring warships down out of the clouds.",
        weapons: {
            "Zenith Rail Cannon": "One slug a salvo, fast enough to cross the sky before the thunder does.",
        },
    ),
    "aster_t1_mobile_aa": (
        lore: "A cheap tracked AA gun, fielded in pairs so one is always shooting.",
        weapons: {
            "Single Barrel AA Gun": "A single rapid barrel bolted onto a Warden-pattern tracked chassis.",
        },
    ),
    "aster_t2_mobile_aa": (
        lore: "Meridian Arms' answer to faster tech-two aircraft, mounted on treads.",
        weapons: {
            "Conventional Flak": "Slow shells timed to burst in an aircraft's path rather than chase the hull.",
        },
    ),
    "aster_t1_interceptor": (
        lore: "Reach's basic fighter, still called Shrike by pilots out of habit.",
        weapons: {
            "Twin Autocannon": "Built to clear scouts and bombers, not trade with heavier iron.",
        },
    ),
    "aster_t1_bomber": (
        lore: "A light bomber that has flown every Reach campaign since Twin Shoals.",
        weapons: {
            "Bomb Bay": "A pair of heavy bombs let go together, wide enough to take a work crew in one pass.",
        },
    ),
    "aster_t1_air_scout": (
        lore: "An unarmed radar airframe, built by Halcyon Aerospace for endurance.",
    ),
    "aster_t1_rotor_gunship": (
        lore: "A low-altitude helicopter built for support where fixed wings cannot loiter.",
        weapons: {
            "Light Machine Gun": "A chin-mounted gun for suppressing whatever the Wasp hovers over.",
            "Unguided Rockets": "A pair of rocket pods for targets the machine gun cannot crack.",
        },
    ),
    "aster_t3_support": (
        lore: "A radar, sonar and anti-missile airframe, built after the losses at Twin Shoals. A salvage ray under its nose strips the wrecks it flies over.",
    ),
    "aster_t2_reclaim_carrier": (
        lore: "A fan-lift carrier that fields its own Salvage Drones, called the flock. A tech 2 air factory's first answer to a field of wrecks.",
    ),
    "aster_t1_air_reclaimer": (
        lore: "A single fan, a single salvage ray. Crews fly them in pairs over the fields the trucks cannot reach, and lose them by the dozen.",
    ),
    "aster_reclaim_drone": (
        lore: "A small, disposable reclaimer that lives and dies with its parent Osprey.",
    ),
    "aster_t2_gunship": (
        lore: "A vector-thrust gunship built to hover over a target and grind it down.",
        weapons: {
            "Chin Autocannon": "A long-barrelled autocannon in a chin turret, for steady fire while the gunship holds position.",
            "Rocket Pods": "Two six-tube launchers that ripple a dozen rockets off in a second, for what the cannon cannot finish.",
        },
    ),
    "aster_t2_fire_bomber": (
        lore: "A four-engine flying fortress built to burn a position, not just crater it.",
        weapons: {
            "Incendiary Carpet": "Scatters two dozen incendiaries meant to set the ground alight.",
            "Dorsal AA": "A top-mounted gun keeping fighters off the fortress's exposed back.",
            "Port AA": "A side-mounted gun covering the fortress's flank on the approach.",
            "Tail AA": "A rear-facing gun watching the one approach no escort ever covers.",
        },
    ),
    "aster_t2_torpedo_bomber": (
        lore: "A sea-patrol drone that listens for hulls under the water and comes down to the wave tops to answer them.",
        weapons: {
            "Aerial Torpedoes": "Dropped in pairs from low over the water; they find their own way once they are in.",
        },
    ),
    "aster_t2_interceptor": (
        lore: "A fast interceptor built jointly to run down bombers before they arrive.",
        weapons: {
            "Interceptor Missiles": "Steer themselves the last stretch so the pilot can already be turning.",
        },
    ),
    "aster_t3_air_superiority": (
        lore: "Reach's air superiority fighter, crewed by veterans of the Shrike wings.",
        weapons: {
            "Bolt Rifle": "The electric bore cut down to fire bolts: each carries its own charge, and bursts into lightning round what it hits.",
        },
    ),
    "aster_t3_strategic_bomber": (
        lore: "A strategic bomber released sparingly, its mission known before the target.",
        weapons: {
            "AEB Bomb": "An electric bore's whole charge in one casing: it bursts into a ball of ionised air that lightning strikes out of, levelling almost whatever it lands on.",
        },
    ),
    "aster_t3_assault_aircraft": (
        lore: "A shielded assault aircraft built to strafe through flak and out the other side.",
        weapons: {
            "Avenger Rotary Cannon": "A forward rotary cannon firing incendiary shells: each strafing run leaves a line of burning ground.",
            "Talon Rockets": "A guided rocket under each wing, loosed one after the other just before the cannon opens up.",
        },
    ),
    "aster_t1_land_factory": (
        lore: "Reach's basic land factory, usually the first thing an enemy tries to level.",
    ),
    "aster_t2_land_factory": (
        lore: "The same hall widened for tech-two armor, a refit crews call raising the roof.",
    ),
    "aster_t3_land_factory": (
        lore: "The full tech-three hall, taller gantries on the same slab as the first Forge.",
    ),
    "aster_t1_air_factory": (
        lore: "Halcyon Aerospace's basic hangar, launching every light airframe in the roster.",
    ),
    "aster_t2_air_factory": (
        lore: "The same hangar with a rear equipment house for tech-two airframes.",
    ),
    "aster_t3_air_factory": (
        lore: "Taller assembly gantries over the Aerie's original apron and tower.",
    ),
    "aster_core_mine": (
        lore: "Sinks a bore shaft and sends seeker drills out under the ground for hundreds of metres, feeding on any ore seam they reach.",
    ),
    "aster_core_mine_t2": (
        lore: "A taller headframe and a second bank of seeker drills, working the same ground far harder.",
    ),
    "aster_core_mine_t3": (
        lore: "The full deep-core rig: a crown mast over the shaft, stripping every seam in reach down to the bedrock.",
    ),
    "aster_core_mine_t4": (
        lore: "Drives a second shaft far below the pit floor and hammers it deeper with every blow. It costs a fortune for what it adds, but what it adds does not depend on the ground around it.",
    ),
    "aster_t1_power": (
        lore: "A squat fusion drum built fast and cheap for a young economy.",
    ),
    "aster_t2_power": (
        lore: "A larger containment drum around a hotter, more demanding core.",
    ),
    "aster_t3_power": (
        lore: "The largest fusion plant in the Reach inventory, tall enough to see for miles.",
    ),
    "aster_t2_fabricator": (
        lore: "Pours a reactor's worth of current through a sealed chamber to condense usable matter. Wasteful by any measure, and a bomb if the containment fails.",
    ),
    "aster_t3_fabricator": (
        lore: "The same chamber refitted under heavier coils, drinking a whole Reactor III for a draw that would light a city. Built against its reactor, the two go up as one.",
    ),
    "aster_mass_storage": (
        lore: "A squat bunker buffering refined ore between the mines and the factory floor.",
    ),
    "aster_mass_storage_t2": (
        lore: "A deeper vault, dug down to hold what the mines and the salvage crews bring in.",
    ),
    "aster_mass_storage_t3": (
        lore: "A reinforced strategic reserve, big enough to bank a battlefield's worth of salvage.",
    ),
    "aster_energy_storage": (
        lore: "Banked cells storing reactor output for the moments a base needs a surge.",
    ),
    "aster_energy_storage_t2": (
        lore: "The bank built up in place, more cells racked onto the first to carry a heavier grid through a surge.",
    ),
    "aster_energy_storage_t3": (
        lore: "A strategic charge reserve: enough stored power to hold shields and factories up through a long stall.",
    ),
    "aster_t1_point_defense": (
        lore: "A basic static gun built around the same cannon the Warden tank carries.",
        weapons: {
            "Light Cannon": "A single reliable gun, cheaper to reuse than to design anew.",
        },
    ),
    "aster_t2_point_defense": (
        lore: "A heavy static gun holding lines the Sentinel alone could not.",
        weapons: {
            "Triple Cannon Battery": "Three barrels laying down the crossfire infantry call the wall.",
        },
    ),
    "aster_t3_point_defense": (
        lore: "A keep built round one rail cannon, for the fronts where Redoubts kept meeting walkers they could not stop.",
        weapons: {
            "Citadel Rail Cannon": "One slug every few seconds, each one enough to open a Paladin's shield and the frame behind it.",
        },
    ),
    "aster_t2_artillery": (
        lore: "A static howitzer built where mobility matters less than range and shell weight.",
        weapons: {
            "Heavy Howitzer": "A single devastating round that every gun crew treats as an event.",
        },
    ),
    "aster_t2_missile_defense": (
        lore: "Two of the fleet's interceptor lasers lifted off a cruiser's deck and set on a pole, for the bases that learned what a Javelin battery does to a factory.",
    ),
    "aster_t3_missile_defense": (
        lore: "Four lasers where there were two, and a reach to match: the answer to the artillery parks that learned to fire in batteries.",
    ),
    "aster_t1_reclaimer": (
        lore: "A salvage mast with one slow head. It charges its beam before each pull, and reaches further than any engineer can walk in a minute.",
    ),
    "aster_t2_reclaimer": (
        lore: "The Scavenger raised another storey, its head re-wound for a longer, harder pull.",
    ),
    "aster_t3_reclaimer": (
        lore: "A heavy reclaim tower whose beam strips a whole battlefield of what fell on it.",
    ),
    "aster_t1_attack_boat": (
        lore: "A harbour patrol hull with a gun ring on the bow, quick enough to pick its fights.",
        weapons: {
            "Heavy Machine Gun": "A rotary gun on the bow ring that shreds light hulls and anything on the shore.",
        },
    ),
    "aster_t1_frigate": (
        lore: "The Reach's first real warship: a faceted escort that outranges anything ashore.",
        weapons: {
            "Naval Gun": "A long rifle in the forward turret that reaches well inland.",
            "Twin AA Gun": "A twin mount on the aft deckhouse that keeps aircraft off the escort.",
        },
    ),
    "aster_t1_submarine": (
        lore: "A small attack boat that runs dived, where only sonar finds it.",
        weapons: {
            "Torpedo Tubes": "Four bow tubes of homing torpedoes, the only weapon that reaches a dived hull.",
        },
    ),
    "aster_t1_sonar": (
        lore: "A moored spar buoy whose hydrophones hear hulls no radar can see.",
    ),
    "aster_t1_torpedo_defense": (
        lore: "A moored float carrying a torpedo launcher. Its hydrophones hear hulls a little past a hunting boat's reach, and it puts torpedoes into them first, dived or not.",
        weapons: {
            "Torpedo Launcher": "A twin-tube launcher turning under the float, fired in pairs at hulls up to 600 m off, submarines included.",
        },
    ),
    "aster_t2_torpedo_defense": (
        lore: "The float refitted with a second launcher and heavier torpedoes that run further: a harbour mouth or a fleet anchorage no submarine gets into.",
    ),
    "aster_t3_torpedo_defense": (
        lore: "An installation built on the seabed, a spire standing from it up to the surface. Its batteries put heavy torpedoes into hulls across a whole bay and meet the torpedoes coming back. Nothing above the water can see it or touch it; only sonar hears it, and only torpedoes reach it.",
        weapons: {
            "Heavy Torpedo Launcher": "The batteries' tubes, firing heavy torpedoes at hulls a kilometre off, four to a salvo.",
            "Interceptor Battery": "Four batteries round the installation, each firing interceptors up and out at torpedoes a kilometre off.",
        },
    ),
    "aster_t4_submarine": (
        lore: "The largest hull the Reach ever sent under the water, built where it floats because no slip could hold it. It carries its own warheads, assembled aboard, and missiles that climb out of the sea and fall on bases half a map away. Up on the surface its rail turrets fight; under it, only sonar hears it and its shield holds.",
        weapons: {
            "Long-Range Torpedoes": "Six heavy bow tubes whose torpedoes run far.",
            "AEB Strike Missiles": "Four hatches aft of the sail. A volley climbs into the high air and falls on as many marks, each going off as an electric bore's blast.",
            "Interceptor Tubes": "Torpedoes aft that meet torpedoes coming in.",
            "Deck Rail Turret": "A rail turret fore and aft of the sail, working only with the boat surfaced.",
        },
    ),
    "aster_t1_salvage_boat": (
        lore: "A reclaim tower put to sea on two hulls. It draws what sank back up as it sails, out where no engineer can follow.",
    ),
    "aster_t2_destroyer": (
        lore: "The fleet's workhorse. It hears dived hulls, shoots down the torpedoes they fire with torpedoes of its own, and its bolt rifle lobs further inland than any shore battery.",
        weapons: {
            "Bolt Rifle": "The Paladin's bolt rifle a size smaller, in the forward house. It fires on a slight arc to clear a headland or a ridge ashore, and it cannot bear astern; the ship turns to bring it round.",
            "Torpedo Tubes": "Four bow tubes. The destroyer charges what it hears.",
            "Point Defence Gun": "A fast gun on the hangar roof that keeps aircraft off the ship.",
            "Interceptor Tubes": "Short torpedoes off the quarterdeck that run at torpedoes coming in and burst them.",
        },
    ),
    "aster_t2_aa_cruiser": (
        lore: "A wide, flat hull built round a radar. Its laser burns missiles out of the air and its sixteen cells put a whole ripple of missiles up to meet aircraft. Nothing on it touches a submarine.",
        weapons: {
            "Vertical Missile Array": "Sixteen cells forward of the bridge, fired as one ripple. The missiles leave straight up and curve onto their marks.",
            "Deck Gun": "One gun forward, for what comes close.",
        },
    ),
    "aster_t2_missile_ship": (
        lore: "A narrow hull that is all launch rack. Its cells hold racks of unguided rockets, rippled out by the dozen onto a stretch of shore or a knot of ships. Point defence takes them one at a time; there are too many to take them all. It has nothing else.",
        weapons: {
            "Dumbfire Rockets": "Thirty-two unguided rockets a salvo out of eight canted cells, lobbed high and falling over and round the mark.",
        },
    ),
    "aster_t2_submarine": (
        lore: "An angular hunter-killer with six tubes and ears that reach further than the Barracuda's. Surfaced, its deck gun raids buoys, wharfs and shorelines; dived, only sonar finds it.",
        weapons: {
            "Torpedo Tubes": "Six bow tubes in two banks, fired three at a time.",
            "Deck Gun": "A gun forward of the sail that only works with the boat on the surface.",
            "Interceptor Tubes": "Two stern tubes that meet torpedoes coming in, surfaced or dived.",
        },
    ),
    "aster_t2_shield_boat": (
        lore: "A hull built to carry a shield generator to sea. Shells and missiles break on its dome; torpedoes run under the skirt.",
    ),
    "aster_t3_rail_trimaran": (
        lore: "A Zenith that floats: the anti-ship rail laid down the keel of a long trimaran, so the sea can shoot back at the clouds. It carries nothing else, and dies to anything that reaches it on the water.",
        weapons: {
            "Zenith Rail Cannon": "The hull turns to aim and the barrel rises in its cradle; the breech swings down into a well in the deck.",
        },
    ),
    "aster_t3_battleship": (
        lore: "The anchor of the sea. Three triple turrets of Arc Cannons reach further than it can see, so it fights on what its escorts and scouts tell it. Alone it is a target: weak AA, no sonar, nothing against torpedoes.",
        weapons: {
            "Fore Battery": "Three Arc Cannons in the forward house: a long charge, then three rounds of plasma on a shallow arc that burst in lightning. A broadside heels the ship.",
            "Second Battery": "The superfiring house behind the first.",
            "Aft Battery": "The house astern. It cannot bear through the citadel.",
            "Light AA": "A twin mount over the aft citadel, and all the air defence it has.",
        },
    ),
    "aster_t3_carrier": (
        lore: "A flight deck at sea, refitted as the fleet's long arm against the air. Its radar sees further than any hull afloat, and its missiles reach aircraft long before they reach the ships it guards. It carries no gun at all: what gets in close, the escorts must meet.",
        weapons: {
            "Long Range SAM": "Twelve hatched cells in two blocks on the island's plinth, fore and aft.",
            "Interceptor Tubes": "Torpedoes under the stern that meet torpedoes coming in.",
        },
    ),
    "aster_t3_submarine": (
        lore: "The Reach's deterrent. It launches from under the water: a boil on the surface, then cruise missiles that run in low over sea and shore, so only close-in guns get a shot, and late. Every launch paints the boat for everyone listening.",
        weapons: {
            "Heavy Torpedo Tubes": "Eight bow tubes, fired four at a time.",
            "Cruise Missiles": "Four hatches behind the sail. Each missile boosts clear of the water, unfolds its wings and skims in under 25 m; one whose mark dies finds another.",
        },
    ),
    "aster_t2_sonar": (
        lore: "The same buoy with a longer array streamed deeper, doubling what it hears.",
    ),
    "aster_t3_sonar": (
        lore: "An active array that pings the sea itself, heard across half an ocean.",
    ),
    "aster_t1_radar": (
        lore: "Reach's basic radar mast, raised before a base's first factory finishes.",
    ),
    "aster_t2_radar": (
        lore: "The same lattice mast built taller, doubling the tech-one tower's reach.",
    ),
    "aster_t3_radar": (
        lore: "The mast at full height, seeing clear across a battlefield the size of Twin Shoals.",
    ),
    "aster_t2_shield": (
        lore: "A shield tower raised after Twin Shoals proved a base needs one to survive.",
    ),
    "aster_t3_shield": (
        lore: "The same tower refitted with a far larger reactor and a wider dome.",
    ),
    "aster_t2_warp_damper": (
        lore: "A field mast that knots space for a mile and more around it. A ship that drops out of warp inside it comes out slow, torn and blind, and the guns below are waiting.",
    ),
    "aster_wall": (
        lore: "A plain wall section that joins its neighbours into one rampart, cheap enough to raise faster than guns can knock it down.",
    ),
    "aster_t1_aa": (
        lore: "The static counterpart to the Gnat, trusting volume of fire over accuracy.",
        weapons: {
            "Rotary AA Gun": "The commander's rotary gun, turned skyward to answer the first strafing runs of a war.",

        },
    ),
    "aster_t2_aa": (
        lore: "A dug-in heavy flak gun, the Squall's big sister, laid by radar and a rangefinder.",
        weapons: {
            "Heavy Twin Flak": "Two long barrels fired together; the shells drift apart and burst side by side across a flight.",
        },
    ),
    "aster_t3_sam": (
        lore: "A slow, long-range SAM battery paired with a Watchtower for the eyes it lacks.",
        weapons: {
            "Long Range SAM": "One missile carrying enough warhead to bring down almost anything.",
        },
    ),
    "aster_t4_nuke_silo": (
        lore: "The weapon Asteria swore it would never field on its own soil, built anyway once the districts started falling.",
    ),
    "aster_t4_artillery": (
        lore: "Built from the plans of a gun the old navies laid down and never finished. Nobody aims it at a unit; it is aimed at a map.",
        weapons: {
            "Culverin Long Gun": "A shell every few seconds from the far side of the war, somewhere near what it was meant for.",
        },
    ),
    "aster_t3_nuke_defense": (
        lore: "A tracking mast and four cells that buy a city one more morning, one warhead at a time.",
    ),
}
