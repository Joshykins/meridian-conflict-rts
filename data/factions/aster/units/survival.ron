// Survival mode's hostile machinery. Faction-neutral in intent (the engine
// replicates units of every faction); it lives with Aster until there is a
// neutral data set. No builder lists these, so nobody can build them.
[
    (
        key: "replication_engine",
        name: "The Progenitor",
        role: "Precursor Foundry",
        tech: 5,
        categories: ["Structure", "Land", "Naval", "Defense", "DirectFire", "Replicator"],
        // Invulnerable in play (the sim flags it and its veil absorbs
        // everything); the figure is what the details card shows.
        health: 2000000,
        cost: (materials: 1000000, energy: 1000000, time: 100000),
        radius: 110, height: 150, footprint: (20, 20),
        vision: 900, radar: 3000,
        water_build: true,
        // Its own veil draws on this; the engine's side never runs dry.
        economy: (energy_income: 100000, energy_upkeep: 5000, materials_storage: 100000, energy_storage: 1000000),
        shield: (radius: 170, health: 1000000, regen: 100000),
        weapons: [(
            name: "Suppression Lance",
            damage: 2400, range: 1100, reload: 3.5, salvo: 2, salvo_delay: 0.3, speed: 1600, trajectory: Direct,
            turret_turn: 45, muzzle: (40, 0, 118),
            targets: ["Land", "Naval"], color: Blue,
            sounds: (fire: "survival_lance"),
        )],
        mesh: "replication_engine", icon: Factory,
        lights: [],
        sounds: (death: "blast_large"),
    ),
    (
        key: "replication_node",
        name: "Progenitor Shaper",
        role: "Precursor Shaper",
        tech: 3,
        categories: ["Structure", "Land", "Naval", "Replicator"],
        health: 16000,
        cost: (materials: 4000, energy: 40000, time: 2000),
        radius: 26, height: 46, footprint: (5, 5),
        vision: 500,
        water_build: true,
        // Its defences, at level 1; `growth` says what each level adds.
        economy: (energy_upkeep: 50),
        shield: (radius: 180, health: 6000, regen: 60),
        lance: (charge: 3, reload: 6, damage: 1500, splash: 14, range: 800, targets: ["Land", "Naval", "Air"]),
        // Its anti-nuke: interceptors assembled one at a time, like an array's.
        strategic: (
            kind: Interceptor,
            missile: (materials: 1500, energy: 30000, time: 60000),
            power: 600,
            stock: 1,
            speed: 900,
            coverage: 1600,
        ),
        growth: (
            health: (percent: 15),
            shield_radius: (per_level: 22, most: 900),
            shield_health: (percent: 18),
            shield_regen: (percent: 18),
            lance_damage: (percent: 20),
            lance_splash: (per_level: 3, most: 120),
            lance_range: (per_level: 35, most: 2200),
            lance_charge: (per_level: 0.15, most: 8),
            lance_reload: (percent: -4, least: 1.5),
            interceptor_stock: (per_level: 0.34),
            interceptor_coverage: (per_level: 80, most: 4000),
            interceptor_round: (percent: -6, least: 6000),
        ),
        mesh: "replication_node", icon: Factory,
        lights: [],
        sounds: (death: "blast_large"),
    ),
    // A Shaper's base (mc-sim survival/base.rs): raised round it as it grows, unravelled
    // when it dies. Units print on a platform's deck: only a pier at its middle blocks.
    // The meshes are placeholders until the base has its own models.
    (
        key: "progenitor_platform",
        name: "Print Platform",
        role: "Precursor Platform",
        tech: 3,
        categories: ["Structure", "Land", "Replicator"],
        health: 6000,
        cost: (materials: 300, energy: 3000, time: 150),
        radius: 48, height: 3, footprint: (8, 8),
        hull: (4, 4),
        vision: 200,
        mesh: "precursor_floor", icon: Factory,
        lights: [],
        sounds: (death: "blast_large"),
    ),
    (
        key: "progenitor_platform_great",
        name: "Great Print Platform",
        role: "Precursor Platform",
        tech: 3,
        categories: ["Structure", "Land", "Replicator"],
        health: 15000,
        cost: (materials: 800, energy: 8000, time: 400),
        radius: 96, height: 4, footprint: (16, 16),
        hull: (6, 6),
        vision: 200,
        mesh: "precursor_floor", icon: Factory,
        lights: [],
        sounds: (death: "blast_large"),
    ),
    (
        key: "progenitor_slip",
        name: "Print Slip",
        role: "Precursor Slip",
        tech: 3,
        categories: ["Structure", "Naval", "Replicator"],
        health: 6000,
        cost: (materials: 300, energy: 3000, time: 150),
        radius: 48, height: 3, footprint: (8, 8),
        hull: (4, 4),
        water_build: true,
        vision: 200,
        mesh: "precursor_floor", icon: Factory,
        lights: [],
        sounds: (death: "blast_large"),
    ),
    (
        key: "progenitor_slip_great",
        name: "Great Print Slip",
        role: "Precursor Slip",
        tech: 3,
        categories: ["Structure", "Naval", "Replicator"],
        health: 15000,
        cost: (materials: 800, energy: 8000, time: 400),
        radius: 96, height: 4, footprint: (16, 16),
        hull: (6, 6),
        water_build: true,
        vision: 200,
        mesh: "precursor_floor", icon: Factory,
        lights: [],
