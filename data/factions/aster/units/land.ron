            name: "Arc Howitzer",
            damage: 4467, splash: 48, range_min: 150, range: 1800, reload: 10.0, speed: 240, trajectory: Ballistic, loft: 6,
            turret_turn: 45, muzzle: (6.666, 0, 8.599), pivot: (-0.675, 0, 5.175), spread: 4.6,
