        radius: 13.6, height: 24,
        vision: 800,
        shield: (kind: Hull, health: 2800, regen: 28),
        economy: (energy_upkeep: 60),
        // Amphibious: it walks the seabed. Wading, its projectors stay above the water and
        // fire on anything ashore or afloat; once the sea closes over them they fall silent,
        // and the shin tubes (only under water) hunt ships from below (docs/STYLE.md "The navy").
        motion: (layer: Amphibious, size: 2, speed: 29, accel: 26, turn: 130),
        weapons: [
            // Twin bolt rifles, one on each shoulder, the Raptor's gun: a fast blue bolt
            // that bursts in lightning round what it hits (`discharge`).
            (
                name: "Bolt Rifle",
                damage: 338, splash: 5, range: 780, reload: 1.4, speed: 400, trajectory: Direct,
                turret_turn: 150, muzzle: (10.0, -7.2, 18.0), pivot: (-0.8, 0, 18.4),
                targets: ["Land", "Naval"], color: Blue, flash: 0.6, impact: 1.8, shockwave: 0.6,
                tracer: 0.35, plasma: 0.8, trail: true, wake: 0.35, bolts: 6, discharge: 16, arc_charge: 8.2,
