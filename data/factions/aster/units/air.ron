(
 // Bastion: a 300 m capital spacecraft that keeps station in the cloud deck.
 // Engineers raise it on a lot of its own. Told to set down, it glides in and settles on
 // its legs, lowers the ramp beneath its belly, and land units line up behind the stern and
 // walk up the ramp's centre line into the hold, and back down it (`mc_sim::transport`).
 // Four rotary cannon turrets, one to each side: nose, port and starboard sponsons, and
 // stern. Each rests facing its own way (`facing`) and covers a cone (`arc`) round it, so
 // the ship has a gun on anything that comes at it, two on most. Pivots are
 // `bastion::TURRETS` in the model; muzzles are 12 m along the barrel as the house faces the
 // nose. They shoot aircraft at any height, but reach the ground only along the line of
 // sight (`slant`): from the clouds they cannot, and they start to sweep the landing site
 // as it comes down.
 key: "aster_t3_lift_ship", name: "Bastion", role: "Assault Transport", title: "Heavy Transport", tech: 3, categories: ["Air", "Space"],
 health: 16000, cost: (mass: 4200, energy: 63000, time: 25200),
 radius: 160, height: 95, footprint: (28, 13), hull: (166, 76), vision: 520,
 motion: (layer: Air, size: 0, speed: 78, accel: 14, turn: 16, altitude: 560, hover: true, deploy: 2.2),
 transport: (capacity: 96, descent: 80, hold: (20, 0), ramp: (-16, -84), width: 40, floor: 34, clearance: 34, unload: 0.4),
 warp: (per_km: 8000, spool: 4, cooldown: 60, speed: 3500),
 hull_mounts: true,
 weapons: [
  // Nose: a long-reach chin turret, slower to traverse, 160 degrees across the bow.
  (name: "Rotary Cannon", damage: 12, range: 300, reload: 0.12, speed: 900, trajectory: Direct,
   turret_turn: 120, arc: 160, mount: true, slant: true, pivot: (160, 0, 38), muzzle: (172, 0, 38), spread: 1.5,
   targets: ["Air", "Land", "Naval", "Structure"], color: Orange, flash: 1.0, impact: 1.0, tracer: 0.7,
   rounds: 6, casings: 3, spin_up: 0.4, sounds: (fire: "aster_minigun", impact: "shell_light")),
  // Port sponson: quick to traverse, 170 degrees off the left flank.
  (name: "Rotary Cannon", damage: 12, range: 280, reload: 0.12, speed: 900, trajectory: Direct,
   turret_turn: 180, arc: 170, facing: 90, mount: true, slant: true, pivot: (-40, 62, 50), muzzle: (-28, 62, 50), spread: 1.5,
   targets: ["Air", "Land", "Naval", "Structure"], color: Orange, flash: 1.0, impact: 1.0, tracer: 0.7,
   rounds: 6, casings: 3, sounds: (fire: "aster_minigun", impact: "shell_light")),
  // Starboard sponson: the same off the right flank.
  (name: "Rotary Cannon", damage: 12, range: 280, reload: 0.12, speed: 900, trajectory: Direct,
   turret_turn: 180, arc: 170, facing: -90, mount: true, slant: true, pivot: (-40, -62, 50), muzzle: (-28, -62, 50), spread: 1.5,
   targets: ["Air", "Land", "Naval", "Structure"], color: Orange, flash: 1.0, impact: 1.0, tracer: 0.7,
   rounds: 6, casings: 3, sounds: (fire: "aster_minigun", impact: "shell_light")),
  // Stern: high on the tail, 160 degrees across the wake; covers the ramp as units walk on.
  (name: "Rotary Cannon", damage: 12, range: 300, reload: 0.12, speed: 900, trajectory: Direct,
   turret_turn: 120, arc: 160, facing: 180, mount: true, slant: true, pivot: (-156, 0, 70), muzzle: (-144, 0, 70), spread: 1.5,
   targets: ["Air", "Land", "Naval", "Structure"], color: Orange, flash: 1.0, impact: 1.0, tracer: 0.7,
   rounds: 6, casings: 3, sounds: (fire: "aster_minigun", impact: "shell_light")),
 ],
 mesh: "lift_ship", icon: Transport,
 sounds: (death: "blast_large", moving: "aster_lift_ship"),
),
]
