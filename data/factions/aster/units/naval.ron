                turret_turn: 60, arc: 270, muzzle: (13.4, 0, 4.1), pivot: (8.8, 0, 4.1), spread: 0.8,
                targets: ["Land", "Naval"], color: Orange, flash: 2.4, impact: 1.6, shockwave: 0.4,
                sounds: (fire: "cannon_heavy", impact: "shell_on_armour", ground: "shell_heavy"),
            ),
            // A twin flak mount on the deckhouse aft, turning on its own. It reaches
            // further than the deck gun, so the escort covers the ships around it.
            (
                name: "Twin AA Gun",
                damage: 11, range: 520, reload: 0.3, speed: 900, trajectory: Direct,
                turret_turn: 200, muzzle: (-4.2, 0, 8.1), pivot: (-6.4, 0, 8.1), mount: true,
