// Aster naval units. Hulls ride the water (`layer: Naval`: deep water only);
// a naval hull's origin is its waterline, `height` is what stands above it,
// and the keel is drawn below. Warships are bigger than land units, slower,
// tougher and longer-ranged.
[
    (
        key: "aster_t1_attack_boat",
        name: "Skiff",
        role: "Attack Boat",
        tech: 1,
        categories: ["Naval", "DirectFire"],
        health: 380,
        cost: (mass: 60, energy: 330, time: 230),
        radius: 6, height: 4,
        vision: 350,
        motion: (layer: Naval, size: 0, speed: 48, accel: 30, turn: 120),
        // A three-barrel rotary gun on a ring at the bow. It spins up briefly before the
        // stream starts; the casings leave its port just behind the barrels.
        weapons: [(
            name: "Heavy Machine Gun",
            damage: 11, range: 330, reload: 0.4, speed: 620, trajectory: Direct,
            turret_turn: 220, muzzle: (4.6, 0, 3.1), pivot: (3.3, 0, 3.1), spread: 2.0,
            targets: ["Land", "Naval"], color: Orange, rounds: 8, tracer: 0.6, casings: 1.5, spin_up: 0.2,
            sounds: (fire: "aster_minigun", impact: "shell_light"),
        )],
        mesh: "attack_boat", icon: Ship,
        sounds: (death: "blast_small", moving: "boat_engine"),
    ),
    (
        key: "aster_t1_frigate",
        name: "Pike",
