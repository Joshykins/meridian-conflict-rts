    (
        // Two missile-defence laser heads on a yoke, a tracking radar turning between
        // them. Each head burns a missile of its own, 10 hp of casing a tick (a Javelin
        // rocket takes 0.8 s). Draws power: unpaid, the lasers go dark.
        key: "aster_t2_missile_defense",
        name: "Corona",
        role: "Tactical Missile Defence",
        tech: 2,
        categories: ["Land", "Defense"],
        health: 1800,
        cost: (mass: 360, energy: 3600, time: 900),
        radius: 5.25, height: 12, footprint: (1, 1),
