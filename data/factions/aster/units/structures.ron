        health: 4500,
        cost: (mass: 360, energy: 2900, time: 560),
        radius: 34, height: 9, footprint: (6, 6), hull: (24, 24),
        vision: 300,
        // A buried hangar. Aircraft come down through the hatch in the middle, as many
        // at once as fit the shaft, mend below, and are fired back out of launch tunnels
        // at the corners (their mouths match `models/aster/airbase.rs`), running `run`
        // metres inside first. `reach` is the ground it looks after: idle aircraft inside
        // it land here first, and its guard area, the whole reach unless changed, fits
        // inside it. Upgrades keep the same building and what it holds.
        airbase: (
            capacity: 6, reach: 1200, heal: 0.03, hatch: 1.6, launch: 1.6, launch_speed: 55, run: 12,
            tunnels: [(29.7, 29.7, 2.0, 45), (-29.7, -29.7, 2.0, 225)],
        ),
        upgrades_to: "aster_t2_airbase",
        mesh: "airbase", icon: Airbase,
        sounds: (death: "blast_large"),
    ),
