    // Core mines. They stand on land or, raised on stilts, on open water.
    // Every hectare of land in `reach` is worth `ground` materials a
    // second, and every hectare of ore `per_hectare`, and the shaft itself `base`
    // from the moment the mine is finished. Where mines' reaches overlap, the
    // ground is divided by a straight line through the two points where the
    // circles cross. Every tier reaches as far; the tiers are the investment,
    // and each is a poorer one than the last: 2.5x then 2x the yield of the
    // tier below for ever dearer upgrades, so a new mine beats an upgrade.
    // The hammer runs on energy: a side that cannot pay its upkeep gets a
    // quarter of its mines' output at worst (mc-sim mines.rs `UNPOWERED`).
    (
        key: "aster_core_mine",
        name: "Core Mine",
        role: "Materials Mine",
        tech: 1,
        categories: ["Land", "Economy", "Extractor"],
        health: 1500,
        cost: (mass: 160, energy: 960, time: 160),
        radius: 12.8, height: 12.6, footprint: (3, 3),
        vision: 300, water_build: true,
        economy: (mass_storage: 250, energy_upkeep: 10),
        mine: (
            reach: 1000,
            ground: 0.010, per_hectare: 0.9, base: 1.1,
        ),
        upgrades_to: "aster_core_mine_t2",
        mesh: "core_mine", icon: Extractor,
        sounds: (step: "mine_blow"),
    ),
    (
        key: "aster_core_mine_t2",
