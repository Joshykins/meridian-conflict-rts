    // Core mines. They stand on land only. Ore is what they are for: every
    // hectare of ore in `reach` is worth `per_hectare` materials a second, bare
    // land only `ground` (a whole circle of it about a tenth of a mine on a
    // field), and the shaft itself `base` from the moment the mine is finished.
    // Where mines' reaches overlap, the ground is divided by a straight line
    // through the two points where the circles cross. Every tier reaches as far
    // and yields 3x, 7x, 12x a tier 1 (about 2 / 6 / 14 / 23 a second on a
    // duel map's field); a new mine pays back in under a minute, the upgrades in
    // about 3, 7 and 11 minutes. A mine climbs one tier past its side's tech
    // (`Blueprints::upgrade_needs`), so the economy grows before the army tiers.
    // The hammer runs on energy: a side that cannot pay its upkeep gets a
    // quarter of its mines' output at worst (mc-sim mines.rs `UNPOWERED`).
    (
        key: "aster_core_mine",
        name: "Core Mine",
        role: "Materials Mine", title: "Materials Mine",
        tech: 1,
        categories: ["Land", "Economy", "Extractor"],
        health: 600,
        cost: (mass: 45, energy: 270, time: 72),
        radius: 12.8, height: 12.6, footprint: (3, 3),
        vision: 300,
        economy: (mass_storage: 100, energy_upkeep: 2),
        mine: (
            reach: 1000,
            ground: 0.00036, per_hectare: 0.6, base: 0.2,
        ),
        upgrades_to: "aster_core_mine_t2",
        mesh: "core_mine", icon: Extractor,
        sounds: (step: "mine_blow"),
    ),
    (
        key: "aster_core_mine_t2",
        name: "Core Mine II",
        role: "Materials Mine", title: "Materials Mine",
        tech: 2,
        categories: ["Land", "Economy", "Extractor"],
        health: 2000,
        cost: (mass: 750, energy: 4500, time: 1100),
        radius: 12.8, height: 20.8, footprint: (3, 3),
        vision: 360,
        economy: (mass_storage: 200, energy_upkeep: 8),
        mine: (
            reach: 1000,
            ground: 0.00108, per_hectare: 1.8, base: 0.6,
        ),
        upgrades_to: "aster_core_mine_t3",
        mesh: "core_mine", icon: Extractor,
        sounds: (step: "mine_blow"),
    ),
    (
        key: "aster_core_mine_t3",
