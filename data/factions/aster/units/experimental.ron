// Aster experimentals (tech 4): too big for any factory. Combat engineers raise them on a
// lot of their own, as they would a structure (`footprint` on a mobile unit), and the
// finished machine drives off it.
[
    (
        // A super-heavy assault tank built round the AEB-2, the electric bore scaled up
        // until it no longer aims well: the bolt strays, and the charge sears everything
        // along its channel on the way down, leaving the ground molten behind it. A bolt
        // rifle on each sponson for what gets close, a rotary AA gun on the engine deck
        // that rests facing aft, and a hull field over all of it.
        key: "aster_t4_assault_tank",
        name: "Fulgur",
        role: "Super-Heavy Assault Tank",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 60000,
        cost: (materials: 22000, energy: 220000, time: 129000),
        radius: 31.35, height: 24.75,
        footprint: (6, 6),
        vision: 1200,
        shield: (kind: Hull, health: 18000, regen: 120),
        economy: (energy_upkeep: 300),
        hull_mounts: true,
        motion: (layer: Land, size: 5, speed: 16, accel: 8, turn: 30),
        weapons: [
            (
                name: "AEB-2 Electric Bore",
                damage: 6000, splash: 22, range: 1500, reload: 9.0, hitscan: true, trajectory: Direct,
                turret_turn: 24, muzzle: (37.95, 0, 18.48), pivot: (0.825, 0, 18.48), spread: 1.2,
                targets: ["Land", "Naval", "Structure"], color: Blue, flash: 0.24, impact: 1.6, shockwave: 4.5,
                trail: false, wake: 0, bolts: 0,
                bore: (width: 7, damage: 2000, cool: 45, blast: 45, blast_time: 6),
                sounds: (fire: "aster_bore_heavy", charge: "aster_bore_heavy_charge", charge_time: 2.2, impact: "aster_bore_heavy_strike", ground: "aster_bore_heavy_strike"),
            ),
            (
                // The Paladin's bolt rifle, bigger: a blue plasma bolt that bursts in
                // lightning round what it hits (`discharge`).
                name: "Bolt Rifle",
                damage: 480, splash: 6, range: 780, reload: 2.4, speed: 400, trajectory: Direct,
                turret_turn: 90, muzzle: (28.875, 17.325, 14.025), pivot: (14.85, 17.325, 11.88), mount: true,
                targets: ["Land", "Naval"], color: Blue, flash: 0.7, impact: 1.9, shockwave: 0.7,
                tracer: 0.35, plasma: 0.9, trail: true, wake: 0.35, bolts: 6, discharge: 18,
                sounds: (fire: "aster_bolt_rifle_heavy", impact: "aster_bolt_rifle_heavy_strike", ground: "aster_bolt_rifle_heavy_strike"),
            ),
            (
                // The Paladin's bolt rifle, bigger: a blue plasma bolt that bursts in
                // lightning round what it hits (`discharge`).
                name: "Bolt Rifle",
                damage: 480, splash: 6, range: 780, reload: 2.4, speed: 400, trajectory: Direct,
                turret_turn: 90, muzzle: (28.875, -17.325, 14.025), pivot: (14.85, -17.325, 11.88), mount: true,
                targets: ["Land", "Naval"], color: Blue, flash: 0.7, impact: 1.9, shockwave: 0.7,
                tracer: 0.35, plasma: 0.9, trail: true, wake: 0.35, bolts: 6, discharge: 18,
                sounds: (fire: "aster_bolt_rifle_heavy", impact: "aster_bolt_rifle_heavy_strike", ground: "aster_bolt_rifle_heavy_strike"),
            ),
            (
                // The Sparrow's rotary gun, in a house of its own on the engine deck.
                // It rests facing aft (`facing`) and raised to the sky, guarding the tank's
                // back; its muzzle is given as it faces the nose, level. It spins up on a
                // target, then each 0.2 s shot is seen and heard as eight rounds. The
                // Sparrow's numbers with a little more reach (the user's call).
                name: "Rotary AA Gun",
                damage: 16, range: 480, reload: 0.2, speed: 800, trajectory: Direct,
                turret_turn: 240, facing: 180, muzzle: (-15.7575, 0, 11.7975), pivot: (-23.925, 0, 11.7975), mount: true,
                targets: ["Air"], color: Orange, spin_up: 0.4, rounds: 8, tracer: 0.7, casings: 4.5,
                sounds: (fire: "aster_minigun", impact: "shell_light"),
            ),
        ],
        mesh: "assault_tank", icon: Tank,
        sounds: (death: "blast_colossal", moving: "tracks_colossal"),
    ),
    (
        // A hunched assault walker on reverse knees, built to close in where the Fulgur
        // stands off: a gatling-breach cannon for each forearm, each laying on a mark of its
        // own a little off where the torso points, and two thermobaric rocket launchers in
        // the hump on its back that set the ground in front of it alight. A hull field over
        // its plates; nothing for the air.
        key: "aster_t4_breacher",
        name: "Breacher",
        role: "Assault Walker",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 72000,
        cost: (materials: 26000, energy: 260000, time: 150000),
        radius: 30, height: 67.5,
        footprint: (8, 8),
        vision: 1250,
        shield: (kind: Hull, health: 16000, regen: 110),
        economy: (energy_upkeep: 300),
        motion: (layer: Land, size: 5, speed: 19, accel: 9, turn: 40),
        weapons: [
            (
                // The hump's launchers: sixteen cells each, raked steeply over the head, the
                // whole load rippled out in under two seconds and scattered wide over the
                // ground ahead. Each rocket bursts as a fuel-air charge and leaves the ground
                // burning where it fell. Listed first: the launchers ride the torso, so the
                // torso's aim is theirs, and the arms after them each swing off it on their
                // own (`sway`). The launchers are fixed in the hump (`fixed_rack`): the
                // rockets leave the cells as they stand, along the cells (`rake`, the model's
                // `breacher::POD` rake of 0.95 rad).
                name: "Thermobaric Rocket Pods",
                damage: 240, splash: 36, range_min: 190, range: 1125, reload: 18.0, salvo: 32, salvo_delay: 0.05, speed: 300, trajectory: Ballistic, rake: 54.43, fixed_rack: true, loft: 2,
                turret_turn: 40, pivot: (0, 0, 50), muzzle: (-8.75, 6.5, 62.5),
                // The model's `pods::mouths`, the left launcher's then the right's in turn.
                muzzles: [(-6.3125, 3.5, 60.75), (-6.3125, -3.5, 60.75), (-6.3125, 5.5, 60.75), (-6.3125, -5.5, 60.75), (-6.3125, 7.5, 60.75), (-6.3125, -7.5, 60.75), (-6.3125, 9.5, 60.75), (-6.3125, -9.5, 60.75),
                          (-7.9375, 3.5, 61.9125), (-7.9375, -3.5, 61.9125), (-7.9375, 5.5, 61.9125), (-7.9375, -5.5, 61.9125), (-7.9375, 7.5, 61.9125), (-7.9375, -7.5, 61.9125), (-7.9375, 9.5, 61.9125), (-7.9375, -9.5, 61.9125),
                          (-9.5625, 3.5, 63.0875), (-9.5625, -3.5, 63.0875), (-9.5625, 5.5, 63.0875), (-9.5625, -5.5, 63.0875), (-9.5625, 7.5, 63.0875), (-9.5625, -7.5, 63.0875), (-9.5625, 9.5, 63.0875), (-9.5625, -9.5, 63.0875),
                          (-11.1875, 3.5, 64.25), (-11.1875, -3.5, 64.25), (-11.1875, 5.5, 64.25), (-11.1875, -5.5, 64.25), (-11.1875, 7.5, 64.25), (-11.1875, -7.5, 64.25), (-11.1875, 9.5, 64.25), (-11.1875, -9.5, 64.25)],
                targets: ["Land", "Naval", "Structure"], color: Orange, missile: true,
                intercept: 60, spread: 11, trail: true, tracer: 1.2, flash: 0.8, impact: 3.5, shockwave: 2.0,
                caliber: 0.7,
                burn: 16, burn_dps: 40,
                sounds: (fire: "breacher_rockets", impact: "fire_bomb"),
            ),
            (
                // Right forearm. Six barrels turn in the cluster, the Tempest cut down to an arm:
                // it opens fire a third of the way into its spin-up and comes up to a heavy
                // stream of shells (`spin_ramp`), each shot seen and heard as three (`rounds`,
                // `each_round`).
                name: "Gatling-Breach Cannon",
                damage: 300, splash: 10, range: 750, reload: 0.3, speed: 900, trajectory: Direct,
                turret_turn: 50, pivot: (0, 0, 50), muzzle: (44.375, -21.875, 32.4375), spread: 1.5, spin_up: 1.2, spin_ramp: 3.0,
                barrels: 6, laps: 3, sway: 40, rounds: 3, casings: 27.5,
                targets: ["Land", "Naval", "Structure"], color: Orange,
                flash: 1.6, impact: 1.8, shockwave: 0.8, tracer: 0.8,
                sounds: (fire: "breacher_gatling_fire", each_round: true, spin: "breacher_gatling_spin", whir: "breacher_gatling_whir", spindown: "breacher_gatling_spindown", impact: "shell_heavy", ground: "shell_heavy"),
            ),
            (
                // Left forearm, the right's mirror.
                name: "Gatling-Breach Cannon",
                damage: 300, splash: 10, range: 750, reload: 0.3, speed: 900, trajectory: Direct,
                turret_turn: 50, pivot: (0, 0, 50), muzzle: (44.375, 21.875, 32.4375), spread: 1.5, spin_up: 1.2, spin_ramp: 3.0,
                barrels: 6, laps: 3, sway: 40, rounds: 3, casings: 27.5,
                targets: ["Land", "Naval", "Structure"], color: Orange,
                flash: 1.6, impact: 1.8, shockwave: 0.8, tracer: 0.8,
                sounds: (fire: "breacher_gatling_fire", each_round: true, spin: "breacher_gatling_spin", whir: "breacher_gatling_whir", spindown: "breacher_gatling_spindown", impact: "shell_heavy", ground: "shell_heavy"),
            ),
        ],
        mesh: "breacher", icon: AssaultWalker,
        sounds: (death: "blast_colossal", moving: "breacher_walk", step: "breacher_step"),
    ),
    (
        // A huge bomber that makes its own weather. While any foe is in reach its Storm
        // Seeder lets a seed of charged cloud go from the tail every second, aimed at
        // nothing: each hangs where it was let go, so a run lays a trail of them over what it
        // crosses, swells into a thunderhead, and grown, strikes down eight times onto the
        // foes under it, each bolt bursting where it lands (`cloud`, mc-sim `cloud_seed.rs`).
        // Small twin AA mounts keep fighters honest: little damage, long reach. Lasers burn
        // missiles out of the air round it and a hull field lies over its plates. It flies
        // runs like any bomber. Raised on a lot like the Fulgur.
        key: "aster_t4_storm_bomber",
        name: "Nimbus",
        role: "Storm Bomber",
        title: "Storm Bomber",
        tech: 4,
        categories: ["Air", "Experimental"],
        health: 52000,
        cost: (materials: 20000, energy: 240000, time: 120000),
        radius: 110, height: 24,
        footprint: (8, 19),
        vision: 1300,
        // Each gun mount turns about its own pivot, not on the seeder's aim.
        hull_mounts: true,
        shield: (kind: Hull, health: 18000, regen: 120),
        // The lasers burn missiles within this of the hull, a sphere: from 380 m up it still
        // covers about 560 m of ground. Their heads sit on the sponsons behind the wing (the
        // model's `nimbus::body::LASERS`).
        anti_missile: 680, anti_missile_lasers: 2,
        anti_missile_mounts: [(-20, 8.6, 8.2), (-20, -8.6, 8.2)],
        // The field and the lasers draw power.
        economy: (energy_upkeep: 300),
        motion: (layer: Air, size: 0, speed: 75, accel: 18, turn: 22, altitude: 380, hover: false),
        weapons: [
            (
                // Eight bolts of 400, each a blast 26 m round, a second apart, from a seed every
                // second: 3200 a cloud, about 3200 a second once a run's trail is striking and
                // every bolt finds something.
                // The seed leaves from the middle of the dispenser's mouth in the tail.
                name: "Storm Seeder",
                damage: 3200, range: 600, reload: 1.0, speed: 100, trajectory: Direct,
                // Nothing turns: the seed always leaves the dispenser's mouth at the tail, so
                // the mouth is its own pivot, whatever the aim.
                turret_turn: 720, muzzle: (-46.5, 0, 7.2), pivot: (-46.5, 0, 7.2),
                cloud: (grow: 7.0, strike: 8.0, bolts: 8, radius: 150, splash: 26),
                targets: ["Land", "Naval", "Structure"], color: Blue,
                flash: 0.0, impact: 2.6, shockwave: 1.6, ion_blast: 26,
                // Heard as a loop while it seeds (`hold`), not a shot a second.
                sounds: (hold: "storm_seeding", impact: "storm_bolt", ground: "storm_bolt"),
            ),
            (
                // Four small twin mounts, barrels linked, each turning on its own: dorsal fore
                // and aft on the deck, one out on each wing. Pivots and barrel ends (the mount
                // facing the nose) are the model's: `models::aster::air::nimbus`
                // (`tests/nimbus.rs`).
                name: "Twin AA Gun",
                damage: 10, range: 650, reload: 0.5, salvo: 2, salvo_batch: 2, speed: 900, trajectory: Direct,
                turret_turn: 220, muzzle: (12.6, 0, 13.8), pivot: (9, 0, 13.8), mount: true,
                muzzles: [(12.6, 0.4, 13.8), (12.6, -0.4, 13.8)],
                targets: ["Air"], color: Orange, tracer: 0.6,
                sounds: (fire: "autocannon", impact: "shell_light"),
            ),
            (
                name: "Twin AA Gun",
                damage: 10, range: 650, reload: 0.5, salvo: 2, salvo_batch: 2, speed: 900, trajectory: Direct,
                turret_turn: 220, facing: 180, muzzle: (-16.4, 0, 13.8), pivot: (-20, 0, 13.8), mount: true,
                muzzles: [(-16.4, 0.4, 13.8), (-16.4, -0.4, 13.8)],
                targets: ["Air"], color: Orange, tracer: 0.6,
                sounds: (fire: "autocannon", impact: "shell_light"),
            ),
            (
                name: "Twin AA Gun",
                damage: 10, range: 650, reload: 0.5, salvo: 2, salvo_batch: 2, speed: 900, trajectory: Direct,
                turret_turn: 220, facing: 90, muzzle: (-5.4, 48, 8.5), pivot: (-9, 48, 8.5), mount: true,
                muzzles: [(-5.4, 48.4, 8.5), (-5.4, 47.6, 8.5)],
                targets: ["Air"], color: Orange, tracer: 0.6,
                sounds: (fire: "autocannon", impact: "shell_light"),
            ),
            (
                name: "Twin AA Gun",
                damage: 10, range: 650, reload: 0.5, salvo: 2, salvo_batch: 2, speed: 900, trajectory: Direct,
                turret_turn: 220, facing: -90, muzzle: (-5.4, -48, 8.5), pivot: (-9, -48, 8.5), mount: true,
                muzzles: [(-5.4, -47.6, 8.5), (-5.4, -48.4, 8.5)],
                targets: ["Air"], color: Orange, tracer: 0.6,
                sounds: (fire: "autocannon", impact: "shell_light"),
            ),
        ],
        mesh: "storm_bomber", icon: Bomber,
        sounds: (death: "blast_colossal", moving: "nimbus_engine", takeoff: "nimbus_takeoff"),
    ),
    (
        // The first tier 5: a two-legged siege walker nearly five hundred metres tall, raised
        // on a lot of its own like the Fulgur. It strides straight over structures and slopes
        // rather than round them, and wades any sea on the maps with the water below its
        // knees, its guns still firing over it. Every footfall is felt: what is under the
        // foot is crushed. The right arm is a rotary cluster of six battleship barrels, the
        // left an AEB-3, a bore so big its discharge takes the heart out of a base. Rocket
        // pods and a twin flak turret ride each shoulder, and a hull field lies over its
        // plates.
        key: "aster_t5_titan",
        name: "Behemoth",
        role: "Siege Titan",
        tech: 5,
        categories: ["Land", "DirectFire", "Experimental"],
        // Air is its counter: its guns outrange anything on the ground and its feet crush
        // what gets under them, but it has no anti-air at all; it wants escorts.
        health: 1300000,
        cost: (materials: 120000, energy: 1200000, time: 400000),
        radius: 160, height: 480,
        footprint: (32, 32),
        vision: 2400, radar: 4200,
        // A personal field over its plates.
        shield: (kind: Hull, health: 200000, regen: 600),
        economy: (energy_upkeep: 4000),
        motion: (layer: Land, size: 5, speed: 26, accel: 5, turn: 12, stride: true),
        // One footfall each half stride (the model's 256 m stride at this size), planted
        // ahead of the middle on alternate sides: anything short of an experimental under
        // the sole is crushed.
        stomp: (pace: 128, reach: 76.8, gauge: 88, radius: 56, damage: 20000),
        weapons: [
            (
                // Shoulder pods: heavy unguided rockets rippled at the mark, lofted out of the
                // pods on an arc (`rake`), scattering wide and bursting big. Its third
                // weapon, and still more than most armies can take. Listed first: the pods
                // ride the torso itself, so the torso's aim is theirs, and the arms after
                // them each swing a little off it on their own (`sway`).
                name: "Hailstorm Rocket Pods",
                damage: 3000, splash: 70, range_min: 600, range: 3200, reload: 14.0, salvo: 24, salvo_delay: 0.1, speed: 320, trajectory: Ballistic, rake: 17.19, fixed_rack: true, loft: 7,
                turret_turn: 20, pivot: (0, 0, 392), muzzle: (2.6, 80, 461.6),
                // Two rows of three in each pod's face, the pods fixed on the shoulders and
                // raked 17 degrees nose-up (`fixed_rack`, `rake`: the model's `titan::POD_PITCH`):
                // the rockets leave the cells along them. The salvo ripples down them in turn,
                // twice round.
                muzzles: [(2.6, 62.4, 461.6), (2.6, 80, 461.6), (2.6, 97.6, 461.6), (-2.6, 62.4, 478.4), (-2.6, 80, 478.4), (-2.6, 97.6, 478.4),
                          (2.6, -62.4, 461.6), (2.6, -80, 461.6), (2.6, -97.6, 461.6), (-2.6, -62.4, 478.4), (-2.6, -80, 478.4), (-2.6, -97.6, 478.4)],
                targets: ["Land", "Naval", "Structure"], color: Orange, missile: true,
                intercept: 400, spread: 7, trail: true, wake: 8, tracer: 4, impact: 4.5, shockwave: 2.5,
                // A heavy rocket in each tube: 6 m across in the 9.6 m mouth, 43 m long in the 60 m pod.
                caliber: 6,
                sounds: (fire: "titan_rockets", impact: "shell_heavy"),
            ),
            (
                // Right arm. Six heavy barrels turn in the cluster: a battleship's gun fired
                // like a machine gun, conventional shells walking round the mark. Its arms fire
                // from nearly 300 m up: what is close is under them, out of their reach
                // (`range_min`), and left to its feet and its flak.
                name: "Tempest Rotary Cannon",
                // It opens fire a third of the way into its spin-up and fires faster as the
                // barrels come up to speed (`spin_ramp`): a slow heavy beat, two shells a second at
                // full spin (a whole number of ticks, so a barrel is always at the top), each one a battleship's broadside on its own.
                // Each shell leaves the barrel at the top of the cluster as it comes round
                // (`barrels`), so the muzzle is that barrel's, 19.6 m over the cluster's axis.
                // It shoots flat from nearly 300 m up, so a shell laid a hair high skims over
                // its mark and comes down hundreds of metres past it: the spread is kept
                // tight (0.7 degrees lands most shells on a T4 at full range; 4 landed one
                // in twenty), and the burst is wide, so the fall of shot still walks about.
                damage: 5400, splash: 60, range_min: 900, range: 2600, reload: 0.5, speed: 1000, trajectory: Direct,
                turret_turn: 20, pivot: (0, 0, 392), muzzle: (256, -144, 315.6), spread: 0.7, spin_up: 2.5, spin_ramp: 3.0,
                barrels: 6, sway: 15,
                targets: ["Land", "Naval", "Structure"], color: Orange,
                flash: 4.5, impact: 4.2, shockwave: 2.6, tracer: 0.7,
                // Each shot kicks its one spent casing out of the port in the gun's flank (`port`,
                // the model's `titan::EJECT` at 4x; it turns and pitches with the gun), every
                // one thrown the same way (out of that flank and up, `throw`) before it tumbles
                // off on its own: it comes down like a falling girder, crushing what it lands
                // on, lies there a while and sinks away. It is worth nothing.
                sabot: (port: (40, -178.4, 300), throw: (0, -0.83, 0.56), kick: 18, damage: 1500, splash: 24, casing: "aster_t5_titan_sabot"),
                sounds: (fire: "titan_gatling_fire", spin: "titan_gatling_spin", whir: "titan_gatling_whir", spindown: "titan_gatling_spindown", impact: "titan_shell_hit", ground: "titan_shell_hit", casing: "titan_casing_land"),
            ),
            (
                // Left arm. An argon tracer too fast to see, then the whole charge down its
                // channel: it sears a lane to the mark and bursts there, and the gun keeps
                // pouring its charge down the channel into a lightning storm that spreads
                // from the hit and vaporises a whole base over several seconds (`storm`):
                // an electrical warhead.
                name: "AEB-3 Cataclysm Bore",
                damage: 40000, splash: 150, range_min: 1200, range: 3800, reload: 45.0, speed: 12000, trajectory: Direct,
                turret_turn: 20, pivot: (0, 0, 392), muzzle: (280, 144, 296), spread: 0.8, sway: 15,
                targets: ["Land", "Naval", "Structure"], color: Blue, flash: 0.6, impact: 3.0, shockwave: 9.0,
                tracer: 0, trail: false, wake: 0, bolts: 0,
                bore: (width: 60, damage: 20000, cool: 150, storm: (radius: 440, seconds: 9, damage: 6000)),
                sounds: (fire: "titan_bore_fire", charge: "titan_bore_charge", charge_time: 6.0, impact: "titan_bore_strike", ground: "titan_bore_strike", far: "titan_bore_far"),
            ),
        ],
        mesh: "titan", icon: Titan,
        sounds: (death: "titan_death", moving: "titan_walk", step: "titan_step", step_far: "titan_step_far"),
    ),
    (
        // The second tier 5: a space elevator. Three great clamp towers stand round a
        // receiving well; once they are finished a cable is let down out of orbit into
        // the well and they close on it. From then on three cargo crates fall down the
        // cable every `period`, sirens sounding as they come, land in the ways out between
        // the towers and open; what was queued on the elevator drives out of them as
        // groups, free, up to the `payload` of materials and the crates' seats, and the empty
        // crates sink into the ground. Whatever of the payload the queue leaves is brought
        // down as plain materials for the store.
        key: "aster_t5_space_elevator",
        name: "Skyhook",
        role: "Space Elevator", title: "Space Elevator",
        tech: 5,
        categories: ["Land", "Factory", "Experimental"],
        health: 1500000,
        cost: (materials: 160000, energy: 1600000, time: 500000),
        radius: 150, height: 300, footprint: (26, 26), hull: (22, 22),
        vision: 600,
        // 20 000 materials every 30 s: about 670 materials a second once it is running, so it
        // pays for itself in four minutes if nothing touches it.
        elevator: (period: 30, payload: 20000, tether: 24, descent: 7, dock: 18, sink: 4),
        // What it brings down: everything ARC's land and air factories make, and the
        // tech 4 land experimentals; nothing that floats.
        builder: (power: 0, range: 0, builds: [
            "aster_t1_engineer", "aster_t1_mobile_reclaimer", "aster_t1_scout", "aster_t1_bot", "aster_t1_tank", "aster_t1_artillery", "aster_t1_mobile_aa",
            "aster_t2_engineer", "aster_t2_mobile_reclaimer", "aster_t2_tank", "aster_t2_hover", "aster_t2_missile", "aster_t2_mobile_shield", "aster_t2_mobile_aa",
            "aster_t3_engineer", "aster_t3_mobile_reclaimer", "aster_t3_assault_bot", "aster_t3_artillery", "aster_t3_sniper",
            "aster_t1_interceptor", "aster_t1_bomber", "aster_t1_air_scout", "aster_t1_rotor_gunship",
            "aster_t2_gunship", "aster_t2_fire_bomber", "aster_t2_torpedo_bomber", "aster_t2_interceptor",
            "aster_t3_air_superiority", "aster_t3_support", "aster_t3_strategic_bomber", "aster_t3_assault_aircraft",
            "aster_t4_assault_tank", "aster_t4_breacher",
        ]),
        mesh: "space_elevator", icon: Elevator,
        sounds: (death: "blast_large"),
    ),
    (
        // The Tempest's spent casing, as it is drawn falling and lying where it fell
