                targets: ["Land", "Naval", "Structure", "Space"], color: Blue, flash: 2.2, impact: 2.0, shockwave: 1.6,
                tracer: 0.35, plasma: 0.6, streak: 3, trail: true, wake: 1.0, bolts: 8, discharge: 45, melt: 0.55,
                howitzer: (length: 26, radius: 1.2),
                sounds: (fire: "leviathan_broadside", charge: "leviathan_charge", charge_time: 3.4, charge_volume: 1.6, impact: "aster_trebuchet_strike", ground: "aster_trebuchet_strike"),
            ),
            (
                name: "Arc Cannon Casemate",
                damage: 1800, splash: 30, range: 2400, reload: 10, salvo: 2, salvo_delay: 0, speed: 700, trajectory: Direct,
                turret_turn: 30, arc: 160, facing: -90, mount: true, pivot: (-70, -66, 58), muzzle: (-44, -66, 58),
                muzzles: [(-44, -66, 60.5), (-44, -66, 55.5)], spread: 1.2,
                targets: ["Land", "Naval", "Structure", "Space"], color: Blue, flash: 2.2, impact: 2.0, shockwave: 1.6,
                tracer: 0.35, plasma: 0.6, streak: 3, trail: true, wake: 1.0, bolts: 8, discharge: 45, melt: 0.55,
                howitzer: (length: 26, radius: 1.2),
                sounds: (fire: "leviathan_broadside", charge: "leviathan_charge", charge_time: 3.4, charge_volume: 1.6, impact: "aster_trebuchet_strike", ground: "aster_trebuchet_strike"),
            ),
            // Two low twin bolt rifle houses on the spine, one forward facing ahead and one
            // aft facing astern: the Paladin's gun at a warship's size and reach, for what
            // the casemates cannot bear on.
            (
                name: "Twin Bolt Rifle",
                damage: 700, splash: 8, range: 1600, reload: 2.2, speed: 700, trajectory: Direct,
                turret_turn: 60, arc: 300, facing: 0, mount: true, pivot: (150, 0, 118), muzzle: (174, 0, 118),
                muzzles: [(174, -2.5, 118), (174, 2.5, 118)],
                targets: ["Land", "Naval", "Structure", "Space"], color: Blue, flash: 0.9, impact: 2.0, shockwave: 0.8,
                tracer: 0.35, plasma: 1.0, trail: true, wake: 0.4, bolts: 6, discharge: 20,
                sounds: (fire: "aster_bolt_rifle_heavy", charge: "aster_bolt_rifle_heavy_charge", charge_time: 0.6, impact: "aster_bolt_rifle_heavy_strike", ground: "aster_bolt_rifle_heavy_strike"),
            ),
