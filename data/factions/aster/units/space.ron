// Aster warships of the upper air ("Space" category): capital hulls that hang in the
// cloud layer like the lift ships, but are built to fight. Engineers raise them on a lot
// of their own (`footprint` on a mobile unit) and the finished ship climbs off it.
[
    (
        // The Reach's eyes in the upper air: a small single-drive hull with a hammerhead of
        // sensors across its bow, a tech 2 tower's reach that goes where the army goes.
        // Unarmed. It hangs at fighter height, inside the reach of tech 1 anti-air, and its
        // radar draws power like a tower's: an energy stall (or a pause) blinds it.
        key: "aster_t1_sensor_ship",
        name: "Vigil",
        role: "Sensor Ship",
        tech: 1,
        categories: ["Air", "Space", "Intel"],
        health: 700,
        cost: (mass: 280, energy: 4200, time: 1400),
        radius: 36, height: 22, footprint: (6, 5), hull: (36, 27), vision: 1500, radar: 6000,
        motion: (layer: Air, size: 0, speed: 90, accel: 20, turn: 40, altitude: 200, hover: true),
        // Warp: a scout's light drive, cheaper to charge than the Courier's.
        warp: (energy: 1200, spool: 3, cooldown: 40, speed: 3000),
        economy: (energy_upkeep: 100),
        weapons: [],
        mesh: "sensor_ship", icon: SensorShip,
        sounds: (death: "blast_small", moving: "aster_vigil"),
    ),
    (
        // The Reach's light warship of the upper air: a small hull with one long rail cannon
        // slung under its belly for the ground below, and a rotary cannon on its back to
        // keep aircraft off it.
        // It hangs below the heavy hulls, inside the reach of tech 2 anti-air, and has no
        // shield: flak and interceptors are its answer, and the Resolute outguns it.
        key: "aster_t2_corvette",
        name: "Valiant",
        role: "Rail Corvette",
        tech: 2,
        categories: ["Air", "Space"],
        health: 7000,
        cost: (mass: 1100, energy: 18000, time: 6600),
        radius: 58, height: 30, footprint: (10, 5), hull: (58, 24), vision: 1400,
        motion: (layer: Air, size: 0, speed: 75, accel: 12, turn: 24, altitude: 420, hover: true),
        // Between the Vigil's light drive and the Bastion's.
        warp: (range: 8000, energy: 4000, spool: 3, cooldown: 50, speed: 3200),
        hull_mounts: true,
        weapons: [
            // The long rail cannon, the Resolute's turret gun drawn out, hung under the belly
            // on a post: it turns right round and lays straight down onto the ground. It
            // charges, then throws a slug far past anything else a tech 2 ship carries.
            (
                name: "Long Rail Cannon",
                damage: 650, splash: 5, range: 1500, reload: 3.6, speed: 1400, rail: true, trajectory: Direct,
                turret_turn: 50, arc: 360, mount: true, pivot: (10, 0, 9), muzzle: (50, 0, 9),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, flash: 1.4, impact: 1.3, heavy_rail: 0.1,
                sounds: (fire: "aster_rail_heavy", charge: "resolute_turret_charge", charge_time: 0.9, charge_volume: 1.2, impact: "aster_rail_hit"),
            ),
            // A rotary cannon on a raised barbette amidships, the sky all round it: a stream
            // of rounds at aircraft only. It spins up before it fires, so a fighter's pass
            // can beat it.
            (
                name: "AA Rotary Cannon",
                damage: 24, range: 550, reload: 0.12, speed: 1000, trajectory: Direct,
                turret_turn: 160, arc: 360, mount: true, pivot: (-4, 0, 42), muzzle: (6.8, 0, 42), spread: 1.2,
                targets: ["Air"], color: Orange, flash: 1.0, impact: 1.0, tracer: 0.7,
                rounds: 6, casings: 3, spin_up: 0.5, sounds: (fire: "aster_minigun", impact: "shell_light"),
            ),
        ],
        mesh: "rail_corvette", icon: Warship,
        sounds: (death: "blast_large", moving: "aster_corvette"),
    ),
    (
        // The Reach's first line warship. A slow, heavy armoured hull laid round one gun: the
        // spinal rail cannon runs the length of the keel and is aimed by turning and pitching
        // the whole ship onto the mark, far beyond its turrets. Its own search radar finds
        // the marks. Four rail cannon turrets for everything else, rocket cells for aircraft.
        // Expensive, and no shield: massed air superiority fighters are its answer.
        key: "aster_t3_frigate",
        name: "Resolute",
        role: "Heavy Frigate",
        tech: 3,
        categories: ["Air", "Space"],
        health: 55000,
        cost: (mass: 5000, energy: 60000, time: 20000),
        radius: 150, height: 70, footprint: (27, 13), hull: (162, 78), vision: 1900, radar: 2400,
        motion: (layer: Air, size: 0, speed: 60, accel: 6, turn: 8, altitude: 560, hover: true),
        // The costliest jump of the line, and the slowest to spool and to recharge.
        warp: (energy: 20000, spool: 5, cooldown: 75, speed: 4000),
        hull_mounts: true,
        weapons: [
            // Fixed along the keel: the ship turns and pitches to aim it. Charges, then one
            // shot that is felt across the map, at anything on the ground or the sea. Its
            // splash is full damage out to the edge (no falloff), so it stays tight. Reach
            // stops short of the Zenith's 2600, so the frigate's counter outranges it.
            (
                name: "Spinal Rail Cannon",
                damage: 9000, splash: 24, range: 2400, reload: 20.0, speed: 2400, rail: true, trajectory: Direct,
                turret_turn: 0, arc: 4, muzzle: (150, 0, 47),
                targets: ["Space", "Land", "Naval", "Structure"], color: Orange,
                flash: 4.0, impact: 4.0, shockwave: 4.0, heavy_rail: 1.0,
                sounds: (fire: "spinal_rail_fire", charge: "spinal_rail_charge", charge_time: 3.0, charge_volume: 2.4, impact: "spinal_rail_impact", ground: "spinal_rail_ground"),
            ),
            // Rail cannon turrets: one slung under the prow, one astern of the bridge (it can
            // only dip a little below its deck), one each side low on the flanks. Their
            // arcs stop where the hull, the nacelles or the deck would be in the way. Each
            // charges before it fires, arcs crawling its rails as the capital guns' do
            // (`heavy_rail` under 0.15: the charge and the rails' heat, an ordinary shot),
            // and the charge is heard over the battle below (`charge_volume`).
            (
                name: "Rail Cannon Turret",
                damage: 400, splash: 4, range: 1600, reload: 3.0, speed: 1300, rail: true, trajectory: Direct,
                turret_turn: 60, arc: 250, mount: true, pivot: (104, 0, 22), muzzle: (137.8, 0, 22),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, flash: 1.4, impact: 1.2, heavy_rail: 0.1,
                sounds: (fire: "aster_rail_heavy", charge: "resolute_turret_charge", charge_time: 0.9, charge_volume: 1.2, impact: "aster_rail_hit"),
            ),
            (
                name: "Rail Cannon Turret",
                damage: 400, splash: 4, range: 1600, reload: 3.0, speed: 1300, rail: true, trajectory: Direct,
                turret_turn: 60, arc: 270, facing: 180, depression: 12, mount: true, pivot: (-116, 0, 74), muzzle: (-82.2, 0, 74),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, flash: 1.4, impact: 1.2, heavy_rail: 0.1,
                sounds: (fire: "aster_rail_heavy", charge: "resolute_turret_charge", charge_time: 0.9, charge_volume: 1.2, impact: "aster_rail_hit"),
            ),
            (
                name: "Rail Cannon Turret",
                damage: 400, splash: 4, range: 1600, reload: 3.0, speed: 1300, rail: true, trajectory: Direct,
                turret_turn: 60, arc: 140, facing: 70, mount: true, pivot: (10, 42, 34), muzzle: (43.8, 42, 34),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, flash: 1.4, impact: 1.2, heavy_rail: 0.1,
                sounds: (fire: "aster_rail_heavy", charge: "resolute_turret_charge", charge_time: 0.9, charge_volume: 1.2, impact: "aster_rail_hit"),
            ),
            (
                name: "Rail Cannon Turret",
                damage: 400, splash: 4, range: 1600, reload: 3.0, speed: 1300, rail: true, trajectory: Direct,
                turret_turn: 60, arc: 140, facing: -70, mount: true, pivot: (10, -42, 34), muzzle: (43.8, -42, 34),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, flash: 1.4, impact: 1.2, heavy_rail: 0.1,
                sounds: (fire: "aster_rail_heavy", charge: "resolute_turret_charge", charge_time: 0.9, charge_volume: 1.2, impact: "aster_rail_hit"),
            ),
            // Rocket cells either side of the spine: a ripple of guided rockets straight up,
            // over onto the aircraft. Enough to see off a few fighters, not a wing of them.
            (
                name: "AA Rocket Cells",
                damage: 320, splash: 10, range: 700, reload: 1.6, speed: 420, trajectory: Direct,
                turret_turn: 0, arc: 360, muzzle: (18, 13.8, 62.2),
                muzzles: [(18, 13.8, 62.2), (18, 19.2, 62.2), (26, 13.8, 62.2), (26, 19.2, 62.2), (34, 13.8, 62.2), (34, 19.2, 62.2), (42, 13.8, 62.2), (42, 19.2, 62.2)],
                targets: ["Air"], color: Orange, missile: true, guided: true, vertical_launch: true,
                intercept: 25, proximity: 12, trail: true,
                sounds: (fire: "missile_launch", impact: "shell_light"),
            ),
            (
                name: "AA Rocket Cells",
                damage: 320, splash: 10, range: 700, reload: 1.6, speed: 420, trajectory: Direct,
                turret_turn: 0, arc: 360, muzzle: (18, -13.8, 62.2),
                muzzles: [(18, -13.8, 62.2), (18, -19.2, 62.2), (26, -13.8, 62.2), (26, -19.2, 62.2), (34, -13.8, 62.2), (34, -19.2, 62.2), (42, -13.8, 62.2), (42, -19.2, 62.2)],
                targets: ["Air"], color: Orange, missile: true, guided: true, vertical_launch: true,
                intercept: 25, proximity: 12, trail: true,
                sounds: (fire: "missile_launch", impact: "shell_light"),
            ),
        ],
        mesh: "space_frigate", icon: Warship,
        sounds: (death: "blast_colossal", moving: "aster_frigate"),
    ),
    (
        // The ground's answer to warships in the upper air: one enormous rail cannon on a
        // slow turntable, built at home. It reaches hulls far beyond any other gun and
        // shoots at nothing else.
        key: "aster_t4_anti_ship",
        name: "Zenith",
        role: "Anti-Ship Rail Cannon",
        tech: 4,
        categories: ["Land", "Defense", "AntiAir", "Experimental"],
        health: 40000,
        cost: (mass: 4000, energy: 50000, time: 16000),
        radius: 46, height: 86, footprint: (8, 8),
        vision: 600,
        weapons: [
            (
                name: "Zenith Rail Cannon",
                damage: 7000, splash: 20, range: 2600, reload: 10.0, speed: 3000, rail: true, trajectory: Direct,
                turret_turn: 20, pivot: (0, 0, 78), muzzle: (135, 0, 78),
                targets: ["Space"], color: Orange,
                flash: 4.0, impact: 4.0, shockwave: 3.0, heavy_rail: 1.0,
                sounds: (fire: "zenith_rail_fire", charge: "zenith_rail_charge", charge_time: 2.5, impact: "zenith_rail_impact", ground: "spinal_rail_ground"),
            ),
        ],
        mesh: "anti_ship_rail", icon: AntiAir,
        sounds: (death: "blast_large"),
    ),
]
