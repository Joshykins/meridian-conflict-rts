                    (-20, -22, 126), (-8, -28, 126), (-14, -22, 126), (-26, -28, 126), (-8, -22, 126), (-20, -28, 126), (-26, -22, 126), (-14, -28, 126),
                ],
                salvo: 16, salvo_delay: 0.25, split: true, hatch: 0.6, caliber: 1.1,
                targets: ["Air"], color: Orange, missile: true, guided: true, vertical_launch: true,
                cold_launch: 1.8, boost: 0.9, intercept: 140, proximity: 12, splash: 32, trail: true,
                impact: 2, shockwave: 1,
                sounds: (fire: "missile_launch", impact: "shell_light"),
            ),
        ],
        mesh: "space_dreadnought", icon: Warship,
        sounds: (death: "blast_colossal", moving: "aster_frigate"),
