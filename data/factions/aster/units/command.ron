[
    // The commander is refitted where it stands, one slot at a time (`refits`). A slot holds
    // one module; a module with `after` is the next tier of that one and replaces it, the
    // others in a slot are alternatives. `cost` is the price of the refit. Every loadout is
    // compiled to a blueprint of its own; the model tags each module's pieces with its key
    // (`mechs::commander`), so a new module wants pieces there too.
    (
        key: "aster_commander",
        name: "ARC Commander",
        role: "Armored Command Unit",
        tech: 1,
        categories: ["Land", "Commander", "Engineer", "DirectFire"],
        health: 11000, regen: 10,
        cost: (mass: 18000, energy: 5000000, time: 6000000),
        radius: 10.4, height: 24,
        vision: 600, radar: 1500,
        motion: (layer: Amphibious, size: 0, speed: 30, accel: 30, turn: 150),
        economy: (mass_income: 1, energy_income: 20, mass_storage: 1000, energy_storage: 5000),
        // `arm`: it builds with the arm on its torso, so it turns to face its work and
        // holds its fire while it builds. `emitter` is where the beam leaves the model.
        builder: (power: 10, range: 70, arm: (turn: 140, emitter: (7.68, 4.8, 15.52), pivot: (-0.48, 4.8, 15.68)), builds: [
            "aster_t1_land_factory", "aster_t1_air_factory", "aster_t1_naval_factory", "aster_core_mine", "aster_t1_power", "aster_mass_storage", "aster_energy_storage", "aster_t1_point_defense", "aster_t1_radar", "aster_t1_sonar", "aster_t1_torpedo_defense", "aster_wall", "aster_t1_aa", "aster_t1_reclaimer",
        ]),
        // The machine gun is always there; what the refits add rides the same arm or a shoulder.
        weapons: [(
            name: "Vulcan Machine Gun",
            // `sweep`: it fires down the barrel whenever anything it can shoot is within
            // 30 degrees either side of it. `splash` and `impact`: each round bursts a little.
            damage: 40, splash: 2, range: 360, reload: 0.2, speed: 720, trajectory: Direct,
            turret_turn: 36, muzzle: (8.8, -4.8, 15.52), pivot: (-0.48, -4.8, 15.68), spread: 0.4, sweep: 30,
            targets: ["Land", "Naval"], color: Orange, flash: 1.3, impact: 1.3, tracer: 0.7, spin_up: 0.6,
            // Each 0.2 s shot is seen and heard as eight rounds: a stream, not a pulse.
            rounds: 8,
            // A casing for each round, out of the breech on the arm's outside.
            casings: 5,
            sounds: (fire: "aster_minigun", impact: "shell_light"),

        )],
        refits: [
            (
                key: "engineering", name: "Left Arm",
                modules: [
                    (
                        key: "eng_2", icon: Engineer, name: "Engineering Suite II", tech: 2,
                        summary: "Tech 2 construction, faster building, heavier armour.",
                        cost: (mass: 2400, energy: 24000, time: 1800),
                        health: 3000, regen: 5, build_power: 30, build_range: 5,
                        // The suite's gear comes to work (turns, opens) over this long.
                        unfold: 0.6,
                        builds: ["aster_t2_land_factory", "aster_t2_air_factory", "aster_t2_naval_factory", "aster_core_mine_t2", "aster_t2_power", "aster_t2_point_defense", "aster_t2_artillery", "aster_t2_reclaimer", "aster_t2_radar", "aster_mass_storage_t2", "aster_energy_storage_t2", "aster_t2_sonar", "aster_t2_torpedo_defense", "aster_t2_shield", "aster_t2_warp_damper", "aster_t2_aa", "aster_t2_missile_defense", "aster_t2_lift_ship", "aster_t2_sensor_ship", "aster_t2_fabricator"],
                    ),
                    (
                        key: "eng_3", icon: Engineer, name: "Engineering Suite III", tech: 3, after: "eng_2",
                        summary: "Tech 3 and experimental construction, much faster building, heavy armour.",
                        cost: (mass: 6000, energy: 60000, time: 4500),
                        health: 7000, regen: 15, build_power: 150, build_range: 10,
                        // The lance runs out past the projector while it builds: the beam leaves its tip.
                        arm_emitter: (12.0, 4.8, 15.52),
                        builds: ["aster_t2_land_factory", "aster_t2_air_factory", "aster_t2_naval_factory", "aster_core_mine_t2", "aster_t2_power", "aster_t2_point_defense", "aster_t2_artillery", "aster_t2_reclaimer", "aster_t2_radar", "aster_mass_storage_t2", "aster_energy_storage_t2", "aster_t2_sonar", "aster_t2_torpedo_defense", "aster_t2_shield", "aster_t2_warp_damper", "aster_t2_aa", "aster_t2_missile_defense", "aster_t3_missile_defense", "aster_t3_land_factory", "aster_t3_air_factory", "aster_t3_naval_factory", "aster_core_mine_t3", "aster_core_mine_t4", "aster_t3_power", "aster_t3_reclaimer", "aster_t3_radar", "aster_mass_storage_t3", "aster_energy_storage_t3", "aster_t3_sonar", "aster_t3_torpedo_defense", "aster_t3_shield", "aster_t3_sam", "aster_t3_point_defense", "aster_t2_lift_ship", "aster_t2_sensor_ship", "aster_t3_lift_ship", "aster_t3_corvette", "aster_t4_frigate", "aster_t4_dreadnought", "aster_t4_assault_tank", "aster_t5_titan", "aster_t4_anti_ship", "aster_t3_nuke_defense", "aster_t4_nuke_silo", "aster_t4_submarine", "aster_t4_artillery", "aster_t2_fabricator", "aster_t3_fabricator"],
                    ),
                ],
            ),
            (
                key: "gun", name: "Right Arm",
                modules: [
                    (
                        key: "cannon", icon: Tank, name: "Breach Cannon",
                        summary: "A heavy cannon on the forearm; the machine gun moves under it.",
                        cost: (mass: 600, energy: 7200, time: 700),
                        remount: [(weapon: "Vulcan Machine Gun", muzzle: (6.24, -6.64, 14.96))],
                        weapons: [(
                            name: "Breach Cannon",
                            damage: 280, splash: 4, range: 400, reload: 1.8, speed: 380, trajectory: Direct,
                            turret_turn: 110, muzzle: (10.88, -4.8, 15.52), pivot: (-0.48, -4.8, 15.68),
                            targets: ["Land", "Naval"], color: Orange, flash: 2.6, shockwave: 0.6,
                            sounds: (fire: "aster_breach", impact: "shell_heavy"),
                        )],
                    ),
                    (
                        key: "railgun", icon: Tank, name: "Meridian Rail Cannon", after: "cannon",
                        summary: "The cannon rebuilt as a rail gun: long range, heavy hits.",
                        cost: (mass: 1800, energy: 21600, time: 2200),
                        // It replaces the cannon's refit, so it carries the cannon's move of the Vulcan too.
                        remount: [(weapon: "Vulcan Machine Gun", muzzle: (6.24, -6.64, 14.96))],
                        weapons: [(
                            name: "Meridian Rail Cannon",
                            damage: 950, splash: 12, range: 780, reload: 2.4, speed: 1200, rail: true, trajectory: Direct,
                            turret_turn: 110, muzzle: (12.48, -4.8, 15.52), pivot: (-0.48, -4.8, 15.68),
                            targets: ["Land", "Naval"], color: Orange, flash: 3.6, impact: 4.5, shockwave: 1.3,
                            // It charges before it fires, arcs crawling its rails as every rail
                            // gun's do (`heavy_rail` under 0.15: the charge and the rails' heat,
                            // an ordinary shot).
                            heavy_rail: 0.1,
                            sounds: (fire: "aster_rail_cannon", charge: "commander_rail_charge", charge_time: 0.8, impact: "aster_rail_impact"),
                        )],
                    ),
                ],
            ),
            (
                key: "back", name: "Back",
                modules: [
                    (
                        key: "mfe", icon: Power, name: "Material Formation Engine",
                        summary: "Makes materials and energy on the commander's back.",
                        cost: (mass: 1200, energy: 14400, time: 1400),
                        // About a tech 1 mine and a half on a field and a third of a tech 2 reactor, carried
                        // on the one unit that ends the game if it dies.
                        economy: (mass_income: 3, energy_income: 100),
                    ),
                    (
                        key: "shield", icon: Shield, name: "Personal Shield",
                        summary: "A field wrapped round the commander.",
                        cost: (mass: 1200, energy: 14400, time: 1400),
                        economy: (energy_upkeep: 150),
                        shield: (kind: Hull, health: 8000, regen: 80),
                    ),
                    (
                        key: "drone_port", icon: SalvageCarrier, name: "Salvage Drone Port",
                        summary: "Two salvage drones ride the back and reclaim wrecks far round the commander. Cheap to rebuild.",
                        cost: (mass: 450, energy: 5400, time: 700),
                        // On two pads over the back, behind the head; they turn with the torso.
                        // Home, a drone comes in 3 m over its pad and settles onto it.
                        drone: "aster_reclaim_drone", drone_radius: 1400,
                        drone_sockets: [(-5.3, 2.0, 21.8), (-5.3, -2.0, 21.8)], drone_approach: 3,
                    ),
                ],
            ),
            (
                key: "shoulder", name: "Shoulder",
                modules: [
                    (
                        key: "aa", icon: AntiAir, name: "AA Flak Cannon",
                        summary: "Twin-barrelled anti-air flak on the right shoulder; fires while the commander builds.",
                        cost: (mass: 900, energy: 10800, time: 1100),
                        categories: ["AntiAir"],
                        weapons: [(
                            // Twin barrels fired together; the pair scatter a few degrees,
                            // so each shot lays two bursts apart across the flight.
                            name: "AA Flak Cannon", mount: true,
                            damage: 120, range: 640, reload: 1.1, speed: 340, trajectory: Direct,
                            turret_turn: 240, muzzle: (4.96, -5.44, 23.28), pivot: (0, -4.96, 23.28),
                            muzzles: [(4.96, -5.44, 23.28), (4.96, -4.48, 23.28)],
                            salvo: 2, salvo_batch: 2, spread: 3,
                            targets: ["Air"], color: Orange, flak: true, proximity: 12, splash: 40,
                            flash: 1.6, impact: 1.4,
                            sounds: (fire: "flak_gun", impact: "flak_burst"),
                        )],
                    ),
                    (
                        key: "artillery", icon: Artillery, name: "Shoulder Howitzer",
                        summary: "Lobbed shells at long range from the right shoulder; fires while the commander builds.",
                        cost: (mass: 1100, energy: 13200, time: 1400),
                        categories: ["Artillery"],
                        weapons: [(
                            name: "Shoulder Howitzer", mount: true,
                            damage: 420, splash: 14, range_min: 120, range: 1900, reload: 8.0, speed: 200, trajectory: Ballistic, loft: 3,
                            turret_turn: 60, muzzle: (7.84, -4.96, 23.28), pivot: (0, -4.96, 23.28), spread: 1.5,
                            targets: ["Structure", "Land", "Naval"], color: Orange, shockwave: 0.7,
                            sounds: (fire: "howitzer", impact: "shell_heavy", ground: "shell_heavy"),
                        )],
                    ),
                    (
                        key: "aux_eng", icon: Engineer, name: "Auxiliary Engineering Suite",
                        summary: "Folds out over the left shoulder and builds with a second beam.",
                        cost: (mass: 800, energy: 9600, time: 900),
                        build_power: 60,
                        // Stands up behind the back; the arm sweeps round the shoulder, then the
                        // head unfolds at its wrist (`hinge`) and points down at the work.
                        emitters: [(6.558, 5.6, 23.829)], unfold: 1.4, hinge: (2.56, 5.6, 24.64),
                    ),
                ],
            ),
        ],
        wreck_fraction: 0.2,
        mesh: "commander", icon: Commander,
        sounds: (death: "commander_death", moving: "walker_heavy", step: "footstep_commander"),
    ),
    (
        key: "aster_t1_engineer",
        name: "Mason",
        role: "Engineer", title: "Engineer",
        tech: 1,
        categories: ["Land", "Engineer"],
        health: 150,
        cost: (mass: 52, energy: 260, time: 260),
        radius: 4.2, height: 3.8,
        vision: 180,
        motion: (layer: Hover, size: 0, speed: 30, accel: 30, turn: 160),
        // `arm`: a two-bone boom. Idle, the boom folds up and the forearm sits
        // level; at work the boom drops, then the forearm aims. It crawls on
        // treads and floats the water instead of walking the bed.
        builder: (power: 5, range: 55, arm: (turn: 200, rest: 85, emitter: (2.567, 0, 2.146), pivot: (1.108, 0, 2.146), shoulder: (0, 0, 1.587)), builds: [
            "aster_t1_land_factory", "aster_t1_air_factory", "aster_t1_naval_factory", "aster_core_mine", "aster_t1_power", "aster_mass_storage", "aster_energy_storage", "aster_t1_point_defense", "aster_t1_radar", "aster_t1_sonar", "aster_t1_torpedo_defense", "aster_wall", "aster_t1_aa", "aster_t1_reclaimer",
        ]),
        // Once the side has tech 2 it can build its own next tier onto itself, where it stands.
        upgrades_to: "aster_t2_engineer",
        mesh: "engineer", icon: Engineer,
        sounds: (moving: "tracks"),
    ),
    (
        key: "aster_t2_engineer",
        name: "Mason II",
        role: "Field Engineer", title: "Engineer",
        tech: 2,
        categories: ["Land", "Engineer"],
        health: 420,
        cost: (mass: 200, energy: 1200, time: 900),
        radius: 5.0, height: 4.4,
        vision: 200,
        motion: (layer: Hover, size: 0, speed: 29, accel: 29, turn: 150),
        builder: (power: 30, range: 60, arm: (turn: 200, rest: 85, emitter: (3.056, 0, 2.485), pivot: (1.319, 0, 2.485), shoulder: (0, 0, 1.838)), builds: [
            "aster_t2_lift_ship", "aster_t2_sensor_ship", "aster_t1_land_factory", "aster_t1_air_factory", "aster_t1_naval_factory", "aster_core_mine", "aster_t1_power", "aster_mass_storage", "aster_energy_storage", "aster_t1_point_defense", "aster_t1_radar", "aster_t1_sonar", "aster_t1_torpedo_defense", "aster_wall", "aster_t1_reclaimer", "aster_t2_land_factory", "aster_t2_air_factory", "aster_t2_naval_factory", "aster_core_mine_t2", "aster_t2_power", "aster_t2_point_defense", "aster_t2_artillery", "aster_t2_reclaimer", "aster_t2_radar", "aster_mass_storage_t2", "aster_energy_storage_t2", "aster_t2_sonar", "aster_t2_torpedo_defense", "aster_t2_shield", "aster_t2_warp_damper", "aster_t1_aa", "aster_t2_aa", "aster_t2_missile_defense",
            "aster_t2_fabricator",
        ]),
        upgrades_to: "aster_t3_engineer",
        mesh: "engineer", icon: Engineer,
        sounds: (moving: "tracks"),
    ),
    (
        key: "aster_t3_engineer",
        name: "Mason III",
        role: "Combat Engineer", title: "Engineer",
        tech: 3,
        categories: ["Land", "Engineer"],
        health: 900,
        cost: (mass: 800, energy: 6400, time: 3200),
        radius: 6.0, height: 5.0,
        vision: 220,
        motion: (layer: Hover, size: 1, speed: 28, accel: 28, turn: 150),
        builder: (power: 150, range: 70, arm: (turn: 200, rest: 85, emitter: (3.667, 0, 2.824), pivot: (1.583, 0, 2.824), shoulder: (0, 0, 2.088)), builds: [
            "aster_t2_lift_ship", "aster_t2_sensor_ship", "aster_t1_land_factory", "aster_t1_air_factory", "aster_t1_naval_factory", "aster_core_mine", "aster_t1_power", "aster_mass_storage", "aster_energy_storage", "aster_t1_point_defense", "aster_t1_radar", "aster_t1_sonar", "aster_t1_torpedo_defense", "aster_wall", "aster_t1_reclaimer", "aster_t2_land_factory", "aster_t2_air_factory", "aster_t2_naval_factory", "aster_core_mine_t2", "aster_t2_power", "aster_t2_point_defense", "aster_t2_artillery", "aster_t2_reclaimer", "aster_t2_radar", "aster_mass_storage_t2", "aster_energy_storage_t2", "aster_t2_sonar", "aster_t2_torpedo_defense", "aster_t2_shield", "aster_t2_warp_damper", "aster_t3_land_factory", "aster_t3_air_factory", "aster_t3_naval_factory", "aster_core_mine_t3", "aster_core_mine_t4", "aster_t3_power", "aster_t3_reclaimer", "aster_t3_radar", "aster_mass_storage_t3", "aster_energy_storage_t3", "aster_t3_sonar", "aster_t3_torpedo_defense", "aster_t3_shield", "aster_t1_aa", "aster_t2_aa", "aster_t2_missile_defense", "aster_t3_missile_defense", "aster_t3_sam", "aster_t3_point_defense", "aster_t3_lift_ship", "aster_t3_corvette", "aster_t4_frigate", "aster_t4_dreadnought", "aster_t4_assault_tank", "aster_t5_titan", "aster_t4_anti_ship", "aster_t3_nuke_defense", "aster_t4_nuke_silo", "aster_t4_submarine", "aster_t4_artillery",
            "aster_t2_fabricator", "aster_t3_fabricator",
        ]),
        mesh: "engineer", icon: Engineer,
        sounds: (moving: "tracks"),
    ),
    // The Reclaimer: the engineer's partner, a salvage hovercraft with one reclaim head on
    // an A-frame that works what it passes without stopping, over land, shore and shallows.
    // Every factory makes it, and like the engineer it builds its next tier onto itself,
    // in about 20 s (`upgrade_power` over the next tier's build time).
    // One mesh (`reclaimer`, `models::aster::reclaimers`) drawn bigger per tier: 7/6 at tech 2,
    // 4/3 at tech 3, so the head's pivot and emitter are the tech 1 numbers times that.
    (
        key: "aster_t1_mobile_reclaimer",
        name: "Gleaner",
        role: "Reclaimer", title: "Reclaimer",
        tech: 1,
        categories: ["Land"],
        health: 320,
        cost: (mass: 60, energy: 360, time: 240),
        radius: 4.6, height: 3.4,
        vision: 400,
        motion: (layer: Hover, size: 0, speed: 29, accel: 26, turn: 100),
        reclaimer: (power: 5, range: 550, charge: 0.8, mobile: true, heads: [
            (pivot: (-2.1, 0, 4.1), emitter: (0.23, 0, 4.1), turn: 90, pitch: (-70, 80)),
        ]),
        upgrades_to: "aster_t2_mobile_reclaimer",
        upgrade_power: 50,
        weapons: [],
        mesh: "reclaimer", icon: Salvage,
        sounds: (death: "blast_small", moving: "aster_hover"),
    ),
    (
        key: "aster_t2_mobile_reclaimer",
        name: "Gleaner II",
        role: "Field Reclaimer", title: "Reclaimer",
        tech: 2,
        categories: ["Land"],
