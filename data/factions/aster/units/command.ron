        cost: (mass: 240, energy: 1440, time: 1000),
        radius: 5.367, height: 3.967,
        vision: 550,
        motion: (layer: Hover, size: 0, speed: 28, accel: 26, turn: 100),
        reclaimer: (power: 20, range: 800, charge: 0.8, mobile: true, heads: [
            (pivot: (-2.45, 0, 4.783), emitter: (0.268, 0, 4.783), turn: 90, pitch: (-70, 80)),
        ]),
        upgrades_to: "aster_t3_mobile_reclaimer",
        upgrade_power: 160,
        weapons: [],
        mesh: "reclaimer", icon: Salvage,
        sounds: (death: "blast_small", moving: "aster_hover"),
    ),
    (
        key: "aster_t3_mobile_reclaimer",
        name: "Gleaner III",
        role: "Heavy Reclaimer", title: "Reclaimer",
        tech: 3,
        categories: ["Land"],
        health: 2400,
        cost: (mass: 840, energy: 6000, time: 3200),
        radius: 6.133, height: 4.533,
        vision: 700,
        motion: (layer: Hover, size: 1, speed: 27, accel: 26, turn: 100),
        reclaimer: (power: 70, range: 1100, charge: 0.8, mobile: true, heads: [
            (pivot: (-2.8, 0, 5.467), emitter: (0.307, 0, 5.467), turn: 90, pitch: (-70, 80)),
