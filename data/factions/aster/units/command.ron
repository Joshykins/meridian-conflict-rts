[
    // The commander's engineering suites are upgrades like any other: each tier is a
    // blueprint, `upgrades_to` names the next, and the next tier's `cost` is the price
    // of the refit. A mobile unit is refitted where it stands and stays the same unit;
    // the order sits in its queue, and stopping it (or cancelling it there) scraps it.
    (
        key: "aster_commander",
        name: "ARC Commander",
        role: "Armored Command Unit",
        tech: 1,
        categories: ["Land", "Commander", "Engineer", "DirectFire"],
        health: 11000, regen: 10,
        cost: (mass: 18000, energy: 5000000, time: 6000000),
        radius: 8.125, height: 18.75,
        vision: 420, radar: 0,
        motion: (layer: Amphibious, size: 1, speed: 17, accel: 17, turn: 150),
        economy: (mass_income: 1, energy_income: 20, mass_storage: 650, energy_storage: 4000),
        // `arm`: it builds with the arm on its torso, so it turns to face its work and
        // holds its fire while it builds. `emitter` is where the beam leaves the model.
        builder: (power: 10, range: 70, arm: (turn: 170, emitter: (6.0, 3.75, 12.125), pivot: (-0.375, 3.75, 12.25)), builds: [
            "aster_t1_land_factory", "aster_t1_extractor", "aster_t1_power", "aster_mass_storage",
            "aster_energy_storage", "aster_t1_point_defense", "aster_t1_radar", "aster_wall",
        ]),
        upgrades_to: "aster_commander_t2",
        weapons: [(
            name: "Meridian Rail Rifle",
            damage: 100, range: 330, reload: 1.0, speed: 520, trajectory: Direct,
