        // Airburst detonation, then scattered cracks as the fragments arrive.
        "aster_shatter_impact": (
            length: 1.25, peak: 0.82, room: 0.32,
            layers: [
                Burst(low: 520, high: 3600, attack: 0.0002, decay: 0.012, gain: 4.6),
