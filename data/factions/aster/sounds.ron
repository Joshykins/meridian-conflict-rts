        // An arc weapon discharging. It hits like a gun does (a snap, a body, real
        // bass); what makes it energy is the bolt, a buzzing stack of harmonics
        // falling fast and a little out of tune between the ears. Never a thin chirp.
        "aster_arc": (
            length: 1.0, peak: 0.62, room: 0.5,
            layers: [
                Burst(low: 800, high: 3000, attack: 0.0003, decay: 0.007, gain: 1.2),
                Burst(low: 150, high: 900, attack: 0.0008, decay: 0.04, gain: 1.8),
