                Tone(from: 260, to: 60, glide: 0.05, attack: 0.0008, decay: 0.08, gain: 1.2),
                Tone(from: 120, to: 32, glide: 0.18, attack: 0.0015, decay: 0.26, gain: 1.15),
                Tone(from: 58, to: 24, glide: 0.5, attack: 0.004, decay: 0.55, gain: 0.5),
                Drive(1.4),
                // The air slamming shut behind the slug: one fast tearing fall.
                Sweep(at: 0.002, from: 2400, to: 380, glide: 0.18, q: 0.9, attack: 0.002, decay: 0.07, gain: 0.3, pan: 0.2),
                Sweep(at: 0.005, from: 420, to: 60, glide: 0.8, q: 0.55, attack: 0.02, decay: 0.42, gain: 0.5),
                // The report coming back, twice, further and duller each time.
                Burst(at: 0.31, low: 200, high: 1000, attack: 0.0005, decay: 0.012, gain: 6, pan: 0.4),
                Burst(at: 0.312, low: 60, high: 320, attack: 0.003, decay: 0.13, gain: 5, pan: 0.4),
                Tone(at: 0.31, from: 110, to: 38, glide: 0.14, attack: 0.003, decay: 0.22, gain: 0.3, pan: 0.4),
                Sweep(at: 0.31, from: 260, to: 60, glide: 0.8, q: 0.5, attack: 0.04, decay: 0.4, gain: 0.26, pan: 0.4),
                Burst(at: 0.78, low: 120, high: 600, attack: 0.0008, decay: 0.02, gain: 2.4, pan: -0.45),
                Tone(at: 0.78, from: 80, to: 30, glide: 0.22, attack: 0.005, decay: 0.32, gain: 0.16, pan: -0.45),
                Sweep(at: 0.78, from: 160, to: 45, glide: 1.0, q: 0.5, attack: 0.08, decay: 0.55, gain: 0.16, pan: -0.45),
            ],
        ),
        // Its hit: one shot every couple of seconds, so it can be the biggest punch there is.
        "aster_rail_impact": (like: "shell_on_armour", size: 1.9, peak: 0.9),
        "aster_arc_siege": (like: "aster_arc", size: 2.6, peak: 0.8),
        // Capacitors filling before a heavy discharge: rises, and stops as the shot goes.
        "aster_arc_charge": (
            length: 1.0, peak: 0.35, room: 0.4,
            layers: [
                Stack(from: 140, to: 620, glide: 0.7, attack: 0.62, decay: 0.05, gain: 1.0, detune: 1.01, width: 0.3,
