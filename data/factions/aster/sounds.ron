            ],
        ),
        // Small arms: the scout's carbine.
        "aster_pulse": (like: "aster_arc", size: 0.6, peak: 0.4),
        // Batteries and heavy projectors: the Bastion, tech 2 and 3 guns.
        "aster_arc_heavy": (like: "aster_arc", size: 1.8, peak: 0.7),
        // The Paladin's hit: the same punch as a shell, held down so a pair of
        // projectors does not drown the fire report.
        "aster_arc_impact": (like: "shell_on_armour", size: 0.7, peak: 0.32),
        // The commander's rail cannon. Not an energy weapon: a slug driven past the
        // speed of sound, so it is the loudest gun on the field. A supersonic crack
        // with nothing above it, the slam of the rails taking the load (a short
        // struck-metal clank, not a ring), a chest-deep thump, the air tearing shut
        // behind the slug, then the report rolling back off the hills. No bolt.
        "aster_rail_cannon": (
            length: 3.2, peak: 0.9, room: 0.5,
            layers: [
                Burst(low: 700, high: 2500, attack: 0.0002, decay: 0.005, gain: 20),
                Burst(low: 180, high: 1100, attack: 0.0004, decay: 0.028, gain: 15),
                Burst(at: 0.002, low: 55, high: 300, attack: 0.002, decay: 0.17, gain: 11),
