                Burst(at: 0.53, low: 570, high: 2000, attack: 0.0002, decay: 0.0062, gain: 0.204, pan: 0.45),
                Burst(at: 0.62, low: 540, high: 1900, attack: 0.0002, decay: 0.0064, gain: 0.171, pan: 0.55),
                Burst(at: 0.73, low: 510, high: 1800, attack: 0.0002, decay: 0.0066, gain: 0.143, pan: 0.5),
                Burst(at: 0.86, low: 480, high: 1600, attack: 0.0002, decay: 0.0068, gain: 0.116, pan: 0.58),
                Burst(at: 1.02, low: 450, high: 1500, attack: 0.0002, decay: 0.007, gain: 0.099, pan: 0.55),
