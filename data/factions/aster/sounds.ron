                Burst(at: 0.225, low: 650, high: 3500, attack: 0.0003, decay: 0.009, gain: 2.3, pan: 0.35),
                Stack(at: 0.225, from: 360, to: 120, glide: 0.05, attack: 0.001, decay: 0.1, gain: 0.65, detune: 1.01, width: 0.15, partials: [(1, 1), (1.8, 0.4)]),
