        // A Culverin shell landing: the heaviest shell there is.
        "culverin_hit": (like: "shell_heavy", size: 1.5, peak: 0.9),
        // A Culverin shell landing, heard from anywhere on the map: the titan's far strike,
        // a little higher.
        "culverin_far": (like: "titan_bore_far", size: 0.9, peak: 0.8),
        // A Trebuchet ground stake striking home, once a stake as it plants: the spike's
