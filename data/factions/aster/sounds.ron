// Aster's own sounds. Its conventional guns, impacts, deaths and running gear
// come from the general library (`data/sounds`); what is Aster's alone is the
// rail guns, the flak burst and the hover drive.
(
    sounds: {
        "aster_rotor": (
            length: 2, peak: 0.36, room: 0, looped: true,
            layers: [
                Drone(freq: 38, gain: 0.6, wobble: 14, depth: 0.85),
                Drone(freq: 76, gain: 0.24, wobble: 14, depth: 0.8),
                Rumble(freq: 340, q: 0.8, gain: 2.8, wobble: 14, depth: 0.9),
            ],
        ),
        "aster_heavy_jet": (like: "aster_jet", size: 1.6, peak: 0.36),
        // Massive spacecraft reactor: only sustained low machinery tones. No
        // broadband noise, hiss or weather-like rumble. Slow beating gives weight.
        "aster_lift_ship": (
            length: 12, peak: 0.36, room: 0, looped: true,
            layers: [
                Drone(freq: 30, gain: 0.55, wobble: 0.08333, depth: 0.05, pan: -0.15),
                Drone(freq: 30.1667, gain: 0.16, wobble: 0.08333, depth: 0.04, pan: 0.15),
                Drone(freq: 60, gain: 0.28, wobble: 0.08333, depth: 0.06),
                Drone(freq: 90, gain: 0.12, wobble: 0.1667, depth: 0.05, pan: -0.1),
                Drone(freq: 120, gain: 0.055, wobble: 0.08333, depth: 0.04, pan: 0.1),
                Drone(freq: 151, gain: 0.02, wobble: 0.1667, depth: 0.06),
                Drive(1.15),
            ],
        ),
        "aster_assault_engine": (
            length: 2, peak: 0.38, room: 0, looped: true,
            layers: [
                Drone(freq: 48, gain: 0.9, wobble: 4, depth: 0.25),
                Drone(freq: 96, gain: 0.5, wobble: 6, depth: 0.2),
                Rumble(freq: 480, q: 1.2, gain: 3.8, wobble: 2, depth: 0.3),
                Rumble(freq: 1800, q: 0.7, gain: 1.8, wobble: 3, depth: 0.2),
            ],
        ),
        // A rotary gun's stream. The weapon draws each 0.2 s shot as eight rounds
        // (`rounds` in command.ron), so this is eight light reports 25 ms apart:
        // back to back, shots join into one steady rattle. Keep it light; a
        // commander fires it all game.
        "aster_minigun": (
            length: 0.26, peak: 0.45, room: 0.1,
            layers: [
                Burst(low: 900, high: 3600, attack: 0.0003, decay: 0.0045, gain: 2.6),
                Burst(low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 2.2),
                Tone(from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.025, low: 1000, high: 3200, attack: 0.0003, decay: 0.0045, gain: 2.3),
                Burst(at: 0.025, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 2.0),
                Tone(at: 0.025, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.050, low: 900, high: 3600, attack: 0.0003, decay: 0.0045, gain: 2.5),
                Burst(at: 0.050, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 2.1),
                Tone(at: 0.050, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.075, low: 1000, high: 3200, attack: 0.0003, decay: 0.0045, gain: 2.2),
                Burst(at: 0.075, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 1.9),
                Tone(at: 0.075, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.100, low: 900, high: 3600, attack: 0.0003, decay: 0.0045, gain: 2.6),
                Burst(at: 0.100, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 2.2),
                Tone(at: 0.100, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.125, low: 1000, high: 3200, attack: 0.0003, decay: 0.0045, gain: 2.3),
                Burst(at: 0.125, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 2.0),
                Tone(at: 0.125, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.150, low: 900, high: 3600, attack: 0.0003, decay: 0.0045, gain: 2.4),
                Burst(at: 0.150, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 2.1),
                Tone(at: 0.150, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Burst(at: 0.175, low: 1000, high: 3200, attack: 0.0003, decay: 0.0045, gain: 2.2),
                Burst(at: 0.175, low: 150, high: 850, attack: 0.0006, decay: 0.011, gain: 1.9),
                Tone(at: 0.175, from: 190, to: 95, glide: 0.012, attack: 0.0008, decay: 0.012, gain: 0.22),
                Drive(1.15),
            ],
        ),
        // The Thunderhead's minigun: a hundred reports a second tearing into one "brrrt",
        // a growl under them that sags as the barrels load up, a thump of recoil at the front.
        // Each plays a little past the next shot so the stream never gaps.
        "aster_avenger": (
            length: 0.28, peak: 0.94, room: 0.1,
            layers: [
                Burst(at: 0.000, low: 110, high: 2600, attack: 0.0004, decay: 0.006, gain: 7),
                Burst(at: 0.010, low: 90, high: 3000, attack: 0.0004, decay: 0.006, gain: 5.6),
                Burst(at: 0.020, low: 110, high: 2600, attack: 0.0004, decay: 0.006, gain: 6.2),
                Burst(at: 0.030, low: 90, high: 3000, attack: 0.0004, decay: 0.006, gain: 5.6),
                Burst(at: 0.040, low: 110, high: 2600, attack: 0.0004, decay: 0.006, gain: 6.2),
                Burst(at: 0.050, low: 90, high: 3000, attack: 0.0004, decay: 0.006, gain: 5.6),
                Burst(at: 0.060, low: 110, high: 2600, attack: 0.0004, decay: 0.006, gain: 6.2),
                Burst(at: 0.070, low: 90, high: 3000, attack: 0.0004, decay: 0.006, gain: 5.6),
                Burst(at: 0.080, low: 110, high: 2600, attack: 0.0004, decay: 0.006, gain: 6.2),
                Burst(at: 0.090, low: 90, high: 3000, attack: 0.0004, decay: 0.006, gain: 5.6),
                Fm(from: 104, to: 86, glide: 0.1, ratio: 0.5, index: 2.4, fade: 0.1, attack: 0.002, decay: 0.07, gain: 1.3),
                Tone(from: 90, to: 48, glide: 0.08, attack: 0.001, decay: 0.05, gain: 1.1),
                Drive(1.6),
                Burst(at: 0.1, low: 200, high: 1400, attack: 0.001, decay: 0.012, gain: 1.4),
            ],
        ),
        "aster_avenger_impact": (
            length: 0.48, peak: 0.72, room: 0.18,
            layers: [
                Burst(low: 600, high: 3500, attack: 0.0004, decay: 0.015, gain: 5),
                Burst(low: 90, high: 650, attack: 0.001, decay: 0.06, gain: 6),
                Tone(from: 130, to: 42, glide: 0.08, attack: 0.001, decay: 0.12, gain: 0.9),
                Burst(at: 0.025, low: 250, high: 1800, attack: 0.004, decay: 0.09, gain: 1.1),
            ],
        ),
        // A flak shell bursting high up: a deep, round thud you feel more than
        // hear, a dull krump with only a soft edge on top (no crack, no crackle,
        // no fragment patter), then the report coming back off the ground as a
        // low, smooth rumble. Far off it is all thud.
        "flak_burst": (
            length: 1.8, peak: 0.8, room: 0.5,
            layers: [
                // The edge: just enough to place it, soft and low.
                Burst(low: 300, high: 1100, attack: 0.0006, decay: 0.012, gain: 4),
                // The thud: dense low body and a falling sub under it.
                Burst(at: 0.001, low: 40, high: 260, attack: 0.003, decay: 0.14, gain: 14),
                // The punch: the thud's upper body, what small speakers carry.
                Burst(at: 0.001, low: 110, high: 420, attack: 0.002, decay: 0.08, gain: 16),
                Tone(from: 82, to: 40, glide: 0.1, attack: 0.002, decay: 0.16, gain: 0.8),
                Tone(from: 52, to: 28, glide: 0.25, attack: 0.004, decay: 0.3, gain: 0.5),
                Drive(1.1),
                // The report rolling back, smooth and low.
                Sweep(at: 0.02, from: 420, to: 70, glide: 0.8, q: 0.5, attack: 0.03, decay: 0.5, gain: 0.35),
                // The slapback off the ground below, duller and to one side.
                Burst(at: 0.38, low: 45, high: 240, attack: 0.006, decay: 0.14, gain: 5, pan: 0.35),
                Tone(at: 0.38, from: 60, to: 34, glide: 0.2, attack: 0.006, decay: 0.25, gain: 0.35, pan: 0.35),
                Sweep(at: 0.4, from: 220, to: 50, glide: 0.8, q: 0.5, attack: 0.05, decay: 0.5, gain: 0.18, pan: 0.35),
            ],
        ),
        // The commander's Breach Cannon: a heavy shell gun fired close, one shot
        // every two seconds, so each one can be the loudest thing on the field.
        // A hard crack and a wide bark over a punch you feel, the forearm kicking
        // under it, the report slapping back off the ground, and the autoloader
        // spitting the case and ramming the next shell before the gun is ready.
        "aster_breach": (
            length: 2.3, peak: 0.84, room: 0.6,
            layers: [
                // The charge: crack, bark, then the punch in the bass.
                Burst(low: 700, high: 2500, attack: 0.0002, decay: 0.008, gain: 15),
                Burst(low: 180, high: 1200, attack: 0.0005, decay: 0.04, gain: 14),
                Burst(at: 0.002, low: 60, high: 380, attack: 0.002, decay: 0.12, gain: 9),
                Tone(from: 260, to: 72, glide: 0.05, attack: 0.001, decay: 0.07, gain: 1.2),
                Tone(from: 130, to: 42, glide: 0.1, attack: 0.0015, decay: 0.16, gain: 1.1),
                Tone(from: 72, to: 28, glide: 0.22, attack: 0.003, decay: 0.3, gain: 0.75),
                // The forearm taking the recoil: a short metal kick, gone before it can ring.
                Fm(from: 340, to: 150, glide: 0.06, ratio: 1.41, index: 1.8, fade: 0.04, attack: 0.001, decay: 0.05, gain: 0.45),
                Drive(1.35),
                // The report rolling away, low.
                Sweep(at: 0.005, from: 600, to: 110, glide: 0.5, q: 0.55, attack: 0.015, decay: 0.26, gain: 0.45),
                // The shell going away: heavier and slower than a tank's.
                Tone(at: 0.035, from: 1250, to: 420, glide: 0.7, attack: 0.05, decay: 0.24, gain: 0.07, pan: 0.3),
                Tone(at: 0.035, from: 1262, to: 425, glide: 0.7, attack: 0.05, decay: 0.21, gain: 0.05, pan: 0.2),
                Sweep(at: 0.035, from: 2000, to: 600, glide: 0.6, q: 3, attack: 0.03, decay: 0.2, gain: 0.06, pan: 0.3),
                // The report slapping back off the ground.
                Burst(at: 0.2, low: 160, high: 800, attack: 0.0006, decay: 0.02, gain: 3.5, pan: -0.35),
                Tone(at: 0.2, from: 110, to: 40, glide: 0.12, attack: 0.003, decay: 0.18, gain: 0.22, pan: -0.35),
                Sweep(at: 0.2, from: 260, to: 70, glide: 0.6, q: 0.5, attack: 0.03, decay: 0.3, gain: 0.18, pan: -0.35),
                // The autoloader: the case kicked out, then the next shell rammed home.
                Burst(at: 0.42, low: 900, high: 2400, attack: 0.0003, decay: 0.006, gain: 1.2, pan: -0.15),
                Fm(at: 0.42, from: 620, to: 540, glide: 0.02, ratio: 2.76, index: 1.2, fade: 0.02, attack: 0.001, decay: 0.03, gain: 0.08, pan: -0.15),
                Burst(at: 0.64, low: 200, high: 900, attack: 0.0005, decay: 0.015, gain: 1.8, pan: -0.15),
                Tone(at: 0.64, from: 180, to: 90, glide: 0.03, attack: 0.001, decay: 0.05, gain: 0.2, pan: -0.15),
            ],
        ),
        // A heavy flak gun: a deep, heavy thump with only a dull edge on top,
        // the report booming off short and low so shots a second apart stay
        // separate, then the breech clunking open and the next round rammed. No
        // crack, no shell whine, no falling tone: it is a gun working, not a pew.
        "flak_gun": (
            length: 1.1, peak: 0.52, room: 0.4,
            layers: [
                Burst(low: 250, high: 1000, attack: 0.0005, decay: 0.012, gain: 6),
                Burst(at: 0.001, low: 40, high: 240, attack: 0.002, decay: 0.11, gain: 13),
                Burst(at: 0.001, low: 110, high: 420, attack: 0.0015, decay: 0.06, gain: 16),
                Tone(from: 110, to: 48, glide: 0.06, attack: 0.001, decay: 0.12, gain: 0.85),
                Tone(from: 60, to: 32, glide: 0.18, attack: 0.003, decay: 0.2, gain: 0.45),
                Drive(1.15),
                // The report, short and low.
                Sweep(at: 0.005, from: 380, to: 80, glide: 0.4, q: 0.5, attack: 0.01, decay: 0.22, gain: 0.35),
                // The breech: case out with a dull clunk, the next round rammed home.
                Burst(at: 0.26, low: 200, high: 800, attack: 0.0005, decay: 0.008, gain: 0.8, pan: -0.15),
                Burst(at: 0.4, low: 90, high: 450, attack: 0.001, decay: 0.02, gain: 1.8, pan: -0.15),
                Tone(at: 0.4, from: 120, to: 70, glide: 0.03, attack: 0.001, decay: 0.05, gain: 0.15, pan: -0.15),
            ],
        ),
        // Incendiary strike: a blast first (crack, low-mid boom), then the fire
        // holding as a low tone. Noise is only the opening. The roar is not a hiss.
        "fire_bomb": (
            length: 3.6, peak: 0.55, room: 0.55,
            layers: [
                Burst(low: 480, high: 2200, attack: 0.0003, decay: 0.01, gain: 7.5),
                Burst(low: 100, high: 560, attack: 0.0007, decay: 0.055, gain: 10),
                Burst(at: 0.002, low: 55, high: 280, attack: 0.002, decay: 0.11, gain: 7),
                Tone(from: 190, to: 54, glide: 0.08, attack: 0.001, decay: 0.13, gain: 1.45),
                Tone(from: 102, to: 34, glide: 0.2, attack: 0.002, decay: 0.28, gain: 1.15),
                Drive(1.15),
                Stack(at: 0.06, from: 92, to: 42, glide: 1.35, attack: 0.04, decay: 1.55, gain: 0.55, detune: 1.008, width: 0.18,
                    partials: [(1, 1), (1.5, 0.36), (2.15, 0.16)]),
                Tone(at: 0.1, from: 56, to: 30, glide: 1.4, attack: 0.05, decay: 1.6, gain: 0.5),
                Sweep(at: 0.04, from: 340, to: 70, glide: 1.1, q: 0.55, attack: 0.06, decay: 1.15, gain: 0.14),
            ],
        ),

        // Small arms: the scout's carbine, a light gun's crack cut short.
        "aster_carbine": (like: "cannon_light", size: 0.45, peak: 0.26),
        // The Bulwark's pair of rails: the commander's rail cannon, a little lighter,
        // still loud: nothing in its class hits this fast.
        "aster_rail_tank": (like: "aster_rail_cannon", size: 0.85, peak: 0.86),
        // The Resolute's rail turrets.
        "aster_rail_heavy": (like: "aster_rail_cannon", size: 1.2, peak: 0.94),
        // A rail slug arriving: harder and sharper than a shell, a hit you feel.
        "aster_rail_hit": (like: "shell_on_armour", size: 1.45, peak: 0.76),
        // The Citadel's rail cannon: the family's recipe, far bigger than the Resolute turrets',
        // still short of the capital rails (data/sounds/heavy_rail.ron).
        "citadel_rail_fire": (like: "aster_rail_cannon", size: 1.5, peak: 0.9),
        "citadel_rail_hit": (like: "shell_on_armour", size: 1.9, peak: 0.8),
        // Its spent cartridge hitting the ground: the Behemoth's casing, far smaller.
        "citadel_casing_land": (like: "titan_casing_land", size: 0.5, peak: 0.55),
        // Its charge, 1.2 s before each shot: the Paladin's charge on a gun many times its
        // size, and plainly electrical. A contactor slams a capacitor bank onto the rails;
        // the bank buzzes (a rough, gritty growl, the sound of heavy current, never a clean
        // note) and climbs as it fills while the transformer growls under it; the air along
        // the rails fizzes and sizzles, sparks and then arcs jumping the slot closer and
        // closer, all of it at its loudest the instant the gun fires. No layer here rings
        // on a pitch after it is struck: a harmonic note that decays reads as a plucked
        // string. Kept in the 150 Hz to 3 kHz band, heard on any speaker and over a battle.
        "citadel_rail_charge": (
            length: 1.5, peak: 0.8, room: 0.3,
            layers: [
                // The contactor closing: a hard clack, a knock, and its relay chattering after.
                Burst(low: 300, high: 2200, attack: 0.0005, decay: 0.009, gain: 3.2, seed: 21),
                Tone(from: 150, to: 80, glide: 0.04, attack: 0.001, decay: 0.05, gain: 0.35),
                Burst(at: 0.028, low: 500, high: 2600, attack: 0.0003, decay: 0.004, gain: 1.2, pan: 0.15, seed: 22),
                Burst(at: 0.047, low: 500, high: 2600, attack: 0.0003, decay: 0.003, gain: 0.7, pan: -0.1, seed: 23),
                // The bank's buzz: a rough growl up an octave as it fills, held rough the whole
                // way (a long `fade`), and a gritty sizzle of current over it.
                Fm(at: 0.03, from: 96, to: 196, glide: 1.17, ratio: 0.5, index: 2.8, fade: 8.0, attack: 1.12, decay: 0.07, gain: 0.55),
                Fm(at: 0.03, from: 96, to: 150, glide: 1.17, ratio: 0.5, index: 2.2, fade: 8.0, attack: 0.12, decay: 0.4, gain: 0.4),
                // The transformer growl under it, rough the whole way up.
                Fm(at: 0.02, from: 50, to: 112, glide: 1.18, ratio: 0.5, index: 2.4, fade: 4.0, attack: 1.16, decay: 0.07, gain: 0.7),
                Drive(1.6),
                // The air along the rails ionising: a fizz whose band climbs with the charge,
                // and the current's sizzle, a fast ragged buzz of noise.
                Sweep(at: 0.15, from: 700, to: 2800, glide: 1.0, q: 1.3, attack: 0.98, decay: 0.05, gain: 0.4, seed: 71),
                Roll(at: 0.05, from: 900, to: 2200, glide: 1.1, attack: 1.1, decay: 0.06, gain: 0.3, swell: 110, depth: 1.0, pan: -0.1, seed: 72),
                // Crackle crawling over the rails, thickening to a roar of sparks.
                Roll(at: 0.3, from: 1200, to: 3200, glide: 0.88, attack: 0.88, decay: 0.06, gain: 0.26, swell: 32, depth: 0.9, pan: 0.2, seed: 341),
                Roll(at: 0.55, from: 1400, to: 3400, glide: 0.63, attack: 0.63, decay: 0.06, gain: 0.2, swell: 41, depth: 0.9, pan: -0.25, seed: 342),
                // Sparks jumping the slot, sooner and harder as it fills.
                Burst(at: 0.16, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.0, pan: -0.3, seed: 101),
                Burst(at: 0.33, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.1, pan: 0.25, seed: 102),
                Burst(at: 0.47, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.3, pan: -0.15, seed: 103),
                Burst(at: 0.59, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.4, pan: 0.35, seed: 104),
                Burst(at: 0.69, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.6, pan: -0.35, seed: 105),
                Burst(at: 0.77, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.7, pan: 0.1, seed: 106),
                Burst(at: 0.84, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.8, pan: 0.3, seed: 107),
                Burst(at: 0.9, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.0, pan: -0.25, seed: 108),
                Burst(at: 0.95, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.1, pan: 0.15, seed: 109),
                Burst(at: 0.995, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.3, pan: -0.1, seed: 110),
                Burst(at: 1.035, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.4, pan: 0.2, seed: 111),
                Burst(at: 1.07, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.6, pan: -0.2, seed: 112),
                Burst(at: 1.1, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.7, pan: 0.4, seed: 113),
                Burst(at: 1.125, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 2.8, pan: -0.4, seed: 114),
                Burst(at: 1.147, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 3.0, pan: 0.05, seed: 115),
                Burst(at: 1.166, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 3.1, pan: 0.3, seed: 116),
                Burst(at: 1.182, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 3.3, pan: -0.3, seed: 117),
                Burst(at: 1.196, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 3.4, pan: 0.1, seed: 118),
                // Arcs across the slot: a crack with a short sizzle after, heavier each time.
                Burst(at: 0.55, low: 300, high: 2000, attack: 0.0005, decay: 0.014, gain: 1.6, pan: -0.35, seed: 131),
                Roll(at: 0.55, from: 2400, to: 500, glide: 0.07, attack: 0.001, decay: 0.056, gain: 0.5, swell: 90, depth: 1.0, seed: 151),
                Burst(at: 0.86, low: 280, high: 2100, attack: 0.0005, decay: 0.018, gain: 2.4, pan: 0.4, seed: 132),
                Roll(at: 0.86, from: 2400, to: 500, glide: 0.09, attack: 0.001, decay: 0.072, gain: 0.5, swell: 90, depth: 1.0, seed: 152),
                Burst(at: 1.04, low: 260, high: 2200, attack: 0.0005, decay: 0.022, gain: 3.0, pan: -0.2, seed: 133),
                Roll(at: 1.04, from: 2400, to: 500, glide: 0.10, attack: 0.001, decay: 0.080, gain: 0.5, swell: 90, depth: 1.0, seed: 153),
                Burst(at: 1.14, low: 240, high: 2200, attack: 0.0005, decay: 0.028, gain: 3.6, pan: 0.15, seed: 134),
                Roll(at: 1.14, from: 2400, to: 500, glide: 0.12, attack: 0.001, decay: 0.096, gain: 0.5, swell: 90, depth: 1.0, seed: 154),
            ],
        ),
        // The Resolute's turret rails, 0.9 s before each shot. Four of these guns charge
        // every 3 s, often together, so this is short and clean, not the Citadel's
        // grinding buzz (that recipe sped up was a wall of hash with a tail over the
        // shot): a clack as the bank closes, a charged hum that swells and lifts, the air
        // hissing up along the rails with a few sparks, and one snap as it tops out. All
        // of it has let go by the shot, so the rail's crack lands on silence.
        "resolute_turret_charge": (
            length: 1.1, peak: 0.8, room: 0.3,
            layers: [
                // The bank closing: a firm clack and a knock under it.
                Burst(low: 400, high: 2400, attack: 0.0005, decay: 0.007, gain: 1.6, seed: 61),
                Tone(from: 170, to: 95, glide: 0.05, attack: 0.001, decay: 0.06, gain: 0.3),
                // The charge: a hum with a little grit in it (a low `index`: rough, not a
                // grinder), swelling and lifting a fifth as the bank fills, cut at the shot.
                Fm(at: 0.02, from: 118, to: 176, glide: 0.86, ratio: 0.5, index: 1.5, fade: 6.0, attack: 0.84, decay: 0.035, gain: 0.55),
                Fm(at: 0.02, from: 59, to: 88, glide: 0.86, ratio: 0.5, index: 1.2, fade: 6.0, attack: 0.84, decay: 0.035, gain: 0.35),
                Drive(1.4),
                // The air along the rails: a hiss rising with the charge, and a sizzle under
                // it that thickens near the top.
                Sweep(at: 0.1, from: 900, to: 2600, glide: 0.76, q: 1.4, attack: 0.76, decay: 0.035, gain: 0.5, seed: 62),
                Roll(at: 0.45, from: 1000, to: 2400, glide: 0.41, attack: 0.41, decay: 0.035, gain: 0.32, swell: 60, depth: 0.9, pan: 0.15, seed: 63),
                // A few sparks, closer together towards the top.
                Burst(at: 0.36, low: 900, high: 2800, attack: 0.0002, decay: 0.003, gain: 0.7, pan: -0.3, seed: 64),
                Burst(at: 0.56, low: 900, high: 2800, attack: 0.0002, decay: 0.003, gain: 0.9, pan: 0.3, seed: 65),
                Burst(at: 0.69, low: 900, high: 2800, attack: 0.0002, decay: 0.003, gain: 1.1, pan: -0.15, seed: 66),
                Burst(at: 0.78, low: 900, high: 2800, attack: 0.0002, decay: 0.003, gain: 1.3, pan: 0.2, seed: 67),
                // Topped out: one arc across the slot, a crack with a short sizzle.
                Burst(at: 0.85, low: 300, high: 2200, attack: 0.0005, decay: 0.012, gain: 1.9, seed: 68),
                Roll(at: 0.85, from: 2400, to: 600, glide: 0.06, attack: 0.001, decay: 0.045, gain: 0.45, swell: 90, depth: 1.0, seed: 69),
            ],
        ),
        // The commander's rail cannon, 0.8 s before each shot: the same charge on the arm's
        // small gun, quicker and higher again, and quieter, since it is heard all game.
        "commander_rail_charge": (like: "citadel_rail_charge", size: 0.68, length: 1.4, peak: 0.24),
        // The rail gun: a gun first. A slug driven many times past the speed of sound
        // makes a blast as big as any cannon's, so the body is a heavy gun's: a hard
        // wide crack, a chest-deep boom that falls away, the air slamming shut behind
        // the slug. The rail is heard under it, not over it: the capacitors dumping (a
        // low electrical thunk leading the blast by a hair), a short dry arc at the
        // muzzle, and the rails taking the load (a low struck-metal clank). No high
        // whistle or zip: that made it sound light. The slug is heard crackling away
        // downrange, and the report rolls back off the hills. The whole rail family is
        // this recipe scaled (`like`).
        "aster_rail_cannon": (
            length: 3.4, peak: 0.95, room: 0.55,
            layers: [
                // The capacitors dumping.
                Fm(from: 78, to: 46, glide: 0.05, ratio: 0.5, index: 3.2, fade: 0.03, attack: 0.0005, decay: 0.06, gain: 0.6),
                // The blast: crack, bark, boom.
                Burst(low: 1500, high: 5000, attack: 0.0001, decay: 0.003, gain: 4),
                Burst(low: 450, high: 2000, attack: 0.0002, decay: 0.012, gain: 24),
                Burst(low: 120, high: 700, attack: 0.0006, decay: 0.06, gain: 20),
                Burst(at: 0.002, low: 45, high: 260, attack: 0.002, decay: 0.22, gain: 15),
                // The rails taking the load, low and short.
                Fm(from: 170, to: 140, glide: 0.2, ratio: 1.41, index: 2.2, fade: 0.05, attack: 0.0006, decay: 0.08, gain: 0.32),
                Tone(from: 210, to: 52, glide: 0.07, attack: 0.0008, decay: 0.11, gain: 1.4),
                Tone(from: 105, to: 30, glide: 0.2, attack: 0.0015, decay: 0.32, gain: 1.35),
                Tone(from: 54, to: 22, glide: 0.55, attack: 0.004, decay: 0.65, gain: 0.7),
                Drive(1.55),
                // The arc at the muzzle: one dry snap, well down in the mix.
                Burst(at: 0.001, low: 2500, high: 6500, attack: 0.0001, decay: 0.0025, gain: 2),
                // The air slamming shut behind the slug: a low tearing rush, not a whistle.
                Sweep(at: 0.003, from: 1800, to: 420, glide: 0.12, q: 0.8, attack: 0.002, decay: 0.07, gain: 0.26, pan: 0.2),
                Sweep(at: 0.005, from: 380, to: 50, glide: 0.9, q: 0.55, attack: 0.02, decay: 0.5, gain: 0.62),
                // The report coming back, twice, further and duller each time.
                Burst(at: 0.31, low: 180, high: 900, attack: 0.0005, decay: 0.014, gain: 6.5, pan: 0.4),
                Burst(at: 0.312, low: 55, high: 300, attack: 0.003, decay: 0.15, gain: 5.5, pan: 0.4),
                Tone(at: 0.31, from: 100, to: 34, glide: 0.16, attack: 0.003, decay: 0.26, gain: 0.34, pan: 0.4),
                Sweep(at: 0.31, from: 240, to: 55, glide: 0.8, q: 0.5, attack: 0.04, decay: 0.42, gain: 0.28, pan: 0.4),
                Burst(at: 0.78, low: 110, high: 520, attack: 0.0008, decay: 0.022, gain: 2.6, pan: -0.45),
                Tone(at: 0.78, from: 75, to: 28, glide: 0.24, attack: 0.005, decay: 0.34, gain: 0.18, pan: -0.45),
                Sweep(at: 0.78, from: 150, to: 42, glide: 1.0, q: 0.5, attack: 0.08, decay: 0.58, gain: 0.17, pan: -0.45),
                // The slug tearing off downrange, faster than its own sound: a dry crackle
                // that thins out, dulls and drifts away to one side over a second, on a
                // fast-fluttering tear that sinks with it.
                Roll(at: 0.025, from: 3200, to: 600, glide: 1.4, attack: 0.03, decay: 1.0, gain: 0.198, swell: 38, depth: 0.95, pan: 0.3, seed: 361),
                Burst(at: 0.03, low: 1100, high: 4200, attack: 0.0002, decay: 0.003, gain: 0.968, pan: 0.05),
                Burst(at: 0.043, low: 1070, high: 4100, attack: 0.0002, decay: 0.0032, gain: 0.918, pan: -0.1),
                Burst(at: 0.051, low: 1040, high: 3900, attack: 0.0002, decay: 0.0034, gain: 0.864, pan: 0.15),
