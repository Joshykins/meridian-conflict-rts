(
    key: "Regency",
    // Replays, saves and network matches store the key.
    name: "The Regency",
    abbreviation: "Regency",
    description: "An old empire of rival houses that has waited for a king since its first one died, and rules in his place. Its technology was learned from Precursor machines long before humanity found any. Ultra-mechanical war machines of dark plate over bronze workings, lit red; plasma bound by gravity, star cores, nanites that build, and shields.",
    // Their own structures and engineer, but no fighting units yet: their factories turn out
    // the stand-in's until they have some. Structures are always their own (mc-data checks).
    stand_in: Some("Aster"),
    commander: "regency_commander",
    plating_color: (0.03, 0.026, 0.026),
    accent_color: (0.012, 0.01, 0.01),
    highlight_color: (1.0, 0.05, 0.07),
    shield_color: (0.95, 0.24, 0.12),
    // Nanites build for them: a builder pours a stream of them onto its work, and a black
    // swarm holding the building's shape condenses into plate, violet light running through
    // it, instead of it being printed under a beam.
    construction: Nanite,
    // Their torpedoes are driven by plasma: a glassy line of steam boiling up over a red
    // glow in the water, where ARC's leave a white seam of air.
    torpedo_look: Plasma,
    // Their structures are lit from below at night: low red embers round the foot of the
    // plating, not floodlights over the yard.
    structure_lamps: Ember,
    // Their shields are a veil in pinch fusion's prism, the light of their star cores and the
    // Sunspear: white-hot glass with soft rose, magenta and peach running over it like a
    // curtain, on a lattice of red-tinged triangles. Their generators' cores, and the
    // Exarch's back projector, burn the same prism.
    shield_look: Prism,
    // Their own voices (data/factions/regency/sounds.ron): heavy machines, bronze struck and
    // rings spinning up, not ARC's servos and chimes.
    sounds: (
        select: {
            Commander: "regency_select_commander",
            Engineer: "regency_select_engineer",
            Bot: "regency_select_bot",
            Scout: "regency_select_scout",
            Factory: "regency_select_factory",
            Extractor: "regency_select_extractor",
            Power: "regency_select_power",
            Storage: "regency_select_storage",
            Defense: "regency_select_defense",
            AntiAir: "regency_select_anti_air",
            Intel: "regency_select_intel",
            Wall: "regency_select_wall",
        },
        build: (beam: "regency_nanite", start: "regency_nanite_start", end: "regency_nanite_end"),
    ),
)
