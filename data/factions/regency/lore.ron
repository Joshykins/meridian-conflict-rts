// In-world lore for the Regency's own units and the weapons they carry. One short sentence
// each; weapon names must match the unit file's `name:` exactly.
{
    "regency_commander": (
        lore: "A walking command machine that comes ashore alone and puts up a stronghold with the nanite emitter in its taloned hand; ARC crews call it the Exarch.",
        weapons: {
            "Plasmeric Repeater": "The cannon that is its right forearm fires slugs of plasma held tight by gravity; they hit like shells and glaze the ground they miss.",
        },
    ),
    "regency_t4_scorpion": (
        lore: "A walking siege engine in the shape of a scorpion; ARC crews learned to fear the white lance that tears trenches across the field before they learned its name.",
        weapons: {
            "Excavation Lance": "A sustained white-rose fusion lance that sweeps the field, gouges the ground and leaves molten glass across its path.",
            "Left Gravitic Salvo": "Six charged plasma missiles launch straight, spiral above the ground and converge across the target area.",
            "Right Gravitic Salvo": "A matching six-shot salvo interleaves with the left claw to cover the target area with twelve impacts.",
        },
    ),
    "regency_t3_mobile_aa": (
        lore: "A fusion gun lifted off the Sunspear's keep and raised to the sky, carried to wherever warships hang over the field.",
        weapons: {
            "Pinch-fusion Cannon": "Plasma squeezed until it fuses and pinched out in one fast shot up at a hull in the upper air, where it opens like a small sun.",
        },
    ),
    "regency_t3_artillery": (
        lore: "A long pinch bore that charges coil by coil and lobs a single shot of fusion over the horizon; where it lands the ground runs like glass.",
        weapons: {
            "Pinch-fusion Howitzer": "One great charge of fusion thrown high, landing as a blinding strike that melts a pool into the ground and leaves a knot of fusion burning over it.",
        },
    ),
    "regency_t3_wake_tank": (
        lore: "A heavy hover tank built round one wide projector; when it lets go, a fan of plasma rolls out over the ground ahead and nothing standing in it is spared.",
        weapons: {
            "Pinched-plasmeric Wake Projector": "Plasma gathered across a wide mouth and pinched out flat, so it spreads as it goes: a wake that sears everything in front of the tank and glasses the ground under it.",
        },
    ),
    "regency_t3_strider": (
        lore: "A fighting machine on three long legs that walks one leg at a time; its keeled head stands so high that it wades out into the sea and keeps firing.",
        weapons: {
            "Pinched-plasmeric Cannon": "Plasma squeezed by gravity into a ball in front of the bore and pinched out as one dense jet; the strider's two take turns.",
        },
    ),
    "regency_t1_engineer": (
        lore: "A construction craft that rides a gravity lift over land and sea alike and builds with the nanite emitter on its arm.",
        weapons: {},
    ),
    "regency_t2_engineer": (
        lore: "A heavier lift craft for field work: twin emitters on its arm and a feed drum on its back build the larger machines of a holding.",
        weapons: {},
    ),
    "regency_t3_engineer": (
        lore: "The Regency's heaviest builder craft, rammed and skirted for the front, its arm crowned with a ring of emitters; it raises their greatest works.",
        weapons: {},
    ),
    "regency_t1_scout": (
        lore: "A fast six-legged walker that carries a radar array on a mast over its back; it goes ahead of everything else.",
        weapons: {
            "Light Plasmeric Repeater": "A small plasmeric gun that fires single light slugs.",
        },
    ),
    "regency_t1_raider": (
        lore: "A low, fast four-legged walker with a repeater slung either side of the turret on its back; it comes in quick and close.",
        weapons: {
            "Twin Plasmeric Repeater": "Two plasmeric guns that take turns, a steady stream of red bolts.",
        },
    ),
    "regency_t1_tank": (
        lore: "A plated tank that rides a gravity lift instead of tracks, so a river or a strait is no obstacle to it.",
        weapons: {
            "Plasmeric Repeater": "A steady stream of fat red bolts of gravity-bound plasma that splash and sear what they hit.",
        },
    ),
    "regency_t1_mobile_aa": (
        lore: "A six-legged gun carriage whose repeater organ is always held up at the sky.",
        weapons: {
            "Plasmeric AA Repeater": "Plasma bolts out of each tube in turn, bursting among aircraft in a spray of burning plasma.",
        },
    ),
    "regency_t3_air_superiority": (
        lore: "A long blade of a jet built round one rifle laid down its keel; it hunts other aircraft and seldom has to fire twice.",
        weapons: {
            "Pinch-fusion Rifle": "Plasma pinched until it fuses and fired out from under the nose blade as one white-hot shot.",
        },
    ),
    "regency_t3_strategic_bomber": (
        lore: "A heavy jet under a hammer of a nose blade that carries one small caged star slung between its engines, and lets it go over whatever must stop existing.",
        weapons: {
            "Pinch-fusion Bomb": "A small star held in gravity rings until it is dropped; it flashes on the ground like a sun coming up and melts what it lands on.",
        },
    ),
    "regency_t3_spy_plane": (
        lore: "An unarmed glider on long straight wings that flies far above the weather, too high for most guns and too fast for the fighters that try; it looks down and the empire sees.",
        weapons: {},
    ),
    "regency_t1_artillery": (
        lore: "A low four-legged walker that crouches behind the line and lobs plasma over it.",
        weapons: {
            "Plasmeric Mortar": "A charge of plasma held in gravity and thrown high; it comes down, lets go and sears the ground where it lands.",
        },
    ),
    "regency_t2_bombard": (
        lore: "A siege walker that raises the pod on its back and lobs seekers high over the field; ARC crews hear them break apart overhead before they see them.",
        weapons: {
            "Heavy Gravitic Seeker": "A finned missile carrying six cased warheads, lobbed on a high arc; it opens over its mark and rains the smaller missiles down round it.",
        },
    ),
    "regency_t1_land_factory": (
        lore: "A press works under swept armour: fabricators hung round a turning ring pour nanites onto the bay floor, and the machine walks out finished.",
        weapons: {},
    ),
    "regency_t1_air_factory": (
        lore: "Four armoured towers hold a lift ring over the pad; the craft is poured whole under it and rises through.",
        weapons: {},
    ),
    "regency_t2_land_factory": (
        lore: "The land factory at tech 2: an outboard machine bank along each wing and more fabricator heads.",
        weapons: {},
    ),
    "regency_t3_land_factory": (
        lore: "The land factory at tech 3: its fabrication ring lifted on four pylons, high enough to make the battle scorpion.",
        weapons: {},
    ),
    "regency_t2_air_factory": (
        lore: "The air factory at tech 2: flywheel presses on its houses and more fabricator heads.",
        weapons: {},
    ),
    "regency_t3_air_factory": (
        lore: "The air factory at tech 3: a crown raised over its lift ring, and more heads hung from it.",
        weapons: {},
    ),
    "regency_t1_naval_factory": (
        lore: "A floating dock of two armoured arms and a gantry; the hull is poured in the slip between them and sails straight out.",
        weapons: {},
    ),
    "regency_t2_naval_factory": (
        lore: "The floating dock refitted for warships: more machinery on its arms and fabricators enough to pour a destroyer whole in the slip.",
        weapons: {},
    ),
    "regency_t3_naval_factory": (
        lore: "The dock at its greatest: a capital ship is poured whole alongside its quay, longer than the yard that makes it.",
        weapons: {},
    ),
    "regency_t3_battleship": (
        lore: "A battleship that can go under: three houses of pinch-fusion guns that come up out of the sea to fire, and go down again.",
        weapons: {
            "Fore Pinch-fusion Cannon": "Twin guns that squeeze their plasma until it fuses and launch it white-hot; it melts what it lands on.",
            "Second Pinch-fusion Cannon": "The second pair of pinch-fusion guns, raised over the first.",
            "Aft Pinch-fusion Cannon": "The aft pair, covering the stern.",
            "Gravitic Torpedo Tubes": "Four bow tubes of heavy gravitic torpedoes, fired dived or up.",
            "Plasmeric AA Repeater": "A light AA repeater that works only with the hull up.",
            "Port Fore Secondary": "A twin heavy repeater on the beam.",
            "Port Aft Secondary": "A twin heavy repeater on the beam.",
            "Starboard Fore Secondary": "A twin heavy repeater on the beam.",
            "Starboard Aft Secondary": "A twin heavy repeater on the beam.",
        },
    ),
    "regency_t3_carrier": (
        lore: "A carrier that holds the sky over a fleet: heavy seekers rising from its deck reach aircraft far past any gun.",
        weapons: {
            "Heavy Gravitic Seeker Battery": "Twelve cells of heavy gravitic seekers, rippled off and spread over the fliers in reach.",
            "Port Plasmeric AA Repeater": "Bursting bolts for what gets close on the port side.",
            "Starboard Plasmeric AA Repeater": "Bursting bolts for what gets close on the starboard side.",
            "Interceptor Tubes": "Short gravitic torpedoes that meet torpedoes coming in.",
        },
    ),
    "regency_t3_submarine": (
        lore: "The fastest hull under the sea: it hunts with torpedoes, and surfaces bristling with lighter guns to finish what it caught.",
        weapons: {
            "Gravitic Torpedo Launcher": "Six tubes of gravitic torpedoes, fired three at a time.",
            "Interceptor Tubes": "Short gravitic torpedoes that meet torpedoes coming in.",
            "Fore Twin Plasmeric Repeater": "A twin repeater forward, up only.",
            "Aft Twin Plasmeric Repeater": "A twin repeater aft, up only.",
            "Plasmeric AA Repeater": "An AA repeater that works only with the hull up.",
            "Gravitic Seeker Pod": "Six gravitic seekers for aircraft, launched with the hull up.",
        },
    ),
    "regency_t1_air_scout": (
        lore: "A dart of a drone and the fastest thing in the sky; it carries nothing but its eyes, and is gone before a gun can turn.",
        weapons: {},
    ),
    "regency_t1_fighter": (
        lore: "A small jet drone with a plasmeric gun either side of its nose, built to hunt other aircraft.",
        weapons: {
            "Twin Plasmeric Repeater": "Two light plasmeric guns that throw bolts of plasma held tight by gravity, fast enough to catch a plane.",
        },
    ),
    "regency_t1_bomber": (
        lore: "A blade of a wing that runs in over the line and lays a short stick of plasma along it.",
        weapons: {
            "Plasmeric Bomb": "A charge of plasma held in gravity until it lands, then let go all at once.",
        },
    ),
    "regency_t2_transport": (
        lore: "A compact split-hull spacecraft whose protected hold carries one Exarch. Its swept charcoal armour frames a violet-lit loading bay; it sets down to take its commander aboard.",
        weapons: {},
    ),
    "regency_t1_attack_boat": (
        lore: "A blade of a boat that lies just under the surface where no gun can find it, and comes up only to fire.",
        weapons: {
            "Twin Plasmeric Repeater": "Two light plasmeric guns in a low turret that fire bolts of plasma held tight by gravity; they work only with the hull up.",
        },
    ),
    "regency_t1_submarine": (
        lore: "An attack submarine that hunts by ear and kills with gravitic torpedoes.",
        weapons: {
            "Gravitic Torpedo Tubes": "Each torpedo is a charge of plasma held and steered in a gravity cage; it boils the sea round the hull it finds.",
        },
    ),
    "regency_t1_frigate": (
        lore: "The one small hull of the Regency's that stays on the surface: the eyes and the umbrella of a squadron.",
        weapons: {
            "Heavy Plasmeric Repeater": "A heavy plasmeric gun forward that fires slow, hard bolts of plasma.",
            "Plasmeric AA Repeater": "Bolts of plasma out of each tube in turn, bursting into a spray among aircraft.",
        },
    ),
    "regency_t2_destroyer": (
        lore: "A heavy destroyer that dives: it fights from under the sea with torpedoes behind its shield, and comes up to bring its cannon to bear.",
        weapons: {
            "Pinched-plasmeric Cannon": "Plasma gathered and squeezed by gravity in front of the bore, then pinched out as one dense jet; it works only with the hull up.",
            "Gravitic Torpedo Tubes": "Four bow tubes of gravitic torpedoes, fired dived or surfaced.",
            "Plasmeric AA Repeater": "A light AA repeater aft that works only with the hull up.",
            "Interceptor Tubes": "Short gravitic torpedoes that run at torpedoes coming in and burst them under the water.",
        },
    ),
    "regency_t2_cruiser": (
        lore: "A cruiser that holds the sky over a fleet, and reaches far inland with one heavy seeker at a time.",
        weapons: {
            "Gravitic Seeker Battery": "Twelve cells of gravitic seekers rippled off at the aircraft in reach, spread over them.",
            "Heavy Gravitic Seeker": "One great plasma charge held and steered in gravity containment, thrown high and brought down on a structure far over the coast.",
            "Plasmeric Repeater": "A light plasmeric gun for what comes close.",
        },
    ),
    "regency_t1_extractor": (
        lore: "A beam run straight down into the ground cuts the bore, and the ore it frees is drawn up the column round it. It draws nothing from the grid.",
        weapons: {},
    ),
    "regency_t2_extractor": (
        lore: "The rig refitted with pinch emitters that join the beam at the mouth, and a second collector ring.",
        weapons: {},
    ),
    "regency_t3_extractor": (
        lore: "The rig refitted with emitter posts round the bore and a third collector ring; the beam cuts wider still.",
        weapons: {},
    ),
    "regency_t4_extractor": (
        lore: "The deepest bore: a heavier lens and a beam that surges, sunk far below the ore fields.",
        weapons: {},
    ),
    "regency_t1_power": (
        lore: "Turning gravity rings squeeze plasma to the pressure inside a star until it fuses. Breach the field and the freed star flares and goes supernova: a sight across the field, and harmless to all of it.",
        weapons: {},
    ),
    "regency_t2_power": (
        lore: "A bigger core under more rings; like every Regency generator, freed it burns out as light, not fire.",
        weapons: {},
    ),
    "regency_t3_power": (
        lore: "The largest star core, held under a crown of six talons. Its supernova lights the whole field.",
        weapons: {},
    ),
    "regency_t2_fabricator": (
        lore: "Gravity squeezes raw energy in a sealed vessel until matter condenses out of it. A breached vessel lets it all go at once.",
        weapons: {},
    ),
    "regency_t3_fabricator": (
        lore: "The largest condenser, its vessel braced under a cage of plate; what forms in it is worth the grid it starves.",
        weapons: {},
    ),
    "regency_storage": (
        lore: "An armoured mass vault between two long energy cells: one building holds both.",
        weapons: {},
    ),
    "regency_storage_t2": (
        lore: "The vault and its cells built up a storey: more mass under armour, more charge in the cells.",
        weapons: {},
    ),
    "regency_storage_t3": (
        lore: "The largest Reliquary, its vault and cells built up again under heavier machinery.",
        weapons: {},
    ),
    "regency_t1_point_defense": (
        lore: "A squat armoured drum under a low turret: a three-barrelled repeater that tracks anything close and punches through it.",
        weapons: {
            "Plasmeric Repeater": "Three plasma slugs a burst, short-ranged, each one bursting white-hot against armour.",
        },
    ),
    "regency_t2_point_defense": (
        lore: "An armoured keep under a long turret, a ring turning under it and rams working in its skirt. Placeholder text.",
        weapons: {
            "Pinched-plasmeric Cannon": "Plasma squeezed dense by gravity and pinched out downrange in one long jet; all of it stops in what it hits.",
        },
    ),
    "regency_t3_point_defense": (
        lore: "A great keep carrying a fusion chamber on its turret's back. Placeholder text.",
        weapons: {
            "Pinch-fusion Cannon": "The squeezed plasma is pushed until it fuses, and the gun fires the fusion out: bright bursts strobing down the stream.",
        },
    ),
    "regency_t1_aa": (
        lore: "Twin raised barrels on a braced column, fed from a drum magazine, filling the sky with bursting plasma.",
        weapons: {
            "Plasmeric AA Repeater": "Each bolt bursts among aircraft into a spray of hot plasma that burns every one it reaches.",
        },
    ),
    "regency_t1_radar": (
        lore: "A braced mast crowned with a sensor ring that turns free of it, held by gravity alone.",
        weapons: {},
    ),
    "regency_t2_radar": (
        lore: "The mast refitted with a second floating ring and braced legs; it reaches twice as far.",
        weapons: {},
    ),
    "regency_t3_radar": (
        lore: "The mast refitted with a third floating ring and clamped feet; it reaches farther still.",
        weapons: {},
    ),
    "regency_wall": (
        lore: "Plated sections that lock into one wall where they stand side by side: armour lapped down over a graphite waist, a spiked tower at every end and corner, a block of them one rampart. Slow to build, very hard to cut.",
        weapons: {},
    ),
    "regency_t2_tank": (
        lore: "A battle tank that rides a gravity lift where an ARC tank would roll on tracks, over ground and water alike; its one gun is the Halberd's, built small enough to carry.",
        weapons: {
            "Pinched-plasmeric Cannon": "Plasma gathered between three projectors in front of the bore, squeezed dense by gravity and pinched out as one short jet that bursts and sears what it hits.",
        },
    ),
    "regency_t2_mobile_aa": (
        lore: "An armoured craft on a gravity lift that runs with the army over land and water and keeps the sky over it.",
        weapons: {
            "Gravitic Seeker Battery": "Charges of plasma held in gravity cradles and let go one after another; each steers itself onto an aircraft without motor or exhaust and bursts beside it.",
        },
    ),
    "regency_t4_nuke_silo": (
        lore: "The Regency kept the warhead from the war that made them an empire, and built the silo round the memory of it.",
    ),
    "regency_t4_nuke_defense": (
        lore: "Gravity lenses that see a warhead coming over the horizon, and cells that throw a seeker up to break its containment before it falls.",
    ),
    "regency_t2_drone_carrier": (
        lore: "A hull on gravity lift that carries no gun, only a rack of Wicks down its back; it lets them go a salvo at a time and its nanites build them again in their bays.",
        weapons: {
            "Pinched-plasmeric Wick": "A small drone carrying one charge of plasma held tight by gravity; it flies into what it is sent at and lets go, and nothing of it comes back.",
        },
    ),
    "regency_wick": (
        lore: "One charge of pinched plasma on a lift bell no bigger than a man, built in the Quiver's hull to be spent.",
        weapons: {},
    ),
    "regency_t3_assault_aircraft": (
        lore: "A heavy craft that comes in over a battle and stops there, hanging on six lift bells while its beam walks back and forth below it and the ground turns to glass.",
        weapons: {
            "Pinch-fusion Beam": "Plasma pinched until it fuses and held as a beam, white at its heart with bursts of fusion strobing along it; it sweeps across its mark and melts the ground it crosses.",
        },
    ),
    "regency_t2_interceptor": (
        lore: "A jet drawn out to a needle behind a blade of a nose, built to run down whatever flies over Regency ground.",
        weapons: {
            "Gravitic Seeker Battery": "A charge of plasma held between two graphite tines either side under the chin, let go and steered onto an aircraft by its own gravity cage.",
        },
    ),
    "regency_t2_strike_drone": (
        lore: "A slow, thin-skinned drone that circles its mark far out and never comes in close; ARC crews learned to send fighters for it rather than guns.",
        weapons: {
            "Gravitic Seeker Pod": "Four charges of plasma thrown up out of open cages on its back, each steering itself down onto the mark from further out than a gun can answer.",
        },
    ),
    "regency_t2_torpedo_bomber": (
        lore: "A twin-boomed jet that comes down to the wave tops on its run and leaves a gravity-held torpedo in the water under each boom.",
        weapons: {
            "Gravitic Torpedo Cradles": "Each torpedo is a charge of plasma in a gravity cage; it falls in, steers onto the hull below and boils the sea round it.",
        },
    ),
    "regency_t1_mobile_reclaimer": (
        lore: "A lift hull with one nanite head. Its strands unpick whatever lies in reach as it drifts across the field.",
    ),
    "regency_t2_mobile_reclaimer": (
        lore: "Grown larger, its strands thicker and its reach longer.",
    ),
    "regency_t3_mobile_reclaimer": (
        lore: "The largest of the line: a whole wreck comes apart into its strands while it passes.",
    ),
    "regency_t1_reclaimer": (
        lore: "A plated mast over a sealed vault, one nanite head at its crown. What its strands reach comes home down them and is melted into stock below.",
    ),
    "regency_t2_reclaimer": (
        lore: "Two flank pylons rise beside the mast, each with a head of its own: three wrecks come apart at once.",
    ),
    "regency_t3_reclaimer": (
        lore: "The vault deepened and the heads rewound for the longest pull the Regency fields; a battlefield empties into it.",
    ),
    "regency_t3_assault_transport": (
        lore: "A vaulted cargo ark that sets an armoured force down beneath its swept shoulders, its broad ramp opening into a deep protected hold.", weapons: {},
    ),
    "regency_t2_space_frigate": (
        lore: "An economical two-gun escort, its narrow split bow carrying only the plasma cannons it needs to guard the fleet.",
        weapons: {"Escort Plasma Cannon": "A compact cannon firing contained plasma against ships, aircraft and surface targets."},
    ),
    "regency_t3_space_cruiser": (
        lore: "A crescent of overlapping armour around a heavy spine, built to suppress armies, bombard bases and break enemy ships.",
        weapons: {
            "Heavy Anti-ship Plasma Cannon": "Two heavy bow cannons throw dense plasma charges at capital hulls.",
            "Suppression Plasma Battery": "Six independently aiming casemates lay overlapping plasma salvos over a wide area.",
        },
    ),
    "regency_t3_space_destroyer": (
        lore: "Two immense arched hulls carry a caged plasma projector. It holds station over its mark while the beam sweeps across the ground and turns its path to molten glass.",
        weapons: {"Excavation Plasma Beam": "A sustained pinch-fusion discharge swept across a broad swath, melting and searing what it crosses."},
    ),
}
