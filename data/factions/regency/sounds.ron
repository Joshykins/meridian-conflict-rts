                Burst(at: 2.31, low: 700, high: 2600, attack: 0.0002, decay: 0.003, gain: 1.7, pan: -0.1, seed: 118),
                Burst(at: 2.38, low: 700, high: 2600, attack: 0.0002, decay: 0.005, gain: 2.2, pan: 0.35, seed: 119),
