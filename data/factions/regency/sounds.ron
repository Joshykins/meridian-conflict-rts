// The Regency's own sounds: the Exarch's gun; the battle scorpion's legs, feet, beam and
// bombs; every Regency answer to a selection; their builders' nanites; the Picket's,
// Canopy's and heavy point defences' guns; the Outrider's walk.
(
    sounds: {
        // The Exarch's cannon arm. The weapon draws each 0.3 s shot as three slugs 0.1 s
        // apart (`rounds` in command.ron), so this is three rounds: each a dry crack over a
        // compression thump, the slug's dark buzz falling away under it, a short low sizzle
        // after. Lighter than the Picket (a commander fires it all game), never a pew.
        "regency_stinger": (
            length: 0.6, peak: 0.44, room: 0.12,
            layers: [
                Burst(at: 0.0, low: 450, high: 2000, attack: 0.0002, decay: 0.004, gain: 5),
                Burst(at: 0.0, low: 100, high: 700, attack: 0.0005, decay: 0.022, gain: 4),
                Tone(at: 0.0, from: 170, to: 53, glide: 0.05, attack: 0.001, decay: 0.06, gain: 0.9),
                Stack(at: 0.003, from: 264, to: 95, glide: 0.04, attack: 0.002, decay: 0.04, gain: 0.3, detune: 1.008, width: 0.2, partials: [(1, 1), (2, 0.45), (3, 0.25)]),
                Burst(at: 0.1, low: 450, high: 2000, attack: 0.0002, decay: 0.004, gain: 5, pan: 0.1),
                Burst(at: 0.1, low: 100, high: 700, attack: 0.0005, decay: 0.022, gain: 4, pan: 0.1),
                Tone(at: 0.1, from: 164, to: 51, glide: 0.05, attack: 0.001, decay: 0.06, gain: 0.9, pan: 0.1),
                Stack(at: 0.103, from: 254, to: 92, glide: 0.04, attack: 0.002, decay: 0.04, gain: 0.3, detune: 1.008, width: 0.2, partials: [(1, 1), (2, 0.45), (3, 0.25)]),
                Burst(at: 0.2, low: 450, high: 2000, attack: 0.0002, decay: 0.004, gain: 5, pan: -0.1),
                Burst(at: 0.2, low: 100, high: 700, attack: 0.0005, decay: 0.022, gain: 4, pan: -0.1),
                Tone(at: 0.2, from: 176, to: 55, glide: 0.05, attack: 0.001, decay: 0.06, gain: 0.9, pan: -0.1),
                Stack(at: 0.203, from: 273, to: 99, glide: 0.04, attack: 0.002, decay: 0.04, gain: 0.3, detune: 1.008, width: 0.2, partials: [(1, 1), (2, 0.45), (3, 0.25)]),
                Drive(1.5),
                Sweep(at: 0.008, from: 1300, to: 420, glide: 0.12, q: 0.9, attack: 0.006, decay: 0.06, gain: 0.2),
                Sweep(at: 0.108, from: 1300, to: 420, glide: 0.12, q: 0.9, attack: 0.006, decay: 0.06, gain: 0.2, pan: 0.1),
                Sweep(at: 0.208, from: 1300, to: 420, glide: 0.12, q: 0.9, attack: 0.006, decay: 0.06, gain: 0.2, pan: -0.1),
            ],
        ),
        // The battle scorpion's walk. Eight heavy legs working under a tonne-heavy armoured body: the drive's growl,
        // a pump chugging with the stride, the rams straining as each group of legs lifts
        // (one side, then the other), the plates grinding low over each other and the
        // weight rolling in the ground. Nothing above the low mids: no chitter, no clatter.
        // No footfalls in it: those are `regency_footfall`. Every steady frequency and wobble
        // is a whole number of cycles in the 2.4 s loop.
        "regency_crawl": (
            length: 2.4, peak: 0.26, room: 0.0, looped: true,
            layers: [
                // The drive: a growl on 45.8 Hz and its harmonics, breathing with the stride.
                Fm(from: 45.8333, to: 45.8333, glide: 1, ratio: 0.5, index: 1.4, fade: 1000, attack: 0.01, decay: 100000, gain: 0.28),
                Drone(freq: 91.6667, gain: 0.12, wobble: 2.0833, depth: 0.55),
                Drone(freq: 137.5, gain: 0.06, wobble: 4.1667, depth: 0.6, pan: -0.1),
                // The rams: each group of legs straining up to the lift and easing off.
                Fm(at: 0.05, from: 64, to: 86, glide: 0.45, ratio: 1.41, index: 0.7, fade: 0.4, attack: 0.25, decay: 0.2, gain: 0.16, pan: -0.3),
                Fm(at: 0.65, from: 60, to: 80, glide: 0.45, ratio: 1.41, index: 0.7, fade: 0.4, attack: 0.25, decay: 0.2, gain: 0.15, pan: 0.3),
                Fm(at: 1.25, from: 66, to: 88, glide: 0.45, ratio: 1.41, index: 0.7, fade: 0.4, attack: 0.25, decay: 0.2, gain: 0.16, pan: -0.25),
                Fm(at: 1.85, from: 62, to: 82, glide: 0.4, ratio: 1.41, index: 0.7, fade: 0.35, attack: 0.22, decay: 0.18, gain: 0.15, pan: 0.25),
                // A valve letting go at the top of each lift: a dull thump, not a click.
                Burst(at: 0.55, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.1, pan: -0.3),
                Burst(at: 1.15, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.0, pan: 0.3),
                Burst(at: 1.75, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.1, pan: -0.25),
                Burst(at: 2.3, low: 60, high: 380, attack: 0.002, decay: 0.035, gain: 1.0, pan: 0.25),
                Drive(1.3),
                // Plates grinding over each other as it moves, low.
                Rumble(freq: 260, q: 0.9, gain: 3.2, wobble: 4.1667, depth: 0.7),
                Drone(freq: 183.3333, gain: 0.04, wobble: 4.1667, depth: 0.7, pan: 0.1),
                // The weight in the ground.
                Rumble(freq: 110, q: 0.7, gain: 3.0, wobble: 2.0833, depth: 0.5),
            ],
        ),
        // A heavy armoured foot coming down (the scorpion's, and the Exarch's talons): the leg's ram shoving it down
        // (a short hiss of oil under pressure), then the impact, a deep thud into the
        // ground with a dull clank of the leg's armour taking the load, grit crunching and
        // the weight settling. No bright tick or ring: it is heavy, not tinny.
        "regency_footfall": (
            length: 0.6, peak: 0.34, room: 0.3,
            layers: [
                // The ram driving the leg down.
                Sweep(from: 1400, to: 500, glide: 0.05, q: 0.9, attack: 0.01, decay: 0.03, gain: 0.12),
                // The impact: the thud and the ground's answer.
                Burst(at: 0.045, low: 35, high: 240, attack: 0.002, decay: 0.09, gain: 9),
                Tone(at: 0.045, from: 118, to: 44, glide: 0.08, attack: 0.002, decay: 0.12, gain: 1.4),
                Tone(at: 0.05, from: 60, to: 34, glide: 0.2, attack: 0.006, decay: 0.2, gain: 0.9),
                // The leg's armour taking the load: one low, dull clank.
                Fm(at: 0.047, from: 176, to: 150, glide: 0.08, ratio: 1.41, index: 0.9, fade: 0.04, attack: 0.002, decay: 0.07, gain: 0.26, pan: 0.1),
                // Grit crunching under the claw.
                Burst(at: 0.046, low: 140, high: 900, attack: 0.001, decay: 0.022, gain: 2.2),
                Drive(1.4),
                Roll(at: 0.06, from: 520, to: 140, glide: 0.3, attack: 0.02, decay: 0.16, gain: 0.18, swell: 9, depth: 0.6, seed: 7101),
            ],
        ),


        // ---- selection answers ---------------------------------------------------------
        // What a Regency answers the player with, by the kind of thing it is (faction.ron's
        // `sounds.select`). Heard as data/sounds/responses.ron's are: at interface volume,
        // from no place, far more often than any gun, so short and quiet. Not ARC's servos
        // and chimes: a Regency breathes, hisses, clicks wetly, rattles its chitin, growls and
        // beats. Every answer is a gesture that moves, and the kind is told by the gesture;
        // what pitch there is still lands on the interface's D and A.

        // ---- answers to a selection -----------------------------------------------------
        // Machines, like ARC's (data/sounds/responses.ron), but the Regency's own voice: heavier,
        // more metal in it, and gravity in it too: rings spinning up onto a note, plates and
        // clamps setting, bronze struck. Still gestures, never a held tone; still on the
        // interface's D and A, short and quiet; the kind of unit told by the gesture.

        // The Exarch: the biggest answer. A heavy servo growl rising A to D under two bronze
        // strikes a fifth apart, the armour settling in a dull double clank, a sub swelling.
        "regency_select_commander": (
            length: 1.2, peak: 0.32, room: 0.6,
            layers: [
                Fm(from: 110, to: 146.8, glide: 0.2, ratio: 0.5, index: 2.2, fade: 0.14, attack: 0.02, decay: 0.14, gain: 0.8),
                Fm(at: 0.06, from: 293.7, to: 293.7, glide: 0.01, ratio: 1.41, index: 2.0, fade: 0.08, attack: 0.002, decay: 0.2, gain: 0.55, pan: -0.2),
                Fm(at: 0.14, from: 440, to: 440, glide: 0.01, ratio: 1.41, index: 1.8, fade: 0.08, attack: 0.002, decay: 0.24, gain: 0.5, pan: 0.2),
                Tone(from: 41.2, to: 55, glide: 0.2, attack: 0.05, decay: 0.2, gain: 0.5),
                Fm(at: 0.3, from: 196, to: 164.8, glide: 0.03, ratio: 1.41, index: 1.6, fade: 0.02, attack: 0.001, decay: 0.04, gain: 0.45, pan: -0.25),
                Fm(at: 0.36, from: 185, to: 155.6, glide: 0.03, ratio: 1.41, index: 1.6, fade: 0.02, attack: 0.001, decay: 0.05, gain: 0.45, pan: 0.25),
                Burst(at: 0.06, low: 250, high: 1400, attack: 0.0005, decay: 0.006, gain: 1.2),
                Burst(at: 0.3, low: 200, high: 1200, attack: 0.0005, decay: 0.006, gain: 1.4, pan: -0.25),
                Burst(at: 0.36, low: 200, high: 1200, attack: 0.0005, decay: 0.007, gain: 1.4, pan: 0.25),
                Drive(1.2),
            ],
        ),
        // The engineer: its lift field spinning up onto its note, then the emitter's ready tick.
        "regency_select_engineer": (
            length: 0.8, peak: 0.24, room: 0.45,
            layers: [
                Stack(from: 146.8, to: 293.7, glide: 0.14, attack: 0.02, decay: 0.08, gain: 0.6, detune: 1.007, width: 0.4, partials: [(1, 1), (2, 0.5), (3, 0.3)]),
                Fm(from: 73.4, to: 110, glide: 0.14, ratio: 0.5, index: 1.4, fade: 0.08, attack: 0.02, decay: 0.07, gain: 0.4),
                Fm(at: 0.15, from: 880, to: 1174.7, glide: 0.015, ratio: 3.5, index: 1.2, fade: 0.02, attack: 0.001, decay: 0.035, gain: 0.7, pan: 0.2),
                Burst(at: 0.15, low: 900, high: 2400, attack: 0.0003, decay: 0.003, gain: 0.7, pan: 0.2),
            ],
        ),
        // The battle scorpion: two heavy strokes of its legs' rams, each falling onto its
        // note, the second a fourth lower, and a bronze clack as its plates lock.
        "regency_select_bot": (
            length: 0.8, peak: 0.28, room: 0.5,
            layers: [
                Fm(from: 330, to: 220, glide: 0.05, ratio: 0.5, index: 2.2, fade: 0.05, attack: 0.002, decay: 0.05, gain: 0.8, pan: -0.2),
                Fm(at: 0.09, from: 246.9, to: 146.8, glide: 0.06, ratio: 0.5, index: 2.2, fade: 0.06, attack: 0.002, decay: 0.07, gain: 0.85, pan: 0.2),
                Tone(from: 110, to: 55, glide: 0.08, attack: 0.002, decay: 0.07, gain: 0.45),
                Fm(at: 0.2, from: 587.3, to: 554.4, glide: 0.02, ratio: 1.41, index: 1.4, fade: 0.02, attack: 0.001, decay: 0.03, gain: 0.35),
                Burst(low: 250, high: 1300, attack: 0.0005, decay: 0.006, gain: 1.2, pan: -0.2),
                Burst(at: 0.09, low: 220, high: 1200, attack: 0.0005, decay: 0.007, gain: 1.2, pan: 0.2),
            ],
        ),
        // A scout: its sensor sweeping out, quick and rising, and the return coming back.
        "regency_select_scout": (
            length: 0.7, peak: 0.2, room: 0.55,
            layers: [
                Fm(from: 440, to: 880, glide: 0.06, ratio: 2, index: 1.2, fade: 0.05, attack: 0.002, decay: 0.05, gain: 0.7, pan: -0.25),
                Fm(at: 0.18, from: 880, to: 830.6, glide: 0.04, ratio: 2, index: 0.8, fade: 0.05, attack: 0.004, decay: 0.07, gain: 0.35, pan: 0.25),
                Fm(from: 220, to: 293.7, glide: 0.06, ratio: 0.5, index: 1.2, fade: 0.05, attack: 0.002, decay: 0.05, gain: 0.35),
                Burst(low: 700, high: 2200, attack: 0.0003, decay: 0.003, gain: 0.8, pan: -0.25),
            ],
        ),

        // ---- structures: plant; things start, stroke, set and lock ----
        // A factory: the press coming down twice, and its fabrication ring spinning up an octave.
        "regency_select_factory": (
            length: 1.0, peak: 0.3, room: 0.6,
            layers: [
                Fm(from: 220, to: 164.8, glide: 0.04, ratio: 1.41, index: 2.4, fade: 0.03, attack: 0.001, decay: 0.05, gain: 0.8, pan: -0.25),
                Fm(at: 0.11, from: 196, to: 146.8, glide: 0.04, ratio: 1.41, index: 2.4, fade: 0.03, attack: 0.001, decay: 0.06, gain: 0.85, pan: 0.25),
                Tone(from: 90, to: 50, glide: 0.05, attack: 0.002, decay: 0.05, gain: 0.45),
                Tone(at: 0.11, from: 85, to: 46, glide: 0.05, attack: 0.002, decay: 0.06, gain: 0.45),
                Stack(at: 0.12, from: 146.8, to: 293.7, glide: 0.25, attack: 0.04, decay: 0.12, gain: 0.5, detune: 1.006, width: 0.35, partials: [(1, 0.8), (2, 0.6), (3, 0.35), (5, 0.12)]),
                Burst(low: 250, high: 1300, attack: 0.0005, decay: 0.007, gain: 1.2, pan: -0.25),
                Burst(at: 0.11, low: 220, high: 1200, attack: 0.0005, decay: 0.008, gain: 1.2, pan: 0.25),
            ],
        ),
        // A mine: its excavation beam drawing breath: two deep pulses, the second lower.
        "regency_select_extractor": (
            length: 0.9, peak: 0.28, room: 0.5,
            layers: [
                Fm(from: 146.8, to: 110, glide: 0.08, ratio: 0.5, index: 2.0, fade: 0.08, attack: 0.004, decay: 0.07, gain: 0.8),
                Fm(at: 0.16, from: 110, to: 73.4, glide: 0.1, ratio: 0.5, index: 2.0, fade: 0.1, attack: 0.004, decay: 0.1, gain: 0.8),
                Tone(from: 70, to: 45, glide: 0.1, attack: 0.004, decay: 0.08, gain: 0.5),
                Tone(at: 0.16, from: 60, to: 38, glide: 0.12, attack: 0.004, decay: 0.12, gain: 0.5),
                Burst(low: 200, high: 1000, attack: 0.0005, decay: 0.006, gain: 1.0),
                Burst(at: 0.16, low: 180, high: 900, attack: 0.0005, decay: 0.008, gain: 1.0),
            ],
        ),
        // A star core: the cage's rings closing in, a note climbing onto D, and the star's
        // pulse under it, one deep beat.
        "regency_select_power": (
            length: 1.0, peak: 0.27, room: 0.6,
            layers: [
                Stack(from: 110, to: 293.7, glide: 0.3, attack: 0.08, decay: 0.12, gain: 0.55, detune: 1.008, width: 0.4, partials: [(1, 1), (1.5, 0.45), (2, 0.4), (3, 0.2)]),
                Fm(at: 0.26, from: 73.4, to: 55, glide: 0.1, ratio: 0.5, index: 1.8, fade: 0.1, attack: 0.004, decay: 0.12, gain: 0.7),
                Tone(at: 0.26, from: 55, to: 36.7, glide: 0.12, attack: 0.004, decay: 0.14, gain: 0.5),
                Burst(at: 0.26, low: 180, high: 900, attack: 0.0005, decay: 0.008, gain: 0.9),
            ],
        ),
        // Storage: a heavy vault door swung on its drum, and the bolts thrown.
        "regency_select_storage": (
            length: 0.8, peak: 0.26, room: 0.5,
            layers: [
                Fm(from: 164.8, to: 110, glide: 0.12, ratio: 0.5, index: 1.6, fade: 0.1, attack: 0.02, decay: 0.08, gain: 0.7),
                Fm(at: 0.16, from: 440, to: 392, glide: 0.02, ratio: 1.41, index: 2.0, fade: 0.02, attack: 0.001, decay: 0.03, gain: 0.5, pan: -0.15),
                Fm(at: 0.2, from: 440, to: 392, glide: 0.02, ratio: 1.41, index: 2.0, fade: 0.02, attack: 0.001, decay: 0.035, gain: 0.5, pan: 0.15),
                Burst(at: 0.16, low: 300, high: 1400, attack: 0.0005, decay: 0.005, gain: 1.1, pan: -0.15),
                Burst(at: 0.2, low: 300, high: 1400, attack: 0.0005, decay: 0.005, gain: 1.1, pan: 0.15),
            ],
        ),
        // A gun emplacement: the turret traversing on its ring, clunking into place, locking twice.
        "regency_select_defense": (
            length: 0.8, peak: 0.28, room: 0.5,
            layers: [
                Fm(from: 196, to: 261.6, glide: 0.1, ratio: 0.5, index: 2.2, fade: 0.08, attack: 0.01, decay: 0.07, gain: 0.7),
                Fm(at: 0.12, from: 293.7, to: 220, glide: 0.03, ratio: 1.41, index: 2.2, fade: 0.025, attack: 0.001, decay: 0.04, gain: 0.8, pan: -0.2),
                Fm(at: 0.19, from: 293.7, to: 220, glide: 0.03, ratio: 1.41, index: 2.0, fade: 0.025, attack: 0.001, decay: 0.05, gain: 0.7, pan: 0.2),
                Tone(at: 0.12, from: 95, to: 50, glide: 0.05, attack: 0.002, decay: 0.05, gain: 0.45),
                Burst(at: 0.12, low: 250, high: 1300, attack: 0.0005, decay: 0.006, gain: 1.2, pan: -0.2),
                Burst(at: 0.19, low: 250, high: 1300, attack: 0.0005, decay: 0.006, gain: 1.0, pan: 0.2),
            ],
        ),
        // Anti-air: the same traverse, lighter and quicker, the barrels coming up.
        "regency_select_anti_air": (like: "regency_select_defense", size: 0.8, peak: 0.25),
        // Radar: its rings spinning up one after another, each onto a higher note.
        "regency_select_intel": (
            length: 0.9, peak: 0.24, room: 0.6,
            layers: [
                Stack(from: 146.8, to: 220, glide: 0.1, attack: 0.02, decay: 0.07, gain: 0.5, detune: 1.007, width: 0.4, partials: [(1, 1), (2, 0.5), (3, 0.25)]),
                Stack(at: 0.1, from: 220, to: 293.7, glide: 0.1, attack: 0.02, decay: 0.07, gain: 0.5, detune: 1.007, width: 0.4, partials: [(1, 1), (2, 0.5), (3, 0.25)]),
                Stack(at: 0.2, from: 293.7, to: 440, glide: 0.1, attack: 0.02, decay: 0.1, gain: 0.5, detune: 1.007, width: 0.4, partials: [(1, 1), (2, 0.5), (3, 0.25)]),
                Burst(low: 400, high: 1600, attack: 0.0005, decay: 0.004, gain: 0.7),
            ],
        ),
        // A wall: a dead heavy knock of armour set against armour.
        "regency_select_wall": (
            length: 0.6, peak: 0.24, room: 0.45,
            layers: [
                Fm(from: 146.8, to: 110, glide: 0.03, ratio: 1.41, index: 1.8, fade: 0.02, attack: 0.001, decay: 0.04, gain: 0.8),
                Tone(from: 80, to: 45, glide: 0.05, attack: 0.002, decay: 0.05, gain: 0.55),
                Burst(low: 180, high: 1000, attack: 0.0005, decay: 0.007, gain: 1.4),
            ],
        ),

        // ---- building ------------------------------------------------------------------
        // What a Regency builder makes instead of ARC's weld (faction.ron's `sounds.build`):
        // the nanite streams coming on, pouring while they work, and settling when they
        // stop. Deep and heavy: a great machine far down under the work, felt more than
        // heard, with the particles' rush over it. No chatter, no beeps.

        // The loop while a builder works: a sub note (41 Hz) and a second a half hertz off
        // it, so the whole thing throbs slowly; its octave, fifth and twelfth quietly over
        // it for speakers that cannot play the sub; a low breathing rush of air, and the
        // soft wash of the particle strands above. Every frequency and wobble is a whole
        // number of cycles in the 2.0 s loop.
        "regency_nanite": (
            length: 2.0, peak: 0.4, room: 0.25, looped: true,
            layers: [
                Drone(freq: 41, gain: 0.08, wobble: 0.5, depth: 0.25),
                Drone(freq: 41.5, gain: 0.04, pan: 0.2),
                Drone(freq: 82, gain: 0.07, wobble: 1, depth: 0.3),
                Drone(freq: 61.5, gain: 0.04, wobble: 0.5, depth: 0.4, pan: 0.15),
                Drone(freq: 123, gain: 0.045, wobble: 1.5, depth: 0.5, pan: -0.15),
                Drone(freq: 164, gain: 0.025, wobble: 1, depth: 0.6, pan: 0.1),
                Drive(1.4),
                Rumble(freq: 140, q: 1.2, gain: 1.0, wobble: 0.5, depth: 0.6),
                Wind(freq: 900, q: 1.4, gain: 0.6, swell: 1.0, depth: 0.7, sway: 0.4),
            ],
        ),
        // The streams coming on: a deep thud, then the sub swelling up from far below onto
        // the loop's note with a growl in it, a chord rising over it, and a surge of air
        // climbing as the particles are blasted up round the site.
        "regency_nanite_start": (
            length: 2.6, peak: 0.6, room: 0.35,
            layers: [
                Tone(from: 26, to: 41, glide: 0.8, attack: 0.03, decay: 0.6, gain: 1.0),
                Tone(from: 52, to: 82, glide: 0.8, attack: 0.05, decay: 0.55, gain: 0.45),
                Fm(from: 50, to: 61.5, glide: 0.6, ratio: 0.5, index: 1.6, fade: 0.7, attack: 0.08, decay: 0.55, gain: 0.35),
                Stack(at: 0.05, from: 82, to: 123, glide: 1.0, attack: 0.3, decay: 0.45, gain: 0.3, detune: 1.006, width: 0.5, partials: [(1, 1), (1.5, 0.5), (2, 0.3)]),
                Drive(1.3),
                Burst(low: 30, high: 180, attack: 0.002, decay: 0.09, gain: 5),
                Roll(from: 60, to: 600, glide: 1.2, attack: 0.3, decay: 0.45, gain: 0.9, swell: 3, depth: 0.5),
                Sweep(at: 0.1, from: 300, to: 1800, glide: 1.4, q: 3, attack: 0.5, decay: 0.35, gain: 0.22),
            ],
        ),
        // The streams stopping: the sub and its chord sinking away far below the loop's
        // note, the particles' rush falling, and a last deep settling thud as it comes to
        // rest.
        "regency_nanite_end": (
            length: 2.4, peak: 0.55, room: 0.35,
            layers: [
                Tone(from: 41, to: 22, glide: 1.0, attack: 0.01, decay: 0.55, gain: 1.0),
