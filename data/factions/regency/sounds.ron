        // ---- movement ------------------------------------------------------------------
        // The Outrider walking: a small six-legged crawler scuttling on alternate tripods,
        // eight steps in the 0.96 s loop with a slight swing. Each step is three soft
        // chitin tips a few ms apart with a small low tock of its weight under the first,
        // over a light hiss breathing with the stride. Nothing like the Harrow's crawl:
        // quick and light, no growl, no grind. Every steady wobble is a whole number of
        // cycles in the loop, and the steps are laid over the fold.
        "regency_skitter": (
            length: 0.96, peak: 0.36, room: 0.0, looped: true,
            layers: [
                Burst(at: 0.0314, low: 420, high: 1800, attack: 0.0004, decay: 0.004, gain: 0.7897, pan: -0.1836),
                Tone(at: 0.0314, from: 300, to: 140, glide: 0.012, attack: 0.0006, decay: 0.018, gain: 0.1053, pan: -0.1836),
                Burst(at: 0.0314, low: 90, high: 600, attack: 0.001, decay: 0.012, gain: 1.404, pan: -0.1836),
