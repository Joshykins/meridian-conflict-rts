        // A sub-seeker coming down: the bomb's hit a size down, so a volley's twelve land
        // as a ripple of heavy whumps rather than one blast.
        "regency_seeker_hit": (like: "regency_gravitic_hit", size: 0.8, peak: 0.6),
        // The Sower's walk and feet: the battle scorpion's, a size down.
        "regency_bombard_walk": (like: "regency_crawl", size: 0.75, peak: 0.2),
        "regency_bombard_step": (like: "regency_footfall", size: 0.7, peak: 0.26),
        // ---- the Regency power generators' supernova ----
        // A Regency power generator's star going supernova (renderer supernova_fx.rs), written for the
        // crown's star; the smaller stars are `like` it at their own size (structures.ron).
        // The bang is the first sample, on the tick the plant dies: nothing leads up to it.
        //
        // The star letting go: a deep, muffled hit that blooms open into a warm roar as the
        // shell rolls out, a slow growl sinking under it, the air pushed past you in both
        // ears, and dark thunder going away. Nothing in it is bright: no snap, no sizzle, no
        // hiss, nothing held above about 1.5 kHz, and nothing climbs in pitch.
        "regency_supernova": (
            length: 6.0, peak: 0.85, room: 0.85,
            layers: [
                // The hit: a muffled thud, then the deep body under it.
                Burst(low: 90, high: 1100, attack: 0.0006, decay: 0.03, gain: 7),
                Burst(at: 0.002, low: 35, high: 340, attack: 0.004, decay: 0.5, gain: 12),
                Tone(from: 140, to: 34, glide: 0.9, attack: 0.003, decay: 1.2, gain: 2.0),
                Tone(from: 72, to: 28, glide: 2.0, attack: 0.01, decay: 2.0, gain: 1.4),
                // The bloom: the shell rolling open into a warm roar just after the hit.
                Roll(from: 1300, to: 200, glide: 2.4, attack: 0.22, decay: 1.5, gain: 1.4, swell: 4, depth: 0.5, seed: 8861),
                // The plasma's growl sinking under it, so small speakers hear the body.
                Fm(from: 190, to: 55, glide: 2.0, ratio: 0.5, index: 1.6, fade: 1.4, attack: 0.06, decay: 1.4, gain: 0.7),
                Drive(1.5),
                // The air pushed out past you, one in each ear, sinking.
                Sweep(at: 0.04, from: 1500, to: 200, glide: 2.2, q: 0.5, attack: 0.12, decay: 1.5, gain: 1.0, pan: -0.5, seed: 8862),
                Sweep(at: 0.09, from: 1400, to: 180, glide: 2.4, q: 0.5, attack: 0.14, decay: 1.6, gain: 1.0, pan: 0.5, seed: 8863),
                // What is left: dark thunder going away.
                Roll(at: 0.3, from: 400, to: 60, glide: 4.0, attack: 0.4, decay: 2.3, gain: 0.8, swell: 1.2, depth: 0.4, seed: 8864),
            ],
        ),
        "regency_supernova_mid": (like: "regency_supernova", size: 0.693, peak: 0.75),
        "regency_supernova_small": (like: "regency_supernova", size: 0.585, peak: 0.6),
        // The Seraph's dash (`dash_*` in its sounds). The charge, 1.5 s where it stands:
        // a field engaging, then a rough growl and its octave climbing, air drawn in and
        // a sizzle crackling thicker, all gathering tighter and brighter, ending on a short
        // drawn breath just as it goes. The vanish: a thunderclap snapping shut, four hard
        // electric cracks on top of each other with a bright metal edge, the air slamming
        // in on a short hard sub thump, a tearing rip that is cut off a tenth of a second
        // later by a second crack, then short dark thunder. The arrival, 0.6 s at the
        // landing spot while it is still gone, faint: dry static ticks far apart, then
        // running together, a thin fizz rising and the air swelling very low under it, all
        // stopping dead as it lands. The landing, heard over the whole map: a blinding
        // stacked crack, a huge slam and a sub thump that hits at once, a growl driven
        // hard and dense electric crackle spitting all round, thick at first and thinning
        // out. The wave (its weapon's fire, played with the landing): no crack of its own,
        // the wall of plasma tearing out all round, wide in both ears, rolling for over a
        // second, then thunder going off long and low with the ground slapping it back.
        "regency_seraph_charge": (
            length: 1.5, peak: 0.6, room: 0.25,
            layers: [
                // The field engaging: a heavy contactor clunk and a low thud.
                Burst(low: 50, high: 450, attack: 0.0008, decay: 0.03, gain: 4, seed: 9301),
                Tone(from: 62, to: 38, glide: 0.1, attack: 0.002, decay: 0.14, gain: 0.6),
