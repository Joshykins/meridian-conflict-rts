                Tone(at: 0.4, from: 130, to: 55, glide: 0.25, attack: 0.002, decay: 0.6, gain: 2.2),
                Tone(at: 0.4, from: 82, to: 36, glide: 0.8, attack: 0.004, decay: 1.4, gain: 2.6),
                Tone(at: 0.4, from: 52, to: 34, glide: 2.0, attack: 0.01, decay: 2.2, gain: 1.4),
                // The plasma's rough growl inside the thump, sinking.
