                // The plasma's pressure: a slow random heave that grows and brightens.
                Roll(at: 0.08, from: 220, to: 700, glide: 2.4, attack: 2.4, decay: 0.03, gain: 0.8, swell: 6, depth: 0.4, seed: 306),
