        // The battle scorpion's Pinched-plasmeric Beam, held: heard as this loop while it
        // fires, not a shot a tick. A deep root and its harmonics throbbing five times a
        // second as the stream is driven downrange, a low roar of it under them and a
        // narrow sizzle where it bites. Nothing above the low mids. Every frequency and
        // wobble is a whole number of cycles in the 2 s loop.
        "regency_pinched_beam": (
            length: 2.0, peak: 0.62, room: 0.15, looped: true,
            layers: [
                Drone(freq: 32, gain: 0.09, wobble: 5, depth: 0.35),
                Drone(freq: 64, gain: 0.07, wobble: 5, depth: 0.45),
                Drone(freq: 96, gain: 0.045, wobble: 10, depth: 0.5),
