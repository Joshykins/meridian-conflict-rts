        // ---- tech 2 land units (land_t2.ron) ----
        // The Glaive's Pinched-plasmeric Cannon: the Halberd's charge, shot and strike on a
        // smaller gun, so a little higher and shorter and not as loud.
        "regency_glaive_charge": (like: "regency_halberd_charge", size: 0.8, length: 1.3, peak: 0.3),
        "regency_glaive_fire": (like: "regency_halberd_fire", size: 0.8, peak: 0.52),
        "regency_glaive_hit": (like: "regency_halberd_hit", size: 0.8, peak: 0.7),
        // The Vane's Gravitic Seekers: each let out of its cradle as a bomb is let out of the
        // claw (a crack over a compression thump, its buzz tearing away), but lighter, six
        // in a salvo; each bursts beside its aircraft as a Canopy bolt does, heavier.
        "regency_seeker_launch": (like: "regency_gravitic_throw", size: 0.7, peak: 0.4),
        "regency_seeker_burst": (like: "regency_canopy_burst", size: 1.25, peak: 0.5),
        // ---- the Regency strategic weapons: the Pinch-fusion Warhead and the Gravitic Interceptor ----
        // The Regency's answers to `data/sounds/nuke.ron`, as big and as low. Red plasma held
        // in gravity: everything is a thump and a crack with a rough, seething roar after it;
        // nothing rings, hums on a note or rises at the end.
        //
        // A Pinch-fusion Warhead going off, heard over the whole map. The gravity pinch
        // first: for 0.4 s the air is pulled in, a deep suck that grows louder and only
        // ever darker. Then the ignition: a plasmeric crack, a slam and a sub-bass thump
        // that takes seconds to let go, a rough growl sinking inside it. Then the plasma
        // seethes for half a minute: thunder rolling from both sides, a low roar fluttering
        // and fizzing, crackle spitting at random and thinning out, the ground heaving as
        // the front goes out and comes back, all of it slowly sinking. Body at 60-120 Hz.
        "regency_nuke_detonation": (
            length: 30.0, peak: 0.82, room: 1.0,
            layers: [
                // The pinch: the air drawn in, swelling, its band falling as it is pulled tight.
                Sweep(from: 1200, to: 380, glide: 0.42, q: 0.6, attack: 0.39, decay: 0.03, gain: 1.4, seed: 9101),
                Roll(from: 280, to: 150, glide: 0.42, attack: 0.39, decay: 0.03, gain: 1.3, swell: 6, depth: 0.4, seed: 9102),
                Tone(from: 36, to: 31, glide: 0.4, attack: 0.38, decay: 0.04, gain: 0.7),
                // The ignition: a plasmeric crack, a slam, and the sub-bass thump under it.
