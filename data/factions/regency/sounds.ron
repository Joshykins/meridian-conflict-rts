        // The Sunspear's Pinch-fusion Cannon, heard 2.2 s before its one shot: the plasma
        // squeezed until it fuses. It starts low and quiet so the end can be big: a deep
        // field clunk, the air drawn in, a gravity heave throbbing slowly under a growl
        // that fills and only leans up, then the core going white: an overload growl an octave up, until the pinch slams shut on the launch.
        "regency_sunspear_charge": (
            length: 2.4, peak: 0.48, room: 0.3,
            layers: [
                // The field engaging, deep.
                Burst(low: 50, high: 420, attack: 0.001, decay: 0.03, gain: 4),
                Tone(from: 56, to: 38, glide: 0.1, attack: 0.002, decay: 0.15, gain: 0.5),
