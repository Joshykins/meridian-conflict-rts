                Roll(at: 2.52, from: 360, to: 70, glide: 0.6, attack: 0.04, decay: 0.2, gain: 0.4, swell: 5, depth: 0.5, seed: 122),
                Foam(at: 2.51, from: 2000, to: 900, glide: 0.5, q: 0.9, attack: 0.01, decay: 0.14, gain: 0.9, swell: 34, depth: 0.7, seed: 123),
            ],
        ),
        // The lance held, heard as this loop while it burns down onto the ground: a fusion
        // stream roaring out of the core. A deep rough growl and its body a fifth and an
        // octave up, breathing slowly as the pinch flexes; a broad roar of the stream that
        // flutters like a torch and drifts in colour; a searing sizzle where it bites, never
        // above the low highs. Every steady tone and wobble is a whole number of cycles in
        // the 4 s loop.
        "regency_lance_hold": (
            length: 4.0, peak: 0.7, room: 0.15, looped: true,
            layers: [
