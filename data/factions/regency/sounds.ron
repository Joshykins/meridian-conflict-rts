                Tone(from: 64, to: 32, glide: 0.4, attack: 0.002, decay: 0.6, gain: 1.6),
                Tone(from: 40, to: 26, glide: 0.9, attack: 0.01, decay: 0.9, gain: 0.8),
                // The blast's growl: rough, with a metal edge that dies fast.
                Fm(from: 120, to: 64, glide: 0.3, ratio: 0.5, index: 2.8, fade: 0.35, attack: 0.002, decay: 0.45, gain: 0.9),
                Fm(from: 240, to: 130, glide: 0.25, ratio: 0.5, index: 1.8, fade: 0.3, attack: 0.003, decay: 0.3, gain: 0.6),
                Fm(at: 0.003, from: 92, to: 60, glide: 0.2, ratio: 1.41, index: 2.0, fade: 0.08, attack: 0.002, decay: 0.12, gain: 0.5),
                Drive(1.9),
                // The wave tearing away: a roar that holds, then recedes.
                Sweep(at: 0.01, from: 2400, to: 450, glide: 1.5, q: 0.8, attack: 0.03, decay: 0.8, gain: 1.2, seed: 64),
                Roll(at: 0.02, from: 1600, to: 300, glide: 1.4, attack: 0.04, decay: 0.75, gain: 0.8, swell: 12, depth: 0.6, seed: 63),
                // The front widening either side as it runs out.
                Roll(at: 0.12, from: 1300, to: 420, glide: 1.4, attack: 0.2, decay: 0.5, gain: 0.5, swell: 16, depth: 0.7, pan: -0.5, seed: 65),
                Roll(at: 0.16, from: 1250, to: 400, glide: 1.4, attack: 0.2, decay: 0.5, gain: 0.5, swell: 16, depth: 0.7, pan: 0.5, seed: 66),
                // Thunder rolling off, long and low.
