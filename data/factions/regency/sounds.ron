        // ---- weapons -------------------------------------------------------------------
        // Every Regency turret throws plasma, and every one is heard as plasma: a hot,
        // wet thump of the bolt leaving the pinch and a sizzle riding on it, never a
        // laser pew, never a slug's crack (docs/STYLE.md "The Regency suite"). The tiers
        // are told apart by what the gun does before and after, not by pitch alone: the
        // Picket spits, the Halberd squeezes and pinches out one roaring jet, the Sunspear draws
        // the air in until it goes critical and roars. Every sizzle is noise (`Foam`,
        // `Roll`), and no tone above the low mids ever falls: that is the pew.
        //
        // The Picket's Plasmeric Repeater: one bolt a play, 5.5 a second from one turret
        // and several turrets at once, so it is short and finished. A rough low-mid
        // "thoom" as the bolt is spat, a little wet throat noise, and a hot fizz riding
        // off with it.
        "regency_picket_bolt": (
            length: 0.32, peak: 0.42, room: 0.1,
            layers: [
                // The spit: a soft-edged push of air, all body, almost no crack.
                Burst(low: 140, high: 1100, attack: 0.0012, decay: 0.022, gain: 5),
                // The thoom: a growl that starts rough and settles low within 60 ms.
                Fm(from: 215, to: 112, glide: 0.05, ratio: 0.5, index: 2.2, fade: 0.03, attack: 0.002, decay: 0.05, gain: 0.85),
                Tone(from: 120, to: 70, glide: 0.04, attack: 0.002, decay: 0.045, gain: 0.35),
                Drive(1.45),
                // The plasma's throat: a wide noise band settling, wet rather than whistling.
                Sweep(at: 0.004, from: 900, to: 420, glide: 0.06, q: 1.1, attack: 0.004, decay: 0.045, gain: 0.6),
                // A wet gurgle in the throat as the bolt leaves.
                Roll(at: 0.003, from: 1100, to: 350, glide: 0.08, attack: 0.004, decay: 0.05, gain: 0.45, swell: 28, depth: 0.7),
                // The fizz riding off with the bolt.
                Foam(at: 0.006, from: 2300, to: 1500, glide: 0.12, q: 1.0, attack: 0.006, decay: 0.07, gain: 2.4, swell: 40, depth: 0.6),
            ],
        ),
        // A Picket bolt splashing: a soft wet pop, a small low slap, and the plasma
        // sizzling off whatever it hit. Short: a stream of them lands.
        "regency_picket_hit": (
            length: 0.5, peak: 0.4, room: 0.15,
            layers: [
                Burst(low: 220, high: 1600, attack: 0.0005, decay: 0.007, gain: 5),
                Burst(low: 80, high: 700, attack: 0.001, decay: 0.026, gain: 6),
                Fm(from: 175, to: 88, glide: 0.06, ratio: 0.5, index: 2.0, fade: 0.04, attack: 0.002, decay: 0.06, gain: 0.6),
                Drive(1.4),
                // The plasma spattering and frying.
                Foam(at: 0.004, from: 2200, to: 1200, glide: 0.3, q: 0.9, attack: 0.004, decay: 0.1, gain: 1.4, swell: 36, depth: 0.9),
                Hiss(at: 0.01, freq: 1000, q: 0.8, attack: 0.01, decay: 0.08, gain: 0.2),
            ],
        ),

        // The Halberd's Pinched-plasmeric Cannon, heard 1.0 s before its salvo: plasma
        // drawn in and squeezed into a ball by gravity. A field closing with a clunk, a
        // deep rough hum filling up and only leaning upward, the air rushing in (a noise
        // band that falls as it is drawn tight), a sizzle and a slow random throb
        // swelling under it, and at the end the pinch snapping shut into the shot.
        "regency_halberd_charge": (
            length: 1.2, peak: 0.36, room: 0.2,
            layers: [
                // The gravity field engaging.
                Burst(low: 80, high: 600, attack: 0.0008, decay: 0.016, gain: 3),
                Tone(from: 72, to: 50, glide: 0.05, attack: 0.002, decay: 0.08, gain: 0.4),
                // The squeeze: a deep growl and its rough mid body filling up.
                Fm(at: 0.02, from: 52, to: 64, glide: 0.95, ratio: 0.5, index: 2.2, fade: 3.0, attack: 0.93, decay: 0.035, gain: 0.5),
                Fm(at: 0.12, from: 150, to: 172, glide: 0.85, ratio: 0.5, index: 1.4, fade: 3.0, attack: 0.83, decay: 0.035, gain: 0.6),
                Drive(1.4),
                // Plasma drawn in: the band falls as it is pulled tight.
                Sweep(at: 0.05, from: 2600, to: 650, glide: 0.9, q: 1.1, attack: 0.88, decay: 0.035, gain: 0.7, seed: 11),
                // The pressure throbbing at random, harder as it fills.
                Roll(at: 0.15, from: 320, to: 520, glide: 0.8, attack: 0.8, decay: 0.035, gain: 0.8, swell: 9, depth: 0.85, seed: 12),
                // The ball's skin sizzling.
