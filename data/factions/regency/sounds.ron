        // ---- The Fallen: the Regency's gravitic engine (tier 5) ----
        // The Fallen (`regency_t5_gravitic_engine`, its `gravitic.sounds`). Gathering, 15 s at
        // the engine, exactly as long as the sim gathers (the launch is heard as it ends): the
        // rings start from rest and spin up, a rough growl and its voices climbing, each ring
        // passing as a soft whoom, slow at first and then running together into one whir; the
        // frame groans under the load; the ground round it shakes harder and splits, cracks
        // snapping and booming ever closer together; violet crackle and lightning thicken from
        // halfway; the air is drawn in; and at the end one tight breath and silence.
        // No beeps: every pitched voice is a rough Fm growl, and nothing rings on a note.
        "regency_fallen_gather": (
            length: 15, peak: 0.72, room: 0.4,
            layers: [
                // Waking: a heavy contactor clunk deep in the body, the thud of the drive taking hold,
                // and the whole frame settling with a long low shudder of metal.
                Burst(low: 40, high: 420, attack: 0.001, decay: 0.06, gain: 5, seed: 9701),
                Tone(from: 72, to: 36, glide: 0.3, attack: 0.003, decay: 0.5, gain: 0.9),
                Sweep(at: 0.03, from: 520, to: 140, glide: 1.4, q: 2.5, attack: 0.08, decay: 0.8, gain: 0.5, seed: 9702),
                // The great rings turning over from rest: a rough growl and the voices above it,
                // climbing as they spin up, the inner ring joining later and turning the other way.
                Fm(at: 0.15, from: 22, to: 60, glide: 14.65, ratio: 0.5, index: 2.4, fade: 1000, attack: 14.65, decay: 0.025, gain: 0.75),
                Fm(at: 1.5, from: 46, to: 135, glide: 13.3, ratio: 0.5, index: 2, fade: 1000, attack: 13.3, decay: 0.025, gain: 0.5, pan: -0.2),
                Fm(at: 4, from: 72, to: 205, glide: 10.8, ratio: 0.5, index: 1.6, fade: 1000, attack: 10.8, decay: 0.025, gain: 0.36, pan: 0.2),
                // Over the last few seconds the whole of it tightens: a fourth, higher voice.
                Fm(at: 10.5, from: 150, to: 320, glide: 4.3, ratio: 0.5, index: 1.3, fade: 6, attack: 4.3, decay: 0.025, gain: 0.24),
                // The bearings taking the weight as the rings first turn: a low grinding rumble that
                // carries the first seconds and gives way to the rest.
                Roll(at: 0.3, from: 240, to: 420, glide: 6, attack: 1.2, decay: 4, gain: 0.55, swell: 3, depth: 0.7, seed: 9705),
                Foam(at: 0.6, from: 520, to: 700, glide: 6, q: 0.9, attack: 1.5, decay: 3.5, gain: 0.3, swell: 9, depth: 0.8, pan: 0.3, seed: 9706),
                // The frame groaning under the load: low strained creaks, further apart at first,
                // each a little higher and harder than the last.
                Sweep(at: 0.8, from: 150, to: 105, glide: 1.6, q: 4, attack: 0.35, decay: 0.7, gain: 0.6, pan: -0.176, seed: 9710),
                Fm(at: 0.8, from: 64, to: 50, glide: 1.4, ratio: 0.5, index: 1.1, fade: 1, attack: 0.3, decay: 0.6, gain: 0.14),
