        // The battle scorpion's Pinched-plasmeric Beam, held: heard as this loop while it
        // fires, not a shot a tick. A deep root and its harmonics throbbing five times a
        // second as the stream is driven downrange, a low roar of it under them and a
        // narrow sizzle where it bites. Nothing above the low mids. Every frequency and
        // wobble is a whole number of cycles in the 2 s loop.
        "regency_pinched_beam": (
            length: 2.0, peak: 0.62, room: 0.15, looped: true,
            layers: [
                Drone(freq: 32, gain: 0.09, wobble: 5, depth: 0.35),
                Drone(freq: 64, gain: 0.07, wobble: 5, depth: 0.45),
                Drone(freq: 96, gain: 0.045, wobble: 10, depth: 0.5),
                Drone(freq: 128, gain: 0.03, wobble: 10, depth: 0.6),
                Drone(freq: 256, gain: 0.015, wobble: 10, depth: 0.7),
                Drive(1.5),
                Rumble(freq: 140, q: 0.7, gain: 2.4, wobble: 5, depth: 0.35),
                Rumble(freq: 720, q: 1.8, gain: 1.3, wobble: 10, depth: 0.55),
            ],
        ),
        // ---- the Scourge's Heavy Pinch-fusion Lance ----
        // The belly core spinning up, heard once as the 2.5 s charge begins. It starts low
        // and quiet so the end can be big: a field clunk as the containment engages, a deep
        // rough hum the gravity clamp makes as it bears down, a growl that fills in over it
        // and only leans up, the plasma's pressure heaving at random and rising, the air
        // drawn in. In the last second the core overloads: a rougher growl an octave up,
        // a fizz and crackle thickening at random (never on an even beat), arcs snapping
        // out, and the pinch drawing in on itself until the lance lights at 2.5 s with a
        // crack, a slam and a deep boom, its roar rolling off over half a second.
        "regency_lance_charge": (
            length: 3.2, peak: 0.8, room: 0.3,
            layers: [
                // The containment engaging, deep, with a dull clank of the ring taking up.
                Burst(low: 45, high: 380, attack: 0.001, decay: 0.035, gain: 3.5, seed: 101),
                Tone(from: 58, to: 36, glide: 0.12, attack: 0.002, decay: 0.16, gain: 0.45),
                Fm(at: 0.004, from: 210, to: 196, glide: 0.05, ratio: 1.41, index: 1.2, fade: 0.03, attack: 0.001, decay: 0.05, gain: 0.18),
                // The gravity clamp bearing down: a deep rough hum filling the whole charge.
                Fm(at: 0.03, from: 34, to: 46, glide: 2.4, ratio: 0.5, index: 2.6, fade: 8.0, attack: 2.45, decay: 0.03, gain: 0.6),
                // Its mid body, coming in behind it.
                Fm(at: 0.35, from: 96, to: 124, glide: 2.1, ratio: 0.5, index: 2.2, fade: 8.0, attack: 2.12, decay: 0.03, gain: 0.85),
                // The overload: a rougher growl an octave up, only in the last stretch.
                Fm(at: 1.35, from: 196, to: 248, glide: 1.1, ratio: 0.5, index: 1.7, fade: 8.0, attack: 1.12, decay: 0.03, gain: 0.55),
                Fm(at: 1.9, from: 300, to: 372, glide: 0.6, ratio: 0.5, index: 1.2, fade: 8.0, attack: 0.58, decay: 0.03, gain: 0.25, pan: 0.15),
                // The lance lighting: a crack, a slam, a deep boom that holds, a growl in it.
                Burst(at: 2.5, low: 600, high: 2800, attack: 0.0002, decay: 0.007, gain: 14, seed: 102),
                Burst(at: 2.5, low: 90, high: 900, attack: 0.0005, decay: 0.08, gain: 26, seed: 103),
                Burst(at: 2.502, low: 30, high: 220, attack: 0.004, decay: 0.22, gain: 13, seed: 104),
                Tone(at: 2.5, from: 120, to: 46, glide: 0.15, attack: 0.001, decay: 0.2, gain: 1.3),
                Tone(at: 2.5, from: 58, to: 32, glide: 0.35, attack: 0.004, decay: 0.3, gain: 0.9),
                Fm(at: 2.5, from: 140, to: 82, glide: 0.25, ratio: 0.5, index: 2.4, fade: 0.2, attack: 0.002, decay: 0.22, gain: 0.7),
                Drive(1.5),
                // The air drawn in early on, its band falling as it is pulled in.
                Sweep(at: 0.05, from: 2400, to: 500, glide: 1.5, q: 0.9, attack: 0.9, decay: 0.55, gain: 0.45, seed: 105),
                // The plasma's pressure: a slow random heave that grows and brightens.
                Roll(at: 0.08, from: 220, to: 700, glide: 2.4, attack: 2.4, decay: 0.03, gain: 0.8, swell: 6, depth: 0.4, seed: 306),
                // The core going white: a fizz spreading up, then crackle thickening either side.
                Foam(at: 0.9, from: 1100, to: 2000, glide: 1.6, q: 0.9, attack: 1.58, decay: 0.03, gain: 1.3, swell: 40, depth: 0.9, seed: 107),
                Roll(at: 1.2, from: 1800, to: 2600, glide: 1.3, attack: 1.28, decay: 0.03, gain: 0.45, swell: 95, depth: 1.0, pan: -0.3, seed: 108),
                Roll(at: 1.55, from: 1700, to: 2500, glide: 0.95, attack: 0.93, decay: 0.03, gain: 0.45, swell: 105, depth: 1.0, pan: 0.3, seed: 109),
                // Arcs snapping out, at random, harder as it goes.
                Burst(at: 1.31, low: 700, high: 2600, attack: 0.0002, decay: 0.004, gain: 0.9, pan: 0.3, seed: 111),
                Burst(at: 1.62, low: 700, high: 2600, attack: 0.0002, decay: 0.003, gain: 1.1, pan: -0.35, seed: 112),
                Burst(at: 1.71, low: 700, high: 2600, attack: 0.0002, decay: 0.005, gain: 1.2, pan: 0.1, seed: 113),
                Burst(at: 1.93, low: 700, high: 2600, attack: 0.0002, decay: 0.004, gain: 1.5, pan: -0.15, seed: 114),
                Burst(at: 2.04, low: 700, high: 2600, attack: 0.0002, decay: 0.003, gain: 1.4, pan: 0.4, seed: 115),
