        // ---- weapons -------------------------------------------------------------------
        // Every Regency turret throws plasma, and every one is heard as plasma: a hot,
        // wet thump of the bolt leaving the pinch and a sizzle riding on it, never a
        // laser pew, never a slug's crack (docs/STYLE.md "The Regency suite"). The tiers
        // are told apart by what the gun does before and after, not by pitch alone: the
        // Picket spits, the Halberd squeezes and pinches out one roaring jet, the Sunspear draws
        // the air in until it goes critical and roars. Every sizzle is noise (`Foam`,
        // `Roll`), and no tone above the low mids ever falls: that is the pew.
        //
        // The Plasmeric Repeater (the Picket's, the Sledge's, the navy's): one bolt a
        // play, up to five a second from one gun and several guns at once, so it is
        // finished inside half a second. Three stages, none of them a tone that falls
        // above the low mids: the containment snapping open (a hard bright snap and a
        // crackle of discharge), the bolt spat out (a heavy push of air and a deep growl
        // with a kick under it, all body), and the hot plasma riding off with it (a fizz
        // and a throat of air that settle into a short rolling report).
        "regency_repeater": (
            length: 0.5, peak: 0.46, room: 0.12,
            layers: [
                // The snap of the field letting go: bright, a few milliseconds.
                Burst(low: 700, high: 4800, attack: 0.0003, decay: 0.004, gain: 4, seed: 41),
                // The spit: a soft-edged push of air.
                Burst(low: 120, high: 1300, attack: 0.001, decay: 0.03, gain: 5.5, seed: 42),
                // The kick under it, and the growl settling low within 80 ms.
                Tone(from: 115, to: 52, glide: 0.06, attack: 0.001, decay: 0.08, gain: 0.75),
                Fm(from: 250, to: 118, glide: 0.07, ratio: 0.5, index: 2.4, fade: 0.05, attack: 0.002, decay: 0.09, gain: 0.95),
                Drive(1.6),
                // The discharge crackling as the bolt tears out of the mouth.
                Roll(at: 0.002, from: 3600, to: 1500, glide: 0.1, attack: 0.002, decay: 0.05, gain: 0.55, swell: 95, depth: 1.0, seed: 43),
                // The plasma's throat: a wide band of air dropping as the bolt leaves.
                Sweep(at: 0.004, from: 1500, to: 480, glide: 0.12, q: 1.2, attack: 0.005, decay: 0.08, gain: 0.75, seed: 44),
                // The fizz riding off with the bolt.
                Foam(at: 0.01, from: 2600, to: 1700, glide: 0.2, q: 1.0, attack: 0.008, decay: 0.11, gain: 2.3, swell: 45, depth: 0.8, seed: 45),
                // A short rolling report behind it.
                Roll(at: 0.02, from: 520, to: 160, glide: 0.3, attack: 0.02, decay: 0.12, gain: 0.4, swell: 8, depth: 0.5, seed: 46),
            ],
        ),
        // A repeater bolt splashing: a wet hard splat and a low thud as it dumps its heat
        // into what it hit, then the plasma frying on it, crackling and searing, under a
        // short low rumble of air. A stream of them lands, so it is gone inside 0.7 s.
        "regency_repeater_hit": (
            length: 0.7, peak: 0.44, room: 0.16,
            layers: [
                Burst(low: 250, high: 2600, attack: 0.0004, decay: 0.006, gain: 5, seed: 51),
                Burst(low: 70, high: 650, attack: 0.001, decay: 0.035, gain: 6.5, seed: 52),
                Tone(from: 96, to: 48, glide: 0.07, attack: 0.001, decay: 0.1, gain: 0.65),
                Fm(from: 185, to: 84, glide: 0.07, ratio: 0.5, index: 2.2, fade: 0.05, attack: 0.002, decay: 0.08, gain: 0.7),
                Drive(1.5),
                // The plasma spattering and frying on what it hit.
                Foam(at: 0.004, from: 2600, to: 1400, glide: 0.4, q: 0.9, attack: 0.005, decay: 0.17, gain: 1.7, swell: 50, depth: 0.9, seed: 53),
                // Its crackle, quick and fierce.
                Roll(at: 0.01, from: 4200, to: 2000, glide: 0.3, attack: 0.003, decay: 0.1, gain: 0.45, swell: 100, depth: 1.0, seed: 54),
                // Searing.
                Hiss(at: 0.03, freq: 1800, q: 0.7, attack: 0.03, decay: 0.16, gain: 0.25, seed: 55),
                // A short low rumble of the air it heated.
                Roll(at: 0.01, from: 420, to: 120, glide: 0.4, attack: 0.02, decay: 0.15, gain: 0.45, swell: 6, depth: 0.5, seed: 56),
            ],
        ),

        // The raider's Twin Plasmeric Repeater: the repeater's bolt from a smaller gun,
        // a little tighter and lighter, four a second from each raider.
        "regency_repeater_light": (like: "regency_repeater", size: 0.82, peak: 0.34),
        "regency_repeater_light_hit": (like: "regency_repeater_hit", size: 0.82, peak: 0.32),

        // The Halberd's Pinched-plasmeric Cannon, heard 1.0 s before its salvo: plasma
        // drawn in and squeezed into a ball by gravity. A field closing with a clunk, a
        // deep rough hum filling up and only leaning upward, the air rushing in (a noise
        // band that falls as it is drawn tight), a sizzle and a slow random throb
        // swelling under it, and at the end the pinch snapping shut into the shot.
        "regency_halberd_charge": (
            length: 1.2, peak: 0.36, room: 0.2,
            layers: [
                // The gravity field engaging.
                Burst(low: 80, high: 600, attack: 0.0008, decay: 0.016, gain: 3),
                Tone(from: 72, to: 50, glide: 0.05, attack: 0.002, decay: 0.08, gain: 0.4),
                // The squeeze: a deep growl and its rough mid body filling up.
                Fm(at: 0.02, from: 52, to: 64, glide: 0.95, ratio: 0.5, index: 2.2, fade: 3.0, attack: 0.93, decay: 0.035, gain: 0.5),
                Fm(at: 0.12, from: 150, to: 172, glide: 0.85, ratio: 0.5, index: 1.4, fade: 3.0, attack: 0.83, decay: 0.035, gain: 0.6),
                Drive(1.4),
