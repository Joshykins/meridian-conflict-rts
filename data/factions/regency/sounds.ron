                // Its mid body, coming in later.
                Fm(at: 0.5, from: 108, to: 126, glide: 1.65, ratio: 0.5, index: 2.0, fade: 6.0, attack: 1.64, decay: 0.035, gain: 0.9),
                // The overload: a rougher growl an octave up, only in the last stretch.
                Fm(at: 1.45, from: 210, to: 236, glide: 0.75, ratio: 0.5, index: 1.6, fade: 6.0, attack: 0.69, decay: 0.035, gain: 0.5),
                Drive(1.45),
                // The air drawn in early on, its band falling as it is pulled in, then settling.
