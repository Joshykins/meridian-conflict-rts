        // ---- weapons -------------------------------------------------------------------
        // The repeaters use the selected compact accelerator pulse. The larger
        // guns keep their distinct charge, jet and fusion reports; those sounds
        // are not changed by the repeater selection.
        //
        // Audition F, selected by the user: play the actual approved waveform.
        // Its own short room is baked in. Playback is about 3 dB below the
        // audition level to sit alongside the Warden's slower cannon report.
        "regency_repeater": (
            length: 0.62, peak: 0.49, room: 0.0,
            layers: [Sample(file: "sounds/samples/regency-repeater-f.wav")],
        ),
        // The same accelerator field breaking on impact, slightly lower and heavier.
        "regency_repeater_hit": (like: "regency_repeater", size: 1.15, peak: 0.37),

        // The raider's Twin Plasmeric Repeater: the repeater's bolt from a smaller gun,
        // a little tighter and lighter, four a second from each raider.
        "regency_repeater_light": (like: "regency_repeater", size: 0.82, peak: 0.24),
        "regency_repeater_light_hit": (like: "regency_repeater_hit", size: 0.82, peak: 0.23),

        // The Halberd's Pinched-plasmeric Cannon, heard 1.0 s before its salvo: plasma
        // drawn in and squeezed into a ball by gravity. A field closing with a clunk, a
        // deep rough hum filling up and only leaning upward, the air rushing in (a noise
        // band that falls as it is drawn tight), a sizzle and a slow random throb
        // swelling under it, and at the end the pinch snapping shut into the shot.
        "regency_halberd_charge": (
            length: 1.2, peak: 0.36, room: 0.2,
            layers: [
                // The gravity field engaging.
                Burst(low: 80, high: 600, attack: 0.0008, decay: 0.016, gain: 3),
                Tone(from: 72, to: 50, glide: 0.05, attack: 0.002, decay: 0.08, gain: 0.4),
                // The squeeze: a deep growl and its rough mid body filling up.
                Fm(at: 0.02, from: 52, to: 64, glide: 0.95, ratio: 0.5, index: 2.2, fade: 3.0, attack: 0.93, decay: 0.035, gain: 0.5),
                Fm(at: 0.12, from: 150, to: 172, glide: 0.85, ratio: 0.5, index: 1.4, fade: 3.0, attack: 0.83, decay: 0.035, gain: 0.6),
                Drive(1.4),
                // Plasma drawn in: the band falls as it is pulled tight.
                Sweep(at: 0.05, from: 2600, to: 650, glide: 0.9, q: 1.1, attack: 0.88, decay: 0.035, gain: 0.7, seed: 11),
                // The pressure throbbing at random, harder as it fills.
                Roll(at: 0.15, from: 320, to: 520, glide: 0.8, attack: 0.8, decay: 0.035, gain: 0.8, swell: 9, depth: 0.85, seed: 12),
                // The pinch snapping shut, swelling into the shot.
                Burst(at: 0.955, low: 150, high: 1000, attack: 0.03, decay: 0.012, gain: 3, seed: 14),
            ],
        ),
        // The Halberd's shot leaving: the pinch opens and lets its plasma out as one jet a
        // quarter of a second long, then shuts on it. A hard pressure crack, a rough held
        // growl and the jet roaring out under a fizz for as long as it runs, a thoom as the
        // pinch closes, a short roll of the air. No falling tone above the low mids.
        "regency_halberd_fire": (
            length: 1.0, peak: 0.62, room: 0.3,
            layers: [
                // The pinch opening.
                Burst(low: 500, high: 2400, attack: 0.0002, decay: 0.005, gain: 9),
                Burst(low: 90, high: 800, attack: 0.0005, decay: 0.03, gain: 11),
                Burst(at: 0.001, low: 40, high: 240, attack: 0.002, decay: 0.08, gain: 7),
                Tone(from: 120, to: 60, glide: 0.08, attack: 0.001, decay: 0.1, gain: 0.9),
                // The jet: a rough growl held as it runs.
                Fm(from: 96, to: 82, glide: 0.25, ratio: 0.5, index: 2.4, fade: 0.4, attack: 0.004, decay: 0.2, gain: 0.75),
                Fm(at: 0.01, from: 190, to: 172, glide: 0.25, ratio: 0.5, index: 1.6, fade: 0.4, attack: 0.02, decay: 0.18, gain: 0.45),
                Drive(1.55),
                // The pinch shutting on the tail of the jet.
                Burst(at: 0.24, low: 80, high: 700, attack: 0.002, decay: 0.035, gain: 6, seed: 23),
                Tone(at: 0.24, from: 105, to: 52, glide: 0.08, attack: 0.002, decay: 0.12, gain: 0.7),
                // The air rolling after it down range.
                Roll(at: 0.03, from: 700, to: 140, glide: 0.5, attack: 0.03, decay: 0.2, gain: 0.5, swell: 10, depth: 0.5, seed: 24),
            ],
        ),
        // The Wake's projector winding up, 0.8 s before the wave: a quick, hard charge that
        // tells the field a big shot is coming. A contactor clunk, then the field spinning
        // up: a rough growl and its octave climbing fast together, a rising rush of air
        // drawn into the mouth and a sizzle thickening over it, all crowding into the
        // last tenth of a second; then a short drawn breath as the pinch closes, and the
        // charge is silent when the wave goes.
        "regency_wake_charge": (
            length: 0.85, peak: 0.5, room: 0.2,
            layers: [
                // The field engaging.
                Burst(low: 60, high: 500, attack: 0.0008, decay: 0.02, gain: 4, seed: 81),
                Tone(from: 70, to: 46, glide: 0.06, attack: 0.002, decay: 0.08, gain: 0.5),
                // The spin-up: a rough growl and its octave climbing fast, rougher as it goes.
                Fm(at: 0.02, from: 70, to: 210, glide: 0.7, ratio: 0.5, index: 2.4, fade: 3.0, attack: 0.68, decay: 0.03, gain: 0.55),
                Fm(at: 0.04, from: 140, to: 430, glide: 0.68, ratio: 0.5, index: 1.5, fade: 3.0, attack: 0.66, decay: 0.03, gain: 0.45),
                Drive(1.5),
                // Air drawn into the mouth, its band rising as it fills.
                Sweep(at: 0.03, from: 500, to: 2600, glide: 0.68, q: 1.0, attack: 0.66, decay: 0.03, gain: 0.8, seed: 82),
                // The sizzle: fast random crackle, thickening into the shot.
                Roll(at: 0.15, from: 900, to: 2200, glide: 0.55, attack: 0.55, decay: 0.03, gain: 0.7, swell: 60, depth: 0.9, seed: 83),
                // The pressure heaving under it, faster as it fills.
                Roll(at: 0.05, from: 220, to: 420, glide: 0.65, attack: 0.64, decay: 0.03, gain: 0.6, swell: 14, depth: 0.85, seed: 84),
                // The pinch drawing its breath in: a short hiss falling into the shot.
                Sweep(at: 0.7, from: 3000, to: 900, glide: 0.08, q: 1.2, attack: 0.07, decay: 0.012, gain: 0.5, seed: 85),
            ],
        ),
        // The Wake's wave: the plasma gathered across the projector's mouth is let go as one
        // wall that rolls out over 540 m of ground, and it should sound like the biggest gun
        // on the field. A blinding crack over a huge whump, a deep boom that holds and
        // throbs, a rough metal-edged growl driven hard so the whole blast tears, then the
        // wave roaring away, wide across the stereo field, and thunder rolling off long
        // and low with the ground slapping it back. The weight sits in the low mids as
        // well as the sub, so it carries on small speakers; quiet before the next shot
        // 2.6 s later. No tone falls above the low mids, no pitched layer rings out.
        "regency_wake_fire": (
            length: 2.6, peak: 0.9, room: 0.45,
            layers: [
                // The pinch letting go: the crack and the whump.
                Burst(low: 600, high: 3000, attack: 0.0002, decay: 0.008, gain: 8, seed: 61),
                Burst(low: 90, high: 900, attack: 0.0005, decay: 0.08, gain: 15, seed: 62),
