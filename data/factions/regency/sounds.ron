                Fm(at: 0.25, from: 112, to: 126, glide: 1.7, ratio: 0.5, index: 2.4, fade: 6.0, attack: 1.68, decay: 0.03, gain: 0.55),
                Fm(at: 1.2, from: 224, to: 246, glide: 0.75, ratio: 0.5, index: 1.6, fade: 6.0, attack: 0.73, decay: 0.03, gain: 0.3),
                // Its throb: low noise swelling and sagging, slowly at first, then faster and
                // deeper as the charge fills.
                Roll(at: 0.3, from: 180, to: 320, glide: 1.0, attack: 0.9, decay: 0.25, gain: 0.6, swell: 3.5, depth: 0.9, seed: 6612),
                Roll(at: 1.0, from: 240, to: 460, glide: 0.95, attack: 0.92, decay: 0.03, gain: 0.7, swell: 8, depth: 0.9, seed: 6613),
                Drive(1.4),
