            ],
        ),
        // ---- the Scourge's Heavy Pinch-fusion Lance ----
        // The belly core spinning up, heard once as the 2.5 s charge begins. It starts low
        // and quiet so the end can be big: a field clunk as the containment engages, a deep
        // rough hum the gravity clamp makes as it bears down, a growl that fills in over it
        // and only leans up, the plasma's pressure heaving at random and rising, the air
        // drawn in. In the last second the core overloads: a rougher growl an octave up,
        // and the pinch drawing in on itself until the lance lights at 2.5 s with a
        // crack, a slam and a deep boom, its roar rolling off over half a second.
        "regency_lance_charge": (
            length: 3.2, peak: 0.8, room: 0.3,
            layers: [
                // The containment engaging, deep, with a dull clank of the ring taking up.
                Burst(low: 45, high: 380, attack: 0.001, decay: 0.035, gain: 3.5, seed: 101),
                Tone(from: 58, to: 36, glide: 0.12, attack: 0.002, decay: 0.16, gain: 0.45),
                Fm(at: 0.004, from: 210, to: 196, glide: 0.05, ratio: 1.41, index: 1.2, fade: 0.03, attack: 0.001, decay: 0.05, gain: 0.18),
                // The gravity clamp bearing down: a deep rough hum filling the whole charge.
                Fm(at: 0.03, from: 34, to: 46, glide: 2.4, ratio: 0.5, index: 2.6, fade: 8.0, attack: 2.45, decay: 0.03, gain: 0.6),
                // Its mid body, coming in behind it.
                Fm(at: 0.35, from: 96, to: 124, glide: 2.1, ratio: 0.5, index: 2.2, fade: 8.0, attack: 2.12, decay: 0.03, gain: 0.85),
                // The overload: a rougher growl an octave up, only in the last stretch.
                Fm(at: 1.35, from: 196, to: 248, glide: 1.1, ratio: 0.5, index: 1.7, fade: 8.0, attack: 1.12, decay: 0.03, gain: 0.55),
                Fm(at: 1.9, from: 300, to: 372, glide: 0.6, ratio: 0.5, index: 1.2, fade: 8.0, attack: 0.58, decay: 0.03, gain: 0.25, pan: 0.15),
                // The lance lighting: a crack, a slam, a deep boom that holds, a growl in it.
                Burst(at: 2.5, low: 600, high: 2800, attack: 0.0002, decay: 0.007, gain: 14, seed: 102),
                Burst(at: 2.5, low: 90, high: 900, attack: 0.0005, decay: 0.08, gain: 26, seed: 103),
                Burst(at: 2.502, low: 30, high: 220, attack: 0.004, decay: 0.22, gain: 13, seed: 104),
