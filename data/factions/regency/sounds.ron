                Sweep(at: 0.05, from: 2600, to: 650, glide: 0.9, q: 1.1, attack: 0.88, decay: 0.035, gain: 0.7, seed: 11),
                // The pressure throbbing at random, harder as it fills.
                Roll(at: 0.15, from: 320, to: 520, glide: 0.8, attack: 0.8, decay: 0.035, gain: 0.8, swell: 9, depth: 0.85, seed: 12),
                // The ball's skin sizzling.
                Foam(at: 0.3, from: 1700, to: 2300, glide: 0.7, q: 1.0, attack: 0.67, decay: 0.035, gain: 1.0, swell: 34, depth: 0.9, seed: 13),
                // The pinch snapping shut, swelling into the shot.
                Burst(at: 0.955, low: 150, high: 1000, attack: 0.03, decay: 0.012, gain: 3, seed: 14),
            ],
        ),
        // The Halberd's shot leaving: the pinch opens and lets its plasma out as one jet a
