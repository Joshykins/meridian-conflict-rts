// Regency strategic weapons: the silo that throws a Pinch-fusion Warhead and the array of
// Gravitic Interceptors that answers one, and the Springald map gun (last). The two
// launchers assemble and fire by the same rules as ARC's Sunfall and Parhelion (`docs/NUKES.md`), with a yield to match; only the look and
// the sound are the Regency's (`nuke_look: Plasma` in faction.ron): the warhead goes up
// as a red plasma nova and leaves a glowing cloud of plasma standing over the ground for
// minutes, and the missiles leave dark trails with a white-hot streak at the tail.
[
    (
        // A low plated vault over one deep launch tube ringed by leaning lens pylons; the
        // warhead store beside it is a well loaded by a gravity lift, a floating collar
        // held by low emitter posts (no crane: `models::regency::strategic`).
        key: "regency_t4_nuke_silo",
        name: "Mangonel",
        role: "Pinch-fusion Warhead Silo", title: "Nuke Silo",
        tech: 4,
        categories: ["Land", "Strategic", "Experimental"],
        health: 42000,
        cost: (mass: 9000, energy: 90000, time: 36000),
        radius: 42.5, height: 26, footprint: (8, 8),
        vision: 300,
        strategic: (
            kind: Nuke,
            // One warhead: about five minutes on the silo's own assembly line, as a Sunfall's.
            // Its own power is high and the round long, so engineers assisting add little: a
            // nuke is hard to rush (user, 2026-10-07).
            missile: (mass: 6000, energy: 120000, time: 720000),
            power: 2400,
            stock: 2,
            speed: 320,
            apogee: 4200,
            // The Sunfall's yield: every race's warhead does about the same (user, 2026-09-25).
            blast: (radius: 598, core: 230, damage: 80000, edge: 2500, front: 1.0),
        ),
        mesh: "regency_nuke_silo", icon: Silo,
        sounds: (death: "blast_large"),
    ),
    (
        // A launch block of four cells beside a mast of turning sensor rings, and the
        // magazine that loads them by a gravity lift.
        key: "regency_t4_nuke_defense",
        name: "Barbican",
        role: "Gravitic Interceptor Array", title: "Nuke Defense",
        tech: 4,
        categories: ["Land", "Strategic", "Experimental"],
        health: 16000,
        cost: (mass: 3200, energy: 32000, time: 8000),
        radius: 18.75, height: 20, footprint: (4, 4),
        vision: 300, radar: 2400,
        economy: (energy_upkeep: 25),
        strategic: (
            kind: Interceptor,
            missile: (mass: 1500, energy: 30000, time: 180000),
            power: 1800,
            stock: 4,
            speed: 900,
            apogee: 0,
            coverage: 2400,
        ),
        mesh: "regency_nuke_defense", icon: AntiNuke,
        sounds: (death: "blast_large"),
    ),
    (
        // The Regency's map gun, the Culverin's answer: a Pinch-fusion Howitzer on a
        // turntable, its bore made for three charges at once. It gathers three knots of
        // fusion in front of its bore and lobs them high over everything as one shot, the
        // three wound round each other like the strands of a rope all the way up and over
        // (`braid`, drawn only: the sim flies one shot), closing into one just before it
        // lands as a supernova. Like the Culverin it shells the nearest enemy its side can
        // see or has on radar anywhere in reach, building, army or fleet.
        //
        // Balance: the Culverin's (10000 mass, 30000 HP, 5200 every 9 s, 45 m splash, 1
        // degree of spread, 22 km), bent the Regency way as the Kiln is bent from the
        // Trebuchet: a harder strike (5600) in a tighter blast (40 m), laid truer (0.8
        // degrees) and charged longer (4 s), a little slower to load (10 s), so about the
        // same damage a second.
        //
        // Model: `regency_springald` (`models::regency::turrets::springald`), authored at this
        // size; `pivot`/`muzzle` are its trunnion and the middle of its charge, the gun laid
        // 45 degrees up at rest so it always stands raised (it only ever lobs higher, and
        // `keeps_aim` holds it there); the raised gun is why it stands 48 m.
        key: "regency_t4_artillery",
        name: "Springald",
        role: "Strategic Artillery",
        tech: 4,
        categories: ["Land", "Artillery", "Strategic", "Experimental"],
        health: 30000,
        cost: (mass: 10000, energy: 100000, time: 36000),
        radius: 30, height: 48, footprint: (6, 6),
        vision: 300,
        weapons: [(
            name: "Triune Pinch-fusion Howitzer",
            damage: 5600, splash: 40, range_min: 1500, range: 22000, reload: 10.0, speed: 800,
            trajectory: Ballistic, loft: 15,
            spread: 0.8,
            turret_turn: 8, pivot: (0, 0, 18), muzzle: (36.77, 0, 54.77),
            targets: ["Structure", "Land", "Naval"], keeps_aim: true,
            bombard: 2000,
            color: Orange, red: 1.0,
            plasma_grade: Some(PinchFusion), braid: 3,
            flash: 1.6, impact: 1.6, tracer: 2.4,
            sounds: (
                fire: "regency_triune_fire", charge: "regency_triune_charge", charge_time: 4.0,
                charge_volume: 1.8,
                impact: "regency_triune_hit", ground: "regency_triune_hit", far: "regency_triune_far",
            ),
        )],
        mesh: "regency_springald", icon: Artillery,
        sounds: (death: "blast_large"),
    ),
    (
        // The Regency's area defence: a tall plated spire that makes plasma orbs, small red
        // flecks, and keeps them drifting round its shaft in the air like fireflies, eight
        // at a time, up to thirty-two (four batches), so a quiet minute stores a whole
        // barrage. When anything comes into reach the flecks go out at it one after
        // another, each leaving from wherever it floats, and home on it: they are fast and
        // very accurate, they take another foe when their mark dies, and a fleck with
        // nothing left to hit flies back to the spire and rejoins the store. It shoots
        // anything that is not a submerged boat: structures, land units, ships and, above
        // all, aircraft, which dodge a lobbed shell but not a fleck that turns with them.
        // Each melts a small pool of ground and bursts in plasma. The flecks' homes are
        // the weapon's `muzzles` (the places they drift about, `mc_sim::orbs::place`); the
        // model has no cradles for them, they are light drawn by the renderer.
        //
        // Balance: it is a T4 that holds the line, not one that breaks it. A fleck is 200;
        // a batch of eight every 4 s sustains 400 a second, against the Springald's 560,
        // and the full store, 6400, goes out in under two seconds on whatever walks into
        // 1700 m. Because the flecks home, nearly all of it lands: on one mark it is far
        // more than lobbed shells of the same weight were, and it can't be outrun or dodged
        // by air. The spire can't shoot at anything inside 80 m.
        //
        // Model: `regency_carillon` (`models::regency::carillon`), authored at this size.
        key: "regency_t4_area_defense",
        name: "Carillon",
        role: "Orb Battery", title: "Area Defense",
        tech: 4,
        categories: ["Land", "Defense", "Experimental"],
        health: 26000,
        cost: (mass: 6500, energy: 65000, time: 26000),
        radius: 18.75, height: 66, footprint: (4, 4),
        vision: 450, radar: 900,
        economy: (energy_upkeep: 30),
        weapons: [(
            name: "Plasma Fleck Battery",
            damage: 200, splash: 14, proximity: 7, range_min: 80, range: 1700, reload: 1.0, speed: 420,
            trajectory: Direct,
            spread: 12,
            salvo: 32, salvo_delay: 0.05,
            orbs: 8, orb_time: 4.0,
            turret_turn: 0, arc: 360, muzzle: (11.5, 0, 40),
            muzzles: [
                (11.00, 0.00, 18.0), (-9.95, 9.12, 36.2), (1.39, -15.94, 54.4), (7.46, 9.72, 27.8),
                (-14.53, -2.56, 46.0), (9.28, -5.91, 19.4), (-3.49, 13.04, 37.6), (-7.39, -14.19, 55.8),
                (11.51, 4.19, 29.2), (-13.63, 5.64, 47.4), (4.65, -9.97, 20.8), (4.06, 12.88, 39.0),
                (-13.86, -8.00, 57.2), (11.96, -2.65, 30.6), (-8.46, 12.08, 48.8), (-1.44, -10.91, 22.2),
                (10.34, 8.68, 40.4), (-15.98, 0.70, 58.6), (8.66, -8.66, 32.0), (-0.64, 14.74, 50.2),
                (-7.07, -8.43, 23.6), (13.38, 1.76, 41.8), (-13.11, 9.18, 60.0), (2.65, -11.96, 33.4),
                (7.38, 12.77, 51.6), (-10.49, -3.31, 25.0), (12.24, -5.71, 43.2), (-6.12, 14.78, 61.4),
                (-4.19, -11.51, 34.8), (13.08, 6.81, 53.0), (-10.63, 2.85, 26.4), (7.25, -11.39, 44.6),
            ],
            targets: ["Air", "Land", "Naval", "Structure"],
            color: Orange, red: 1.0,
            plasma_grade: Some(Pinched), melt: 0.6,
            flash: 0.4, impact: 0.8, tracer: 0.5, streak: 1.6, wake: 1.5,
            sounds: (
                fire: "regency_carillon_fire", make: "regency_carillon_make",
                impact: "regency_carillon_hit", ground: "regency_carillon_hit",
            ),
        )],
        mesh: "regency_carillon", icon: Defense,
        sounds: (death: "blast_large"),
    ),
]
