[
    // The Regency commander: a tall war machine on heavy legs and armoured boots, a keeled
    // chest under courses of plates, spiked pauldrons swept back, a long narrow head with two
    // red eyes, a telescoping plasmeric cannon for its right forearm and a taloned left hand
    // that builds. Its torso turns to face what it shoots or builds (and
    // holds its fire while it builds); each forearm pitches about its elbow. Model:
    // `regency_commander` (`models::regency::commander`). It builds only Regency structures (mc-data
    // refuses anything else).
    //
    // Refits: the engineering suites on the hand's forearm; the cannon forearm rebuilt as a
    // pinched-plasmeric cannon, then a pinch-fusion one; on the back, nanite repair (then a
    // field that mends everything of its side round it) or the Material Formation Engine;
    // and an auxiliary engineering arm over the left shoulder.
    (
        key: "regency_commander",
        name: "Exarch",
        role: "Armored Command Unit",
        tech: 1,
        categories: ["Land", "Commander", "Engineer", "DirectFire"],
        health: 11000, regen: 10,
        cost: (mass: 18000, energy: 5000000, time: 6000000),
        radius: 10.4, height: 25,
        vision: 600, radar: 1500,
        motion: (layer: Amphibious, size: 0, speed: 17, accel: 17, turn: 150),
        economy: (mass_income: 1, energy_income: 20, mass_storage: 1000, energy_storage: 5000),
        // `arm`: the taloned hand. The torso turns to face the work, then the forearm pitches at it
        // about the elbow (`pivot`); the beam leaves the violet emitter in its palm.
        builder: (power: 10, range: 70, arm: (turn: 140, emitter: (5.2, 5.2, 14.6), pivot: (-0.5, 5.2, 14.6)), builds: [
            "regency_t1_land_factory", "regency_t1_air_factory", "regency_t1_naval_factory", "regency_t1_extractor", "regency_t1_power", "regency_storage", "regency_t1_point_defense", "regency_t1_aa", "regency_t1_radar", "regency_t1_sonar", "regency_t1_torpedo_defense", "regency_wall", "regency_t1_reclaimer",
        ]),
        weapons: [(
            name: "Plasmeric Repeater",
            // The cannon forearm: short bursts of plasmeric slugs, a commander's steady fire.
            damage: 60, splash: 2, range: 360, reload: 0.3, speed: 760, trajectory: Direct, red: 1.0,
            turret_turn: 36, muzzle: (9.6, -5.2, 14.6), pivot: (-0.5, -5.2, 14.6), spread: 0.4, sweep: 30,
            targets: ["Land", "Naval"], color: Orange, flash: 1.4, impact: 1.3, tracer: 0.8,
            rounds: 3, plasma_grade: Some(Plasmeric),
            sounds: (fire: "regency_stinger", impact: "shell_light"),
        )],
        refits: [
            (
                key: "engineering", name: "Fabrication",
                modules: [
                    (
                        key: "eng_2", icon: Engineer, name: "Engineering Suite II", tech: 2,
                        summary: "More build power and reach: twin nanite emitters and feed canisters on the build arm, heavier plating; and it builds the tech 2 structures.",
                        cost: (mass: 2400, energy: 24000, time: 1800),
                        health: 3000, regen: 5, build_power: 30, build_range: 5,
                        // The emitters come to work (rock on the forearm) over this long.
                        unfold: 0.6,
                        // The tech 2 structures, built new as well as upgraded into, as ARC's engineers do.
                        builds: ["regency_t2_transport", "regency_t2_space_frigate", "regency_t2_land_factory", "regency_t2_air_factory", "regency_t2_naval_factory", "regency_t2_extractor", "regency_storage_t2", "regency_t2_radar", "regency_t2_sonar", "regency_t2_torpedo_defense", "regency_t2_reclaimer", "regency_t2_power", "regency_t2_point_defense", "regency_t2_artillery", "regency_t2_shield", "regency_t2_aa", "regency_t2_missile_defense", "regency_t2_fabricator"],
                    ),
                    (
                        key: "eng_3", icon: Engineer, name: "Engineering Suite III", tech: 3, after: "eng_2",
                        summary: "Far more build power and reach: a fabrication lance out of the hand, a ring of emitters round the wrist, a feed drum over the elbow, heavy plating; and it builds the tech 3 structures.",
                        cost: (mass: 6000, energy: 60000, time: 4500),
                        health: 7000, regen: 15, build_power: 150, build_range: 10,
                        // The lance runs out of the palm while it builds: the beam leaves its tip.
                        arm_emitter: (8.18, 5.2, 14.6),
                        // It takes Suite II's place, so it builds the tech 2 structures too.
                        builds: ["regency_t2_transport", "regency_t2_space_frigate", "regency_t2_land_factory", "regency_t2_air_factory", "regency_t2_naval_factory", "regency_t2_extractor", "regency_storage_t2", "regency_t2_radar", "regency_t2_sonar", "regency_t2_torpedo_defense", "regency_t2_reclaimer", "regency_t2_power", "regency_t2_point_defense", "regency_t2_artillery", "regency_t2_shield", "regency_t2_aa", "regency_t2_missile_defense", "regency_t3_land_factory", "regency_t3_air_factory", "regency_t3_naval_factory", "regency_t3_extractor", "regency_t4_extractor", "regency_storage_t3", "regency_t3_radar", "regency_t3_sonar", "regency_t3_reclaimer", "regency_t3_power", "regency_t3_point_defense", "regency_t3_shield", "regency_t3_aa", "regency_t3_missile_defense", "regency_t3_assault_transport", "regency_t3_space_cruiser", "regency_t3_space_destroyer", "regency_t4_scorpion", "regency_t4_strider", "regency_t4_nuke_defense", "regency_t4_nuke_silo", "regency_t4_artillery", "regency_t2_fabricator", "regency_t3_fabricator"],
                    ),
                ],
            ),
            (
                key: "gun", name: "Cannon Arm",
                modules: [
                    (
                        key: "pinched", icon: Tank, name: "Pinched-plasmeric Cannon",
                        summary: "The cannon forearm rebuilt longer, the plasma squeezed by gravity into a dense stream: heavier hits at longer reach.",
                        cost: (mass: 700, energy: 8400, time: 800),
                        // The forearm is one gun: the new one takes the Repeater's place.
                        replaces: "Plasmeric Repeater",
                        weapons: [(
                            name: "Pinched-plasmeric Cannon",
                            damage: 240, splash: 3, range: 420, reload: 0.7, speed: 900, trajectory: Direct, red: 1.0,
                            turret_turn: 36, muzzle: (10.6, -5.2, 14.6), pivot: (-0.5, -5.2, 14.6), spread: 0.4, sweep: 30,
                            targets: ["Land", "Naval"], color: Orange, flash: 1.5, impact: 1.5, tracer: 1.1,
                            rounds: 4, round_span: 0.15, plasma_grade: Some(Pinched),
                            sounds: (fire: "regency_glaive_fire", impact: "regency_glaive_hit", ground: "regency_glaive_hit"),
                        )],
                    ),
                    (
                        key: "fusion", icon: Tank, name: "Pinch-fusion Cannon", after: "pinched",
                        summary: "The cannon pushed until the plasma fuses: long, white-hot pinch-fusion jets that burst like small stars.",
                        cost: (mass: 2000, energy: 24000, time: 2400),
                        replaces: "Plasmeric Repeater",
                        weapons: [(
                            name: "Pinch-fusion Cannon",
                            damage: 900, splash: 10, range: 700, reload: 1.4, speed: 1350, trajectory: Direct, red: 1.0,
                            turret_turn: 36, muzzle: (11.6, -5.2, 14.6), pivot: (-0.5, -5.2, 14.6), sweep: 20,
                            targets: ["Land", "Naval"], color: Orange, flash: 1.6, impact: 2.0, tracer: 1.6,
                            plasma_grade: Some(PinchFusion),
                            sounds: (fire: "regency_sunspear_fire", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
                        )],
                    ),
                ],
            ),
            (
                key: "back", name: "Back",
                modules: [
                    (
                        key: "nano_repair", icon: Engineer, name: "Nanite Repair",
                        summary: "Nanite feeds down the spine mend the Exarch's own hull, far faster than it heals bare.",
                        cost: (mass: 900, energy: 10800, time: 1100),
                        regen: 60,
                    ),
                    (
                        key: "nano_field", icon: Engineer, name: "Nanite Repair Field", after: "nano_repair",
                        summary: "The nanites go out in a cloud: every unit and structure of its side near the Exarch slowly mends, and the Exarch still mends itself.",
                        cost: (mass: 2200, energy: 26400, time: 2600),
                        // It takes Nanite Repair's place, so it carries its regen too.
                        regen: 60,
                        // A hundredth of each friend's full health a second, within 120 m.
                        repair_field: (radius: 120, rate: 0.01),
                    ),
                    (
                        key: "mfe", icon: Power, name: "Material Formation Engine",
                        summary: "Makes materials and energy on the Exarch's back.",
                        cost: (mass: 1200, energy: 14400, time: 1400),
                        // As ARC's: about a tech 1 mine and a half and a third of a tech 2
                        // reactor, carried on the one unit that ends the game if it dies.
                        economy: (mass_income: 3, energy_income: 100),
                    ),
                ],
            ),
            (
                key: "shoulder", name: "Shoulder",
                modules: [
                    (
                        key: "aux_eng", icon: Engineer, name: "Auxiliary Engineering Suite",
                        summary: "A nanite arm folds out over the left shoulder and builds with a second beam.",
                        cost: (mass: 800, energy: 9600, time: 900),
                        build_power: 60,
                        // Stands up behind the pauldron; the arm sweeps up over it, then the
                        // head unfolds at its wrist (`hinge`) and points down at the work.
                        emitters: [(3.6, 3.15, 23.5)], unfold: 1.4, hinge: (1.3, 3.15, 24.4),
                    ),
                ],
            ),
        ],
        wreck_fraction: 0.2,
        mesh: "regency_commander", icon: Commander,
        sounds: (death: "commander_death", moving: "walker_heavy", step: "regency_footfall"),
    ),
    // The Regency engineer: a low armoured craft on gravity lift, so it crosses water as it
    // crosses land (`Hover`) and every Regency factory makes it. A housing on its back turns to
    // the work, then the fabricator arm pitches at it about its trunnion (`pivot`); the beam
    // leaves the violet emitter at the arm's tip (`emitter`). Model: `regency_engineer`
    // (`models::regency::engineer`), the higher tiers drawn bigger with their own kit on it.
    //
    // Each lift bell casts red plasma under it (the model's `lifts`, renderer `lift_fx.rs`),
    // which lights the ground (the lamp below, day and night).
    (
        key: "regency_t1_engineer",
        name: "Artificer",
        role: "Engineer", title: "Engineer",
        tech: 1,
        categories: ["Land", "Engineer"],
        health: 170,
        cost: (mass: 55, energy: 280, time: 280),
        radius: 4.2, height: 3.267,
        vision: 180,
        motion: (layer: Hover, size: 0, speed: 28, accel: 30, turn: 170),
        builder: (power: 5, range: 55, arm: (turn: 200, emitter: (2.508, 0, 2.392), pivot: (0.408, 0, 2.392)), builds: [
            "regency_t1_land_factory", "regency_t1_air_factory", "regency_t1_naval_factory", "regency_t1_extractor", "regency_t1_power", "regency_storage", "regency_t1_point_defense", "regency_t1_aa", "regency_t1_radar", "regency_t1_sonar", "regency_t1_torpedo_defense", "regency_wall", "regency_t1_reclaimer",
        ]),
        // Once the side has tech 2 it can build its own next tier onto itself, where it stands.
        upgrades_to: "regency_t2_engineer",
        mesh: "regency_engineer", icon: Engineer,
        lights: [(kind: Point, at: (-0.3, 0, 0.3), color: (1.0, 0.14, 0.06), intensity: 40, range: 9, night_only: false)],
        // A stand-in: ARC's hover hum until the Regency has a lift sound of their own.
        sounds: (moving: "aster_hover"),
    ),
    // Tech 2: bigger, its arm's emitter between twin violet prongs, a feed drum on the
    // housing's back, a fourth plate in each sponson's course and a third lift collar under
    // each sponson's trailing point. Drawn at 25/21 the tech 1's size.
    (
        key: "regency_t2_engineer",
        name: "Artificer II",
        role: "Field Engineer", title: "Engineer",
        tech: 2,
        categories: ["Land", "Engineer"],
        health: 460,
        cost: (mass: 210, energy: 1260, time: 940),
        radius: 5.0, height: 3.889,
        vision: 200,
        motion: (layer: Hover, size: 0, speed: 27, accel: 28, turn: 160),
        builder: (power: 30, range: 60, arm: (turn: 200, emitter: (2.986, 0, 2.847), pivot: (0.486, 0, 2.847)), builds: [
            "regency_t2_transport", "regency_t2_space_frigate", "regency_t1_land_factory", "regency_t1_air_factory", "regency_t1_naval_factory", "regency_t1_extractor", "regency_t1_power", "regency_storage", "regency_t1_point_defense", "regency_t1_aa", "regency_t1_radar", "regency_t1_sonar", "regency_t1_torpedo_defense", "regency_wall", "regency_t1_reclaimer", "regency_t2_land_factory", "regency_t2_air_factory", "regency_t2_naval_factory", "regency_t2_extractor", "regency_storage_t2", "regency_t2_radar", "regency_t2_sonar", "regency_t2_torpedo_defense", "regency_t2_reclaimer", "regency_t2_power", "regency_t2_point_defense", "regency_t2_artillery", "regency_t2_shield", "regency_t2_aa", "regency_t2_missile_defense",
            "regency_t2_fabricator",
        ]),
        upgrades_to: "regency_t3_engineer",
        mesh: "regency_engineer", icon: Engineer,
        lights: [(kind: Point, at: (-0.35, 0, 0.35), color: (1.0, 0.14, 0.06), intensity: 60, range: 11, night_only: false)],
        sounds: (moving: "aster_hover"),
    ),
    // Tech 3: all of tech 2's, and a ring of violet emitter fins round the nozzle, a chin ram
    // under the nose with a third pair of optics, an armoured skirt down each sponson and two
    // lifts under the body for the one. Drawn at 10/7 the tech 1's size.
    (
        key: "regency_t3_engineer",
        name: "Artificer III",
        role: "Combat Engineer", title: "Engineer",
        tech: 3,
        categories: ["Land", "Engineer"],
        health: 980,
        cost: (mass: 840, energy: 6700, time: 3300),
        radius: 6.0, height: 4.667,
        vision: 220,
        motion: (layer: Hover, size: 1, speed: 26, accel: 26, turn: 150),
        builder: (power: 150, range: 70, arm: (turn: 200, emitter: (3.583, 0, 3.417), pivot: (0.583, 0, 3.417)), builds: [
            "regency_t2_transport", "regency_t2_space_frigate", "regency_t1_land_factory", "regency_t1_air_factory", "regency_t1_naval_factory", "regency_t1_extractor", "regency_t1_power", "regency_storage", "regency_t1_point_defense", "regency_t1_aa", "regency_t1_radar", "regency_t1_sonar", "regency_t1_torpedo_defense", "regency_wall", "regency_t1_reclaimer", "regency_t2_land_factory", "regency_t2_air_factory", "regency_t2_naval_factory", "regency_t2_extractor", "regency_storage_t2", "regency_t2_radar", "regency_t2_sonar", "regency_t2_torpedo_defense", "regency_t2_reclaimer", "regency_t2_power", "regency_t2_point_defense", "regency_t2_artillery", "regency_t2_shield", "regency_t2_aa", "regency_t2_missile_defense", "regency_t3_land_factory", "regency_t3_air_factory", "regency_t3_naval_factory", "regency_t3_extractor", "regency_t4_extractor", "regency_storage_t3", "regency_t3_radar", "regency_t3_sonar", "regency_t3_reclaimer", "regency_t3_power", "regency_t3_point_defense", "regency_t3_shield", "regency_t3_aa", "regency_t3_missile_defense", "regency_t3_assault_transport", "regency_t3_space_cruiser", "regency_t3_space_destroyer", "regency_t4_scorpion", "regency_t4_strider", "regency_t4_nuke_defense", "regency_t4_nuke_silo", "regency_t4_artillery",
            "regency_t2_fabricator", "regency_t3_fabricator",
        ]),
        mesh: "regency_engineer", icon: Engineer,
        lights: [(kind: Point, at: (-0.4, 0, 0.4), color: (1.0, 0.14, 0.06), intensity: 90, range: 13, night_only: false)],
        sounds: (moving: "aster_hover"),
    ),
    // The Reclaimer: the Artificer's partner, a hover hull on gravity lift with one nanite
    // head on a turning house over its stern that takes apart what it passes without
    // stopping. Regency reclaim is nanite work: the head shoots the faction's strands at the
    // wreck and the matter rides home down them (beams.wgsl `BEAM_NANITE_RECLAIM`). Against
    // ARC's Reclaimer its nanites pull harder at a shorter reach. Every factory makes it, and
    // it builds its next tier onto itself in about 20 s (`upgrade_power`). One mesh
    // (`regency_reclaimer`) drawn bigger per tier, 7/6 and 4/3, so the head's pivot and lens are the tech 1 numbers times that.
    // Each lift bell casts red plasma under it (the model's `lifts`), lighting the ground.
    (
        key: "regency_t1_mobile_reclaimer",
        name: "Breaker",
        role: "Reclaimer", title: "Reclaimer",
        tech: 1,
        categories: ["Land"],
        health: 300,
        cost: (mass: 60, energy: 360, time: 240),
        radius: 4.6, height: 3.4,
        vision: 400,
        motion: (layer: Hover, size: 0, speed: 31, accel: 28, turn: 110),
        reclaimer: (power: 6, range: 450, charge: 0.8, mobile: true, heads: [
            (pivot: (-1.5, 0, 2.9), emitter: (0.75, 0, 2.9), turn: 90, pitch: (-70, 80)),
        ]),
        upgrades_to: "regency_t2_mobile_reclaimer",
        upgrade_power: 50,
        weapons: [],
        mesh: "regency_reclaimer", icon: Salvage,
        lights: [(kind: Point, at: (-0.4, 0, 0.3), color: (1.0, 0.14, 0.06), intensity: 50, range: 10, night_only: false)],
