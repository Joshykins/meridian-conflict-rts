[
    // The Regency commander: a tall war machine on heavy legs and armoured boots, a keeled
    // chest under courses of plates, spiked pauldrons swept back, a long narrow head with two
    // red eyes, a telescoping plasmeric cannon for its right forearm and a taloned left hand
    // that builds. Its torso turns to face what it shoots or builds (and
    // holds its fire while it builds); each forearm pitches about its elbow. Model:
    // `regency_commander` (`models::regency::commander`). It builds only Regency structures (mc-data
    // refuses anything else).
    //
    // Refits: only the engineering suites so far; the rest of its slots are still open.
    (
        key: "regency_commander",
        name: "Exarch",
        role: "Armored Command Unit",
        tech: 1,
        categories: ["Land", "Commander", "Engineer", "DirectFire"],
        health: 11000, regen: 10,
        cost: (mass: 18000, energy: 5000000, time: 6000000),
        radius: 10.4, height: 25,
        vision: 600, radar: 1500,
        motion: (layer: Amphibious, size: 0, speed: 17, accel: 17, turn: 150),
        economy: (mass_income: 1, energy_income: 20, mass_storage: 1000, energy_storage: 5000),
        // `arm`: the taloned hand. The torso turns to face the work, then the forearm pitches at it
        // about the elbow (`pivot`); the beam leaves the violet emitter in its palm.
        builder: (power: 10, range: 70, arm: (turn: 140, emitter: (5.2, 5.2, 14.6), pivot: (-0.5, 5.2, 14.6)), builds: [
            "regency_t1_land_factory", "regency_t1_air_factory", "regency_t1_naval_factory", "regency_t1_extractor", "regency_t1_power", "regency_storage", "regency_t1_point_defense", "regency_t1_aa", "regency_t1_radar", "regency_wall",
        ]),
        weapons: [(
            name: "Plasmeric Repeater",
            // The cannon forearm: short bursts of plasmeric slugs, a commander's steady fire.
            damage: 60, splash: 2, range: 360, reload: 0.3, speed: 760, trajectory: Direct, red: 1.0,
            turret_turn: 36, muzzle: (9.6, -5.2, 14.6), pivot: (-0.5, -5.2, 14.6), spread: 0.4, sweep: 30,
            targets: ["Land", "Naval"], color: Orange, flash: 1.4, impact: 1.3, tracer: 0.8,
            rounds: 3, plasma_grade: Some(Plasmeric),
            sounds: (fire: "regency_stinger", impact: "shell_light"),
        )],
        refits: [
            (
                key: "engineering", name: "Fabrication",
                modules: [
                    (
                        key: "eng_2", icon: Engineer, name: "Engineering Suite II", tech: 2,
                        summary: "More build power and reach: twin nanite emitters and feed canisters on the build arm, heavier plating; and it builds the tech 2 structures.",
                        cost: (mass: 720, energy: 7200, time: 900),
                        health: 3000, regen: 5, build_power: 30, build_range: 5,
                        // The emitters come to work (rock on the forearm) over this long.
                        unfold: 0.6,
                        // The tech 2 structures that are built new, not upgraded into.
                        builds: ["regency_t2_power", "regency_t2_point_defense"],
                    ),
                    (
                        key: "eng_3", icon: Engineer, name: "Engineering Suite III", tech: 3, after: "eng_2",
                        summary: "Far more build power and reach: a fabrication lance out of the hand, a ring of emitters round the wrist, a feed drum over the elbow, heavy plating; and it builds the tech 3 structures.",
                        cost: (mass: 2400, energy: 24000, time: 3000),
                        health: 7000, regen: 15, build_power: 150, build_range: 10,
                        // The lance runs out of the palm while it builds: the beam leaves its tip.
                        arm_emitter: (8.18, 5.2, 14.6),
                        // It takes Suite II's place, so it builds the tech 2 structures too.
                        builds: ["regency_t2_power", "regency_t2_point_defense", "regency_t3_power", "regency_t3_point_defense"],
                    ),
                ],
            ),
        ],
        wreck_fraction: 0.2,
        mesh: "regency_commander", icon: Commander,
        sounds: (death: "commander_death", moving: "walker_heavy", step: "regency_footfall"),
    ),
    // The Regency engineer: a low armoured craft on gravity lift, so it crosses water as it
    // crosses land (`Hover`) and every Regency factory makes it. A housing on its back turns to
    // the work, then the fabricator arm pitches at it about its trunnion (`pivot`); the beam
    // leaves the violet emitter at the arm's tip (`emitter`). Model: `regency_engineer`
    // (`models::regency::engineer`).
    (
        key: "regency_t1_engineer",
        name: "Artificer",
        role: "Engineer",
        tech: 1,
        categories: ["Land", "Engineer"],
        health: 170,
        cost: (mass: 55, energy: 280, time: 280),
        radius: 3.6, height: 2.8,
        vision: 180,
        motion: (layer: Hover, size: 0, speed: 28, accel: 30, turn: 170),
        builder: (power: 5, range: 55, arm: (turn: 200, emitter: (2.15, 0, 2.05), pivot: (0.35, 0, 2.05)), builds: [
            "regency_t1_land_factory", "regency_t1_air_factory", "regency_t1_naval_factory", "regency_t1_extractor", "regency_t1_power", "regency_storage", "regency_t1_point_defense", "regency_t1_aa", "regency_t1_radar", "regency_wall",
        ]),
        mesh: "regency_engineer", icon: Engineer,
        // A stand-in: ARC's hover hum until the Regency has a lift sound of their own.
        sounds: (moving: "aster_hover"),
    ),
]
