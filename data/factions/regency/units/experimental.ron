// The Regency experimentals (tech 4): too big for any factory. Their tech 3 engineers and an
// Exarch with Engineering Suite III raise them on a lot of their own, as they would a
// structure (`footprint` on a mobile unit), and the finished machine walks off it.
[
    // The battle scorpion: a heavy armoured scorpion on eight legs. Its tail is the turret:
    // the top of it bends round to aim within `aim_arc` (60 degrees either side of the
    // nose), and past that the scorpion turns its whole body. The tail ends in a
    // fusion excavation lance that immediately sweeps a white-rose stream across its mark,
    // glassing the ground where the stream lands. Each claw charges a Gravitic Bomb between
    // its fingers and throws it, a salvo of six from each: straight launches opening into corkscrews over
    // the mark from around it.
    //
    // Model: `regency_scorpion` (`models::regency::scorpion`), authored at 10.4 x 19 m and built
    // 3.25 times authored size (2.5 times its previous size): every mount follows it.
    (
        key: "regency_t4_scorpion",
        name: "Harrow",
        role: "Battle Scorpion",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 9200,
        cost: (mass: 900, energy: 7200, time: 5200),
        radius: 33.8, height: 61.75,
        footprint: (7, 7),
        vision: 360,
        // It walks the seabed like the Paladin; wading, the tail stays above the water.
        motion: (layer: Amphibious, size: 4, speed: 24, accel: 20, turn: 110, aim_arc: 120),
        // The single point that best matches the tail's bending top joints (the model's
        // `AIM_PIVOT`): the beam's muzzle turns about it, not the unit's middle.
        turret_at: (-22.1, 0.0),
        // The claws' bombs turn on their own, each about its own claw (`mount`, `pivot`
        // at the muzzle: whichever way it throws, it leaves from between the fingers).
        hull_mounts: true,
        weapons: [
            (
                name: "Excavation Lance",
                // Lights at once and holds on its mark; between marks it stays lit as the
                // tail slews, striking units along the line and glassing the ground.
                damage: 30, range: 280, reload: 0.1, hitscan: true, beam: true, trajectory: Direct,
                splash: 4,
                turret_turn: 180, muzzle: (14.3, 0, 57.2), pivot: (-5.2, 0, 60.45), sweep: 6,
                targets: ["Land", "Naval", "Structure"], color: Blue, red: 0.0,
                flash: 2.5, impact: 1.0, plasma_grade: Some(PinchFusion),
                sounds: (hold: "regency_pinched_beam"),
            ),
            (
                name: "Left Gravitic Salvo",
                // Left six: charge together, leave straight, then corkscrew above
                // the ground onto six area points. Right six interleave with them.
                damage: 300, splash: 12, range_min: 40, range: 340, reload: 5.0, speed: 180,
                trajectory: Direct, curve: 45, corkscrew: 18, tracer: 2.6, salvo: 6, salvo_delay: 0.1,
                mount: true, arc: 120, turret_turn: 90,
                muzzle: (56.875, 10.725, 17.225), pivot: (56.875, 10.725, 17.225),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                flash: 1.3, impact: 2.2, shockwave: 1.0, plasma_grade: Some(Plasmeric),
                sounds: (fire: "regency_gravitic_throw", charge: "regency_gravitic_charge", charge_time: 1.2, impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
            ),
            (
                name: "Right Gravitic Salvo",
                // Right six: identical timing, the area pattern rotated half a sector.
                damage: 300, splash: 12, range_min: 40, range: 340, reload: 5.0, speed: 180,
                trajectory: Direct, curve: 45, corkscrew: 18, tracer: 2.6, salvo: 6, salvo_delay: 0.1,
                mount: true, arc: 120, turret_turn: 90,
                muzzle: (56.875, -10.725, 17.225), pivot: (56.875, -10.725, 17.225),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                flash: 1.3, impact: 2.2, shockwave: 1.0, plasma_grade: Some(Plasmeric),
                sounds: (fire: "regency_gravitic_throw", charge: "regency_gravitic_charge", charge_time: 1.2, impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
            ),
        ],
        mesh: "regency_scorpion", icon: Bot,
        sounds: (death: "blast_large", moving: "regency_crawl", step: "regency_footfall"),
    ),
    // The strider: a fighting machine on three long legs (a tripod) nearly a hundred metres
    // tall, its keeled head carried high over the field. The head is the turret: it turns
    // on the legs' crown and carries a Pinch-fusion Cannon slung under a plated outrigger
    // either side. Each squeezes a charge in front of its mouth until it fuses and launches
    // it as one shot; the two take turns, the second half a reload behind the first. A
    // launcher on the back of the head throws a battery of Gravitic Seekers straight up;
    // they climb high and rain down over what is near it, spread over the targets in
    // reach (`split`). No anti-air: aircraft are safe from it.
    //
    // It walks one leg at a time, the third swinging while two stand (`set_crawl_legs` with
    // a lone leg on the centreline). It wades: it walks the seabed like the Paladin, its
    // head high enough over the water to fire on anything ashore or afloat.
    //
    // Balance: the Fulgur's class, the Regency way: shorter reach (1000 m to 1500), no
    // shield (more armour instead: its HP is near the Fulgur's HP and shield together), the
    // seekers for what hides behind a rise.
    //
    // Model: `regency_strider` (`models::regency::strider`), authored at the old tech 3
    // size (12 x 32 m) and built 3 times authored size: every mount follows it.
    (
        key: "regency_t4_strider",
        name: "Strider",
        role: "Assault Tripod",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 72000,
        cost: (mass: 3400, energy: 34000, time: 20000),
        radius: 36.0, height: 96.0,
        footprint: (6, 6),
        vision: 1200,
        motion: (layer: Amphibious, size: 4, speed: 20, accel: 14, turn: 70),
        weapons: [
            (
                name: "Pinch-fusion Cannon",
                // The left cannon. Its charge is squeezed until it fuses, then launched as one
                // shot, laid a little up so it arcs over a low rise (`flat_fire`).
                damage: 2400, splash: 8, range: 1000, reload: 4.6, speed: 1350, trajectory: Ballistic,
                loft: 0.6, flat_fire: true,
                turret_turn: 40, muzzle: (30.0, 11.4, 74.7), pivot: (3.6, 0, 74.7),
                targets: ["Land", "Naval"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion),
                flash: 0.8, impact: 2.6, tracer: 2.4,
                sounds: (
                    fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 1.6,
                    charge_volume: 1.6,
                    impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
                ),
            ),
            (
                name: "Pinch-fusion Cannon",
                // The right cannon: half a reload behind the left (`twins.rs`).
                damage: 2400, splash: 8, range: 1000, reload: 4.6, speed: 1350, trajectory: Ballistic,
                loft: 0.6, flat_fire: true,
                turret_turn: 40, muzzle: (30.0, -11.4, 74.7), pivot: (3.6, 0, 74.7),
                targets: ["Land", "Naval"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion),
                flash: 0.8, impact: 2.6, tracer: 2.4,
                sounds: (
                    fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 1.6,
                    charge_volume: 1.6,
                    impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
                ),
            ),
            (
                name: "Gravitic Seeker Battery",
                // Eight cells in two rows on the head's back, front pair first. The launcher
                // rides the head (`mount` on a vertical launcher): the seekers leave straight
                // up out of their cells, climb to `apogee` and fall on their marks, spread
                // over the targets in reach. Ground only.
                damage: 260, splash: 14, range_min: 120, range: 900, reload: 9.0, speed: 240,
                trajectory: Direct, turret_turn: 0, arc: 360, mount: true,
                muzzle: (-8.4, 1.86, 93.0), pivot: (-13.35, 0, 93.0),
                muzzles: [
                    (-8.4, 1.86, 93.0), (-8.4, -1.86, 93.0), (-11.7, 1.86, 93.0), (-11.7, -1.86, 93.0),
                    (-15.0, 1.86, 93.0), (-15.0, -1.86, 93.0), (-18.3, 1.86, 93.0), (-18.3, -1.86, 93.0),
                ],
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                missile: true, guided: true, vertical_launch: true, apogee: 300,
                salvo: 8, salvo_delay: 0.15, split: true,
                intercept: 60, caliber: 1.0, flash: 1.2, impact: 2.2, shockwave: 1.0,
                plasma_grade: Some(Gravitic),
                sounds: (fire: "regency_gravitic_throw", impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
            ),
        ],
        mesh: "regency_strider", icon: Bot,
        sounds: (death: "blast_large", moving: "regency_crawl", step: "regency_footfall"),
    ),
]
