// The Regency experimentals (tech 4 and 5): too big for any factory. Their tech 3 engineers and an
// Exarch with Engineering Suite III raise them on a lot of their own, as they would a
// structure (`footprint` on a mobile unit), and the finished machine walks off it.
[
    // The battle scorpion: a heavy armoured scorpion on eight legs. Its tail is the turret:
    // the top of it bends round to aim within `aim_arc` (60 degrees either side of the
    // nose), and past that the scorpion turns its whole body. The tail ends in a
    // fusion excavation lance that immediately sweeps a white-rose stream across its mark,
    // glassing the ground where the stream lands. Each claw charges a Gravitic Bomb between
    // its fingers and throws it, a salvo of six from each: straight launches opening into corkscrews over
    // the mark from around it.
    //
    // Model: `regency_scorpion` (`models::regency::scorpion`), authored at 10.4 x 19 m and built
    // 3.25 times authored size (2.5 times its previous size): every mount follows it.
    (
        key: "regency_t4_scorpion",
        name: "Harrow",
        role: "Battle Scorpion",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 9200,
        cost: (mass: 900, energy: 7200, time: 5200),
        radius: 33.8, height: 61.75,
        footprint: (7, 7),
        vision: 360,
        // It walks the seabed like the Paladin; wading, the tail stays above the water.
        motion: (layer: Amphibious, size: 4, speed: 24, accel: 20, turn: 110, aim_arc: 120),
        // The single point that best matches the tail's bending top joints (the model's
        // `AIM_PIVOT`): the beam's muzzle turns about it, not the unit's middle.
        turret_at: (-22.1, 0.0),
        // The claws' bombs turn on their own, each about its own claw (`mount`, `pivot`
        // at the muzzle: whichever way it throws, it leaves from between the fingers).
        hull_mounts: true,
        weapons: [
            (
                name: "Excavation Lance",
                // Lights at once and holds on its mark; between marks it stays lit as the
                // tail slews, striking units along the line and glassing the ground.
                damage: 30, range: 280, reload: 0.1, hitscan: true, beam: true, trajectory: Direct,
                splash: 4,
                turret_turn: 180, muzzle: (14.3, 0, 57.2), pivot: (-5.2, 0, 60.45), sweep: 6,
                targets: ["Land", "Naval", "Structure"], color: Blue, red: 0.0,
                flash: 2.5, impact: 1.0, plasma_grade: Some(PinchFusion),
                sounds: (hold: "regency_pinched_beam"),
            ),
            (
                name: "Left Gravitic Salvo",
                // Left six: charge together, leave straight, then corkscrew above
                // the ground onto six area points. Right six interleave with them.
                damage: 300, splash: 12, range_min: 40, range: 340, reload: 5.0, speed: 180,
                trajectory: Direct, curve: 45, corkscrew: 18, tracer: 2.6, salvo: 6, salvo_delay: 0.1,
                mount: true, arc: 120, turret_turn: 90,
                muzzle: (56.875, 10.725, 17.225), pivot: (56.875, 10.725, 17.225),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                flash: 1.3, impact: 2.2, shockwave: 1.0, plasma_grade: Some(Plasmeric),
                sounds: (fire: "regency_gravitic_throw", charge: "regency_gravitic_charge", charge_time: 1.2, impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
            ),
            (
                name: "Right Gravitic Salvo",
                // Right six: identical timing, the area pattern rotated half a sector.
                damage: 300, splash: 12, range_min: 40, range: 340, reload: 5.0, speed: 180,
                trajectory: Direct, curve: 45, corkscrew: 18, tracer: 2.6, salvo: 6, salvo_delay: 0.1,
                mount: true, arc: 120, turret_turn: 90,
                muzzle: (56.875, -10.725, 17.225), pivot: (56.875, -10.725, 17.225),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                flash: 1.3, impact: 2.2, shockwave: 1.0, plasma_grade: Some(Plasmeric),
                sounds: (fire: "regency_gravitic_throw", charge: "regency_gravitic_charge", charge_time: 1.2, impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
            ),
        ],
        mesh: "regency_scorpion", icon: Bot,
        sounds: (death: "blast_large", moving: "regency_crawl", step: "regency_footfall"),
    ),
    // The strider: a fighting machine on three long legs (a tripod) nearly a hundred metres
    // tall, its keeled head carried high over the field. The head is the turret: it turns
    // on the legs' crown and carries a Pinch-fusion Cannon slung under a plated outrigger
    // either side. Each squeezes a charge in front of its mouth until it fuses and launches
    // it as one shot; the two take turns, the second half a reload behind the first. A
    // launcher on the back of the head throws a battery of Gravitic Seekers straight up;
    // they climb high and rain down over what is near it, spread over the targets in
    // reach (`split`). No anti-air: aircraft are safe from it.
    //
    // It walks one leg at a time, the third swinging while two stand (`set_crawl_legs` with
    // a lone leg on the centreline). It wades: it walks the seabed like the Paladin, its
    // head high enough over the water to fire on anything ashore or afloat.
    //
    // Balance: the Fulgur's class, the Regency way: shorter reach (1000 m to 1500), no
    // shield (more armour instead: its HP is near the Fulgur's HP and shield together), the
    // seekers for what hides behind a rise.
    //
    // Model: `regency_strider` (`models::regency::strider`), authored at the old tech 3
    // size (12 x 32 m) and built 3 times authored size: every mount follows it.
    (
        key: "regency_t4_strider",
        name: "Strider",
        role: "Assault Tripod",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 60000,
        cost: (mass: 3400, energy: 34000, time: 20000),
        radius: 36.0, height: 96.0,
        footprint: (6, 6),
        vision: 1200,
        motion: (layer: Amphibious, size: 4, speed: 35, accel: 20, turn: 40),
        weapons: [
            (
                name: "Pinch-fusion Cannon",
                // The left cannon. Its charge is squeezed until it fuses, then launched as one
                // shot, laid a little up so it arcs over a low rise (`flat_fire`). It lands as
                // a supernova a building wide, and reaches a little past a Breacher's rockets.
                damage: 4200, splash: 24, range: 1250, reload: 4.6, speed: 1350, trajectory: Ballistic,
                loft: 0.6, flat_fire: true,
                turret_turn: 40, muzzle: (30.0, 11.4, 74.7), pivot: (3.6, 0, 74.7),
                targets: ["Land", "Naval"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion),
                flash: 1.2, impact: 4.5, tracer: 2.4,
                sounds: (
                    fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 1.6,
                    charge_volume: 1.6,
                    impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
                ),
            ),
            (
                name: "Pinch-fusion Cannon",
                // The right cannon: half a reload behind the left (`twins.rs`).
                damage: 4200, splash: 24, range: 1250, reload: 4.6, speed: 1350, trajectory: Ballistic,
                loft: 0.6, flat_fire: true,
                turret_turn: 40, muzzle: (30.0, -11.4, 74.7), pivot: (3.6, 0, 74.7),
                targets: ["Land", "Naval"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion),
                flash: 1.2, impact: 4.5, tracer: 2.4,
                sounds: (
                    fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 1.6,
                    charge_volume: 1.6,
                    impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
                ),
            ),
            (
                name: "Gravitic Seeker Battery",
                // Eight cells in two rows on the head's back, front pair first. The launcher
                // rides the head (`mount` on a vertical launcher): the seekers, solid cased
                // bodies as every Regency missile, leave straight up out of their cells, climb
                // to `apogee` and fall on their marks, spread over the targets in reach even
                // under an attack order (`split_ordered`). Each carries pinch fusion and goes off as
                // a small supernova (`fusion_strike`). Ground only.
                damage: 420, splash: 20, range_min: 120, range: 1250, reload: 8.0, speed: 260,
                trajectory: Direct, turret_turn: 0, arc: 360, mount: true,
                muzzle: (-8.4, 1.86, 93.0), pivot: (-13.35, 0, 93.0),
                muzzles: [
                    (-8.4, 1.86, 93.0), (-8.4, -1.86, 93.0), (-11.7, 1.86, 93.0), (-11.7, -1.86, 93.0),
                    (-15.0, 1.86, 93.0), (-15.0, -1.86, 93.0), (-18.3, 1.86, 93.0), (-18.3, -1.86, 93.0),
                ],
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                missile: true, guided: true, vertical_launch: true, apogee: 300,
                salvo: 8, salvo_delay: 0.15, split: true, split_ordered: true,
                intercept: 60, caliber: 1.0, flash: 1.2, impact: 1.2, shockwave: 1.0,
                plasma_grade: Some(Gravitic), fusion_strike: true,
                sounds: (fire: "regency_gravitic_throw", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
        ],
        mesh: "regency_strider", icon: Bot,
        sounds: (death: "blast_large", moving: "regency_crawl", step: "regency_footfall"),
    ),
    // T4 siege quadruped: a low armored hull over four widely planted limbs, a Strider's
    // and a Breacher's peer. The recessed aperture charges for three seconds, then holds a
    // cutting stream for five. Two heavy guns and eight cased Ruin Rockets cover its flanks.
    // Model and every weapon mount use the same 1.2x authored scale.
    (
        key: "regency_t4_colossus",
        name: "Colossus",
        role: "Siege Walker",
        tech: 4,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 75000,
        cost: (mass: 4200, energy: 42000, time: 24000),
        radius: 48.0, height: 44.4,
        footprint: (8, 8),
        vision: 1250,
        shield: (kind: Hull, health: 18000, regen: 120),
        economy: (energy_upkeep: 400),
        motion: (layer: Land, size: 5, speed: 25, accel: 10, turn: 30, aim_arc: 80),
        weapons: [
            (
                name: "Heavy Pinched Lance",
                // Charged for three seconds with the head opening, then fifty ticks of beam
                // over five seconds, each a hit on everything within a compound's breadth of
                // the mark; the head stays open until the burn ends. It slews slowly while it
                // burns (`sweep`), dragging a trench of glass from mark to mark. A tight red
                // Pinched stream, not the Scourge's star: no halo, no spill.
                damage: 1200, splash: 40, range_min: 180, range: 1200, reload: 40.0,
                salvo: 50, salvo_delay: 0.1,
                hitscan: true, beam: true, trajectory: Direct,
                turret_turn: 14, sweep: 10, muzzle: (30.4800, 0.0000, 31.4400), pivot: (12.0000, 0.0000, 31.4400),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(Pinched), flash: 1.0, impact: 1.5, tracer: 1.5,
                sounds: (
                    charge: "regency_lance_charge", charge_time: 3.0,
                    hold: "regency_lance_hold", spindown: "regency_lance_vent",
                ),
            ),
            (
                name: "Rapid Pinch-fusion Gun",
                // The left gun, on a turret of its own.
                damage: 450, splash: 12, range: 1100, reload: 0.8, speed: 1500, trajectory: Ballistic,
                loft: 0.3, flat_fire: true, mount: true, turret_turn: 70, arc: 200,
                muzzle: (25.2000, 12.9600, 37.2000), pivot: (10.8000, 12.9600, 37.2000),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion),
                flash: 1.2, impact: 1.6, tracer: 1.4,
                sounds: (fire: "regency_sunspear_fire", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
            (
                name: "Rapid Pinch-fusion Gun",
                // The right gun: half a reload behind the left (`twins.rs`).
                damage: 450, splash: 12, range: 1100, reload: 0.8, speed: 1500, trajectory: Ballistic,
                loft: 0.3, flat_fire: true, mount: true, turret_turn: 70, arc: 200,
                muzzle: (25.2000, -12.9600, 37.2000), pivot: (10.8000, -12.9600, 37.2000),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion),
                flash: 1.2, impact: 1.6, tracer: 1.4,
                sounds: (fire: "regency_sunspear_fire", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
            (
                name: "Ruin Rocket Battery",
                // Eight cased rockets out of the back, lofted and not guided: they leave in a
                // quick ripple, scatter wide (`spread`) and fall where they will, with red
                // exhaust and a compact red containment burst.
                damage: 900, splash: 30, range_min: 300, range: 1400, reload: 24.0,
                salvo: 8, salvo_delay: 0.2, speed: 800, trajectory: Ballistic, rake: 65, loft: 3,
                mount: true, turret_turn: 60, arc: 360, spread: 6,
                muzzle: (-6.9000, 0.0000, 40.8300), pivot: (-7.8000, 0.0000, 38.4000),
                muzzles: [
                    (-5.8028, 2.7000, 40.4236), (-5.8028, -2.7000, 40.4236), (-5.8028, 0.9000, 40.4236), (-5.8028, -0.9000, 40.4236),
                    (-7.9972, 2.7000, 41.2364), (-7.9972, -2.7000, 41.2364), (-7.9972, 0.9000, 41.2364), (-7.9972, -0.9000, 41.2364),
                ],
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                missile: true, intercept: 100, caliber: 1.0, trail: true, wake: 0.8, tracer: 1,
                flash: 0.9, impact: 1.0,
                plasma_grade: Some(Gravitic),
                sounds: (fire: "regency_gravitic_throw", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
        ],
        mesh: "regency_colossus", icon: SiegeWalker,
        sounds: (death: "blast_large", moving: "regency_crawl", step: "regency_footfall"),
    ),
    // The Seraph, the Regency's tier 5: a winged mecha that hangs over the ground on its
    // lifts (it hovers over land and water alike), an assassin among titans. It is fast
    // for anything its size, and it does not walk into a fight: once it sees enemies on the
    // ground some way off it winds up and is simply there, in the middle of them, and its
    // landing goes off as a shockwave that throws their army flat (`dash`, mc-sim
    // `dash.rs`). A Rapid Fusion Repeater rides each forearm, the two taking turns; from
    // between its wings a battery of sixteen Gravitic Seekers goes up whenever there is
    // anything in reach, and all at once every time it lands from a dash (`on_dash`),
    // arcing over and down on what stands all round it. No anti-air, but the forearms reach spacecraft.
    //
    // Balance: a first pass. Half a Behemoth's price for a third of its health, most of it
    // in its hull field (220000 health under a 260000 field that comes back at 1200/s);
    // about 7500 dps at 1000 m against the Behemoth's siege reach, the forearms reaching
    // spacecraft too, and a dash that puts it under a siege gun's `range_min`. Raised on a lot by Artificer IIIs or the
    // Exarch's Engineering Suite III, like the tier 4s.
    //
    // Model: `regency_seraph` (`models::regency::seraph`), authored at a fifth size and
    // built 5 times authored size: every mount follows it.
    (
        key: "regency_t5_seraph",
        name: "Seraph",
        role: "Strike Titan",
        tech: 5,
        categories: ["Land", "DirectFire", "Experimental"],
        health: 220000,
        cost: (mass: 60000, energy: 600000, time: 200000),
        radius: 75.0, height: 155.0,
        footprint: (13, 13),
        vision: 2000,
        shield: (kind: Hull, health: 260000, regen: 1200),
        economy: (energy_upkeep: 2000),
        motion: (layer: Hover, size: 5, speed: 70, accel: 60, turn: 120),
        // Once it sees an enemy on the ground or the water between 400 m and 1800 m, with
        // nothing at its feet, it charges for 1.5 s, is gone for 1.5 s (the air where it
        // lands crackling faintly for the last 0.6 s of it) and comes down in the middle of
        // everything within 250 m of it, letting go its Seraphic Nova at its feet. Then 15 s to recharge. It dashes idle, chasing, on an attack-move or patrol,
        // or at an attack order's mark; never on a move order, at hold fire or at hold
        // position.
        dash: (range: 1800, min: 400, gather: 250, cooldown: 15, windup: 1.5, transit: 3.0, arrive: 1.0),
        weapons: [
            (
                name: "Rapid Fusion Repeater",
                // The left forearm's: a pinch-fusion bolt every half second, at the ground,
                // the sea or a spacecraft overhead. The torso turns to the mark and both
                // forearms come up to it about the elbows; with nothing to shoot they hang at
                // its sides, the guns pointed down (`rest_pitch`). Each takes the foe nearest
                // where it already points (`keep_aim`), so it swings as little as it can.
                damage: 1500, splash: 18, range: 1000, reload: 0.5, speed: 1600, trajectory: Ballistic,
                loft: 0.3, flat_fire: true, turret_turn: 120, rest_pitch: -80,
                muzzle: (37, 23.75, 76.25), pivot: (-1, 21.75, 77),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion), keep_aim: true,
                flash: 1.3, impact: 1.8, tracer: 1.5,
                sounds: (fire: "regency_sunspear_fire", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
            (
                name: "Rapid Fusion Repeater",
                // The right forearm's: half a reload behind the left (`twins.rs`).
                damage: 1500, splash: 18, range: 1000, reload: 0.5, speed: 1600, trajectory: Ballistic,
                loft: 0.3, flat_fire: true, turret_turn: 120, rest_pitch: -80,
                muzzle: (37, -23.75, 76.25), pivot: (-1, -21.75, 77),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion), keep_aim: true,
                flash: 1.3, impact: 1.8, tracer: 1.5,
                sounds: (fire: "regency_sunspear_fire", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
            (
                name: "Gravitic Seeker Battery",
                // Sixteen cells in four rows between the wings, fired inside pair first. The
                // seekers leave straight up, climb to `apogee`, turn over and fall on the
                // targets round it, spread over them even under an attack order
                // (`split_ordered`), each a small supernova (`fusion_strike`). It fires
                // whenever anything is in reach, and the whole battery goes up the moment it
                // lands from a dash, whatever its reload (`on_dash`). Ground only.
                damage: 1100, splash: 26, range_min: 60, range: 1300, reload: 12.0, speed: 300,
                trajectory: Direct, turret_turn: 0, arc: 360, mount: true,
                muzzle: (-7.75, 5.75, 106.5), pivot: (-12.625, 0, 106.5),
                muzzles: [
                    (-7.75, 5.75, 106.5), (-7.75, -5.75, 106.5), (-7.75, 9.25, 106.5), (-7.75, -9.25, 106.5),
                    (-11, 5.75, 106.5), (-11, -5.75, 106.5), (-11, 9.25, 106.5), (-11, -9.25, 106.5),
                    (-14.25, 5.75, 106.5), (-14.25, -5.75, 106.5), (-14.25, 9.25, 106.5), (-14.25, -9.25, 106.5),
                    (-17.5, 5.75, 106.5), (-17.5, -5.75, 106.5), (-17.5, 9.25, 106.5), (-17.5, -9.25, 106.5),
                ],
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                missile: true, guided: true, vertical_launch: true, apogee: 260,
                salvo: 16, salvo_delay: 0.1, split: true, split_ordered: true, on_dash: true,
                intercept: 80, caliber: 1.2, flash: 1.2, impact: 1.4, shockwave: 1.0,
                plasma_grade: Some(Gravitic), fusion_strike: true,
                sounds: (fire: "regency_gravitic_throw", impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
            (
                name: "Seraphic Nova",
                // The landing (`dash_only`): a wall of red plasma rolls out all round from its
                // feet to 320 m in about a second and a quarter, the Wake's wave as a ring
                // and a mobile nuke: 15000 where it lands, a quarter of that at its edge,
                // and a 1.5 s stun on all but experimentals. It rolls over hills and walls;
                // only a shield dome stops it.
                damage: 15000, range: 320, reload: 15, hitscan: true, trajectory: Direct,
                cone: (angle: 180, edge: 0.25, speed: 260, stun: 1.5), dash_only: true,
                turret_turn: 0, arc: 360, mount: true, muzzle: (0, 0, 0),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(Pinched),
                flash: 4.0, impact: 2.0, shockwave: 1.5,
                sounds: (fire: "regency_seraph_wave"),
            ),
        ],
        mesh: "regency_seraph", icon: WingedTitan,
        sounds: (
            death: "blast_colossal", moving: "aster_hover",
            dash_charge: "regency_seraph_charge", dash_leave: "regency_seraph_vanish", dash_gone: "regency_seraph_gone",
            dash_arrive: "regency_seraph_arrive",
            dash_land: "regency_seraph_landing",
        ),
    ),
]
