// The Regency's tech 3 land units, made by the Anvil III. Models: `models::regency::*`; a model
// authored at another size says so, and its tests tie these numbers to it.
[
    // Mobile anti-spaceship gun: a siege carriage that plants to fire, the Sunspear's
    // Pinch-fusion gun on four tread pods, the Regency's answer to warships in the upper air
    // that ARC meets with the Narwhal at sea and the Zenith at home. It cannot fire on the
    // move: stopped, it plants (`deploy`), each tread pod turning out into an X and its arm
    // pivoting down to lift the body, then its gun rises and its rails slide out; told to
    // move, it packs first.
    // Either way takes nine seconds. It plants whenever it stands still, so one parked
    // ahead of a raid is ready for it. It charges for a long beat, then pinches out one
    // fast shot of fusion up at the hull, and shoots at nothing else: escorts keep it alive.
    //
    // Balance: the Narwhal's land peer (3800 mass, 40000 HP, 12000 every 6 s at 3000 m,
    // 0.53 DPS a mass point). Bent the Regency way: it hits harder for its mass (13000
    // every 7 s, 0.58 a mass point) from a shorter reach (2800 m) on a lighter hull
    // (26000 HP), and pays for both with the plant: nine seconds before the first shot,
    // nine more before it can leave. One shot takes an ARC corvette; three, the Suzerain
    // through its shield; two of them bring down an ARC frigate (55000 HP) in about 15 s.
    //
    // Model: `regency_skyspear` (`models::regency::fusion_guns::skyspear`), authored
    // planted at this size; `pivot`/`muzzle` are its trunnion and the middle of its charge.
    (
        key: "regency_t3_mobile_aa",
        name: "Spire",
        role: "Mobile Anti-Ship Gun", title: "Anti-Ship",
        tech: 3,
        categories: ["Land", "AntiAir"],
        health: 26000,
        cost: (mass: 3400, energy: 34000, time: 20000),
        radius: 22.0, height: 42.0,
        vision: 900,
        motion: (layer: Land, size: 4, speed: 15, accel: 6, turn: 28, deploy: 9.0, deploy_idle: true),
        weapons: [(
            name: "Pinch-fusion Cannon",
            damage: 13000, splash: 16, range: 2800, reload: 7.0, speed: 1600, trajectory: Direct,
            turret_turn: 24, muzzle: (12.97, 0, 37.833), pivot: (1, 0, 17.1),
            targets: ["Space"], color: Orange, red: 1.0,
            plasma_grade: Some(PinchFusion),
            flash: 1.2, impact: 3.0, tracer: 3.0,
            sounds: (
                fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 2.6,
                charge_volume: 1.8,
                impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
            ),
        )],
        mesh: "regency_skyspear", icon: AntiAir,
        sounds: (death: "blast_large", moving: "tracks_heavy"),
    ),
    // Heavy artillery: a Pinch-fusion Howitzer. It charges for a long beat, the coils down its
    // bore lighting one after another, then lobs one great shot of fusion high over the
    // field that lands with the Sunspear's strike: the ground melted into a glowing pool and a
    // knot of fusion left burning over it.
    //
    // Balance: the Trebuchet's (800 mass, 4715 HP, 4467 damage every 10 s at 1800 m, 48 m
    // splash, 4.6 degrees of spread). Bent the Regency way: it hits harder (5200) in a tighter
    // blast (40 m), laid truer (2.5 degrees) from a shorter reach (1600 m), and charges longer
    // (2.8 s against 2.4 s).
    //
    // Model: `regency_fusion_howitzer` (`models::regency::fusion_guns::howitzer`), authored at
    // this size; `pivot`/`muzzle` are its trunnion and the middle of its charge.
    (
        key: "regency_t3_artillery",
        name: "Kiln",
        role: "Mobile Fusion Artillery", title: "Heavy Artillery",
        tech: 3,
        categories: ["Land", "Artillery"],
        health: 4900,
        cost: (mass: 820, energy: 6600, time: 4800),
        radius: 11.0, height: 9.5,
        vision: 220,
        motion: (layer: Land, size: 2, speed: 22, accel: 16, turn: 70),
        weapons: [(
            name: "Pinch-fusion Howitzer",
            damage: 5200, splash: 40, range_min: 150, range: 1600, reload: 10.0, speed: 240,
            trajectory: Ballistic, loft: 6, spread: 2.5,
            turret_turn: 45, muzzle: (12.066, 0, 10.435), pivot: (-2.2, 0, 5.8),
            targets: ["Structure", "Land", "Naval"], color: Orange, red: 1.0,
            plasma_grade: Some(PinchFusion),
            flash: 1.0, impact: 1.0, tracer: 2.4,
            sounds: (
                fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 2.8,
                charge_volume: 1.6,
                impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
            ),
        )],
        mesh: "regency_fusion_howitzer", icon: Artillery,
        sounds: (death: "blast_large", moving: "tracks_heavy"),
    ),
    // The wake tank: a heavy armoured hover tank on four lift bells, built round one wide
    // projector in a low turret. It gathers plasma across the projector's mouth and pinches
    // it out as a wake: a wall of plasma standing across the fan, white-hot, orange and red,
    // with threads of cooling red light running out to it from the projector, that rolls
    // out along the ground faster than a man can run (120 m a second), and strikes
    // everything it rolls over (`cone`, `mc-sim` `wake.rs`; drawn by `wake_fx.rs` and
    // wake_shell.wgsl), in a fan 12.5 degrees either side of the projector's line (a 25
    // degree arc; `angle` may go up to 180, a full circle), full weight close in and two
    // fifths of it at the end of its reach. Once let go it rolls on by itself: what
    // outruns it, or leaves the fan before it arrives, is missed. It rolls over the
    // ground, so it needs no line of fire: it is let go at what is behind a hill and
    // reaches it. Shield domes still stop it, and it never reaches aircraft or what is
    // under the water. It scorches the ground it rolls over.
    //
    // Balance: a line breaker that reaches out. HP and cost about 2.6 Bulwarks (the
    // Arbalest's class); it outreaches a Bulwark by half again (540 m to 360), but the
    // front takes four and a half seconds to get there, so moving targets slip it at
    // range and a column driving at it does not. Against one target it does three and a half Bulwarks'
    // damage a second close in, falling to under one and a half at its edge; against a
    // column it strikes every hull down the fan. Hover, so it crosses water (the Regency's
    // lift; ARC's heavy tanks cannot), and slower than a Bulwark to pay for it.
    //
    // Model: `regency_wake_tank` (`models::regency::wake_tank`), authored at this size.
    (
        key: "regency_t3_wake_tank",
        name: "Wake",
        role: "Wake Tank",
        tech: 3,
        categories: ["Land", "DirectFire"],
        health: 4400,
        cost: (mass: 520, energy: 4700, time: 3200),
        radius: 7.6, height: 4.6,
        vision: 380,
        motion: (layer: Hover, size: 1, speed: 25, accel: 18, turn: 75),
        weapons: [(
            name: "Pinched-plasmeric Wake Projector",
            // Charged a second across the projector's mouth, then let go as one wake.
            damage: 680, range: 540, reload: 2.6, hitscan: true, trajectory: Direct,
            cone: (angle: 12.5, edge: 0.4, speed: 320),
            turret_turn: 70, muzzle: (8.2, 0, 3.4), pivot: (1.4, 0, 3.4),
            targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
            plasma_grade: Some(Pinched),
            flash: 1.4, impact: 1.6,
            sounds: (fire: "regency_wake_fire", charge: "regency_wake_charge", charge_time: 0.8),
        )],
        mesh: "regency_wake_tank", icon: Tank,
        sounds: (death: "blast_large", moving: "aster_hover"),
    ),
    // Executioner: Paladin-class assault tank. 11,400 combined hull/shield versus
    // 10,787; 475 precise DPS plus up to 90 rocket DPS, paid for with 13% more mass
    // and slower movement. Rocket scatter makes the extra damage situational.
    (
        key: "regency_t3_assault_tank", name: "Executioner",
        role: "Heavy Fusion Assault Tank", title: "Heavy Tank",
        tech: 3, categories: ["Land", "DirectFire"],
        health: 8400, shield: (kind: Hull, health: 3000, regen: 30),
        economy: (energy_upkeep: 65),
        cost: (mass: 950, energy: 7600, time: 5400),
        radius: 10.5, height: 7.0, vision: 650,
        motion: (layer: Land, size: 2, speed: 25, accel: 20, turn: 85),
        weapons: [
            (
                name: "Pinch-fusion Lance",
                damage: 1800, splash: 3, range: 410, reload: 4.0,
                speed: 4000, trajectory: Direct, rounds: 8, round_span: 0.12,
                turret_turn: 95, muzzle: (10.0, 0, 5.3), pivot: (1.5, 0, 5.3),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion), flash: 0.6, impact: 1.0, tracer: 1.2,
                sounds: (fire: "regency_sunspear_fire", charge: "regency_sunspear_charge",
                    charge_time: 1.5, impact: "regency_sunspear_hit", ground: "regency_sunspear_hit"),
            ),
            (
                name: "Plasmeric Repeater",
                damage: 10, splash: 1, range: 340, reload: 0.4, speed: 600,
                trajectory: Direct, turret_turn: 95,
                muzzle: (5.8, -2.4, 5.3), pivot: (1.5, 0, 5.3),
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(Plasmeric), tracer: 0.9, flash: 0.8, impact: 0.8,
                sounds: (fire: "regency_repeater", impact: "regency_repeater_hit", ground: "regency_repeater_hit"),
            ),
            (
                name: "Redstorm Rocket Volley",
                damage: 120, splash: 7, range: 360, reload: 8.0, speed: 210,
                trajectory: Direct, spread: 7.0,
                missile: true, guided: false, intercept: 30, caliber: 0.28,
                plasma_grade: Some(Gravitic), salvo: 6, salvo_delay: 0,
                turret_turn: 95, muzzle: (0.6, 3.6, 6.0), pivot: (0, 0, 5.3),
                muzzles: [(0.6, 3.1, 6.0), (0.6, 3.6, 6.0), (0.6, 4.1, 6.0),
                          (0.6, -3.1, 6.0), (0.6, -3.6, 6.0), (0.6, -4.1, 6.0)],
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                tracer: 0.8, flash: 0.7, impact: 1.0,
                sounds: (fire: "regency_seeker_launch", impact: "regency_seeker_burst", ground: "regency_seeker_burst"),
            ),
        ],
        mesh: "regency_executioner", icon: Tank,
        sounds: (death: "blast_large", moving: "tracks_heavy"),
    ),
]
