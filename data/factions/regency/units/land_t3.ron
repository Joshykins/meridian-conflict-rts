// The Regency's tech 3 land units, made by the Anvil III. Models: `models::regency::*`; a model
// authored at another size says so, and its tests tie these numbers to it.
[
    // Mobile anti-spaceship gun: a Pinch-fusion gun raised to the sky, the Sunspear's gun drawn
    // small on a moving body, the Regency's answer to warships in the upper air that ARC
    // meets with the Zenith and the Narwhal. It charges for a long beat, then pinches out one
    // fast shot of fusion up at the hull, and shoots at nothing else: escorts keep it alive.
    //
    // Balance: anchored on ARC's tech 3 anti-ship gun, the Narwhal (3800 mass, 40000 HP, 12000
    // every 6 s at 3000 m), and the Zenith (tech 4, 40000 every 7 s at 3200 m), scaled down to
    // a tech 3 unit a factory makes. Bent the Regency way: it hits harder for its mass (7000
    // every 6 s, 0.65 DPS a mass point against the Narwhal's 0.53) from a shorter reach
    // (2400 m), and is light (9000 HP), a gun that needs escorts. Three of them
    // bring down an ARC frigate (55000 HP) in about 16 s.
    //
    // Model: `regency_skyspear` (`models::regency::fusion_guns::skyspear`), authored at this
    // size; `pivot`/`muzzle` are its trunnion and the middle of its charge.
    (
        key: "regency_t3_mobile_aa",
        name: "Spire",
        role: "Mobile Anti-Ship Gun", title: "Anti-Ship",
        tech: 3,
        categories: ["Land", "AntiAir"],
        health: 9000,
        cost: (mass: 1800, energy: 18000, time: 6000),
        radius: 7.0, height: 10.0,
        vision: 600,
        motion: (layer: Land, size: 1, speed: 24, accel: 18, turn: 70),
        weapons: [(
            name: "Pinch-fusion Cannon",
            damage: 7000, splash: 12, range: 2400, reload: 6.0, speed: 1350, trajectory: Direct,
            turret_turn: 40, muzzle: (4.821, 0, 11.145), pivot: (0, 0, 5.4),
            targets: ["Space"], color: Orange, red: 1.0,
            plasma_grade: Some(PinchFusion),
            flash: 0.6, impact: 2.0, tracer: 2.0,
            sounds: (
                fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 2.2,
                charge_volume: 1.6,
                impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
            ),
        )],
        mesh: "regency_skyspear", icon: AntiAir,
        sounds: (death: "blast_large", moving: "tracks_heavy"),
    ),
    // Heavy artillery: a Pinch-fusion Howitzer. It charges for a long beat, the coils down its
    // bore lighting one after another, then lobs one great shot of fusion high over the
    // field that lands with the Sunspear's strike: the ground melted into a glowing pool and a
    // knot of fusion left burning over it.
    //
    // Balance: the Trebuchet's (800 mass, 4715 HP, 4467 damage every 10 s at 1800 m, 48 m
    // splash, 4.6 degrees of spread). Bent the Regency way: it hits harder (5200) in a tighter
    // blast (40 m), laid truer (2.5 degrees) from a shorter reach (1600 m), and charges longer
    // (2.8 s against 2.4 s).
    //
    // Model: `regency_fusion_howitzer` (`models::regency::fusion_guns::howitzer`), authored at
    // this size; `pivot`/`muzzle` are its trunnion and the middle of its charge.
    (
        key: "regency_t3_artillery",
        name: "Kiln",
        role: "Mobile Fusion Artillery", title: "Heavy Artillery",
        tech: 3,
        categories: ["Land", "Artillery"],
        health: 4900,
        cost: (mass: 820, energy: 6600, time: 4800),
        radius: 11.0, height: 9.5,
        vision: 220,
        motion: (layer: Land, size: 2, speed: 22, accel: 16, turn: 70),
        weapons: [(
            name: "Pinch-fusion Howitzer",
            damage: 5200, splash: 40, range_min: 150, range: 1600, reload: 10.0, speed: 240,
            trajectory: Ballistic, loft: 6, spread: 2.5,
            turret_turn: 45, muzzle: (12.066, 0, 10.435), pivot: (-2.2, 0, 5.8),
            targets: ["Structure", "Land", "Naval"], color: Orange, red: 1.0,
            plasma_grade: Some(PinchFusion),
            flash: 1.0, impact: 1.0, tracer: 2.4,
            sounds: (
                fire: "regency_sunspear_fire", charge: "regency_sunspear_charge", charge_time: 2.8,
                charge_volume: 1.6,
                impact: "regency_sunspear_hit", ground: "regency_sunspear_hit",
            ),
        )],
        mesh: "regency_fusion_howitzer", icon: Artillery,
        sounds: (death: "blast_large", moving: "tracks_heavy"),
    ),
    // The wake tank: a heavy armoured hover tank on four lift bells, built round one wide
    // projector in a low turret. It gathers plasma across the projector's mouth and pinches
    // it out as a wake: a rolling crest of plasma arched over the fan, white-hot, orange and
    // red, leaving a trail of cooling red light back to the projector, that rolls out along
    // the ground at a walking pace for a gun (90 m
    // a second), and strikes everything it rolls over (`cone`, `mc-sim` `wake.rs`; drawn by
    // `wake_fx.rs` and wake_shell.wgsl), in a narrow fan 8 degrees either side of
    // the projector's line, full weight close in and two fifths of it at the end of its
    // reach. Once let go it rolls on by itself: what outruns it, or leaves the fan before it
    // arrives, is missed. A crest between the projector and a unit shields it, and the wake
    // never reaches aircraft or what is under the water. It scorches the ground it rolls over.
    //
    // Balance: a line breaker that reaches out. HP and cost about 2.6 Bulwarks (the
    // Arbalest's class); its reach is nearly a Bulwark's (340 m to 360), but the front takes
    // nearly four seconds to get there, so moving targets slip it at range and a column
    // driving at it does not. Against one target it does three and a half Bulwarks' damage
    // a second close in, falling to under one and a half at its edge; against a column it
    // strikes every hull down the fan. Hover, so it crosses water (the Regency's lift; ARC's
    // heavy tanks cannot), and slower than a Bulwark to pay for it.
    //
    // Model: `regency_wake_tank` (`models::regency::wake_tank`), authored at this size.
    (
        key: "regency_t3_wake_tank",
        name: "Wake",
        role: "Wake Tank",
        tech: 3,
        categories: ["Land", "DirectFire"],
        health: 4400,
        cost: (mass: 520, energy: 4700, time: 3200),
        radius: 7.6, height: 4.6,
        vision: 380,
        motion: (layer: Hover, size: 1, speed: 25, accel: 18, turn: 75),
        weapons: [(
            name: "Pinched-plasmeric Wake Projector",
            // Charged a second across the projector's mouth, then let go as one wake.
            damage: 680, range: 340, reload: 2.6, hitscan: true, trajectory: Direct,
            cone: (angle: 8, edge: 0.4, speed: 90),
            turret_turn: 70, muzzle: (8.2, 0, 3.4), pivot: (1.4, 0, 3.4),
            targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
            plasma_grade: Some(Pinched),
            flash: 1.4, impact: 1.6,
            sounds: (fire: "regency_wake_fire", charge: "regency_halberd_charge", charge_time: 1.0),
        )],
        mesh: "regency_wake_tank", icon: Tank,
        sounds: (death: "blast_large", moving: "aster_hover"),
    ),
    // The strider: a fighting machine on three long legs (a tripod), its tall keeled head
    // carried high over the field. The head is the turret: it turns on the legs' crown and carries a
    // Pinched-plasmeric Cannon slung under a plated outrigger either side. Each gathers plasma in
    // front of its bore and pinches it out as a short dense jet; the two take turns.
    //
    // It walks one leg at a time, the third swinging while two stand (`set_crawl_legs` with
    // a lone leg on the centreline). It wades: it walks the seabed like the Paladin, its
    // head high enough over the water to fire on anything ashore or afloat.
    //
    // Balance: the Paladin's class. The Regency way: shorter reach (340 m to 400), heavier
    // shots (a fifth more damage a second), no shield (more armour instead: its HP is near
    // the Paladin's HP and shield together) and no torpedoes, so a dived submarine is safe
    // from it. A little slower.
    //
    // Model: `regency_strider` (`models::regency::strider`), authored at this size.
    (
        key: "regency_t3_strider",
        name: "Strider",
        role: "Assault Tripod",
        tech: 3,
        categories: ["Land", "DirectFire"],
        health: 10200,
        cost: (mass: 860, energy: 6900, time: 4900),
        radius: 12.0, height: 32.0,
        vision: 800,
        motion: (layer: Amphibious, size: 2, speed: 27, accel: 22, turn: 110),
        weapons: [
            (
                name: "Pinched-plasmeric Cannon",
                // The left cannon. A second's charge before the first shot; its jet is
                // drawn as six rounds over a fifth of a second.
                damage: 520, splash: 2, range: 340, reload: 1.8, rounds: 6, round_span: 0.2,
                speed: 900, trajectory: Direct,
                turret_turn: 120, muzzle: (9.0, 3.8, 24.4), pivot: (1.2, 0, 24.4),
                targets: ["Land", "Naval"], color: Orange, red: 1.0,
                plasma_grade: Some(Pinched),
                flash: 1.1, impact: 2.0, tracer: 1.4,
                sounds: (
                    fire: "regency_halberd_fire", charge: "regency_halberd_charge", charge_time: 1.0,
                    impact: "regency_halberd_hit", ground: "regency_halberd_hit",
                ),
            ),
            (
                name: "Pinched-plasmeric Cannon",
                // The right cannon: half a reload behind the left.
                damage: 520, splash: 2, range: 340, reload: 1.8, rounds: 6, round_span: 0.2,
                speed: 900, trajectory: Direct,
                turret_turn: 120, muzzle: (9.0, -3.8, 24.4), pivot: (1.2, 0, 24.4),
                targets: ["Land", "Naval"], color: Orange, red: 1.0,
                plasma_grade: Some(Pinched),
                flash: 1.1, impact: 2.0, tracer: 1.4,
                sounds: (
                    fire: "regency_halberd_fire", charge: "regency_halberd_charge", charge_time: 1.0,
                    impact: "regency_halberd_hit", ground: "regency_halberd_hit",
                ),
            ),
        ],
        mesh: "regency_strider", icon: Bot,
        sounds: (death: "blast_large", moving: "regency_crawl", step: "regency_footfall"),
    ),
]
