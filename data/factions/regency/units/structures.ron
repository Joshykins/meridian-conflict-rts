    // ---- Defence ------------------------------------------------------------------------
    // A plasmeric repeater on a squat mount: shorter reach than a Sentinel, a third more
    // damage inside it. It wants to be where the fight comes to, not where it can see.
    (
        key: "regency_t1_point_defense",
        name: "Picket",
        role: "Point Defense",
        tech: 1,
        categories: ["Land", "Defense", "DirectFire"],
        health: 1500,
        cost: (mass: 260, energy: 2000, time: 260),
        radius: 5.5, height: 8, footprint: (1, 1),
        vision: 240,
        weapons: [(
            name: "Plasmeric Repeater",
            // Three slugs a shot (`rounds`): 75 every 0.9 s.
            damage: 75, splash: 1, range: 220, reload: 0.9, speed: 700, trajectory: Direct,
            turret_turn: 160, muzzle: (5.2, 0, 6.8), pivot: (0, 0, 6),
            targets: ["Land", "Naval"], color: Orange, red: 1.0, rounds: 3,
            plasma_grade: Some(Plasmeric),
            flash: 1.4, impact: 1.2, tracer: 0.8,
            sounds: (fire: "regency_barb", impact: "shell_light"),
        )],
        mesh: "regency_barb", icon: Defense,
    ),
    // The tech 2 point defence: a Pinched-plasmeric Cannon on an armoured keep. Its slugs
    // are plasma squeezed dense by gravity, three to a burst, and they stop in what they
    // hit: all their weight on the one hull, next to nothing splashed. Reach and weight as
    // a Redoubt's. Placeholder name. Model: `regency_pinch_cannon` (`models::regency::pinch_guns`).
    (
        key: "regency_t2_point_defense",
        name: "Halberd",
        role: "Heavy Point Defense",
