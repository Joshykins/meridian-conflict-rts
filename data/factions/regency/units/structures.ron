            plasma_grade: Some(Plasmeric),
            flash: 1.0, impact: 1.0, tracer: 1.2,
            sounds: (fire: "regency_repeater", impact: "regency_repeater_hit", ground: "regency_repeater_hit"),
        )],
        mesh: "regency_barb", icon: Defense,
    ),
    // The tech 2 point defence: a Pinched-plasmeric Cannon. It gathers its plasma in front
    // of the bore and squeezes it dense by gravity (a second's charge), then pinches it out
    // as one shot: a jet of plasma a quarter of a second long (`rounds` over `round_span`,
    // drawn; the sim flies the one shot). It bursts where it hits and sears the ground, all
    // its weight on the one hull, next to nothing splashed. Reach and weight as a
    // Redoubt's. Model: `regency_pinch_cannon` (`models::regency::turrets::halberd`).
    (
        key: "regency_t2_point_defense",
        name: "Halberd",
