    // ---- Economy ------------------------------------------------------------------------
    // Works the same ore as a Core Mine, and as well at every tier, but it digs with a beam
    // and lifts the ore on its own gravity pinch, drawing nothing from the grid: no energy
    // upkeep, so a Regency economy never browns out its mass. It pays for that up front, and
    // upgrades in place through the same four tiers (`models::regency::taproot`); the fourth,
    // like the Deep Core, opens with tech 3. Land only, as the Core Mine.
    (
        key: "regency_t1_extractor",
        name: "Excavator",
        role: "Materials Mine",
        tech: 1,
        categories: ["Land", "Economy", "Extractor"],
        health: 480,
        cost: (mass: 55, energy: 300, time: 90),
        radius: 12.8, height: 11, footprint: (3, 3),
        vision: 300,
        economy: (mass_storage: 100),
        // The beam lifts the ore with no hammer: no blows to show or hear.
        mine: (
            reach: 1000,
            ground: 0.00036, per_hectare: 0.6, base: 0.2, hammer: false,
