    // A small star held in a gravity cage: it gives what a Reactor gives, but a breached
    // cage lets the star fall in on itself and go out, so it dies without a blast and can
    // be packed tight. Tougher, dearer.
    (
        key: "regency_t1_power",
        name: "Star Cage",
        role: "Power Generator",
        tech: 1,
        categories: ["Land", "Economy", "Power"],
        health: 1100,
        cost: (mass: 90, energy: 420, time: 140),
        radius: 6.9, height: 7.5, footprint: (2, 2),
        vision: 120,
        economy: (energy_income: 15),
        mesh: "regency_heart", icon: Power,
    ),
    // The tech 2 and 3 star cores: bigger stars in more cage, on lots of their own (like
    // Reactor II and III, built new, not upgraded). The same trade as the Star Cage: tougher
    // and dearer than the Reactor of their tier, and no blast when the cage is breached.
    (
        key: "regency_t2_power",
        name: "Star Cage II",
        role: "Power Generator",
        tech: 2,
        categories: ["Land", "Economy", "Power"],
