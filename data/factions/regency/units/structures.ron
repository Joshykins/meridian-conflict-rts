// The Regency's own structures: the tech 1 core every side fields (factories, mass, power,
// storage, point defence, anti-air, radar, walls), built as Regency machines: dark armour
// plates lapped over bronze machinery that works. They are not ARC's buildings in black:
// each one bends the shared job toward how the Regency fight.
//
// - Excavator: cuts the ore with an excavation beam and needs no power, but costs more
//   mass up front.
// - Star Cage: a caged star that never explodes; Star Cages can be packed tight where ARC
//   reactors cannot.
// - Reliquary: one building holds mass and energy both.
// - Picket: a short-ranged brawler, more damage than a Sentinel inside its reach.
// - Canopy: bursting flak that hurts a whole flight, not one plane.
// - Orrery: a shorter radar that sees far more; its floating rings add a tier each.
// - Palisade: slow to build, very hard to cut.
//
// Their factories turn out the Regency's own Artificer (its tech 2 and 3 from the factories of
// that tier) and, until the Regency has fighting units
// of their own, the stand-in roster's (ARC) units of their tier, poured by nanite streams
// from fabricator heads whose mounts are in `mc_sim::print_heads`. The land and air
// factories upgrade in place to tech 3, like ARC's; the tech 3 land factory also makes the
// battle scorpion. Models: `models::regency::*`,
// authored at the sizes here, so every muzzle and pivot below is the model's own number.
[
    // ---- Factories ----------------------------------------------------------------------
    (
        key: "regency_t1_land_factory",
        name: "Anvil",
        role: "Land Factory",
        tech: 1,
        categories: ["Land", "Factory"],
        health: 4600,
        cost: (mass: 250, energy: 2000, time: 320),
        radius: 46, height: 22, footprint: (8, 8),
        vision: 200,
        builder: (power: 20, range: 0, builds: [
            "regency_t1_engineer", "regency_t1_scout", "aster_t1_bot", "aster_t1_tank", "aster_t1_artillery", "aster_t1_mobile_aa",
        ]),
        upgrades_to: "regency_t2_land_factory",
        mesh: "regency_brood", icon: Factory,
        sounds: (death: "blast_large"),
    ),
    // Tech 2 adds an outboard machine bank along each wing and two fabricator heads off
    // the press block.
    (
        key: "regency_t2_land_factory",
        name: "Anvil II",
        role: "Land Factory",
        tech: 2,
        categories: ["Land", "Factory"],
        health: 9200,
        cost: (mass: 1580, energy: 12100, time: 2030),
        radius: 46, height: 22, footprint: (8, 8),
        vision: 200,
        builder: (power: 120, range: 0, builds: [
            "regency_t1_engineer", "regency_t2_engineer", "aster_t1_scout", "aster_t1_bot", "aster_t1_tank", "aster_t1_artillery", "aster_t2_tank", "aster_t2_hover", "aster_t2_missile", "aster_t1_mobile_aa", "aster_t2_mobile_aa",
        ]),
        upgrades_to: "regency_t3_land_factory",
        mesh: "regency_brood", icon: Factory,
        sounds: (death: "blast_large"),
    ),
    // Tech 3 lifts the fabrication ring on four pylons, high enough for the battle scorpion
    // to be made under it, and hangs six heads from it; blade plates over the outboard
    // banks, a flywheel drum behind the press.
    (
        key: "regency_t3_land_factory",
        name: "Anvil III",
        role: "Land Factory",
        tech: 3,
        categories: ["Land", "Factory"],
        health: 18500,
        cost: (mass: 4840, energy: 39100, time: 5550),
        radius: 46, height: 35, footprint: (8, 8),
        vision: 200,
        builder: (power: 360, range: 0, builds: [
            "regency_t1_engineer", "regency_t2_engineer", "regency_t3_engineer", "aster_t1_scout", "aster_t1_bot", "aster_t1_tank", "aster_t1_artillery", "aster_t2_tank", "aster_t2_hover", "aster_t2_missile", "aster_t3_assault_bot", "aster_t3_artillery", "aster_t3_sniper", "aster_t1_mobile_aa", "aster_t2_mobile_aa", "regency_t3_scorpion",
        ]),
        mesh: "regency_brood", icon: Factory,
        sounds: (death: "blast_large"),
    ),
    (
        key: "regency_t1_air_factory",
        name: "Skyforge",
        role: "Air Factory",
        tech: 1,
        categories: ["Land", "Air", "Factory"],
