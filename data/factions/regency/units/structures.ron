    // ---- Defence ------------------------------------------------------------------------
    // A plasmeric repeater: a steady stream of plasma bolts, five a second. Shorter reach
    // than a Sentinel, a third more damage inside it. It wants to be where the fight comes
    // to, not where it can see.
    (
        key: "regency_t1_point_defense",
        name: "Picket",
        role: "Point Defense",
        tech: 1,
        categories: ["Land", "Defense", "DirectFire"],
        health: 1500,
