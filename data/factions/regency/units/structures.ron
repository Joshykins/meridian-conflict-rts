    // ---- Economy ------------------------------------------------------------------------
    // Works the same ore as a Core Mine, and as well at every tier, but it digs with a beam
    // and lifts the ore on its own gravity pinch, drawing nothing from the grid: no energy
    // upkeep, so a Regency economy never browns out its mass. It pays for that up front, and
    // upgrades in place through the same four tiers (`models::regency::taproot`); the fourth,
    // like the Deep Core, opens with tech 3 and only adds a fixed yield from its shaft.
    (
        key: "regency_t1_extractor",
        name: "Excavator",
        role: "Materials Mine",
        tech: 1,
        categories: ["Land", "Economy", "Extractor"],
        health: 480,
        cost: (mass: 230, energy: 800, time: 200),
        radius: 12.8, height: 11, footprint: (3, 3),
        vision: 300, water_build: true,
        economy: (mass_storage: 250),
        // The beam lifts the ore with no hammer: no blows to show or hear.
        mine: (
            reach: 1000, sea_reach: 1500,
            ground: 0.010, per_hectare: 0.9, base: 1.1, hammer: false,
        ),
        upgrades_to: "regency_t2_extractor",
        mesh: "regency_taproot", icon: Extractor,
    ),
    (
        key: "regency_t2_extractor",
        name: "Excavator II",
        role: "Materials Mine",
        tech: 2,
        categories: ["Land", "Economy", "Extractor"],
        health: 3840,
        cost: (mass: 1700, energy: 6000, time: 2350),
        radius: 12.8, height: 15, footprint: (3, 3),
        vision: 360, water_build: true,
        economy: (mass_storage: 750),
        mine: (
            reach: 1000, sea_reach: 1500,
            ground: 0.039, per_hectare: 3.6, base: 4.5, hammer: false,
        ),
        upgrades_to: "regency_t3_extractor",
        mesh: "regency_taproot", icon: Extractor,
    ),
