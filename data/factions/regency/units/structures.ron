        builder: (power: 120, range: 0, builds: [
            "regency_t1_engineer", "regency_t1_mobile_reclaimer", "regency_t2_engineer", "regency_t2_mobile_reclaimer", "regency_t1_scout", "regency_t1_raider", "regency_t1_tank", "regency_t1_artillery", "regency_t2_tank", "regency_t2_bombard", "regency_t1_mobile_aa", "regency_t2_mobile_aa",
