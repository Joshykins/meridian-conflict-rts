            plasma_grade: Some(Pinched),
            flash: 1.1, impact: 1.4, shockwave: 0.5,
            sounds: (fire: "regency_pinched_cannon", impact: "regency_pinched_hit", ground: "regency_pinched_hit"),
        )],
        mesh: "regency_pinch_cannon", icon: Defense,
        sounds: (death: "blast_large"),
    ),
    // The tech 3 point defence: a Pinch-fusion Cannon. The plasma is squeezed until it
    // fuses, and the gun fires the fusion out as a stream of bursts, five to a shot, each
    // flaring white where it lands. The Citadel's weight a shot, spread over five hits:
    // it breaks heavies as the Citadel does, and wastes less on light hulls. Placeholder
    // name. Model: `regency_fusion_cannon` (`models::regency::pinch_guns`).
    (
