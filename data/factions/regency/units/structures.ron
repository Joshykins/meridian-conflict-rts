    // The tech 2 artillery installation: a Pinched-plasmeric Howitzer, the Halberd's charge
    // lobbed. It gathers plasma in front of the bore and squeezes it dense (a longer charge
    // than the Halberd's), then pinches it out as one glob on a high arc that bursts and
    // sears the ground where it lands.
    //
    // Balance against the Onager (1900 mass, 2900 HP, 1100 every 16 s at 1900 m, 32 m
    // splash, 1 degree of spread), bent the Regency way: it hits harder (1300) in a tighter
    // blast (24 m), laid truer (0.8 degrees). Same reach, past the Trebuchet's 1800 and the
    // Kiln's 1600, so a tech 3 siege gun has to come into its fire to shell the base, and it
    // kills either in four hits where the Onager needs five.
    //
    // Model: `regency_basilisk` (`models::regency::turrets::basilisk`), authored at this
    // size; `muzzle` is the middle of the charge.
    (
        key: "regency_t2_artillery",
        name: "Basilisk",
        role: "Artillery Installation", title: "Artillery",
        tech: 2,
        categories: ["Land", "Defense", "Artillery"],
        health: 3000,
        cost: (mass: 1950, energy: 13800, time: 1600),
        radius: 10.5, height: 12, footprint: (2, 2),
        vision: 260,
        weapons: [(
            name: "Pinched-plasmeric Howitzer",
            damage: 1300, splash: 24, range_min: 250, range: 1900, reload: 16.0, speed: 220,
            trajectory: Ballistic, loft: 3, spread: 0.8,
            turret_turn: 12, muzzle: (12.4, 0, 12.6), pivot: (0, 0, 7.6),
            targets: ["Structure", "Land", "Naval"], color: Orange, red: 1.0,
            plasma_grade: Some(Pinched),
            flash: 1.3, impact: 2.4, tracer: 1.6,
            sounds: (
                fire: "regency_halberd_fire", charge: "regency_halberd_charge", charge_time: 1.6,
                impact: "regency_halberd_hit", ground: "regency_halberd_hit",
            ),
        )],
        mesh: "regency_basilisk", icon: Artillery,
        sounds: (death: "blast_large"),
    ),
