            name: "Pinched-plasmeric Cannon",
            damage: 240, splash: 1, range: 520, reload: 2.4, salvo: 3, salvo_delay: 0.1,
            speed: 900, trajectory: Direct,
            turret_turn: 90, muzzle: (11.6, 0, 8.4), pivot: (0, 0, 8.4),
