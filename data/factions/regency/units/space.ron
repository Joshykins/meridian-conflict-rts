// Regency space fleet: site-built ships, with guns matched to the models' houses.
[
    (
        key: "regency_t3_assault_transport", name: "Ark", role: "Assault Transport", title: "Heavy Transport",
        tech: 3, categories: ["Air", "Space"], health: 12000,
        cost: (materials: 2800, energy: 46000, time: 16000),
        radius: 150, height: 100, footprint: (25, 13), hull: (150, 75), vision: 700,
        motion: (layer: Air, size: 0, speed: 92, accel: 22, turn: 32, altitude: 440, hover: true, deploy: 1.4),
        // Warp: the Regency's drives take the hull apart into a nanite swarm (`style: Nanite`).
        warp: (per_km: 8000, spool: 4, cooldown: 60, speed: 3500, style: Nanite),
        transport: (capacity: 192, descent: 85, hold: (40, 0), ramp: (-10, -86), width: 44, floor: 38, clearance: 36, unload: 0.4),
        weapons: [], mesh: "regency_ark", icon: Transport,
        shield: (kind: Hull, health: 4000, regen: 45), economy: (energy_upkeep: 80),
        sounds: (death: "blast_large", moving: "aster_hover"),
    ),
    // The Vassal: the Valiant's peer, an escort that keeps the sky over the fleet and lays
    // a lance on the ground or across at a ship. Against the Valiant: about its price and
    // the same lance damage a second at its reach; a lighter hull behind a small hull
    // shield, faster, and three twin repeaters that reach 200 m past its rotary at a little
    // more weight of fire. Model: `models::regency::space::vassal`. Tech 3 since 2026-10-10
    // (the key keeps its old tier for replays).
    (
        key: "regency_t2_space_frigate", name: "Vassal", role: "Escort Frigate", title: "Escort Frigate",
        tech: 3, categories: ["Air", "Space", "DirectFire"], health: 5500,
        cost: (materials: 1900, energy: 31000, time: 11400),
        radius: 56, height: 18, footprint: (10, 5), hull: (56, 22), vision: 1300,
        motion: (layer: Air, size: 0, speed: 95, accel: 18, turn: 30, altitude: 420, hover: true),
        warp: (per_km: 4000, spool: 3, cooldown: 50, speed: 3200, style: Nanite),
        hull_mounts: true,
        shield: (kind: Hull, health: 2000, regen: 25), economy: (energy_upkeep: 50),
        weapons: [
            // Hung under the forward keel on a pylon, turning right round: plasma gathered
            // in front of the bore for a second, then pinched out as one long red jet (the
            // Executioner's lance in the red of the Pinched grade, drawn as the Halberd's).
            (name: "Pinch-plasma Lance", damage: 700, splash: 5, range: 1550, reload: 3.6,
                rounds: 8, round_span: 0.25, speed: 1000, trajectory: Direct,
                turret_turn: 50, arc: 360, mount: true, slant: true,
                pivot: (14, 0, 4.5), muzzle: (38, 0, 4.5),
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, red: 1.0,
                plasma_grade: Some(Pinched), flash: 1.4, impact: 2.2, tracer: 1.6,
                sounds: (
                    fire: "regency_halberd_fire", charge: "regency_halberd_charge", charge_time: 1.0,
                    impact: "regency_halberd_hit", ground: "regency_halberd_hit",
                ), ),
            // Three twin repeaters, the sky all round: on the foredeck,
            (name: "Twin Escort Plasma Repeater", damage: 16, splash: 1, range: 750, reload: 0.45,
                salvo: 2, salvo_delay: 0.08, speed: 700, trajectory: Direct,
                turret_turn: 200, arc: 360, mount: true,
                pivot: (26, 0, 17.5), muzzle: (34, 0.9, 17.5),
                muzzles: [(34, 0.9, 17.5), (34, -0.9, 17.5)],
                targets: ["Air"], color: Orange, red: 1.0,
                plasma_grade: Some(Plasmeric), flash: 0.9, impact: 1.0, tracer: 0.7,
                sounds: (fire: "regency_canopy_fire", impact: "regency_repeater_hit", ground: "regency_repeater_hit"), ),
            // on a barbette amidships, firing over the foredeck's,
            (name: "Twin Escort Plasma Repeater", damage: 16, splash: 1, range: 750, reload: 0.45,
                salvo: 2, salvo_delay: 0.08, speed: 700, trajectory: Direct,
                turret_turn: 200, arc: 360, mount: true,
                pivot: (-12, 0, 19), muzzle: (-4, 0.9, 19),
                muzzles: [(-4, 0.9, 19), (-4, -0.9, 19)],
                targets: ["Air"], color: Orange, red: 1.0,
                plasma_grade: Some(Plasmeric), flash: 0.9, impact: 1.0, tracer: 0.7,
                sounds: (fire: "regency_canopy_fire", impact: "regency_repeater_hit", ground: "regency_repeater_hit"), ),
            // and hung under the stern.
            (name: "Twin Escort Plasma Repeater", damage: 16, splash: 1, range: 750, reload: 0.45,
                salvo: 2, salvo_delay: 0.08, speed: 700, trajectory: Direct,
                turret_turn: 200, arc: 360, mount: true,
                pivot: (-26, 0, 4), muzzle: (-18, 0.9, 4),
                muzzles: [(-18, 0.9, 4), (-18, -0.9, 4)],
                targets: ["Air"], color: Orange, red: 1.0,
                plasma_grade: Some(Plasmeric), flash: 0.9, impact: 1.0, tracer: 0.7,
                sounds: (fire: "regency_canopy_fire", impact: "regency_repeater_hit", ground: "regency_repeater_hit"), ),
        ], mesh: "regency_space_frigate", icon: Warship,
        sounds: (death: "blast_large", moving: "aster_hover"),
    ),
