    // The Regent: the NR-Class Super Destroyer, the Regency fleet's workhorse, four times the
    // Scourge's length and more (about 3.5 km). Its guns are weapon groups: each weapon below
    // is one kind of gun on every house of that kind (`mounts`, the model's: pivots and
    // muzzles are `models::regency::space::regent`'s, muzzles about each pivot as the house
    // faces the nose), each house with its own aim, mark and reload. Weapon order is the
    // model's gun-slot order (`regent/guns.rs` `GROUPS`): keep any new weapon after them.
    //
    // Balance (tests/regent.rs): from 3 km it kills a lone Scourge or Dominion in about 20 s,
    // beats four or five of them and is about even with eight; its direct fire reaches 3 km,
    // inside the Zenith's 3.2 km, so a dozen Zeniths behind missile defence bring it down.
    (
        key: "regency_t5_super_destroyer", name: "The Regent", role: "NR-Class Super Destroyer",
        title: "Super Destroyer",
        tech: 5, categories: ["Air", "Space", "Experimental"], health: 1200000,
        cost: (materials: 400000, energy: 4000000, time: 1300000),
        radius: 1900, height: 760, footprint: (0, 0), hull: (1900, 600), vision: 4000, radar: 6000,
        body: (fore: 1900, aft: -1550, beam: 450),
        motion: (layer: Air, size: 0, speed: 40, accel: 2, turn: 3, altitude: 1500, hover: true, hangs: true),
        hull_mounts: true,
        // The Edict: no gun of its own. The ship gathers along its whole hull, every other gun
        // silent, and fires from the point on it nearest the mark: a total kill within 300 m,
        // falling off to 1.2 km, then a molten wave burning out over it for 10 s.
        edict: (
            gather: 15, range: 6000, reload: 150, energy: 500000, quiet: 3,
            blast: (radius: 1200, core: 300, damage: 400000, edge: 4000, front: 1.6),
            wave: (radius: 1200, speed: 300, damage: 4000, edge: 0.1, linger: 6),
            sounds: (
                gather: "regency_edict_gather", peak: "regency_edict_peak",
                fire: "regency_edict_fire", fire_far: "regency_edict_fire_far",
                impact: "regency_edict_impact", impact_far: "regency_edict_impact_far",
                cancel: "regency_edict_cancel",
            ),
        ),
        // Eight Rondel crush lenses, four a side, each reaching 900 m round it.
        anti_missile: 900, anti_missile_lasers: 8,
        anti_missile_mounts: [
            (1450, 57.75, 625), (760, 120, 671), (-150, 103.75, 691.5), (-680, 52.75, 654.5),
            (1450, -57.75, 625), (760, -120, 671), (-150, -103.75, 691.5), (-680, -52.75, 654.5),
        ],
        weapons: [
            // Four Heavy Pinch-fusion Lances, the Scourge's held star beam on a house of its
            // own: two in wells on the dorsal spine (they dip no lower than 30 degrees off
            // the deck), two hung under the keel. Each charges its core (`spin_up`) before
            // the beam lights, and drags its stream across the ground onto its next mark.
            (
                name: "Heavy Pinch-fusion Lance", damage: 140, splash: 24, range: 3000, reload: 0.1,
                hitscan: true, beam: true, star_beam: true, trajectory: Direct, spin_up: 2.5,
                turret_turn: 20, arc: 300, depression: 30, muzzle: (210, 0, 0), sweep: 10,
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion), flash: 0.6, impact: 3.6, tracer: 30.0,
                sounds: (spin: "regency_lance_charge", hold: "regency_lance_hold", spindown: "regency_lance_vent"),
                mounts: [
                    (pivot: (1450, 0, 631.5), facing: 0),
                    (pivot: (1250, 0, 654), facing: 0),
                ],
            ),
            (
                name: "Heavy Pinch-fusion Lance", damage: 140, splash: 24, range: 3000, reload: 0.1,
