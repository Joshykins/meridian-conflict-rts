    // The Scourge: the Regency's capital warship, the Dominion's peer, the Regent brought
    // down to tech 4 (docs/REGENCY_SPACE_FLEET.md). It fights from the Dominion's height with
    // the lance held from its core under it, six batteries in ball mounts in pockets in its
    // chines, four AA repeaters on the arms and the after deck and four Rondels. Its guns
    // are weapon groups after the lance (`models::regency::space::destroyer`, `guns.rs`):
    // each mount a house of its own, muzzles about its pivot as the house faces the nose.
    (
        key: "regency_t4_space_destroyer", name: "Scourge", role: "Destroyer", title: "Destroyer",
        tech: 4, categories: ["Air", "Space", "Experimental"], health: 170000,
        cost: (materials: 48000, energy: 658000, time: 208000),
        radius: 390, height: 130, footprint: (52, 20), hull: (330, 140), vision: 2400, radar: 3600,
        // Shots meet the long hull along its length, not a disc of its radius.
        body: (fore: 320, aft: -320, beam: 110),
        motion: (layer: Air, size: 0, speed: 40, accel: 4, turn: 6, altitude: 700, hover: true, hangs: true),
        warp: (per_km: 45000, spool: 7, cooldown: 110, speed: 4000, style: Nanite),
        hull_mounts: true,
        // Four Rondel crush lenses on the deck edges, two a side.
        anti_missile: 800, anti_missile_lasers: 4,
        anti_missile_mounts: [(270, 22.75, 88.5), (-110, 61, 110.5), (270, -22.75, 88.5), (-110, -61, 110.5)],
        weapons: [
            // One held beam laid from the lower lens of the energy core in the drum through
            // the ship's middle (nothing turns: the beam is aimed from the lens). The core
            // charges (`spin_up`) before the beam lights, and winds down when it has nothing
            // left. It fires down its line (`sweep`): locked on, it holds on the mark; when
            // the mark dies it stays lit as it slowly drags across the ground onto the next,
            // melting a line of glass between them; it digs no crater.
            (
                name: "Edict Lance", damage: 160, splash: 20, range: 2200, reload: 0.1,
                hitscan: true, beam: true, edict_beam: true, trajectory: Direct, spin_up: 3.0,
                turret_turn: 12, muzzle: (0, 0, 15.2), sweep: 10,
                targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
                plasma_grade: Some(PinchFusion), flash: 0.4, impact: 3.2, tracer: 36.0,
                sounds: (
                    spin: "regency_edict_lance_charge", release: "regency_edict_lance_release",
                    hold: "regency_edict_lance_hold", spindown: "regency_edict_lance_vent",
                ),
            ),
            // Six Pinch-plasma Batteries, three a side, fore to aft, port first: twin forks
            // out of a ball mount seated in a pocket pressed into the chine, clear of the hull
            // below, each fork gathering plasma in the gap ahead of its blades and pinching it
            // out as one jet. Each bears from a little past the nose round its own side to a
            // little past the stern.
            (
                name: "Pinch-plasma Battery",
                damage: 1400, splash: 18, range: 2600, reload: 8, salvo: 2, salvo_delay: 0.35, speed: 900, trajectory: Direct,
                rounds: 8, round_span: 0.3,
                turret_turn: 40, arc: 220,
                muzzle: (32.4, 4.86, 0), muzzles: [(32.4, 4.86, 0), (32.4, -4.86, 0)],
                targets: ["Land", "Naval", "Structure", "Space"], color: Orange, red: 1.0,
                plasma_grade: Some(Pinched), flash: 1.8, impact: 2.6, tracer: 2.0,
                sounds: (
                    fire: "regency_halberd_fire", charge: "regency_halberd_charge", charge_time: 1.0,
                    impact: "regency_halberd_hit", ground: "regency_halberd_hit",
                ),
                mounts: [
                    (pivot: (300, 37, 64.25), facing: 90),
                    (pivot: (245, 42, 64.75), facing: 90),
                    (pivot: (190, 54.75, 63.75), facing: 90),
                    (pivot: (300, -37, 64.25), facing: -90),
                    (pivot: (245, -42, 64.75), facing: -90),
                    (pivot: (190, -54.75, 63.75), facing: -90),
                ],
            ),
            // Four Twin AA Repeaters raised on pedestals, one on each arm's corner and one each
            // side of the after deck, resting laid up at the sky they guard.
            (
                name: "Twin AA Repeater", damage: 45, splash: 3, range: 1500, reload: 0.4,
                salvo: 2, salvo_delay: 0.15, speed: 1300, trajectory: Direct,
                turret_turn: 180, arc: 300, rest_pitch: 45,
                muzzle: (15.75, 1.44, 0), muzzles: [(15.75, 1.44, 0), (15.75, -1.44, 0)],
                targets: ["Air"], color: Orange, red: 1.0,
                plasma_grade: Some(Plasmeric), flash: 1.0, impact: 1.0, tracer: 0.9,
                sounds: (fire: "regency_canopy_fire", impact: "regency_repeater_hit", ground: "regency_repeater_hit"),
                mounts: [
                    (pivot: (-263, 198, 77), facing: 90),
                    (pivot: (-262, 57.5, 102.5), facing: 90),
                    (pivot: (-263, -198, 77), facing: -90),
                    (pivot: (-262, -57.5, 102.5), facing: -90),
                ],
            ),
        ], mesh: "regency_space_destroyer", icon: Warship,
        shield: (kind: Hull, health: 64000, regen: 420), economy: (energy_upkeep: 850),
        sounds: (death: "blast_large", moving: "aster_hover"),
    ),
