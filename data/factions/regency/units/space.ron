        motion: (layer: Air, size: 0, speed: 40, accel: 4, turn: 6, altitude: 700, hover: true, hangs: true),
        warp: (per_km: 45000, spool: 7, cooldown: 110, speed: 4000, style: Nanite),
        hull_mounts: true,
        weapons: [
            // One held beam laid from the lower lens of the energy core in the drum through
            // the ship's middle (nothing turns: the beam is aimed from the lens). The core charges for 2.5 s
            // (`spin_up`) before the beam lights, and winds down when it has nothing left.
            // It fires down its line (`sweep`): locked on, it holds on the mark; when the
            // mark dies it stays lit as it slowly drags across the ground onto the next,
            // melting a line of glass between them. Drawn as the power generator's star
            // (`star_beam`): it melts the ground, it digs no crater.
            (
                name: "Heavy Pinch-fusion Lance", damage: 160, splash: 20, range: 1800, reload: 0.1,
                hitscan: true, beam: true, star_beam: true, trajectory: Direct, spin_up: 2.5,
                turret_turn: 12, muzzle: (0, 0, 15.2), sweep: 10,
