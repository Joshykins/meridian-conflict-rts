// The Regency's fighting units on land. Models: `models::regency::*`; a model authored at another
// size says so, and its tests tie these numbers to it.
[
    // The land scout: a six-legged walker on long legs, fast, with radar and a long look. A
    // mast curls up over its back to a turning radar array; a light plasmeric repeater in a
    // small turret over its neck. Model: `regency_scout` (`models::regency::scout`).
    (
        key: "regency_t1_scout",
        name: "Outrider",
        role: "Land Scout",
        tech: 1,
        categories: ["Land", "Scout", "DirectFire"],
        health: 40,
        cost: (mass: 14, energy: 90, time: 70),
        radius: 3.8, height: 4.0,
        vision: 750, radar: 3000,
        motion: (layer: Land, size: 0, speed: 42, accel: 48, turn: 220),
        weapons: [(
            name: "Light Plasmeric Repeater",
            // A scout's gun: single light slugs, enough to finish a scout or harry an engineer.
            damage: 4, range: 140, reload: 0.5, speed: 600, trajectory: Direct, red: 1.0,
            turret_turn: 240, muzzle: (1.6, 0, 2.3), spread: 1.0,
            targets: ["Land", "Naval"], color: Orange, tracer: 0.6,
            plasma_grade: Some(Plasmeric),
            sounds: (fire: "regency_stinger", impact: "shell_light"),
        )],
        mesh: "regency_scout", icon: Scout,
        sounds: (death: "blast_small", moving: "regency_skitter"),
    ),
    // The raider: fast and light, a low four-legged walker with its legs splayed wide and a
    // repeater pod either side of a keeled turret on its back. Its Twin Plasmeric Repeater walks its two mouths (`muzzles`), a
    // bolt every quarter second. Bent from the Lancer the Regency way: a quarter more damage
    // at a sixth less reach (plasma hits hard, close), a little quicker on its feet. Model:
    // `regency_raider` (`models::regency::raider`), at this size.
    (
        key: "regency_t1_raider",
        name: "Marauder",
        role: "Light Assault Walker", title: "Raider",
        tech: 1,
        categories: ["Land", "DirectFire"],
        health: 80,
        cost: (mass: 36, energy: 160, time: 150),
        radius: 2.6, height: 4.0,
        vision: 290,
        motion: (layer: Land, size: 0, speed: 42, accel: 46, turn: 240),
        weapons: [(
            name: "Twin Plasmeric Repeater",
            // 7 a bolt, four a second: 28 a second, to the Lancer's 22.5.
            damage: 7, splash: 1, range: 230, reload: 0.25, speed: 420, trajectory: Direct,
            turret_turn: 260, muzzle: (2.1, 0.95, 2.7),
            muzzles: [(2.1, 0.95, 2.7), (2.1, -0.95, 2.7)],
            spread: 1.5,
            targets: ["Land", "Naval"], color: Orange, red: 1.0,
            plasma_grade: Some(Plasmeric),
            flash: 0.6, impact: 0.6, tracer: 0.8,
            sounds: (fire: "regency_repeater_light", impact: "regency_repeater_light_hit", ground: "regency_repeater_light_hit"),
        )],
        mesh: "regency_raider", icon: Bot,
        sounds: (death: "blast_small", moving: "regency_skitter"),
    ),
    // The tank: a plated hull on gravity lift, no legs, so it crosses water as it crosses
    // land. Its turret carries a Plasmeric Repeater, the Picket's gun on a hull: a steady
    // stream of fat red bolts, each spat with a hard bloom and splashing where it lands
    // (renderer/regency_guns_fx). Bent from the Warden the Regency way: a quarter more
    // damage a second at an eighth less reach; a little less armour and a little more cost
    // for the lift that takes it over water. Model: `regency_hover_tank`
    // (`models::regency::hover_tank`), at this size.
    (
        key: "regency_t1_tank",
        name: "Sledge",
        role: "Hover Tank", title: "Light Tank",
        tech: 1,
        categories: ["Land", "DirectFire"],
        health: 270,
        cost: (mass: 60, energy: 290, time: 300),
        radius: 4.6, height: 3.4,
        vision: 320,
        motion: (layer: Hover, size: 0, speed: 32, accel: 28, turn: 115),
        weapons: [(
            name: "Plasmeric Repeater",
            // 10 a bolt, two and a half a second: 25 a second, to the Warden's 20.
            damage: 10, splash: 1, range: 265, reload: 0.4, speed: 480, trajectory: Direct,
            turret_turn: 130, muzzle: (4.6, 0, 2.5), pivot: (0.9, 0, 2.5),
            spread: 1.0,
            targets: ["Land", "Naval"], color: Orange, red: 1.0,
            plasma_grade: Some(Plasmeric),
            flash: 1.0, impact: 1.0, tracer: 1.3,
            sounds: (fire: "regency_repeater", impact: "regency_repeater_hit", ground: "regency_repeater_hit"),
        )],
        mesh: "regency_hover_tank", icon: Tank,
        lights: [(kind: Point, at: (0, 0, 0.3), color: (1.0, 0.14, 0.06), intensity: 60, range: 12, night_only: false)],
        // A stand-in: ARC's hover hum until the Regency has a lift sound of their own.
        sounds: (death: "blast", moving: "aster_hover"),
    ),
    // The mobile anti-air: a stocky six-legged walker carrying a Plasmeric Repeater, the
    // Canopy's organ made small: plasma bolts at aircraft, one out of each tube in turn,
    // each striking the plane it is fired at. Bent from the Gnat: a third more damage a
    // second on one plane, at a ninth less reach. Model: `regency_mobile_aa`
    // (`models::regency::mobile_aa`), at this size.
    (
        key: "regency_t1_mobile_aa",
        name: "Brazier",
        role: "Mobile AA Repeater", title: "Mobile AA",
        tech: 1,
        categories: ["Land", "AntiAir"],
        health: 290,
        cost: (mass: 56, energy: 550, time: 225),
        radius: 4.0, height: 4.0,
        vision: 360,
        motion: (layer: Land, size: 0, speed: 33, accel: 30, turn: 110),
        weapons: [(
            name: "Plasmeric Repeater",
            // 3 bolts of 14 every 0.7 s: 60 a second on one plane, to the Gnat's 46.
            damage: 14, splash: 1, range: 320, reload: 0.7, speed: 650, trajectory: Direct,
            salvo: 3, salvo_delay: 0.1,
            turret_turn: 240, muzzle: (2.2, 0, 3.2), pivot: (0, 0, 3.2),
            muzzles: [(2.2, -0.48, 3.2), (2.2, 0.0, 3.2), (2.2, 0.48, 3.2)],
            targets: ["Air"], color: Orange, red: 1.0,
            plasma_grade: Some(Plasmeric),
            flash: 1.0, impact: 1.0, tracer: 0.6,
            sounds: (fire: "regency_brazier_fire", impact: "regency_repeater_hit", ground: "regency_repeater_hit"),
        )],
        mesh: "regency_mobile_aa", icon: AntiAir,
        sounds: (death: "blast", moving: "regency_skitter"),
    ),
    // The light artillery: a low four-legged walker with a Plasmeric Mortar in a turning
    // house on its back. It lobs a charge of plasma held in gravity high onto its mark,
    // where it bursts and sears the ground (renderer `regency_guns_fx/plasmeric.rs`). Anchored
    // on ARC's Ballista; bent the Regency way: harder (150 to 120) and a little wider (7 to
    // 6 m) at shorter reach (400 to 440), laid higher and slower (loft 4, a slow charge a
    // missile-defence laser can burn down), the walker a touch slower and tougher. Model:
    // `regency_mattock` (`models::regency::mattock`), at this size; muzzle and trunnion are
    // its numbers.
    (
        key: "regency_t1_artillery",
        name: "Mattock",
        role: "Mobile Light Artillery", title: "Artillery",
        tech: 1,
        categories: ["Land", "Artillery"],
        health: 150,
        cost: (mass: 56, energy: 280, time: 270),
        radius: 4.2, height: 3.2,
        vision: 340,
        motion: (layer: Land, size: 0, speed: 25, accel: 24, turn: 100),
        weapons: [(
            name: "Plasmeric Mortar",
            damage: 150, splash: 7, range_min: 60, range: 400, reload: 5.0, speed: 125,
            trajectory: Ballistic, loft: 4,
            turret_turn: 70, muzzle: (1.13, 0, 3.45), pivot: (-0.3, 0, 2.45), spread: 1.4,
            // A slow lobbed charge: missile-defence lasers can burn it down.
            intercept: 150,
            targets: ["Land", "Naval"], color: Orange, red: 1.0,
            plasma_grade: Some(Plasmeric),
            flash: 1.0, impact: 1.3,
            sounds: (fire: "regency_gravitic_throw", impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
        )],
        mesh: "regency_mattock", icon: Artillery,
        sounds: (death: "blast_small", moving: "regency_crawl"),
    ),
]
