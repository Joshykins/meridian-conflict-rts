// The Regency's tech 1 air force (docs/AIR_ROSTER.md "The Regency's air force"). Their jets
// are drones in the Cybertronian-jet manner: a nose blade, down-turned fins, dark plates
// lapped back over bronze workings, red optics, red heat in the exhausts. What hovers hangs
// on gravity lift bells, red plasma crackling under them: no rotors, no jet plumes.
//
// Every weapon names its grade (`plasma_grade`): their guns and bombs are plasma. Each is
// anchored on ARC's unit of the same job and bent the Regency way. Models:
// `models::regency::air::*`, authored at the sizes here, so every muzzle, pivot and lens
// below is the model's own number.
[
    // The air scout: a dart, the fastest thing in the air, unarmed. Where ARC's Swift
    // circles over what it finds, the Flechette is through and gone: well over twice its
    // speed, a wider turn, a little thinner skin. Model: `regency_flechette`.
    (
        key: "regency_t1_air_scout",
        name: "Flechette",
        role: "Air Scout", title: "Air Scout",
        tech: 1,
        categories: ["Air", "Scout", "Intel"],
        health: 45,
        cost: (mass: 20, energy: 350, time: 120),
        radius: 3.5, height: 1.4,
        vision: 1100, radar: 3600,
        motion: (layer: Air, size: 0, speed: 270, accel: 110, turn: 95, altitude: 260),
        weapons: [],
        mesh: "regency_flechette", icon: Scout,
        // A stand-in: ARC's jet until the Regency has a drive sound of their own.
        sounds: (death: "blast_small", moving: "aster_jet"),
    ),
    // The fighter: a Twin Plasmeric Repeater in a pod either side of the nose, bolts every
    // 0.35 s at aircraft only. Anchored on the Shrike: about its damage a second (46 to 47)
    // in heavier bolts at a little less reach, a touch quicker, a touch less armour. Model:
    // `regency_quarrel`; the muzzles are its pods' lenses.
    (
        key: "regency_t1_fighter",
        name: "Quarrel",
        role: "Fighter", title: "Fighter",
        tech: 1,
        categories: ["Air", "AntiAir", "DirectFire"],
        health: 240,
        cost: (mass: 45, energy: 770, time: 360),
        radius: 3.6, height: 1.6,
        vision: 480,
        motion: (layer: Air, size: 0, speed: 125, accel: 34, turn: 74, altitude: 200),
        weapons: [(
            name: "Twin Plasmeric Repeater",
            damage: 16, range: 210, reload: 0.35, speed: 480, trajectory: Direct,
            turret_turn: 180, arc: 40, muzzle: (3.3, 0, 0.62),
            muzzles: [(3.3, -0.55, 0.62), (3.3, 0.55, 0.62)],
            targets: ["Air"], color: Orange, red: 1.0,
            plasma_grade: Some(Plasmeric),
            flash: 0.6, impact: 0.6, tracer: 0.8,
            sounds: (fire: "regency_repeater_light", impact: "regency_repeater_light_hit"),
        )],
        mesh: "regency_quarrel", icon: Fighter,
        sounds: (death: "blast_small", moving: "aster_jet"),
    ),
    // The bomber: a blade of a wing that lays a short stick of three Plasmeric Bombs along
    // its run, each a charge of plasma held in gravity until it lands. Anchored on the
    // Petrel's pair (260 a pass): 270 a pass in three lighter bombs strung out along the
    // ground, so a column under it takes more of them. Model: `regency_petard`; the bombs
    // leave its bay.
    (
        key: "regency_t1_bomber",
        name: "Petard",
        role: "Light Bomber", title: "Bomber",
        tech: 1,
        categories: ["Air"],
        health: 250,
        cost: (mass: 60, energy: 980, time: 420),
        radius: 5.6, height: 2.2,
        vision: 520,
        motion: (layer: Air, size: 0, speed: 86, accel: 22, turn: 44, altitude: 200),
        weapons: [(
            name: "Plasmeric Bomb",
            damage: 90, splash: 18, range: 320, reload: 5.0, salvo: 3, salvo_delay: 0.2,
            speed: 90, trajectory: Ballistic, loft: 0.4,
            muzzle: (0.4, 0, 0.5),
            spread: 6,
            targets: ["Land", "Naval", "Structure"], color: Orange, red: 1.0,
            plasma_grade: Some(Plasmeric),
            flash: 0.0, impact: 1.4, tracer: 0.6,
            sounds: (fire: "bomb_release", impact: "regency_gravitic_hit", ground: "regency_gravitic_hit"),
        )],
        mesh: "regency_petard", icon: Bomber,
        sounds: (death: "blast_small", moving: "aster_jet"),
    ),
    // Coffer: the fleet's unarmed commander lift, built on site. Its protected chamber
    // has 26 m of clear width and 28 m of clear height, with the ramp at the stern.
    (
        key: "regency_t2_transport",
        name: "Coffer",
        role: "Light Transport", title: "Transport",
        tech: 2, categories: ["Air", "Space"],
        health: 1400, cost: (mass: 280, energy: 4200, time: 1400),
        radius: 44, height: 36, footprint: (8, 7), hull: (44, 40), vision: 500,
        motion: (layer: Air, size: 0, speed: 165, accel: 42, turn: 70, altitude: 320, hover: true, deploy: 0.6),
        transport: (capacity: 8, descent: 120, hold: (-2, 0), ramp: (-28, -40), width: 26, floor: 1, clearance: 28, unload: 0.25),
        weapons: [], mesh: "regency_coffer", icon: Transport,
        sounds: (death: "blast", moving: "aster_hover"),
    ),
]
