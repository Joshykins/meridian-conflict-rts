                Tone(at: 0.55, from: 85, to: 26, glide: 0.6, attack: 0.002, decay: 0.8, gain: 0.9),
                Drive(1.8),
                // Electrical crackle over the strain.
                Roll(at: 0.05, from: 2200, to: 900, glide: 2.0, attack: 0.1, decay: 1.0, gain: 0.3, swell: 60, depth: 1.0, pan: -0.1, seed: 568),
                Roll(at: 0.55, from: 600, to: 160, glide: 1.2, attack: 0.02, decay: 0.8, gain: 0.4, swell: 3, depth: 0.7, seed: 569),
            ],
        ),
        // A dampener raised under a jump already in warp catches it: a heavy metallic
        // lurch at the exit point, a groan warbling under the strain, crackle.
        "warp_snag": (
            length: 4, peak: 0.8, room: 0.35,
            layers: [
