// Warp drives and warp dampeners (mc-sim `warp.rs`), played by `audio/warp.rs`: a
// capital ship charging its drive, tearing out of the world, the rift where it will come
// out, and the thunderclap as it does; the same jump snagged by an enemy Undertow
// (`aster_t2_warp_damper`), dragged, torn and thrown out stunned; the stunned hull
// arcing and its systems coming back; the dampener's field humming and surging.
//
// A ship may name its own `<moving>_<name>` (e.g. `aster_courier_warp_jump`); these are
// the defaults. The game plays them lower and louder for a bigger hull (by its radius,
// never its tier), so one recipe serves the Courier, the Bastion and the Resolute.
//
// The clean jump is power held in and let go: a rough electrical growl gathering, a
// tear and a snap, a deep thump. No whooshes: no noise swept up or down for a streak or
// for air rushing in (the user found them swooshy); a jump is a blow, not a gust. The dampened one is the same gestures
// fighting something: detuned growls beating against each other, warbling, stuttering,
// metal groaning under strain, and it lasts longer. Nothing here is a clean whine or a
// struck harmonic left to ring (both read as toys or plucked strings), and the body sits
// in 150 Hz to 3 kHz so it carries on small speakers and over a battle.
(
    sounds: {
        // ---- the drive charging --------------------------------------------------------
        // The drive engaging as the spool starts: two contactors slamming home, a deep
        // thunk, and a rough growl drawing power in, crackling. It fades into the charge
        // loops, which carry the rest.
        "warp_spool": (
            length: 3.6, peak: 0.7, room: 0.3,
            layers: [
                // The contactors, the second a beat after the first.
                Burst(low: 250, high: 2200, attack: 0.0005, decay: 0.012, gain: 2.4, seed: 501),
                Tone(from: 115, to: 46, glide: 0.12, attack: 0.001, decay: 0.22, gain: 0.7),
                Burst(at: 0.17, low: 220, high: 2000, attack: 0.0005, decay: 0.014, gain: 2.8, seed: 502),
                Tone(at: 0.17, from: 125, to: 50, glide: 0.12, attack: 0.001, decay: 0.25, gain: 0.8),
                // The drive taking load: a transformer growl and its buzz swelling up.
                Fm(at: 0.18, from: 48, to: 70, glide: 1.4, ratio: 0.5, index: 2.4, fade: 8.0, attack: 0.9, decay: 0.8, gain: 0.55),
                Fm(at: 0.2, from: 96, to: 140, glide: 1.4, ratio: 0.5, index: 2.2, fade: 8.0, attack: 0.9, decay: 0.7, gain: 0.45, pan: 0.1),
                Drive(1.5),
                // Crackle as it takes the load.
                Roll(at: 0.3, from: 1800, to: 2600, glide: 1.2, attack: 0.8, decay: 0.5, gain: 0.18, swell: 95, depth: 1.0, pan: -0.15, seed: 504),
            ],
        ),
        // The drive charging: a steady loop the game raises in pitch (by about an octave)
        // and level as the charge climbs, so it keeps rising however slowly the grid
        // feeds it. A rough transformer growl and the drive's buzz over it, the air around
        // the hull fizzing, a slow throb in the body.
        "warp_charge": (
            length: 4, peak: 0.6, room: 0, looped: true,
            layers: [
                Fm(from: 55, to: 55, glide: 1, ratio: 0.5, index: 2.4, fade: 1000, attack: 0.01, decay: 100000, gain: 0.5),
                Fm(from: 110, to: 110, glide: 1, ratio: 0.5, index: 2.0, fade: 1000, attack: 0.01, decay: 100000, gain: 0.42, pan: -0.15),
                Fm(from: 166, to: 166, glide: 1, ratio: 0.5, index: 1.5, fade: 1000, attack: 0.01, decay: 100000, gain: 0.24, pan: 0.15),
                Drone(freq: 220, gain: 0.12, wobble: 0.75, depth: 0.6),
                Drive(1.5),
                // The fizz of the air, and a thin ionising hiss over it.
                Rumble(freq: 480, q: 1.2, gain: 7.0, wobble: 1.5, depth: 0.5, pan: 0.1),
                Rumble(freq: 1900, q: 1.4, gain: 2.2, wobble: 2.75, depth: 0.6, pan: -0.1),
            ],
        ),
        // Arcs crawling over the drive as the charge nears full: sizzle and cracking
        // sparks, each with a short rough buzz. The game brings it in over the second
        // half of the charge, so the charge thickens as well as climbing.
        "warp_charge_arcs": (
            length: 3.3, peak: 0.7, room: 0.15, looped: true,
            layers: [
                Roll(from: 2600, to: 2600, glide: 1, attack: 0.01, decay: 100000, gain: 0.6, swell: 100, depth: 1.0, seed: 511),
                Hiss(freq: 3200, q: 0.8, attack: 0.01, decay: 100000, gain: 0.05, seed: 512),
                Burst(at: 0.13, low: 500, high: 3500, attack: 0.0005, decay: 0.012, gain: 2.0, pan: -0.4, seed: 513),
                Fm(at: 0.13, from: 120, to: 105, glide: 0.08, ratio: 0.5, index: 3.0, fade: 100, attack: 0.004, decay: 0.07, gain: 0.35, pan: -0.4),
                Burst(at: 0.47, low: 500, high: 3500, attack: 0.0005, decay: 0.01, gain: 1.4, pan: 0.3, seed: 514),
                Burst(at: 0.55, low: 500, high: 3500, attack: 0.0005, decay: 0.015, gain: 2.3, pan: 0.35, seed: 515),
                Fm(at: 0.55, from: 140, to: 118, glide: 0.1, ratio: 0.5, index: 3.0, fade: 100, attack: 0.004, decay: 0.09, gain: 0.4, pan: 0.35),
                Burst(at: 1.02, low: 500, high: 3500, attack: 0.0005, decay: 0.012, gain: 1.7, pan: 0.1, seed: 516),
                Burst(at: 1.41, low: 500, high: 3500, attack: 0.0005, decay: 0.018, gain: 2.5, pan: -0.2, seed: 517),
                Fm(at: 1.41, from: 112, to: 98, glide: 0.1, ratio: 0.5, index: 3.2, fade: 100, attack: 0.004, decay: 0.12, gain: 0.45, pan: -0.2),
                Burst(at: 1.49, low: 500, high: 3500, attack: 0.0005, decay: 0.01, gain: 1.3, pan: -0.25, seed: 518),
                Burst(at: 1.93, low: 500, high: 3500, attack: 0.0005, decay: 0.012, gain: 1.9, pan: 0.45, seed: 519),
                Burst(at: 2.34, low: 500, high: 3500, attack: 0.0005, decay: 0.016, gain: 2.4, pan: 0.0, seed: 520),
                Fm(at: 2.34, from: 130, to: 110, glide: 0.1, ratio: 0.5, index: 3.0, fade: 100, attack: 0.004, decay: 0.1, gain: 0.4),
                Burst(at: 2.69, low: 500, high: 3500, attack: 0.0005, decay: 0.01, gain: 1.5, pan: -0.45, seed: 521),
                Burst(at: 2.75, low: 500, high: 3500, attack: 0.0005, decay: 0.014, gain: 2.1, pan: -0.4, seed: 522),
                Burst(at: 3.08, low: 500, high: 3500, attack: 0.0005, decay: 0.012, gain: 1.8, pan: 0.2, seed: 523),
            ],
        ),

        // ---- the jump --------------------------------------------------------------------
        // Into warp: the drive lets go all at once. A hard snap and a metal tear, the hole
        // it leaves slamming shut (a deep thump a moment later), and a short electrical
        // crackle dying away.
        "warp_jump": (
            length: 4.5, peak: 0.9, room: 0.3,
            layers: [
                Burst(low: 150, high: 4500, attack: 0.0005, decay: 0.02, gain: 3.2, seed: 531),
                Fm(from: 220, to: 900, glide: 0.2, ratio: 1.41, index: 2.4, fade: 0.12, attack: 0.004, decay: 0.16, gain: 0.35),
                Fm(at: 0.005, from: 150, to: 60, glide: 0.5, ratio: 0.5, index: 2.6, fade: 0.6, attack: 0.004, decay: 0.35, gain: 0.6),
                // The hole shutting behind it.
                Burst(at: 0.26, low: 60, high: 900, attack: 0.001, decay: 0.05, gain: 3.5, seed: 532),
                Tone(at: 0.26, from: 95, to: 30, glide: 0.45, attack: 0.002, decay: 0.6, gain: 1.0),
                Fm(at: 0.27, from: 120, to: 48, glide: 0.6, ratio: 0.5, index: 2.0, fade: 0.5, attack: 0.003, decay: 0.45, gain: 0.45),
                Drive(1.6),
                // What charge is left crackling off the place it was.
                Roll(at: 0.02, from: 2400, to: 2000, glide: 0.6, attack: 0.005, decay: 0.35, gain: 0.35, swell: 90, depth: 1.0, seed: 536),
            ],
        ),
        // The rift at the exit point while the ship is in warp: a deep pressure hum with a
        // slow throb. The game raises it in pitch and level toward the moment the
