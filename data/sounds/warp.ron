                // The drive sputtering.
                Chirp(at: 0.1, from: 230, to: 150, glide: 2.0, attack: 0.05, decay: 0.9, gain: 0.3, pulse: 9, ratio: 0.5, index: 2.4, pan: 0.1),
                // The hole shutting, late and heavy.
