        "warp_rift": (
            length: 3, peak: 0.55, room: 0, looped: true,
            layers: [
                Fm(from: 41, to: 41, glide: 1, ratio: 0.5, index: 1.4, fade: 1000, attack: 0.01, decay: 100000, gain: 0.4),
                Drone(freq: 82, gain: 0.3, wobble: 1.33, depth: 0.7),
                Drone(freq: 164, gain: 0.22, wobble: 0.67, depth: 0.5, pan: 0.15),
                Drive(1.3),
                Rumble(freq: 140, q: 0.9, gain: 10.0, wobble: 0.33, depth: 0.4),
            ],
        ),
        // Out of warp: a thunderclap where the ship bursts back into the world. A crack
        // and its slap, a deep boom with body in the mids, a short low roll, and the drive
        // winding down under it.
        "warp_arrive": (
            length: 5.5, peak: 0.9, room: 0.35,
            layers: [
                Burst(low: 80, high: 5000, attack: 0.0004, decay: 0.025, gain: 3.5, seed: 551),
                Burst(at: 0.012, low: 60, high: 1200, attack: 0.001, decay: 0.07, gain: 4.0, seed: 552),
                Tone(from: 72, to: 26, glide: 0.6, attack: 0.002, decay: 0.9, gain: 0.9),
                Fm(from: 130, to: 48, glide: 0.5, ratio: 0.5, index: 2.2, fade: 0.4, attack: 0.003, decay: 0.5, gain: 0.55),
                // The drive winding down.
                Fm(at: 0.5, from: 84, to: 40, glide: 2.4, ratio: 0.5, index: 1.6, fade: 3.0, attack: 0.3, decay: 1.1, gain: 0.3),
                Drive(1.7),
                // Thunder rolling away.
                Roll(at: 0.02, from: 700, to: 160, glide: 1.2, attack: 0.01, decay: 0.8, gain: 0.45, swell: 5, depth: 0.7, seed: 553),
            ],
        ),

        // ---- the dampened jump -------------------------------------------------------------
        // Into warp with an enemy dampener's field over the mark: the same tear and snap,
        // but caught. The tear stutters, the drive's growl beats against a detuned copy of
        // itself, metal grinds and groans under the strain, the drive sputters, and the
        // hole closes late.
        "warp_jump_damped": (
            length: 6, peak: 0.9, room: 0.35,
            layers: [
                // The tear catching and tearing again.
                Burst(low: 120, high: 3500, attack: 0.0005, decay: 0.02, gain: 3.0, seed: 561),
