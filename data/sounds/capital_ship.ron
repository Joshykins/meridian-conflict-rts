// Capital ships' drives, landing and take-off: the defaults `audio/capital.rs` falls
// back to (a ship may name its own `<moving>_<part>`). Tuned on the Bastion, whose
// reactor hum is its own `aster_lift_ship`; these sit on it.
//
// A ship this size is heard as weight: deep FM growls and slowly beating low notes
// (25 to 90 Hz), with a 120 to 300 Hz body so it still reads on small speakers, and
// almost no noise above that (the user found the first pass "airy"). The loops are
// steady on purpose: the game glides their pitch and level with the throttle and the
// height, which is where they move. Sustained FM here is an Fm layer with a decay and
// fade far longer than the sound.
(
    sounds: {
        // Stern engines under way: a growl at 33 Hz beating slowly against a 33.5 Hz
        // drone, its harmonics as the body, and low turbulence swelling underneath.
        "capital_thrust": (
            length: 6, peak: 0.36, room: 0, looped: true,
            layers: [
                Fm(from: 33, to: 33, glide: 1, ratio: 0.5, index: 1.6, fade: 1000, attack: 0.01, decay: 100000, gain: 0.45),
                Drone(freq: 33.5, gain: 0.3, wobble: 0.1667, depth: 0.2),
                Drone(freq: 66, gain: 0.2, wobble: 0.5, depth: 0.2, pan: -0.15),
                Drone(freq: 99, gain: 0.1, wobble: 0.3333, depth: 0.25, pan: 0.15),
                Drone(freq: 132, gain: 0.14, wobble: 0.6667, depth: 0.3),
                Drone(freq: 165, gain: 0.08, wobble: 0.5, depth: 0.35, pan: -0.2),
                Drone(freq: 198, gain: 0.05, wobble: 0.8333, depth: 0.35, pan: 0.2),
                Drive(1.4),
                Rumble(freq: 60, q: 0.8, gain: 12.0, wobble: 0.5, depth: 0.4, pan: -0.1),
                Rumble(freq: 150, q: 1.0, gain: 14.0, wobble: 1.5, depth: 0.35, pan: 0.1),
                Rumble(freq: 250, q: 1.1, gain: 4.0, wobble: 2.5, depth: 0.4),
            ],
        ),
        // The four belly jets blasting down: a deeper growl (27 Hz) chugging against
        // 41 Hz about twice a second as the wash rolls out, low roar under it.
        "capital_lift_jets": (
            length: 4, peak: 0.37, room: 0, looped: true,
            layers: [
                Fm(from: 27, to: 27, glide: 1, ratio: 0.5, index: 1.8, fade: 1000, attack: 0.01, decay: 100000, gain: 0.45),
                Drone(freq: 41, gain: 0.3, wobble: 0.25, depth: 0.25, pan: 0.2),
                Drone(freq: 81, gain: 0.12, wobble: 0.5, depth: 0.3, pan: -0.2),
                Drone(freq: 122, gain: 0.14, wobble: 0.75, depth: 0.3),
                Drone(freq: 162, gain: 0.08, wobble: 0.5, depth: 0.35, pan: 0.2),
                Drive(1.3),
                Rumble(freq: 45, q: 0.8, gain: 14.0, wobble: 0.75, depth: 0.35),
                Rumble(freq: 120, q: 0.9, gain: 14.0, wobble: 2.25, depth: 0.4, pan: -0.2),
                Rumble(freq: 240, q: 1.0, gain: 6.0, wobble: 3.5, depth: 0.45, pan: 0.2),
            ],
        ),
        // Drives spooling up for take-off: a deep growl climbing out of the ground, its
        // body rising with it, a low turbine note coming up underneath, the roar gathering.
        "capital_spool": (
            length: 7.5, peak: 0.42, room: 0.2,
            layers: [
                Burst(low: 30, high: 220, attack: 0.002, decay: 0.08, gain: 4.0),
                Tone(from: 38, to: 22, glide: 0.4, attack: 0.003, decay: 0.6, gain: 0.6),
                Fm(at: 0.1, from: 22, to: 46, glide: 4.0, ratio: 0.5, index: 1.8, fade: 4.0, attack: 3.0, decay: 1.3, gain: 0.55),
                Fm(at: 0.3, from: 44, to: 92, glide: 4.0, ratio: 1.0, index: 1.5, fade: 3.0, attack: 3.0, decay: 1.2, gain: 0.38),
                Tone(at: 0.4, from: 90, to: 210, glide: 4.0, attack: 3.2, decay: 1.0, gain: 0.15),
                Drive(1.3),
                Sweep(at: 0.4, from: 60, to: 240, glide: 3.8, q: 0.9, attack: 3.2, decay: 1.1, gain: 3.5),
            ],
        ),
        // Lift-off: the ground let go of. A deep push, the drives' growl lifting with
        // the ship, the wash rolling away low.
        "capital_liftoff": (
            length: 6, peak: 0.45, room: 0.3,
            layers: [
                Burst(low: 28, high: 200, attack: 0.006, decay: 0.16, gain: 5.0),
                Tone(from: 44, to: 21, glide: 0.8, attack: 0.006, decay: 1.1, gain: 0.8),
                Fm(at: 0.05, from: 28, to: 44, glide: 3.2, ratio: 0.5, index: 1.6, fade: 3.0, attack: 0.4, decay: 1.6, gain: 0.5),
                Fm(at: 0.2, from: 60, to: 88, glide: 3.0, ratio: 1.0, index: 1.4, fade: 2.0, attack: 0.5, decay: 1.3, gain: 0.35),
                Drive(1.35),
                Sweep(at: 0.02, from: 380, to: 55, glide: 2.6, q: 0.8, attack: 0.1, decay: 1.4, gain: 6.0),
                Sweep(at: 0.4, from: 240, to: 45, glide: 3.0, q: 0.9, attack: 0.4, decay: 1.5, gain: 4.5, pan: -0.25),
            ],
        ),
        // Touchdown: the hull's weight on its legs (a deep thud, the frame groaning
        // low as it settles), a short hydraulic breath, a lock going home, and the
        // drives winding down into the ground.
        "capital_touchdown": (
            length: 5.5, peak: 0.45, room: 0.3,
            layers: [
                Burst(low: 25, high: 220, attack: 0.003, decay: 0.12, gain: 6.0),
                Tone(from: 40, to: 19, glide: 0.6, attack: 0.003, decay: 0.9, gain: 0.9),
                Fm(at: 0.06, from: 62, to: 40, glide: 1.4, ratio: 1.41, index: 1.6, fade: 1.0, attack: 0.1, decay: 0.9, gain: 0.42),
                Fm(at: 0.2, from: 70, to: 24, glide: 3.5, ratio: 0.5, index: 1.4, fade: 2.5, attack: 0.05, decay: 1.6, gain: 0.4),
                Drive(1.3),
                Hiss(at: 0.35, freq: 1100, q: 1.2, attack: 0.05, decay: 0.5, gain: 0.08),
                Burst(at: 1.2, low: 90, high: 600, attack: 0.0008, decay: 0.02, gain: 3.5),
                Tone(at: 1.2, from: 110, to: 60, glide: 0.08, attack: 0.001, decay: 0.12, gain: 0.3),
                Sweep(at: 0.1, from: 300, to: 50, glide: 3.0, q: 0.8, attack: 0.15, decay: 1.4, gain: 4.5),
            ],
        ),
        // The ramp opening: the latches letting go, a heavy geared motor taking the
        // weight (its teeth ticking over), the slab swinging down, the lip meeting the ground.
        "capital_ramp_open": (
            length: 5.5, peak: 0.36, room: 0.28,
            layers: [
                Burst(low: 60, high: 500, attack: 0.0008, decay: 0.02, gain: 5.0),
                Burst(at: 0.12, low: 60, high: 500, attack: 0.0008, decay: 0.018, gain: 4.0),
                Fm(at: 0.2, from: 55, to: 82, glide: 1.6, ratio: 2.0, index: 1.8, fade: 3.0, attack: 0.35, decay: 1.4, gain: 0.45),
                Fm(at: 0.25, from: 40, to: 34, glide: 3.0, ratio: 1.41, index: 1.2, fade: 1.5, attack: 0.5, decay: 1.3, gain: 0.26),
                Burst(at: 0.45, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 40),
                Burst(at: 0.75, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 41),
                Burst(at: 1.05, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 42),
                Burst(at: 1.35, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 43),
                Burst(at: 1.65, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 44),
                Burst(at: 1.95, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 45),
                Burst(at: 2.25, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 46),
                Burst(at: 2.55, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 47),
                Burst(at: 2.85, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 48),
                Burst(at: 3.15, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 49),
                Burst(at: 3.3, low: 25, high: 240, attack: 0.002, decay: 0.08, gain: 6.0),
                Tone(at: 3.3, from: 46, to: 22, glide: 0.4, attack: 0.003, decay: 0.55, gain: 0.8),
                Drive(1.25),
            ],
        ),
        // The ramp closing: the geared motor hauling the slab up, labouring and slowing
        // as it comes home, and the locks driving shut.
        "capital_ramp_close": (
            length: 5.5, peak: 0.36, room: 0.28,
            layers: [
                Tone(from: 44, to: 28, glide: 0.2, attack: 0.003, decay: 0.3, gain: 0.45),
                Fm(at: 0.05, from: 86, to: 58, glide: 3.0, ratio: 2.0, index: 1.8, fade: 3.0, attack: 0.3, decay: 1.4, gain: 0.45),
                Fm(at: 0.1, from: 34, to: 40, glide: 2.8, ratio: 1.41, index: 1.2, fade: 1.5, attack: 0.5, decay: 1.3, gain: 0.24),
                Burst(at: 0.30, low: 70, high: 380, attack: 0.001, decay: 0.012, gain: 4.5, seed: 60),
