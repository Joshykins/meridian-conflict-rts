                Sweep(at: 0.4, from: 700, to: 2800, glide: 2.55, q: 1.3, attack: 2.55, decay: 0.08, gain: 0.3, seed: 370),
                Roll(at: 0.6, from: 1100, to: 3000, glide: 2.4, attack: 2.4, decay: 0.1, gain: 0.26, swell: 22, depth: 0.9, pan: -0.3, seed: 331),
