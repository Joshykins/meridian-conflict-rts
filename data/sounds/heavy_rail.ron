                Roll(at: 0.1, from: 160, to: 60, glide: 3.5, attack: 0.2, decay: 1.6, gain: 0.6, swell: 0.9, depth: 0.55, pan: 0.2, seed: 324),
                Burst(at: 0.9, low: 60, high: 420, attack: 0.002, decay: 0.05, gain: 3.2, pan: 0.45),
                Burst(at: 1.4, low: 55, high: 380, attack: 0.002, decay: 0.06, gain: 2.4, pan: -0.4),
                Burst(at: 2.1, low: 50, high: 340, attack: 0.003, decay: 0.06, gain: 1.4, pan: 0.15),
            ],
        ),

        // ---- the Zenith ----------------------------------------------------------
        // Stepped: three banks switched in one after another, each step lifting the
        // transformer's growl and the ground under it, the arcs gathering to the top.
        "zenith_rail_charge": (
            length: 3.3, peak: 0.52, room: 0.35,
            layers: [
                // Three contactor banks closing, heavier each time.
                Burst(low: 60, high: 650, attack: 0.0006, decay: 0.03, gain: 4.5),
                Tone(from: 64, to: 36, glide: 0.1, attack: 0.002, decay: 0.2, gain: 0.45),
                Burst(at: 0.78, low: 55, high: 600, attack: 0.0006, decay: 0.035, gain: 5.5, seed: 11),
                Tone(at: 0.78, from: 60, to: 34, glide: 0.1, attack: 0.002, decay: 0.25, gain: 0.55),
                Burst(at: 1.52, low: 50, high: 560, attack: 0.0006, decay: 0.04, gain: 6.5, seed: 12),
                Tone(at: 1.52, from: 56, to: 32, glide: 0.1, attack: 0.002, decay: 0.3, gain: 0.65),
                // The growl, one stage per bank, each higher and climbing to the shot.
                Fm(at: 0.03, from: 26, to: 34, glide: 0.8, ratio: 0.5, index: 2.4, fade: 4.0, attack: 0.7, decay: 0.3, gain: 0.32),
                Fm(at: 0.8, from: 33, to: 44, glide: 0.8, ratio: 0.5, index: 2.4, fade: 4.0, attack: 0.7, decay: 0.3, gain: 0.48),
                Fm(at: 1.54, from: 42, to: 62, glide: 0.96, ratio: 0.5, index: 2.4, fade: 4.0, attack: 0.96, decay: 0.12, gain: 0.9),
                Fm(at: 1.54, from: 84, to: 128, glide: 0.96, ratio: 2.0, index: 1.2, fade: 3.0, attack: 0.96, decay: 0.1, gain: 0.4),
                // The whine, lower than the ship's and only in the last stage.
                Tone(at: 1.0, from: 300, to: 720, glide: 1.5, attack: 1.5, decay: 0.08, gain: 0.06, pan: -0.1),
                Tone(at: 1.0, from: 302, to: 726, glide: 1.5, attack: 1.5, decay: 0.08, gain: 0.045, pan: 0.1),
                // The ground humming with it.
                Roll(at: 0.2, from: 70, to: 110, glide: 2.3, attack: 2.3, decay: 0.12, gain: 0.5, swell: 3, depth: 0.5, seed: 325),
                Drive(1.35),
                // Arcs jumping off the rails.
                Roll(at: 1.5, from: 700, to: 1800, glide: 1.0, attack: 1.0, decay: 0.1, gain: 0.2, swell: 16, depth: 0.85, pan: 0.25, seed: 333),
                Burst(at: 0.95, low: 260, high: 1600, attack: 0.0005, decay: 0.014, gain: 1.5, pan: -0.3),
                Burst(at: 1.7, low: 260, high: 1700, attack: 0.0005, decay: 0.016, gain: 2.4, pan: 0.4),
                Burst(at: 2.05, low: 240, high: 1800, attack: 0.0005, decay: 0.02, gain: 3.2, pan: -0.45),
                Burst(at: 2.21, low: 220, high: 1800, attack: 0.0005, decay: 0.02, gain: 2.2, pan: 0.2),
                Burst(at: 2.4, low: 200, high: 1900, attack: 0.0005, decay: 0.03, gain: 3.6, pan: -0.1),
            ],
        ),
        // Heard from beside it: the ground heaving, a blast that punches the chest, the
        // slug tearing up and away, and the thunder coming back down off the cloud.
        "zenith_rail_fire": (
            length: 9.0, peak: 0.9, room: 0.9,
            layers: [
                // The N-wave, lower and duller than the ship's: the gun is at your side.
                Burst(low: 900, high: 4200, attack: 0.0001, decay: 0.004, gain: 7),
                Burst(low: 300, high: 1800, attack: 0.0002, decay: 0.016, gain: 28),
                Burst(at: 0.014, low: 220, high: 1500, attack: 0.0002, decay: 0.018, gain: 18),
                // The rails dumping.
                Fm(from: 84, to: 34, glide: 0.1, ratio: 0.5, index: 3.6, fade: 0.05, attack: 0.0005, decay: 0.2, gain: 1.1),
                Fm(at: 0.002, from: 132, to: 100, glide: 0.12, ratio: 1.41, index: 1.8, fade: 0.05, attack: 0.001, decay: 0.14, gain: 0.35),
                // The blast into the ground: a slam and a heave that takes a second to let go.
                Burst(at: 0.002, low: 70, high: 600, attack: 0.0008, decay: 0.1, gain: 30),
                Burst(at: 0.004, low: 26, high: 180, attack: 0.004, decay: 0.6, gain: 20),
                Tone(from: 150, to: 40, glide: 0.1, attack: 0.001, decay: 0.18, gain: 1.4),
                Tone(from: 66, to: 24, glide: 0.4, attack: 0.002, decay: 0.7, gain: 2.0),
                Tone(from: 38, to: 21, glide: 1.2, attack: 0.008, decay: 1.4, gain: 1.3),
                Roll(at: 0.003, from: 240, to: 80, glide: 1.2, attack: 0.01, decay: 0.8, gain: 2.0, swell: 3.0, depth: 0.45, seed: 311),
                Drive(2.1),
                // The slug going up and away.
                Sweep(at: 0.006, from: 1800, to: 260, glide: 0.8, q: 0.8, attack: 0.004, decay: 0.4, gain: 0.45),
                // The ground shaking, and grit coming down off the gun.
                Roll(at: 0.01, from: 120, to: 45, glide: 4.0, attack: 0.05, decay: 2.2, gain: 1.3, swell: 1.4, depth: 0.45, seed: 312),
                Roll(at: 0.25, from: 1000, to: 450, glide: 1.8, attack: 0.3, decay: 0.8, gain: 0.18, swell: 10, depth: 0.85, pan: -0.25, seed: 326),
                // The report up into the sky, and its thunder coming back down off the
