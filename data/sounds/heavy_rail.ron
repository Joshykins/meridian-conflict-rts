        // The slug through a warship's hull, heard from far below: a deep steel slam,
        // the frame tearing, and wreckage raining off it.
        "zenith_rail_impact": (
            length: 6.0, peak: 0.88, room: 0.8,
            layers: [
                Burst(low: 250, high: 1800, attack: 0.0003, decay: 0.012, gain: 10),
                Burst(at: 0.001, low: 55, high: 420, attack: 0.001, decay: 0.14, gain: 26),
