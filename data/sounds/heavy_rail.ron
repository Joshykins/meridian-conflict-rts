                Burst(at: 2.853, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.59, pan: 0.2, seed: 420),
                Burst(at: 2.898, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.65, pan: -0.1, seed: 421),
