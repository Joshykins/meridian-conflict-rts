                Burst(at: 2.62, low: 350, high: 2600, attack: 0.0004, decay: 0.02, gain: 1.26, pan: -0.2, seed: 345),
                Roll(at: 2.62, from: 2400, to: 500, glide: 0.14, attack: 0.001, decay: 0.112, gain: 0.3, swell: 90, depth: 1.0, seed: 435),
                Roll(at: 2.63, from: 700, to: 90, glide: 0.5, attack: 0.012, decay: 0.66, gain: 0.54, swell: 11, depth: 0.8, pan: -0.2, seed: 395),
                Burst(at: 2.8, low: 280, high: 2200, attack: 0.0005, decay: 0.012, gain: 2.25, seed: 386),
                Burst(at: 2.82, low: 350, high: 2600, attack: 0.0004, decay: 0.02, gain: 1.38, pan: 0.45, seed: 346),
                Roll(at: 2.82, from: 2400, to: 500, glide: 0.15, attack: 0.001, decay: 0.120, gain: 0.3, swell: 90, depth: 1.0, seed: 436),
