                Fm(at: 0.006, from: 105, to: 82, glide: 0.2, ratio: 1.41, index: 2.0, fade: 0.05, attack: 0.001, decay: 0.16, gain: 0.45),
                Drive(1.8),
                // The blast going out, and the debris thrown up.
                Sweep(at: 0.005, from: 700, to: 90, glide: 1.0, q: 0.6, attack: 0.01, decay: 0.6, gain: 0.9),
                Roll(at: 0.08, from: 1400, to: 500, glide: 1.6, attack: 0.05, decay: 0.9, gain: 0.35, swell: 9, depth: 0.6, pan: 0.2, seed: 321),
                Roll(at: 0.1, from: 200, to: 70, glide: 3.0, attack: 0.15, decay: 1.5, gain: 0.6, swell: 1.2, depth: 0.55, pan: -0.2, seed: 322),
                // Pieces landing: heavy, low, scattered, fewer and further.
                Burst(at: 0.72, low: 70, high: 520, attack: 0.001, decay: 0.05, gain: 4.5, pan: -0.4),
                Burst(at: 1.05, low: 90, high: 650, attack: 0.001, decay: 0.035, gain: 3.2, pan: 0.5),
                Burst(at: 1.31, low: 60, high: 420, attack: 0.002, decay: 0.07, gain: 3.6, pan: 0.1),
                Burst(at: 1.84, low: 80, high: 560, attack: 0.001, decay: 0.04, gain: 2.0, pan: -0.55),
                Burst(at: 2.5, low: 70, high: 480, attack: 0.002, decay: 0.05, gain: 1.3, pan: 0.35),
                Tone(at: 1.31, from: 60, to: 34, glide: 0.2, attack: 0.004, decay: 0.3, gain: 0.3, pan: 0.1),
            ],
