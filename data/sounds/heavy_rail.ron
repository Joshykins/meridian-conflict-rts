                Fm(at: 0.01, from: 52, to: 40, glide: 0.4, ratio: 0.5, index: 1.6, fade: 0.1, attack: 0.002, decay: 0.4, gain: 0.5),
                Drive(1.5),
                // Plate tearing open along the hole, falling in pitch.
                Sweep(at: 0.03, from: 1400, to: 300, glide: 0.7, q: 2.0, attack: 0.02, decay: 0.35, gain: 0.35, pan: 0.2),
                Sweep(at: 0.01, from: 520, to: 70, glide: 1.2, q: 0.55, attack: 0.02, decay: 0.8, gain: 0.8),
                Roll(at: 0.1, from: 180, to: 60, glide: 3.0, attack: 0.2, decay: 1.6, gain: 0.55, swell: 1.2, depth: 0.55, pan: -0.2, seed: 327),
                // Wreckage falling off it: a scatter of dull metal knocks.
                Burst(at: 0.8, low: 90, high: 700, attack: 0.001, decay: 0.03, gain: 3.2, pan: 0.4),
                Burst(at: 1.25, low: 80, high: 600, attack: 0.001, decay: 0.035, gain: 2.4, pan: -0.45),
                Burst(at: 1.9, low: 70, high: 520, attack: 0.002, decay: 0.045, gain: 1.6, pan: 0.2),
            ],
        ),

        // ---- the Resolute's drives ------------------------------------------------
        // A warship's reactor, heavier and darker than the Bastion's: a growl at 27.5 Hz
        // beating slowly against its neighbour, the fifth over it, and a minor second
        // high in the body that beats and never settles. It breathes slowly. The body
        // (110 to 220 Hz) is there for small speakers.
        "aster_frigate": (
            length: 12, peak: 0.46, room: 0, looped: true,
            layers: [
                Fm(from: 27.5, to: 27.5, glide: 1, ratio: 0.5, index: 1.4, fade: 1000, attack: 0.01, decay: 100000, gain: 0.5),
                Drone(freq: 27.5833, gain: 0.3, wobble: 0.08333, depth: 0.12, pan: 0.15),
                Drone(freq: 41.25, gain: 0.26, wobble: 0.1667, depth: 0.15, pan: -0.15),
                Drone(freq: 55, gain: 0.26, wobble: 0.08333, depth: 0.1),
                Drone(freq: 82.5, gain: 0.16, wobble: 0.25, depth: 0.15, pan: 0.1),
                Drone(freq: 110, gain: 0.13, wobble: 0.1667, depth: 0.2, pan: -0.1),
                Drone(freq: 116.5833, gain: 0.07, wobble: 0.3333, depth: 0.5, pan: 0.2),
                Drone(freq: 165, gain: 0.06, wobble: 0.25, depth: 0.3),
                Drone(freq: 220, gain: 0.03, wobble: 0.4167, depth: 0.4, pan: -0.2),
                Drive(1.25),
                Rumble(freq: 90, q: 0.8, gain: 6.0, wobble: 0.1667, depth: 0.4),
            ],
        ),
        // Its stern engines: the capital roar, heavier.
        "aster_frigate_thrust": (like: "capital_thrust", size: 1.2),
    },
)
