                Roll(at: 1.93, from: 700, to: 90, glide: 0.5, attack: 0.012, decay: 0.58, gain: 0.44, swell: 11, depth: 0.8, pan: -0.45, seed: 393),
                Burst(at: 2.3, low: 280, high: 2200, attack: 0.0005, decay: 0.012, gain: 1.93, seed: 384),
                Burst(at: 2.32, low: 350, high: 2600, attack: 0.0004, decay: 0.02, gain: 1.16, pan: 0.25, seed: 344),
                Roll(at: 2.32, from: 2400, to: 500, glide: 0.13, attack: 0.001, decay: 0.104, gain: 0.3, swell: 90, depth: 1.0, seed: 434),
                Roll(at: 2.33, from: 700, to: 90, glide: 0.5, attack: 0.012, decay: 0.62, gain: 0.49, swell: 11, depth: 0.8, pan: 0.25, seed: 394),
