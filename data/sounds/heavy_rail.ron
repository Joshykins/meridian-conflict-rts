                Burst(at: 2.94, low: 350, high: 2600, attack: 0.0004, decay: 0.02, gain: 1.43, pan: -0.1, seed: 347),
                Roll(at: 2.94, from: 2400, to: 500, glide: 0.16, attack: 0.001, decay: 0.128, gain: 0.3, swell: 90, depth: 1.0, seed: 437),
                Roll(at: 2.95, from: 700, to: 90, glide: 0.5, attack: 0.012, decay: 0.74, gain: 0.64, swell: 11, depth: 0.8, pan: -0.1, seed: 397),
                // Under it all, a thunder bed rolling and growing the whole way up.
                Roll(at: 0.3, from: 160, to: 520, glide: 2.6, attack: 2.6, decay: 0.15, gain: 0.3, swell: 7, depth: 0.9, seed: 360),
