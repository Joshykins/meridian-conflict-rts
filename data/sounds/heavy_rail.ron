                Sweep(at: 0.01, from: 360, to: 55, glide: 1.6, q: 0.5, attack: 0.03, decay: 0.9, gain: 0.8),
                Roll(at: 0.9, from: 300, to: 100, glide: 3.0, attack: 0.3, decay: 2.0, gain: 0.48, swell: 1.5, depth: 0.55, pan: -0.35, seed: 313),
                Roll(at: 1.1, from: 280, to: 95, glide: 3.2, attack: 0.4, decay: 2.2, gain: 0.45, swell: 1.2, depth: 0.55, pan: 0.4, seed: 314),
                Roll(at: 0.6, from: 130, to: 48, glide: 6.0, attack: 0.8, decay: 3.0, gain: 0.56, swell: 0.5, depth: 0.4, seed: 315),
                Burst(at: 0.95, low: 70, high: 600, attack: 0.004, decay: 0.08, gain: 3.5, pan: -0.3),
                Tone(at: 0.95, from: 62, to: 28, glide: 0.5, attack: 0.01, decay: 0.8, gain: 0.35, pan: -0.3),
                Burst(at: 2.2, low: 50, high: 380, attack: 0.008, decay: 0.15, gain: 2.0, pan: 0.35),
                Tone(at: 2.2, from: 48, to: 25, glide: 0.8, attack: 0.02, decay: 1.0, gain: 0.22, pan: 0.35),
                Drive(1.5),
