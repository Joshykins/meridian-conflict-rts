// The two capital rail cannons: the Resolute's spinal rail (`aster_t3_frigate`, fired
// down out of the cloud layer) and the Zenith (`aster_t4_anti_ship`, a ground gun
// firing up at warships). Nothing else in the game is this big, and they must never be
// mistaken for the rail family (`aster_rail_cannon` and its `like`s).
//
// Each shot is three sounds:
// - The charge (`charge_time` before the shot): capacitor banks filling. A transformer
//   growl and a whine climbing together, the air around the rails starting to crackle
//   and the crackle thickening, all of it at its loudest the instant the shot goes, then
//   let go fast under the fire sound. The game pitches every shot by up to 5%, so the top
//   is held a moment and the release overlaps the fire.
// - The fire: the slug through the sound barrier many times over (one hard N-wave crack,
//   front and back shock), the rails dumping (a heavy electrical slam, low and short, no
//   buzz), then a thunder that rolls for seconds, swelling and sagging off the country.
// - The strike: a kinetic slam, the target coming apart, debris falling after.
//
// The spinal rail is heard from the sky: a sharper crack, and the thunder crossing
// overhead from side to side. The Zenith is heard from beside it: the ground heaving,
// more weight under 60 Hz, and the report going up and away and coming back down
// off the cloud. Both keep their body at 40 to 400 Hz; nothing whistles, rings or buzzes.
//
// Tuning notes: every Roll has a pinned `seed`. A Roll's random swells can outpeak the
// crack, and the whole sound is scaled to its loudest sample, so an unlucky swell pushes
// everything else down; the seeds keep the swells where they were measured (and adding
// a layer no longer reshuffles the others). The fire sounds end with a second, gentle
// Drive over the low thunder: that is what puts them well over the Leviathan's broadside
// in loudness at the same 0.9 peak, without clipping.
(
    sounds: {
        // ---- the Resolute's spinal rail cannon ------------------------------------
        // Continuous: one long climb, arcs crawling along the keel and multiplying.
        "spinal_rail_charge": (
            length: 3.8, peak: 0.5, room: 0.35,
            layers: [
                // The banks switched in: a deep contactor thunk.
                Burst(low: 60, high: 700, attack: 0.0006, decay: 0.03, gain: 5),
                Tone(from: 70, to: 38, glide: 0.1, attack: 0.002, decay: 0.2, gain: 0.5),
                // The transformer growl climbing with the charge.
                Fm(at: 0.05, from: 34, to: 72, glide: 2.95, ratio: 0.5, index: 2.2, fade: 6.0, attack: 2.95, decay: 0.12, gain: 1.0),
                Fm(at: 0.1, from: 68, to: 150, glide: 2.9, ratio: 2.0, index: 1.2, fade: 4.0, attack: 2.9, decay: 0.1, gain: 0.45),
                // The whine of the banks, low in the mix, rising the whole way.
                Tone(at: 0.4, from: 380, to: 940, glide: 2.6, attack: 2.6, decay: 0.08, gain: 0.07, pan: -0.1),
                Tone(at: 0.4, from: 383, to: 947, glide: 2.6, attack: 2.6, decay: 0.08, gain: 0.05, pan: 0.1),
                Drive(1.3),
                // The air along the rails ionising: a crackle bed that swells and thickens.
                Roll(at: 0.6, from: 700, to: 1900, glide: 2.4, attack: 2.4, decay: 0.1, gain: 0.2, swell: 14, depth: 0.85, pan: -0.3, seed: 331),
                Roll(at: 1.2, from: 850, to: 2200, glide: 1.8, attack: 1.8, decay: 0.1, gain: 0.17, swell: 19, depth: 0.85, pan: 0.35, seed: 332),
                // Single arcs jumping, closer together and harder as it fills.
                Burst(at: 1.05, low: 300, high: 1800, attack: 0.0005, decay: 0.012, gain: 1.4, pan: 0.4),
                Burst(at: 1.62, low: 300, high: 1800, attack: 0.0005, decay: 0.014, gain: 1.9, pan: -0.35),
                Burst(at: 2.05, low: 280, high: 1900, attack: 0.0005, decay: 0.016, gain: 2.5, pan: 0.2),
                Burst(at: 2.38, low: 260, high: 2000, attack: 0.0005, decay: 0.018, gain: 3.0, pan: -0.5),
                Burst(at: 2.61, low: 250, high: 2000, attack: 0.0005, decay: 0.02, gain: 3.5, pan: 0.45),
                Burst(at: 2.79, low: 240, high: 2100, attack: 0.0005, decay: 0.022, gain: 4.0, pan: -0.15),
                Burst(at: 2.91, low: 220, high: 2100, attack: 0.0005, decay: 0.03, gain: 4.5, pan: 0.3),
                // The last instant: everything at the top, a sub swell under it.
                Tone(at: 2.2, from: 44, to: 52, glide: 0.8, attack: 0.8, decay: 0.12, gain: 0.5),
            ],
        ),
        // Heard from the ground with the ship overhead: the crack first and hardest, the
        // rails' slam, then the thunder crossing the sky and rolling back off the hills.
        "spinal_rail_fire": (
            length: 8.5, peak: 0.9, room: 0.9,
            layers: [
                // The N-wave: the bow shock's crack and the tail shock close behind it.
                Burst(low: 1200, high: 5500, attack: 0.0001, decay: 0.004, gain: 10),
                Burst(low: 400, high: 2400, attack: 0.0002, decay: 0.014, gain: 30),
                Burst(at: 0.016, low: 300, high: 2000, attack: 0.0002, decay: 0.016, gain: 22),
                // The rails dumping: a low electrical slam, bright for an instant, then plain.
                Fm(from: 96, to: 40, glide: 0.08, ratio: 0.5, index: 3.4, fade: 0.04, attack: 0.0005, decay: 0.16, gain: 1.0),
                Fm(at: 0.002, from: 150, to: 118, glide: 0.1, ratio: 1.41, index: 1.8, fade: 0.04, attack: 0.001, decay: 0.12, gain: 0.35),
                // The blast: bark and boom, and the concussion under them.
                Burst(at: 0.002, low: 110, high: 800, attack: 0.0006, decay: 0.08, gain: 30),
                Burst(at: 0.004, low: 36, high: 240, attack: 0.003, decay: 0.5, gain: 22),
                Tone(from: 180, to: 48, glide: 0.08, attack: 0.0008, decay: 0.16, gain: 1.5),
                Tone(from: 82, to: 30, glide: 0.3, attack: 0.002, decay: 0.6, gain: 1.8),
                Tone(from: 46, to: 24, glide: 0.8, attack: 0.006, decay: 0.9, gain: 1.0),
                // The air itself tearing under the slam, held for most of a second.
                Roll(at: 0.003, from: 380, to: 110, glide: 1.2, attack: 0.01, decay: 0.8, gain: 2.0, swell: 3.5, depth: 0.45, seed: 301),
                Drive(2.1),
                // The air torn open down the slug's path, going away below.
                Sweep(at: 0.004, from: 2200, to: 380, glide: 0.35, q: 0.7, attack: 0.002, decay: 0.2, gain: 0.5, pan: 0.15),
                Sweep(at: 0.01, from: 420, to: 60, glide: 1.4, q: 0.5, attack: 0.03, decay: 0.8, gain: 0.8),
                // The thunder crossing overhead, left to right, and the long roll behind it.
                Roll(at: 0.05, from: 420, to: 130, glide: 2.0, attack: 0.05, decay: 1.6, gain: 0.54, swell: 2.2, depth: 0.5, pan: -0.5, seed: 602),
                Roll(at: 0.35, from: 340, to: 110, glide: 2.6, attack: 0.25, decay: 1.8, gain: 0.36, swell: 1.7, depth: 0.55, seed: 303),
                Roll(at: 0.7, from: 300, to: 90, glide: 3.4, attack: 0.4, decay: 2.2, gain: 0.252, swell: 1.3, depth: 0.55, pan: 0.55, seed: 304),
                Roll(at: 0.2, from: 140, to: 55, glide: 6.0, attack: 0.6, decay: 2.8, gain: 0.5, swell: 0.6, depth: 0.5, seed: 305),
                // Returns off the hills: three, each further, lower and wider.
                Burst(at: 0.55, low: 120, high: 900, attack: 0.001, decay: 0.03, gain: 5, pan: 0.45),
                Tone(at: 0.55, from: 76, to: 32, glide: 0.35, attack: 0.004, decay: 0.5, gain: 0.4, pan: 0.45),
                Burst(at: 1.3, low: 80, high: 600, attack: 0.002, decay: 0.06, gain: 3.2, pan: -0.5),
                Tone(at: 1.3, from: 60, to: 28, glide: 0.5, attack: 0.008, decay: 0.7, gain: 0.3, pan: -0.5),
                Burst(at: 2.4, low: 60, high: 420, attack: 0.004, decay: 0.12, gain: 2.0, pan: 0.25),
                Tone(at: 2.4, from: 50, to: 26, glide: 0.7, attack: 0.02, decay: 0.9, gain: 0.2, pan: 0.25),
                // Squeeze the whole of it once more, gently: the shot is felt, not just heard.
                Drive(1.5),
            ],
        ),
        // The slug arriving: a kinetic slam deeper than any shell, the target breaking,
        // and the pieces coming down around it.
        "spinal_rail_impact": (
            length: 6.0, peak: 0.9, room: 0.7,
            layers: [
                Burst(low: 300, high: 2200, attack: 0.0002, decay: 0.01, gain: 12),
                Burst(at: 0.001, low: 60, high: 500, attack: 0.0008, decay: 0.12, gain: 26),
                Burst(at: 0.004, low: 30, high: 200, attack: 0.004, decay: 0.45, gain: 14),
                Tone(from: 140, to: 34, glide: 0.12, attack: 0.001, decay: 0.2, gain: 1.8),
