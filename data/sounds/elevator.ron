// The Skyhook space elevator (`mc_sim::elevator`), heard by `audio/elevator.rs`, which
// looks each part up as `<moving>_<part>` (the unit's `moving` sound) and falls back to
// `elevator_<part>` here.
//
// The loops are steady on purpose: the game glides their pitch and level with the
// platform's height and speed and with the siren's rotors, which is where they move.
// Every steady frequency is a whole number of cycles in its loop. The one-shots are
// tied to the moments the sim and the pose report: the cable falling from orbit, its
// foot passing the clouds, seating in the well, the three jaws closing on it; a
// platform braking, docking, letting its units off, and leaving.
//
// Everything is weight first: bodies at 30 to 150 Hz with mids at 150 Hz to 1.5 kHz
// so small speakers carry them, and no held noise above about 2 kHz.
(
    sounds: {
        // The towers' sirens, one voice per tower crown. A big motor siren with two rotor
        // speeds: the game winds it up from half pitch, then swings it between its high
        // note and a fourth under it every 1.3 s (the mixer's pitch glide slurs each
        // change, so it wails "hi-lo" rather than stepping), turns each tower's horn so its
        // level sweeps round, and winds it down at half pitch as it falls quiet. The nuke
        // alarm is one rotor rising and falling once, a semitone pair; this one alternates.
        // A reedy horn note with a slightly wavering copy beside it, the odd harmonics a
        // ported rotor makes, air chopping through the ports and the motor under it.
        "elevator_siren": (
            length: 4, peak: 0.5, room: 0.4, looped: true,
            layers: [
                Fm(from: 300, to: 300, glide: 1, ratio: 1, index: 1.3, fade: 1000, attack: 0.01, decay: 100000, gain: 0.4),
                Fm(from: 300.25, to: 300.25, glide: 1, ratio: 0.0125, index: 1.6, fade: 1000, attack: 0.01, decay: 100000, gain: 0.28, pan: 0.15),
                Drone(freq: 600, gain: 0.05, wobble: 7.5, depth: 0.2),
                Drone(freq: 900, gain: 0.11, wobble: 7.5, depth: 0.25, pan: -0.1),
                Drone(freq: 1500, gain: 0.035, wobble: 7.5, depth: 0.3, pan: 0.1),
                Drive(1.5),
                Rumble(freq: 300, q: 4, gain: 5, wobble: 7.5, depth: 0.35),
                Rumble(freq: 900, q: 2, gain: 1.5, wobble: 3.75, depth: 0.3),
                Rumble(freq: 75, q: 0.8, gain: 5, wobble: 0.5, depth: 0.3),
            ],
        ),
        // A platform coming down the cable from orbit: the air it shoves aside. A deep growl
        // and its harmonics, buffeting low roar, and tearing air higher up, each swelling at
        // random. The game brings it up as the platform nears and lifts its pitch with speed.
        "elevator_platform_roar": (
            length: 6, peak: 0.4, room: 0, looped: true,
            layers: [
                Fm(from: 29, to: 29, glide: 1, ratio: 0.5, index: 1.7, fade: 1000, attack: 0.01, decay: 100000, gain: 0.4),
                Drone(freq: 58, gain: 0.2, wobble: 0.5, depth: 0.3),
                Drone(freq: 87, gain: 0.12, wobble: 0.3333, depth: 0.35, pan: -0.15),
                Drone(freq: 116, gain: 0.1, wobble: 0.6667, depth: 0.35, pan: 0.15),
                Drone(freq: 145, gain: 0.06, wobble: 0.8333, depth: 0.4),
                Drive(1.4),
                Rumble(freq: 40, q: 0.8, gain: 12, wobble: 0.3333, depth: 0.3),
                Wind(freq: 90, q: 0.7, gain: 10, swell: 1.5, depth: 0.6, sway: 0.4),
                Wind(freq: 220, q: 0.9, gain: 8, swell: 3, depth: 0.5, sway: 0.5, pan: -0.25),
                Wind(freq: 450, q: 1.1, gain: 3, swell: 5, depth: 0.6, sway: 0.4, pan: 0.25),
            ],
        ),
        // The platform's ring of thrusters burning: braking over the last third of the
        // descent, and lifting it away again. A low growl, a roaring bed, and the ragged
        // crackle a big motor makes, fluttering fast.
        "elevator_thrusters": (
            length: 4, peak: 0.42, room: 0, looped: true,
            layers: [
                Fm(from: 37.5, to: 37.5, glide: 1, ratio: 0.5, index: 1.8, fade: 1000, attack: 0.01, decay: 100000, gain: 0.4),
                Drone(freq: 75, gain: 0.2, wobble: 0.75, depth: 0.3),
                Drone(freq: 112.5, gain: 0.1, wobble: 1.25, depth: 0.35, pan: 0.15),
                Drone(freq: 150, gain: 0.08, wobble: 1.75, depth: 0.4, pan: -0.15),
                Drive(1.4),
                Rumble(freq: 60, q: 0.7, gain: 12, wobble: 0.5, depth: 0.35),
                Wind(freq: 160, q: 0.8, gain: 10, swell: 4, depth: 0.5, sway: 0.4, pan: -0.2),
                Wind(freq: 320, q: 0.9, gain: 7, swell: 12, depth: 0.7, sway: 0.5, pan: 0.2),
                Wind(freq: 700, q: 1.0, gain: 2.5, swell: 18, depth: 0.85, sway: 0.4),
            ],
        ),
        // The platform's collars running down through the towers' guide sleeves: steel
        // dragging on steel. Inharmonic metal partials chattering on and off as the collars
        // stick and slip, a low groan of the frame under them, and scraping grit. Kept
        // under 1.5 kHz so it grinds rather than whines; the game raises it with speed.
        "elevator_sleeve_screech": (
            length: 3, peak: 0.3, room: 0, looped: true,
            layers: [
                Fm(from: 130, to: 130, glide: 1, ratio: 1.41, index: 1.5, fade: 1000, attack: 0.01, decay: 100000, gain: 0.25),
                Drone(freq: 520, gain: 0.09, wobble: 6, depth: 0.85),
                Drone(freq: 733.33, gain: 0.06, wobble: 4.3333, depth: 0.9, pan: -0.2),
                Drone(freq: 1013.33, gain: 0.035, wobble: 7.6667, depth: 0.9, pan: 0.2),
                Drive(1.3),
                Wind(freq: 800, q: 2.5, gain: 4, swell: 9, depth: 0.9, sway: 0.4, pan: -0.15),
                Wind(freq: 1250, q: 3, gain: 2.5, swell: 6, depth: 0.9, sway: 0.5, pan: 0.15),
                Wind(freq: 300, q: 1.2, gain: 5, swell: 4, depth: 0.6, sway: 0.3),
            ],
        ),
        // The running elevator at rest: mains hum off its plant, a pump chugging slowly,
        // machinery murmuring in the towers.
        "elevator_hum": (
            length: 4, peak: 0.3, room: 0, looped: true,
            layers: [
                Fm(from: 50, to: 50, glide: 1, ratio: 0.5, index: 1.0, fade: 1000, attack: 0.01, decay: 100000, gain: 0.3),
                Drone(freq: 100, gain: 0.18, wobble: 0.25, depth: 0.2),
                Drone(freq: 150, gain: 0.07, wobble: 0.5, depth: 0.25, pan: -0.15),
                Drone(freq: 200, gain: 0.05, wobble: 0.25, depth: 0.3, pan: 0.15),
                Drone(freq: 300, gain: 0.025, wobble: 0.75, depth: 0.3),
                Drone(freq: 75, gain: 0.1, wobble: 1.5, depth: 0.7),
                Drive(1.2),
                Rumble(freq: 120, q: 1.5, gain: 3, wobble: 1.25, depth: 0.3),
                Rumble(freq: 450, q: 1.5, gain: 0.8, wobble: 0.5, depth: 0.4, pan: 0.2),
            ],
        ),
        // The cable's foot falling out of orbit, 18 s from first sound to the well: far up
        // and faint at first, a deep breathy whistle across the cable sinking in pitch, the
        // roar of torn air opening under it and the growl of the mass coming down, all
        // swelling as it nears and slows, and gone the moment it seats.
        "elevator_cable_fall": (
            length: 19.5, peak: 0.6, room: 0.7,
            layers: [
                Fm(from: 46, to: 31, glide: 17, ratio: 0.5, index: 1.6, fade: 20, attack: 15.5, decay: 0.8, gain: 0.45),
                Fm(from: 330, to: 120, glide: 17, ratio: 0.5, index: 0.7, fade: 20, attack: 15, decay: 0.8, gain: 0.09),
                Drive(1.4),
                Sweep(from: 760, to: 190, glide: 17, q: 5, attack: 15.5, decay: 0.7, gain: 2.5),
                Sweep(at: 0.3, from: 520, to: 150, glide: 17, q: 3, attack: 15.2, decay: 0.7, gain: 2.5, pan: 0.2),
                Roll(at: 1.0, from: 220, to: 480, glide: 15, attack: 14.5, decay: 0.8, gain: 1.3, swell: 3, depth: 0.5, pan: -0.2),
                Roll(from: 80, to: 150, glide: 17, attack: 15.5, decay: 0.9, gain: 1.2, swell: 1.2, depth: 0.5),
            ],
        ),
        // The cable's foot breaking down through the cloud deck: a sonic double boom, a
        // short shove of air, and thunder rolling off it both ways.
        "elevator_cloud_thump": (
            length: 7, peak: 0.6, room: 1.0,
            layers: [
                Burst(low: 30, high: 320, attack: 0.002, decay: 0.08, gain: 10),
                Tone(from: 58, to: 30, glide: 0.35, attack: 0.002, decay: 0.45, gain: 1.6),
                Burst(at: 0.14, low: 30, high: 300, attack: 0.002, decay: 0.09, gain: 8),
                Tone(at: 0.14, from: 54, to: 28, glide: 0.4, attack: 0.002, decay: 0.5, gain: 1.3),
                Drive(1.5),
                Roll(at: 0.05, from: 280, to: 80, glide: 4, attack: 0.05, decay: 1.6, gain: 1.4, swell: 2, depth: 0.6),
                Roll(at: 0.4, from: 200, to: 60, glide: 5, attack: 0.4, decay: 1.8, gain: 0.9, swell: 1.2, depth: 0.7, pan: -0.5),
                Roll(at: 0.6, from: 190, to: 58, glide: 5, attack: 0.5, decay: 1.8, gain: 0.9, swell: 1.0, depth: 0.7, pan: 0.5),
            ],
        ),
        // The cable seating in the well: a crack, a colossal low slam, the ground taking it
        // and the whole steel mass ringing low and short. Then, as the dust rolls out, the
        // three jaws' rams start to drive: a servo groan rising and the oil rushing.
        "elevator_cable_seat": (
            length: 9, peak: 0.85, room: 0.9,
            layers: [
                Burst(low: 90, high: 1100, attack: 0.0006, decay: 0.03, gain: 6),
                Burst(at: 0.002, low: 28, high: 260, attack: 0.003, decay: 0.4, gain: 16),
                Burst(at: 0.003, low: 160, high: 750, attack: 0.002, decay: 0.12, gain: 6),
                Tone(from: 70, to: 28, glide: 0.6, attack: 0.003, decay: 1.0, gain: 2.2),
                Tone(from: 46, to: 24, glide: 1.5, attack: 0.006, decay: 2.0, gain: 1.4),
                Fm(at: 0.01, from: 74, to: 66, glide: 2.5, ratio: 1.41, index: 2.0, fade: 0.8, attack: 0.003, decay: 1.4, gain: 0.5),
                Fm(at: 0.02, from: 151, to: 140, glide: 2, ratio: 2.76, index: 1.2, fade: 0.5, attack: 0.002, decay: 0.7, gain: 0.2, pan: 0.2),
                Fm(at: 1.6, from: 48, to: 64, glide: 4.5, ratio: 2.0, index: 1.6, fade: 4, attack: 1.2, decay: 2.0, gain: 0.3),
                Fm(at: 1.7, from: 96, to: 128, glide: 4.5, ratio: 1.0, index: 1.2, fade: 3, attack: 1.3, decay: 1.8, gain: 0.12, pan: -0.2),
                Drive(1.6),
                Roll(at: 0.01, from: 170, to: 60, glide: 4, attack: 0.02, decay: 2.0, gain: 1.2, swell: 3, depth: 0.6),
                Sweep(at: 0.05, from: 600, to: 150, glide: 2.5, q: 0.8, attack: 0.03, decay: 1.0, gain: 2.0),
                Sweep(at: 1.6, from: 280, to: 480, glide: 4.5, q: 2, attack: 1.2, decay: 1.8, gain: 1.0, pan: 0.15),
            ],
        ),
        // The three jaws closing on the cable one after another, each a hydraulic slam (a
        // crack, a deep blow and the jaw's steel ringing short) from its own tower, the
        // locking pins driving home, and then the rams' pressure let off in one long hiss
