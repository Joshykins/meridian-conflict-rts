                Burst(at: 0.003, low: 150, high: 700, attack: 0.002, decay: 0.14, gain: 7),
                Tone(from: 58, to: 24, glide: 0.8, attack: 0.003, decay: 1.4, gain: 2.6),
                Tone(from: 36, to: 22, glide: 2, attack: 0.008, decay: 2.2, gain: 1.4),
                Fm(at: 0.005, from: 52, to: 47, glide: 3, ratio: 1.41, index: 2.2, fade: 1.0, attack: 0.003, decay: 1.8, gain: 0.55),
                Fm(at: 0.01, from: 117, to: 110, glide: 2, ratio: 2.76, index: 1.3, fade: 0.6, attack: 0.002, decay: 0.9, gain: 0.3, pan: -0.25),
                Fm(at: 0.015, from: 173, to: 166, glide: 2, ratio: 1.41, index: 0.9, fade: 0.4, attack: 0.002, decay: 0.6, gain: 0.12, pan: 0.25),
                Fm(at: 1.25, from: 70, to: 95, glide: 0.3, ratio: 2, index: 1.5, fade: 0.6, attack: 0.08, decay: 0.3, gain: 0.25, pan: -0.3),
                Fm(at: 1.65, from: 68, to: 92, glide: 0.3, ratio: 2, index: 1.5, fade: 0.6, attack: 0.08, decay: 0.3, gain: 0.25, pan: 0.3),
                Fm(at: 2.0, from: 66, to: 90, glide: 0.3, ratio: 2, index: 1.5, fade: 0.6, attack: 0.08, decay: 0.3, gain: 0.25),
                Drive(1.7),
                Roll(at: 0.01, from: 180, to: 55, glide: 5, attack: 0.02, decay: 2.4, gain: 1.3, swell: 2.5, depth: 0.6),
                Burst(at: 1.5, low: 100, high: 800, attack: 0.0008, decay: 0.015, gain: 4, pan: -0.3),
                Tone(at: 1.5, from: 140, to: 70, glide: 0.05, attack: 0.001, decay: 0.1, gain: 0.3, pan: -0.3),
                Burst(at: 1.9, low: 100, high: 800, attack: 0.0008, decay: 0.015, gain: 4, pan: 0.3),
                Tone(at: 1.9, from: 136, to: 68, glide: 0.05, attack: 0.001, decay: 0.1, gain: 0.3, pan: 0.3),
                Burst(at: 2.25, low: 100, high: 800, attack: 0.0008, decay: 0.015, gain: 4.5),
                Tone(at: 2.25, from: 132, to: 66, glide: 0.05, attack: 0.001, decay: 0.12, gain: 0.35),
                Burst(at: 2.5, low: 300, high: 1600, attack: 0.01, decay: 0.12, gain: 3),
                Foam(at: 2.5, from: 1300, to: 600, glide: 5, q: 0.7, attack: 0.05, decay: 2.2, gain: 0.9, swell: 28, depth: 0.45),
                Sweep(at: 2.5, from: 800, to: 350, glide: 5, q: 0.7, attack: 0.08, decay: 2.4, gain: 1.5),
            ],
        ),
        // The deck horn as the units start to roll off: one long low blast, two brassy
        // notes a major third apart scooping up onto pitch, a sub under them, air in the
        // throat, and the echo coming back off the towers.
        "elevator_deck_horn": (
            length: 7, peak: 0.55, room: 1.0,
            layers: [
                Fm(from: 92, to: 98, glide: 0.3, ratio: 1, index: 2.2, fade: 3, attack: 0.15, decay: 1.6, gain: 0.45),
                Fm(from: 115, to: 123, glide: 0.3, ratio: 1, index: 2.0, fade: 3, attack: 0.18, decay: 1.6, gain: 0.3, pan: 0.15),
                Fm(from: 46, to: 49, glide: 0.3, ratio: 0.5, index: 1.2, fade: 3, attack: 0.2, decay: 1.6, gain: 0.25),
                Drive(1.4),
                Hiss(freq: 600, q: 1, attack: 0.1, decay: 1.2, gain: 0.04),
            ],
        ),
        // The platform letting go: the locks releasing, a breath of steam, the thrusters
        // spooling up (a growl climbing out of the deck) and lighting with a deep whump
        // into a roar that the thruster loop carries up and away.
        "elevator_depart": (
            length: 9, peak: 0.7, room: 0.8,
            layers: [
