                Tone(from: 64, to: 32, glide: 0.5, attack: 0.004, decay: 0.7, gain: 1.6),
                Fm(at: 0.05, from: 30, to: 40, glide: 2, ratio: 0.5, index: 1.8, fade: 2, attack: 0.15, decay: 1.4, gain: 0.45),
