                Roll(at: 0.04, from: 420, to: 240, glide: 3, attack: 0.15, decay: 1.4, gain: 1.4, swell: 8, depth: 0.55),
                Roll(at: 0.06, from: 130, to: 80, glide: 3, attack: 0.2, decay: 1.6, gain: 1.2, swell: 3, depth: 0.4),
                Burst(at: 0.2, low: 260, high: 1200, attack: 0.0005, decay: 0.014, gain: 3.5, pan: 0.3),
                Burst(at: 0.27, low: 300, high: 1300, attack: 0.0005, decay: 0.012, gain: 3, pan: -0.35),
                Burst(at: 0.41, low: 240, high: 1100, attack: 0.0005, decay: 0.015, gain: 3.2, pan: 0.1),
