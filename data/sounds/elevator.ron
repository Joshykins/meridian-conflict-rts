                Burst(at: 3.0, low: 30, high: 380, attack: 0.004, decay: 0.25, gain: 12),
                Tone(at: 3.0, from: 64, to: 30, glide: 0.6, attack: 0.004, decay: 0.9, gain: 1.8),
                Drive(1.5),
                Foam(at: 0.35, from: 1200, to: 600, glide: 2, q: 0.7, attack: 0.05, decay: 0.9, gain: 0.6, swell: 26, depth: 0.45),
                Sweep(at: 0.6, from: 60, to: 220, glide: 2.6, q: 0.9, attack: 2.4, decay: 0.8, gain: 3),
                Roll(at: 3.0, from: 420, to: 180, glide: 5, attack: 0.2, decay: 1.8, gain: 1.4, swell: 8, depth: 0.55),
                Roll(at: 3.05, from: 120, to: 60, glide: 5, attack: 0.3, decay: 2.0, gain: 1.4, swell: 3, depth: 0.4),
            ],
        ),
    },
