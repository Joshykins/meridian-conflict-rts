        "elevator_jaws": (
            length: 11, peak: 0.8, room: 0.9,
            layers: [
                Burst(low: 80, high: 900, attack: 0.0006, decay: 0.02, gain: 6, pan: -0.45),
                Burst(at: 0.002, low: 30, high: 240, attack: 0.003, decay: 0.25, gain: 12, pan: -0.45),
                Tone(from: 62, to: 30, glide: 0.4, attack: 0.003, decay: 0.7, gain: 1.8, pan: -0.45),
                Fm(at: 0.005, from: 88, to: 80, glide: 1.2, ratio: 1.41, index: 1.8, fade: 0.5, attack: 0.002, decay: 0.6, gain: 0.35, pan: -0.45),
                Burst(at: 0.45, low: 80, high: 900, attack: 0.0006, decay: 0.02, gain: 6, pan: 0.45),
                Burst(at: 0.452, low: 30, high: 240, attack: 0.003, decay: 0.25, gain: 12, pan: 0.45),
                Tone(at: 0.45, from: 58, to: 29, glide: 0.4, attack: 0.003, decay: 0.7, gain: 1.8, pan: 0.45),
                Fm(at: 0.455, from: 83, to: 76, glide: 1.2, ratio: 1.41, index: 1.8, fade: 0.5, attack: 0.002, decay: 0.6, gain: 0.35, pan: 0.45),
                Burst(at: 0.85, low: 80, high: 900, attack: 0.0006, decay: 0.022, gain: 7),
                Burst(at: 0.852, low: 28, high: 230, attack: 0.003, decay: 0.3, gain: 14),
                Tone(at: 0.85, from: 60, to: 27, glide: 0.5, attack: 0.003, decay: 0.9, gain: 2.1),
                Fm(at: 0.855, from: 79, to: 72, glide: 1.4, ratio: 1.41, index: 1.8, fade: 0.6, attack: 0.002, decay: 0.75, gain: 0.4),
                Drive(1.5),
                Burst(at: 1.3, low: 110, high: 800, attack: 0.0008, decay: 0.015, gain: 3.5, pan: -0.3),
                Burst(at: 1.38, low: 110, high: 800, attack: 0.0008, decay: 0.015, gain: 3.5, pan: 0.3),
                Burst(at: 1.45, low: 110, high: 800, attack: 0.0008, decay: 0.015, gain: 3.5),
                Burst(at: 1.6, low: 300, high: 1600, attack: 0.01, decay: 0.15, gain: 3),
                Roll(at: 1.6, from: 520, to: 200, glide: 6, attack: 0.1, decay: 2.6, gain: 0.8, swell: 6, depth: 0.4),
                Foam(at: 1.6, from: 1400, to: 650, glide: 7, q: 0.7, attack: 0.08, decay: 2.8, gain: 1.0, swell: 30, depth: 0.4),
                Sweep(at: 1.65, from: 900, to: 380, glide: 7, q: 0.6, attack: 0.12, decay: 3.0, gain: 1.6, pan: -0.25),
                Sweep(at: 1.7, from: 850, to: 360, glide: 7, q: 0.6, attack: 0.15, decay: 3.0, gain: 1.6, pan: 0.25),
            ],
        ),
        // The platform's thrusters lighting to brake over the last third of its fall: a
        // deep whump, the growl taking hold and the roar coming up with a crackle.
        "elevator_brake_ignite": (
            length: 5, peak: 0.6, room: 0.6,
            layers: [
