// A tier-5 titan in the interface (`hud/titan.rs`, `titan_marks.rs`): its answer to being
// picked, and the calls that tell a player one is on the field. They are heard at
// interface volume and from no place in the world, like the nuclear alarm, but they are
// not sirens (the alarm owns that): a titan is announced by horns, low and slow, the way
// a ship that size would make itself known. Nothing beeps; every call moves.
(
    sounds: {
        // Picked: a hydraulic groan as something enormous takes the weight, a latch going
        // home, then its reactor answering on D, deep, and a fifth over it.
        "select_titan": (
            length: 1.6, peak: 0.36, room: 0.8,
            layers: [
                Fm(from: 46, to: 73.4, glide: 0.34, ratio: 0.5, index: 1.6, fade: 0.3, attack: 0.03, decay: 0.26, gain: 0.9),
                Sweep(from: 180, to: 420, glide: 0.3, q: 0.9, attack: 0.04, decay: 0.18, gain: 0.5),
                Burst(at: 0.3, low: 60, high: 520, attack: 0.001, decay: 0.03, gain: 2.2),
                Tone(at: 0.3, from: 82, to: 41, glide: 0.2, attack: 0.003, decay: 0.3, gain: 1.1),
                Fm(at: 0.38, from: 73.4, to: 73.4, glide: 1, ratio: 2, index: 1.4, fade: 0.4, attack: 0.02, decay: 0.55, gain: 0.55, pan: -0.15),
                Fm(at: 0.44, from: 110, to: 110, glide: 1, ratio: 2, index: 1.0, fade: 0.4, attack: 0.02, decay: 0.5, gain: 0.35, pan: 0.15),
            ],
        ),
        // An enemy titan seen for the first time: two long horn blasts, the second a
