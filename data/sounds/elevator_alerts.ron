                Fm(at: 1.26, from: 73.4, to: 73.4, glide: 1, ratio: 2.76, index: 1.2, fade: 1.0, attack: 0.01, decay: 1.3, gain: 0.45, pan: -0.25),
                Fm(at: 1.36, from: 110, to: 110, glide: 1, ratio: 2.76, index: 1.0, fade: 1.0, attack: 0.01, decay: 1.2, gain: 0.34, pan: 0.25),
                Fm(at: 1.46, from: 146.8, to: 146.8, glide: 1, ratio: 2.76, index: 0.8, fade: 1.0, attack: 0.01, decay: 1.1, gain: 0.26),
            ],
        ),
    },
)
