// The Paladin's twin bolt rifles (`aster_t3_assault_bot`): a bolt of blue electric
// plasma thrown at 400 m/s that bursts in lightning round what it hits. Each shot
// is three sounds, and none of them is the Arbalest's bore made smaller:
//
// - The charge (0.6 s before the shot): the air round the gun filling with charge.
//   A heavy contactor thunk, a deep hum swelling under it, ionised air hissing up,
//   and crackle coming at random, never on a beat. No climbing whine: that read as
//   a toy powering up.
// - The fire: thunder leaving the gun. A hard electric crack and a blast you feel
//   through the legs, a low boom that holds, the plasma tearing the air, and thunder
//   rolling off the ground for a second after. No falling tone anywhere.
// - The strike: a lightning strike and an explosion at once. A thunderclap, a blast
//   and a deep boom, crackle branching out to both sides, debris, and long thunder
//   rolling away with a return off the ground.
//
// The guns alternate, so one fires every 0.7 s: each shot's onset stands well
// above the thunder still rolling from the last, so a volley is a storm, not a
// smear. Every Roll has a pinned seed, so its random swells stay where they were
// measured.
(
    sounds: {
        // The gun drawing charge before the shot: pressure building, not a whine
        // rising. It ends into the fire sound, not a pause before it.
        "aster_bolt_rifle_heavy_charge": (
            length: 0.8, peak: 0.2, room: 0.25,
            layers: [
                // The capacitor bank's contactor closing: a heavy thunk, felt more than heard.
                Burst(low: 90, high: 700, attack: 0.0006, decay: 0.012, gain: 4),
                Tone(from: 95, to: 60, glide: 0.04, attack: 0.001, decay: 0.06, gain: 0.5),
                // The hum of the charge swelling: deep, rough, and only leaning upward.
                Fm(at: 0.02, from: 48, to: 62, glide: 0.58, ratio: 0.5, index: 2.4, fade: 4.0, attack: 0.55, decay: 0.05, gain: 0.9),
                Fm(at: 0.02, from: 96, to: 124, glide: 0.58, ratio: 1.5, index: 1.2, fade: 4.0, attack: 0.56, decay: 0.04, gain: 0.25),
                Drive(1.5),
                // The air round the gun ionising: a hiss swelling in and opening up a little.
                Sweep(at: 0.05, from: 900, to: 1700, glide: 0.55, q: 0.8, attack: 0.52, decay: 0.04, gain: 0.3, seed: 71),
                // Crackle over the housing: random sparks, sparse, then thick, then the snap.
                Roll(at: 0.15, from: 2600, to: 3000, glide: 0.45, attack: 0.44, decay: 0.03, gain: 0.35, swell: 45, depth: 1.0, seed: 72),
                Burst(at: 0.21, low: 900, high: 2600, attack: 0.0002, decay: 0.003, gain: 0.9, pan: -0.3, seed: 1),
                Burst(at: 0.38, low: 900, high: 2600, attack: 0.0002, decay: 0.004, gain: 1.4, pan: 0.3, seed: 2),
                Burst(at: 0.47, low: 900, high: 2600, attack: 0.0002, decay: 0.003, gain: 1.6, pan: -0.15, seed: 3),
                Burst(at: 0.555, low: 900, high: 2600, attack: 0.0002, decay: 0.004, gain: 2.0, pan: 0.2, seed: 4),
            ],
        ),
        // The shot: a hard electric crack and a blast, a boom that holds, then
        // thunder rolling off the ground.
        "aster_bolt_rifle_heavy": (
            length: 2.0, peak: 0.8, room: 0.4,
            layers: [
                // The crack of the bolt breaking out of the barrel.
                Burst(low: 700, high: 2800, attack: 0.0002, decay: 0.006, gain: 16),
                // The blast: a slam of air under the crack, then the push you feel through the legs.
                Burst(low: 120, high: 900, attack: 0.0004, decay: 0.05, gain: 22),
                Burst(at: 0.002, low: 35, high: 240, attack: 0.003, decay: 0.2, gain: 14),
                // The boom: low and barely moving, holding under everything.
                Tone(from: 140, to: 70, glide: 0.05, attack: 0.001, decay: 0.1, gain: 1.1),
                Tone(from: 66, to: 38, glide: 0.14, attack: 0.001, decay: 0.26, gain: 1.5),
                Tone(from: 40, to: 28, glide: 0.4, attack: 0.004, decay: 0.38, gain: 0.6),
                // The electrical grit in the blast: a growl that starts rough and smooths out.
                Fm(from: 88, to: 72, glide: 0.12, ratio: 0.5, index: 2.6, fade: 0.08, attack: 0.001, decay: 0.14, gain: 0.5),
                Drive(1.5),
                // The plasma tearing the air as it goes down range.
                Sweep(at: 0.004, from: 1500, to: 500, glide: 0.3, q: 0.9, attack: 0.008, decay: 0.16, gain: 0.3, pan: 0.2, seed: 22),
                // Crackle round the bolt as it leaves, hopping side to side.
                Burst(at: 0.016, low: 1000, high: 2800, attack: 0.0002, decay: 0.003, gain: 1.8, pan: 0.3, seed: 31),
                Burst(at: 0.034, low: 900, high: 2600, attack: 0.0002, decay: 0.003, gain: 1.4, pan: -0.35, seed: 32),
                Burst(at: 0.061, low: 800, high: 2400, attack: 0.0002, decay: 0.004, gain: 1.0, pan: 0.4, seed: 33),
                // The recoil: the housing slamming back into the shoulder, a dull steel knock.
                Fm(at: 0.04, from: 150, to: 128, glide: 0.06, ratio: 1.41, index: 1.3, fade: 0.04, attack: 0.001, decay: 0.09, gain: 0.25, pan: -0.1),
                // Thunder: the report rolling off the ground, swelling and sagging as it goes.
                Roll(at: 0.01, from: 900, to: 110, glide: 0.7, attack: 0.02, decay: 0.3, gain: 0.4, swell: 7, depth: 0.5, seed: 23),
                Roll(at: 0.06, from: 260, to: 60, glide: 1.2, attack: 0.08, decay: 0.6, gain: 0.2, swell: 4, depth: 0.5, seed: 24),
                // A return off the hills to one side.
                Burst(at: 0.38, low: 60, high: 380, attack: 0.004, decay: 0.14, gain: 1.6, pan: 0.4, seed: 25),
                Tone(at: 0.38, from: 52, to: 32, glide: 0.3, attack: 0.006, decay: 0.3, gain: 0.15, pan: 0.4),
            ],
        ),
        // The bolt letting go where it lands: a lightning strike and an explosion.
        "aster_bolt_rifle_heavy_strike": (
            length: 3.2, peak: 0.85, room: 0.5,
            layers: [
                // The thunderclap of the discharge.
                Burst(low: 700, high: 3000, attack: 0.0002, decay: 0.007, gain: 18),
                // The blast: a slam, then the ground heaving.
                Burst(low: 100, high: 800, attack: 0.0005, decay: 0.07, gain: 24),
                Burst(at: 0.002, low: 30, high: 220, attack: 0.004, decay: 0.32, gain: 16),
                // The boom, deep and long.
                Tone(from: 130, to: 55, glide: 0.08, attack: 0.001, decay: 0.16, gain: 1.4),
                Tone(from: 60, to: 32, glide: 0.25, attack: 0.002, decay: 0.5, gain: 1.6),
                Tone(from: 36, to: 22, glide: 0.8, attack: 0.008, decay: 1.0, gain: 0.9),
                // The arc's rasp inside the blast: a growl, over almost at once.
                Fm(from: 150, to: 110, glide: 0.08, ratio: 0.5, index: 2.4, fade: 0.06, attack: 0.001, decay: 0.09, gain: 0.5),
                Drive(1.6),
                // The lightning branching out: fast random crackle, its band sinking as it thins.
                Roll(at: 0.004, from: 2400, to: 700, glide: 0.35, attack: 0.004, decay: 0.2, gain: 0.45, swell: 38, depth: 0.9, seed: 41),
                // Branches striking off to either side, further out and softer each time.
                Burst(at: 0.026, low: 800, high: 2600, attack: 0.0002, decay: 0.004, gain: 2.6, pan: -0.4, seed: 42),
                Burst(at: 0.049, low: 800, high: 2600, attack: 0.0002, decay: 0.004, gain: 2.2, pan: 0.45, seed: 43),
                Burst(at: 0.083, low: 700, high: 2400, attack: 0.0002, decay: 0.004, gain: 1.7, pan: -0.2, seed: 44),
                Burst(at: 0.13, low: 600, high: 2200, attack: 0.0002, decay: 0.005, gain: 1.2, pan: 0.3, seed: 45),
                // Debris and dirt thrown up and falling back.
                Hiss(at: 0.02, freq: 700, q: 0.7, attack: 0.03, decay: 0.35, gain: 0.18, seed: 50),
                // Thunder rolling away, first close and rough, then long and low.
                Roll(at: 0.02, from: 1000, to: 120, glide: 0.8, attack: 0.02, decay: 0.55, gain: 0.5, swell: 8, depth: 0.6, seed: 48),
                Roll(at: 0.12, from: 300, to: 50, glide: 1.8, attack: 0.1, decay: 1.3, gain: 0.35, swell: 3, depth: 0.55, seed: 51),
                // The clap coming back off the ground to one side, then further off.
                Burst(at: 0.3, low: 60, high: 500, attack: 0.003, decay: 0.12, gain: 2.4, pan: 0.4, seed: 49),
                Tone(at: 0.3, from: 55, to: 30, glide: 0.3, attack: 0.005, decay: 0.4, gain: 0.35, pan: 0.4),
                Burst(at: 0.85, low: 45, high: 300, attack: 0.008, decay: 0.25, gain: 1.2, pan: -0.45, seed: 52),
            ],
        ),
    },
)
