                Burst(at: 1.96, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.2, pan: 0.4, seed: 529),
                Burst(at: 2.05, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.3, pan: -0.15, seed: 530),
