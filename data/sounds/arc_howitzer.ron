                Burst(at: 2.2, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.4, pan: -0.35, seed: 533),
                Burst(at: 2.26, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.5, pan: 0.1, seed: 534),
                Burst(at: 2.31, low: 900, high: 3000, attack: 0.0002, decay: 0.003, gain: 1.6, pan: -0.2, seed: 535),
                // The overload: a harsher growl climbing into the mids over the last part.
