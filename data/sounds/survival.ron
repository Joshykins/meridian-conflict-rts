// Survival: the Replication Engine's voice. The game asks for these by name.
// The engine is not a factory: nothing clanks. It sounds like a vast
// projector winding up and letting go, detuned stacks and FM that open and
// close, always moving.
(
    sounds: {
        // A round begins printing: a low swell that climbs a fifth and opens,
        // under it a slow sub drop, like a machine the size of a town waking.
        "survival_round": (
            length: 5.0, peak: 0.5, room: 0.55,
            layers: [
                Stack(from: 55, to: 82, glide: 1.6, attack: 0.5, decay: 1.6, gain: 0.7, detune: 1.006, width: 0.4, partials: [(1, 1), (2, 0.45), (3, 0.22), (5, 0.08)]),
                Fm(from: 110, to: 165, glide: 1.4, ratio: 2, index: 2.2, fade: 1.2, attack: 0.35, decay: 1.4, gain: 0.35),
                Tone(from: 70, to: 38, glide: 1.8, attack: 0.2, decay: 1.2, gain: 0.5),
                Drive(1.25),
                Sweep(from: 300, to: 1800, glide: 1.5, q: 3, attack: 0.6, decay: 0.8, gain: 0.8),
            ],
        ),
        // The round is sent: two falling blasts, the second lower, and air
        // rushing out after them.
        "survival_launch": (
            length: 3.0, peak: 0.52, room: 0.5,
            layers: [
                Fm(from: 196, to: 98, glide: 0.5, ratio: 0.5, index: 2.4, fade: 0.5, attack: 0.02, decay: 0.55, gain: 0.5),
                Fm(at: 0.45, from: 147, to: 62, glide: 0.8, ratio: 0.5, index: 2.8, fade: 0.7, attack: 0.02, decay: 0.9, gain: 0.55),
                Tone(at: 0.45, from: 60, to: 34, glide: 0.9, attack: 0.01, decay: 0.8, gain: 0.5),
                Drive(1.3),
                Sweep(at: 0.5, from: 1400, to: 220, glide: 1.2, q: 2, attack: 0.05, decay: 1.2, gain: 0.9),
            ],
        ),
        // The ray lights toward a node site: a charge climbing out of the
        // floor into a bright crack.
        "survival_node_raising": (
            length: 3.2, peak: 0.5, room: 0.45,
            layers: [
                Stack(from: 70, to: 420, glide: 1.4, attack: 1.0, decay: 0.5, gain: 0.5, detune: 1.012, width: 0.5, partials: [(1, 1), (1.5, 0.5), (2, 0.4), (3, 0.2)]),
                Fm(from: 220, to: 880, glide: 1.4, ratio: 1.41, index: 1.4, fade: 1.2, attack: 1.0, decay: 0.3, gain: 0.25),
                Burst(at: 1.4, low: 300, high: 2400, attack: 0.001, decay: 0.05, gain: 8),
                Tone(at: 1.4, from: 180, to: 60, glide: 0.6, attack: 0.002, decay: 0.8, gain: 0.55),
                Drive(1.2),
                Sweep(at: 1.4, from: 3000, to: 500, glide: 0.9, q: 2.5, attack: 0.01, decay: 0.9, gain: 0.7),
            ],
        ),
        // A node comes online: the ray lets go and a chord blooms upward, a
        // little sour (a tritone in it), because this is bad news.
        "survival_node_online": (
            length: 3.6, peak: 0.46, room: 0.5,
            layers: [
                Stack(from: 146, to: 175, glide: 0.5, attack: 0.04, decay: 1.4, gain: 0.5, detune: 1.008, width: 0.45, partials: [(1, 1), (1.41, 0.55), (2, 0.4), (2.83, 0.18)]),
                Fm(from: 350, to: 440, glide: 0.4, ratio: 3.5, index: 1.1, fade: 0.8, attack: 0.02, decay: 1.1, gain: 0.25),
                Tone(from: 90, to: 58, glide: 0.8, attack: 0.01, decay: 0.9, gain: 0.35),
                Drive(1.15),
            ],
        ),
        // A node destroyed: its hum collapsing down, then a clean rising
        // pair: good news, on the upbeat.
        "survival_node_down": (
            length: 3.0, peak: 0.48, room: 0.45,
            layers: [
                Stack(from: 330, to: 55, glide: 0.9, attack: 0.005, decay: 0.9, gain: 0.5, detune: 1.02, width: 0.5, partials: [(1, 1), (1.41, 0.5), (2, 0.35)]),
                Burst(low: 120, high: 1600, attack: 0.001, decay: 0.08, gain: 7),
                Fm(at: 0.8, from: 392, to: 523, glide: 0.25, ratio: 2, index: 0.9, fade: 0.5, attack: 0.01, decay: 0.7, gain: 0.3),
                Fm(at: 1.05, from: 523, to: 784, glide: 0.25, ratio: 2, index: 0.8, fade: 0.5, attack: 0.01, decay: 0.9, gain: 0.3),
                Drive(1.15),
                Sweep(from: 1600, to: 180, glide: 0.8, q: 2, attack: 0.005, decay: 0.8, gain: 0.8),
            ],
        ),
        // The ray itself, held while a node goes up: a thick, beating hum.
        "replication_ray": (
            length: 2.0, peak: 0.42, room: 0.3, looped: true,
            layers: [
                Drone(freq: 55, gain: 0.07, wobble: 3, depth: 0.35),
                Drone(freq: 82.5, gain: 0.055, wobble: 5, depth: 0.5),
                Drone(freq: 110.6, gain: 0.045, wobble: 7.5, depth: 0.65),
                Drone(freq: 165, gain: 0.03, wobble: 11, depth: 0.7),
                Drive(1.35),
                Rumble(freq: 1200, q: 2.4, gain: 2.2, wobble: 9, depth: 0.7),
            ],
        ),
        // A print beam depositing a unit on a bay: the build beam's cousin,
        // glassier, with a slow shimmer.
        "replication_print": (
            length: 2.0, peak: 0.36, room: 0.22, looped: true,
            layers: [
                Drone(freq: 196, gain: 0.045, wobble: 3.5, depth: 0.3),
                Drone(freq: 277, gain: 0.04, wobble: 6, depth: 0.5),
                Drone(freq: 392, gain: 0.03, wobble: 9, depth: 0.6),
                Drive(1.1),
                Rumble(freq: 1500, q: 3, gain: 1.5, wobble: 7, depth: 0.6),
            ],
        ),
    },
)
