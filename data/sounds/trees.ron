// Trees going over (audio/titan/trees.rs): a big walker or a capital ship settling
// knocks a tree down (`SimEvent::TreeTrampled`) and the renderer tips it from its foot,
// landing 1.1 s later (fallen_trees.rs `FALL`). The sound follows that fall: the trunk
// giving way at the foot, the crown rushing down through the air, and the crash as it
// lands.
//
// A tree is wood and leaves, not a blast: the cracks are tiny and bright, the landing is
// mostly the crown's thousands of twigs and leaves crunching and swishing, with only a
// soft, short thump of the trunk under it. Nothing booms, nothing rings. It is a small
// sound in a battle, heard only close (`Ear::hear_close`). Every noise layer has a pinned
// seed, so its crackle stays as measured.
(
    sounds: {
        // One tree coming down, timed to the renderer's fall.
        "tree_fall": (
            length: 2.6, peak: 0.3, room: 0.3,
            layers: [
                // Stage one: the trunk giving way. Fibres snapping, sharp and dry, closer
                // together as it goes, and the wood groaning as it leans: two raspy creaks
                // beating against each other so they never settle into a buzz.
                Burst(low: 1400, high: 4500, attack: 0.0003, decay: 0.004, gain: 2.0, seed: 7311),
                Burst(at: 0.004, low: 500, high: 1800, attack: 0.0005, decay: 0.012, gain: 1.2, seed: 7312),
                Burst(at: 0.13, low: 1600, high: 4800, attack: 0.0003, decay: 0.003, gain: 1.1, pan: 0.2, seed: 7313),
                Burst(at: 0.21, low: 1200, high: 4200, attack: 0.0003, decay: 0.004, gain: 1.4, pan: -0.15, seed: 7314),
                Burst(at: 0.26, low: 1800, high: 5000, attack: 0.0003, decay: 0.003, gain: 0.8, pan: 0.1, seed: 7315),
                Burst(at: 0.3, low: 1400, high: 4400, attack: 0.0003, decay: 0.004, gain: 1.2, seed: 7316),
                Burst(at: 0.33, low: 1600, high: 4800, attack: 0.0003, decay: 0.003, gain: 0.7, pan: -0.2, seed: 7317),
                Chirp(at: 0.05, from: 420, to: 300, glide: 0.5, attack: 0.1, decay: 0.16, gain: 0.07, pulse: 23, ratio: 0.5, index: 2.0),
                Chirp(at: 0.12, from: 560, to: 380, glide: 0.4, attack: 0.08, decay: 0.12, gain: 0.05, pulse: 31, ratio: 0.5, index: 1.8, pan: 0.15),
                // Stage two: the crown picking up speed, its leaves rushing through the air
                // louder and brighter to the end, fluttering.
                Sweep(at: 0.3, from: 900, to: 3200, glide: 0.8, q: 0.8, attack: 0.75, decay: 0.08, gain: 0.35),
                Foam(at: 0.45, from: 2500, to: 5000, glide: 0.65, q: 0.9, attack: 0.6, decay: 0.08, gain: 0.25, swell: 18, depth: 0.8, pan: -0.2, seed: 7321),
                // Stage three, at 1.1 s: it lands. The crown crashing: twigs snapping by
                // the hundred (a fast crackle), leaves swishing, a few bigger branches
                // cracking under it, all dying away over half a second.
                Foam(at: 1.1, from: 4200, to: 1800, glide: 0.6, q: 0.8, attack: 0.006, decay: 0.28, gain: 1.0, swell: 38, depth: 1.0, seed: 7331),
                Foam(at: 1.11, from: 2600, to: 1200, glide: 0.7, q: 0.9, attack: 0.01, decay: 0.3, gain: 0.7, swell: 30, depth: 1.0, pan: 0.25, seed: 7332),
                Sweep(at: 1.1, from: 4000, to: 2000, glide: 0.5, q: 0.6, attack: 0.005, decay: 0.22, gain: 0.6, pan: -0.15, seed: 7333),
                Burst(at: 1.12, low: 1000, high: 3800, attack: 0.0003, decay: 0.005, gain: 1.4, pan: 0.3, seed: 7334),
                Burst(at: 1.17, low: 900, high: 3400, attack: 0.0003, decay: 0.006, gain: 1.1, pan: -0.3, seed: 7335),
                Burst(at: 1.24, low: 1200, high: 4000, attack: 0.0003, decay: 0.004, gain: 0.8, pan: 0.1, seed: 7336),
                // The trunk meeting the ground under it: a soft, short thump, and one small
                // bounce. Kept low in the mix: a big low thud made the first version a blast.
                Burst(at: 1.1, low: 90, high: 420, attack: 0.004, decay: 0.05, gain: 1.0, seed: 7341),
                Burst(at: 1.38, low: 100, high: 450, attack: 0.004, decay: 0.035, gain: 0.4, seed: 7342),
                // Leaves and twigs settling: a last rustle and a few bits pattering down.
                Foam(at: 1.35, from: 3000, to: 2000, glide: 0.8, q: 1.0, attack: 0.08, decay: 0.3, gain: 0.25, swell: 22, depth: 0.9, pan: -0.25, seed: 7351),
                Burst(at: 1.55, low: 1500, high: 4200, attack: 0.0003, decay: 0.003, gain: 0.35, pan: 0.35, seed: 7352),
                Burst(at: 1.72, low: 1300, high: 3800, attack: 0.0003, decay: 0.003, gain: 0.25, pan: -0.3, seed: 7353),
                Burst(at: 1.95, low: 1600, high: 4400, attack: 0.0003, decay: 0.003, gain: 0.18, pan: 0.15, seed: 7354),
            ],
        ),
    },
)
