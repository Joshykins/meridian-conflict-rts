// Trees going over (audio/titan/trees.rs): a big walker or a capital ship settling
// knocks a tree down (`SimEvent::TreeTrampled`) and the renderer tips it from its foot,
// landing 1.1 s later (fallen_trees.rs `FALL`). The sound follows that fall as three
// stages: the trunk giving way at the foot, the crown rushing down through the air, and
// the crash as it lands. Wood, not metal: short dry cracks and a creak of fibre tearing,
// no ringing partials. Every Roll has a pinned seed, so its swells stay as measured.
(
    sounds: {
        // One tree coming down, timed to the renderer's fall.
        "tree_fall": (
            length: 2.7, peak: 0.6, room: 0.5,
            layers: [
                // Stage one: the trunk snapping at the foot. A dry crack, a second one as the
                // fibres let go, and the heartwood tearing: a rasping creak that sinks as it leans.
                Burst(low: 500, high: 2800, attack: 0.0004, decay: 0.014, gain: 6.0),
                Burst(at: 0.002, low: 150, high: 900, attack: 0.001, decay: 0.05, gain: 5.0),
                Burst(at: 0.09, low: 700, high: 3200, attack: 0.0004, decay: 0.009, gain: 3.0, pan: 0.2),
                Burst(at: 0.17, low: 600, high: 2600, attack: 0.0004, decay: 0.008, gain: 2.0, pan: -0.15),
                Chirp(at: 0.02, from: 210, to: 140, glide: 0.55, attack: 0.05, decay: 0.2, gain: 0.5, pulse: 38, ratio: 0.5, index: 1.6),
                Chirp(at: 0.3, from: 170, to: 120, glide: 0.35, attack: 0.08, decay: 0.12, gain: 0.2, pulse: 27, ratio: 0.5, index: 1.4, pan: 0.15),
                // Stage two: the crown picking up speed, its leaves rushing through the air
                // louder and brighter to the end, a flutter in it.
                Sweep(at: 0.2, from: 700, to: 2600, glide: 0.9, q: 0.7, attack: 0.85, decay: 0.12, gain: 0.7),
                Roll(at: 0.35, from: 1800, to: 4200, glide: 0.75, attack: 0.7, decay: 0.1, gain: 0.3, swell: 22, depth: 0.8, pan: -0.2, seed: 7301),
                // Stage three, at 1.1 s: it lands. A dull thud of the trunk on the ground and
                // the ground taking it, then branches snapping under it, one bounce.
                Burst(at: 1.1, low: 35, high: 260, attack: 0.003, decay: 0.16, gain: 4.0),
                Tone(at: 1.1, from: 95, to: 42, glide: 0.18, attack: 0.003, decay: 0.2, gain: 0.7),
                Burst(at: 1.102, low: 250, high: 1600, attack: 0.001, decay: 0.04, gain: 3.0),
                Burst(at: 1.14, low: 600, high: 2800, attack: 0.0004, decay: 0.009, gain: 1.0, pan: 0.3),
                Burst(at: 1.19, low: 500, high: 2400, attack: 0.0004, decay: 0.008, gain: 0.8, pan: -0.35),
                Burst(at: 1.27, low: 700, high: 3000, attack: 0.0004, decay: 0.006, gain: 0.55, pan: 0.1),
                Burst(at: 1.42, low: 40, high: 220, attack: 0.004, decay: 0.08, gain: 2.2),
                Tone(at: 1.42, from: 70, to: 40, glide: 0.1, attack: 0.004, decay: 0.08, gain: 0.4),
                Burst(at: 1.5, low: 550, high: 2200, attack: 0.0004, decay: 0.007, gain: 0.4, pan: -0.2),
                // The crown crashing down: a burst of leaves and twigs, settling into a last
                // rustle.
                Roll(at: 1.1, from: 3200, to: 1400, glide: 0.8, attack: 0.01, decay: 0.3, gain: 0.55, swell: 26, depth: 0.85, seed: 7302),
                Sweep(at: 1.1, from: 2400, to: 900, glide: 0.7, q: 0.6, attack: 0.008, decay: 0.28, gain: 0.5, pan: 0.15),
                Roll(at: 1.3, from: 2600, to: 1600, glide: 1.0, attack: 0.1, decay: 0.3, gain: 0.18, swell: 14, depth: 0.8, pan: -0.25, seed: 7303),
                // Earth thrown up where it landed.
                Roll(at: 1.1, from: 260, to: 90, glide: 0.8, attack: 0.02, decay: 0.3, gain: 0.35, swell: 5, depth: 0.5, seed: 7304),
            ],
        ),
    },
)
