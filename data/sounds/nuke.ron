// Strategic missiles (docs/NUKES.md): a silo launching, an interceptor going up, a
// warhead broken open high up, and the detonation itself. Everything here is big and
// low; nothing whines or rings. A commander's reactor going up is the detonation smaller
// (`commander_death` in battle.ron is its own recipe, trimmed of its high whine).
(
    sounds: {
        // The warhead going off: the flash is silent, then the air arrives. A hard crack held
        // down in the low mids, a slam, and under it a sub-bass thump that takes seconds to
        // let go. The ground heaves three times as the front goes out and comes back, the shock
        // cracks overhead now and then, and the thunder rolls: low noise swelling and sagging
        // at random, from both sides, for half a minute, sinking and thinning as it goes. The
        // body sits around 60 to 120 Hz so small speakers carry it; nothing rises or rings.
        "nuke_detonation": (
            length: 30.0, peak: 0.9, room: 1.0,
            layers: [
                Burst(low: 120, high: 1100, attack: 0.0005, decay: 0.03, gain: 7),
                Burst(at: 0.002, low: 40, high: 420, attack: 0.002, decay: 0.35, gain: 16),
                Burst(at: 0.004, low: 32, high: 200, attack: 0.008, decay: 1.0, gain: 14),
                Tone(from: 130, to: 55, glide: 0.25, attack: 0.002, decay: 0.6, gain: 2.2),
                Tone(from: 80, to: 36, glide: 0.8, attack: 0.004, decay: 1.4, gain: 2.6),
                Tone(from: 52, to: 34, glide: 2.0, attack: 0.01, decay: 2.2, gain: 1.4),
                // The air itself tearing, right under the thump.
                Roll(from: 260, to: 85, glide: 2.5, attack: 0.02, decay: 2.5, gain: 2.4, swell: 3.0, depth: 0.5),
                // The ground heaves as the front passes, and again as it comes back.
                Burst(at: 1.4, low: 35, high: 260, attack: 0.006, decay: 0.5, gain: 9, pan: -0.3),
                Tone(at: 1.4, from: 92, to: 40, glide: 0.8, attack: 0.006, decay: 1.1, gain: 1.6, pan: -0.3),
                Burst(at: 2.9, low: 30, high: 220, attack: 0.008, decay: 0.6, gain: 6.5, pan: 0.35),
                Tone(at: 2.9, from: 80, to: 38, glide: 1.0, attack: 0.008, decay: 1.4, gain: 1.3, pan: 0.35),
                Burst(at: 4.8, low: 28, high: 180, attack: 0.01, decay: 0.7, gain: 4.0),
                Tone(at: 4.8, from: 70, to: 36, glide: 1.4, attack: 0.01, decay: 1.8, gain: 1.0),
                Drive(1.8),
                // The shock cracking overhead as it arrives, and again further off.
                Burst(at: 0.55, low: 90, high: 1000, attack: 0.0006, decay: 0.04, gain: 2.2, pan: -0.4),
                Burst(at: 0.9, low: 80, high: 900, attack: 0.0006, decay: 0.05, gain: 1.6, pan: 0.3),
                Burst(at: 1.42, low: 80, high: 900, attack: 0.0006, decay: 0.05, gain: 1.4, pan: -0.2),
                Burst(at: 2.2, low: 70, high: 800, attack: 0.0008, decay: 0.06, gain: 1.2, pan: 0.5),
                Burst(at: 3.5, low: 70, high: 750, attack: 0.001, decay: 0.07, gain: 0.9, pan: -0.3),
                Burst(at: 5.7, low: 60, high: 650, attack: 0.001, decay: 0.08, gain: 0.7, pan: 0.35),
                Burst(at: 8.3, low: 60, high: 600, attack: 0.0015, decay: 0.09, gain: 0.5, pan: -0.45),
                Burst(at: 12.0, low: 50, high: 500, attack: 0.002, decay: 0.1, gain: 0.35, pan: 0.2),
                // The roll: thunder going away in every direction, swelling at random as the
                // front bounces off the country, getting lower and further as it goes.
                Roll(at: 0.1, from: 320, to: 110, glide: 4.0, attack: 0.3, decay: 5.0, gain: 0.8, swell: 1.2, depth: 0.75),
                Roll(at: 0.6, from: 190, to: 70, glide: 10.0, attack: 1.5, decay: 7.0, gain: 0.75, swell: 0.7, depth: 0.85, pan: -0.5),
                Roll(at: 0.9, from: 180, to: 66, glide: 12.0, attack: 2.0, decay: 7.5, gain: 0.75, swell: 0.6, depth: 0.85, pan: 0.5),
                // The ground shaking under it all, slowest of all.
                Roll(at: 0.3, from: 95, to: 48, glide: 14.0, attack: 1.0, decay: 8.0, gain: 0.85, swell: 0.35, depth: 0.7),
                Roll(at: 4.0, from: 130, to: 52, glide: 16.0, attack: 5.0, decay: 6.5, gain: 0.6, swell: 0.25, depth: 0.9),
                // The fire over the country afterwards: a low roar that falls away.
                Sweep(at: 2.5, from: 110, to: 65, glide: 9.0, q: 0.7, attack: 2.0, decay: 4.0, gain: 0.6),
            ],
        ),
        // A warhead lighting in its silo and climbing out, in two stages. The gas generator
        // kicks it up the tube with a deep whump and a rush of steam; then the motor lights
        // with a hard slam, a sub-bass shove, and the roar: low, fluttering, torn by the
        // crackle a big solid motor makes, swelling as it clears the tube and sinking away
        // as it climbs. Nothing whines; the pitch only falls.
        "nuke_launch": (
            length: 16.0, peak: 0.95, room: 0.9,
            layers: [
                // Stage one: the tube's charge.
                Burst(low: 40, high: 380, attack: 0.003, decay: 0.12, gain: 12),
                Tone(from: 70, to: 34, glide: 0.35, attack: 0.004, decay: 0.5, gain: 2.2),
                Sweep(at: 0.02, from: 900, to: 260, glide: 0.8, q: 0.6, attack: 0.05, decay: 0.45, gain: 1.1),
                // Stage two: the motor lights.
                Burst(at: 0.55, low: 90, high: 1200, attack: 0.0006, decay: 0.03, gain: 9),
                Burst(at: 0.552, low: 32, high: 260, attack: 0.003, decay: 0.45, gain: 16),
                Tone(at: 0.55, from: 96, to: 30, glide: 0.9, attack: 0.003, decay: 1.3, gain: 2.6),
                Fm(at: 0.56, from: 31, to: 36, glide: 5.0, ratio: 0.5, index: 1.8, fade: 4.0, attack: 0.25, decay: 5.0, gain: 0.7),
                Drive(1.6),
                // The roar: a fluttering low bed, a body over it, and a harsher top that thins
                // as it goes up and away.
                Roll(at: 0.58, from: 150, to: 90, glide: 9.0, attack: 0.25, decay: 5.5, gain: 1.6, swell: 8.0, depth: 0.55),
                Roll(at: 0.6, from: 80, to: 55, glide: 10.0, attack: 0.4, decay: 6.5, gain: 1.4, swell: 3.0, depth: 0.4),
                Sweep(at: 0.6, from: 70, to: 52, glide: 8.0, q: 0.6, attack: 0.3, decay: 5.0, gain: 1.9),
                Sweep(at: 0.62, from: 260, to: 120, glide: 9.0, q: 0.7, attack: 0.5, decay: 4.0, gain: 1.1, pan: -0.2),
                Sweep(at: 0.64, from: 240, to: 110, glide: 9.0, q: 0.7, attack: 0.6, decay: 4.2, gain: 1.0, pan: 0.2),
                // Its crackle, thick at first, thinning out.
                Burst(at: 0.869, low: 235, high: 1217, attack: 0.0005, decay: 0.014, gain: 5.83, pan: 0.39),
                Burst(at: 0.879, low: 292, high: 1295, attack: 0.0005, decay: 0.017, gain: 3.93, pan: 0.53),
