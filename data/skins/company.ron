// Merrick's Company: worn sand-grey armour and warm amber emitters.
(
    // Its light: the emitters' hue, a placement ghost's, a charge band's.
    highlight: (1.0, 0.64, 0.25),
    // How its plates are finished (docs/STANDARD.md): dense texture detail, deep seams,
    // plates a little smaller than the standard, edges worn, field grime.
    finish: (detail: 1.0, seams: 2.8, plate: 0.65, wear: 2.0, grime: 1.8),
    slots: (
        plate: (color: Rgb((0.22, 0.19, 0.14)), metal: 0.3, rough: 0.6),
        // Armour painted dark: the plating taken down to graphite.
        plate_dark: (color: Plate((0.3, 0.33, 0.39)), metal: 0.45, rough: 0.42),
        trim: (color: Rgb((0.072, 0.082, 0.1)), metal: 0.7, rough: 0.42),
        emitter: (color: Highlight(0.2), rough: 0.3, glow: Highlight(5.0)),
        metal: (color: Rgb((0.32, 0.33, 0.36)), metal: 0.95, rough: 0.32),
        // Sensors and canopies: dark glass with a little of the emitters' light in it.
        glass: (color: Rgb((0.02, 0.05, 0.09)), metal: 0.9, rough: 0.08, glow: Highlight(0.15)),
        rubber: (color: Rgb((0.03, 0.03, 0.035)), rough: 0.9),
        gun_glow: (color: Rgb((0.3, 0.12, 0.02)), rough: 0.3, glow: Light((1.0, 0.42, 0.08), 4.0)),
        // Construction: the yellow-orange of a build beam.
        build_glow: (color: Rgb((0.3, 0.17, 0.02)), rough: 0.3, glow: Light((1.0, 0.6, 0.1), 4.0)),
        // Obstruction lamps (the shader blinks them).
        beacon: (color: Rgb((0.28, 0.03, 0.03)), rough: 0.28, glow: Light((1.0, 0.08, 0.06), 5.0)),
        nanite: (color: Rgb((0.18, 0.05, 0.3)), rough: 0.25, glow: Light((0.66, 0.12, 1.0), 5.0)),
        // Missile defence: a steady laser red.
        laser: (color: Rgb((0.3, 0.02, 0.02)), rough: 0.25, glow: Light((1.0, 0.07, 0.05), 5.5)),
        // A helmet visor: gold-orange mirror glass.
        visor: (color: Rgb((0.46, 0.2, 0.02)), metal: 1.0, rough: 0.12),
    ),
)
